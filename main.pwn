CMD:id(playerid, params[])
{
	new id = 0;
	if(isnull(params) || strlen(params) > 25) return SendEsp(playerid, "/id [Ник игрока]");
	SendClientMessage(playerid, COLOR_BLUE, "Игроки онлайн:");
	new string[144];
	if(!isNumeric(params))
	{
		if(!IsPlayerConnected(strval(params))) return ErrorMessage(playerid, not_id);
		format(string, sizeof(string), "%s (%i) | LVL: %d | ID: %d", player_name[strval(params)], strval(params), PI[strval(params)][pLevel], PI[strval(params)][pID], (TI[strval(params)][tAFK] > 3) ? (""P"[AFK]") : (""));
		SendClientMessage(playerid, -1, string);
		return 1;
	}
	foreach(new i: Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(strfind(player_name[i], params, true) != -1)
		{
			if(id > 10) break;
			format(string, sizeof(string), "%s (%i) | LVL: %d | ID: %d", player_name[i], i, PI[i][pLevel], PI[i][pID], (TI[i][tAFK] > 3) ? (""P"[AFK]") : (""));
			SendClientMessage(playerid, -1, string);
			id++;
		}
	}
	return 1;
}
CMD:s(playerid, params[])
{
	if(PI[playerid][pStageDeath])
		return ErrorMessage(playerid, "Ваш персонаж не в состоянии кричать!");
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerShoutFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто кричать");
		PlayerShoutFix[playerid] = gettime() + 10;
	}

	if(GetPVarInt(playerid, "FloodByPlayer") > unix && PI[playerid][pExp] < 3) return ErrorMessage(playerid, "Пожалуйста подождите");
	else if(isnull(params) || strlen(params) > 100) return SendEsp(playerid, "/s [текст]");
	new string[145];
	format(string, sizeof(string), "- [%d] %s кричит: %s", playerid, player_RP_name[playerid], params);
	ProxDetector(30.0, playerid, string, COLOR_WHITE);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && !TI[playerid][tCuffed]) ApplyAnimation(playerid, "ON_LOOKERS", "shout_in", 9000.999, 0, 0, 0, 0, 0, 1);
	SetPlayerChatBubble(playerid, params, COLOR_WHITE, 60.0, 10000);
	SetPVarInt(playerid, "FloodByPlayer", unix + 7);
	return 1;
}
CMD:kiss(playerid, params[])
{
	if(PI[playerid][pStageDeath])
		return true;
	new kiss;
	if(PI[playerid][pJailTime] > 0) return ErrorMessage(playerid, "Нельзя использовать эту команду в тюрьме");
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
	if(sscanf(params, "i", kiss)) return SendEsp(playerid, "/kiss [playerid]");
	if(kiss == playerid) return ErrorMessage(playerid, "Нельзя поцеловать самого себя");
	if(!IsPlayerConnected(kiss)) return ErrorMessage(playerid, not_id);
	if(!IsPlayerStream(4.0, playerid, kiss)) return ErrorMessage(playerid, "Игрок не рядом с Вами");
	if(PI[kiss][pJailTime] > 0) return ErrorMessage(playerid, "Игрок в тюрьме");
	if(active_accept(kiss)) return ErrorMessage(playerid, "У игрока есть активное предложение");
	if(PI[kiss][pStageDeath]) return true;

	new string[128];

	format(string, sizeof(string), "Вы предложили "P"%s"G" поцелуй", player_name[kiss]);
	SendUse(playerid, string);
	format(string, sizeof(string), ""P"%s"G" предложил(а) вам поцелуй", player_name[playerid]);
	SendUse(kiss, string);
	SendClientMessage(kiss, COLOR_BLUE, "Нажмите "YES"Y "BLUE"чтобы согласиться "NO"N "BLUE"для отказа");

	SetPVarInt(kiss, "kiss", playerid + 1);
	return 1;
}
alias:w("whisper");
CMD:w(playerid, params[])
{
	if(PI[playerid][pStageDeath] == 2)
		return ErrorMessage(playerid, "Ваш персонаж не в состоянии разговаривать!");
	if(TI[playerid][tGag]) return ErrorMessage(playerid, "У Вас кляп");
	else if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	else if(isnull(params) || strlen(params) > 100) return SendEsp(playerid, "/w(hisper) [сообщение]");
	new string[144];
	format(string, sizeof(string), "- [%d] %s шепчет: %s", playerid, player_RP_name[playerid], params);
	SendStreamMessage(1.25, playerid, string, 0x6E6E6E6E);
	SetPlayerChatBubble(playerid, params, 0x6E6E6E6E, 30.0, 10000);
	return 1;
}
CMD:flip(playerid)
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(PI[playerid][pCash] <= 0) return ErrorMessage(playerid, "У Вас недостаточно средств");

	static const   coin_str0[] = "подбросил(а) монетку, выпал",
								 coin_str1[] = "а \"решка\".", coin_str2[] = " \"орёл\".";

	new string[MAX_PLAYER_NAME + ( sizeof ( coin_str0 ) - 1 ) + ( sizeof ( coin_str1 ) - 1 ) + 1 ] ;

	strcat(string, coin_str0);
	strcat(string, (random(2)) ? (coin_str1) : (coin_str2));

	MeAction(playerid, string);
	return 1;
}
CMD:ame(playerid, params[])
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerMeFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerMeFix[playerid] = gettime() + 60;
	}
	if(isnull(params) || strlen(params) > 80) return SendEsp(playerid, "/ame [действие]");
	//MeAction(playerid,params);
	format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), "%s: %s", player_RP_name[playerid], params);
	SendClientMessage(playerid, COLOR_PURPLE, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;

	SetPlayerChatBubble(playerid, params, COLOR_PURPLE, 13.0, 7000);
	return 1;
}
CMD:ado(playerid, params[])
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(isnull(params) || strlen(params) > 80) return SendEsp(playerid, "/ado [действие]");
	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerDoFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerDoFix[playerid] = gettime() + 60;
	}
	//DoAction(playerid,params);
	SetPlayerChatBubble(playerid, params, COLOR_PURPLE, 13.0, 7000);
	return 1;
}
CMD:me(playerid, params[])
{
	new text[160];
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(sscanf(params, "s[161]", text)) return SendEsp(playerid, "/me [действие]");
	if(strlen(params[0]) > 160) return ErrorMessage(playerid, "Количество символов в действие не может быть более 140");

	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerMeFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerMeFix[playerid] = gettime() + 60;
	}
	if(strlen(text) >= 512)
	{
		new string[128];
		new mes[128];
		new mess[128];
		strmid(string,text,64,128,128);
		strdel(text,64,128);
		format(mes, sizeof(mes), "%s %s-", player_RP_name[playerid], text);
		format(mess, 88, "...%s",string);
		foreach(new i: Player)
		{
			if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
			if(GetPlayerDistanceToPlayer(playerid, i) > 13.0 || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
			SendClientMessage(i, 0xEB4986AA, mes);
			SendClientMessage(i, 0xEB4986AA, mess);
			SetPlayerChatBubble(playerid, mes, 0xEB4986AA, 13.0, 7000);
			break;
		}
	}
	else
	{
		MeAction(playerid, params[0]);
		SetPlayerChatBubble(playerid, params[0], 0xEB4986AA, 13.0, 7000);
	}
	return true;
}
stock MeAction(playerid, const action[], Float: distance = 13.0, type = 0)
{
	new mes[145];
	if(type != 0) {
		format(mes, sizeof(mes), "%s", action);
		SetPlayerChatBubble(playerid, action, 0xFF0000FF, 10.0, 5000);
		return 1;
	}
	format(mes, sizeof(mes), "%s %s", player_RP_name[playerid], action);
	foreach(new i: Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(GetPlayerDistanceToPlayer(playerid, i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessageEx(i, 0xEB4986AA, mes);
	}
	return 1;
}
CMD:do(playerid, params[])
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(sscanf(params, "s[81]", params[0])) return SendEsp(playerid, "/do [действие]");
	if(strlen(params[0]) > 80) return ErrorMessage(playerid, "Количество символов в действие не может быть более 80");

	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerDoFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerDoFix[playerid] = gettime() + 60;
	}

	DoAction(playerid, params[0]);
	SetPlayerChatBubble(playerid, params[0], 0x8D2167AA, 13.0, 7000);
	return 1;
}
stock DoAction(playerid, action[], Float: distance = 13.0)
{
	if(TI[playerid][tGag]) return ErrorMessage(playerid, "У Вас кляп");
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	new string[128];
	format(string, sizeof(string), "%s (%s)", action, player_RP_name[playerid]);
	SendStreamMessage(distance, playerid, string, 0x8D2167AA);
	return 1;
}
CMD:try(playerid, params[])
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerTryFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerTryFix[playerid] = gettime() + 60;
	}

	if(sscanf(params, "s[81]", params[0])) return SendEsp(playerid, "/try [действие]");
	if(strlen(params[0]) > 80) return ErrorMessage(playerid, "Количество символов в действие не может быть более 80");
	TryAction(playerid, params[0]);
	return 1;
}
CMD:todo(playerid, params[])
{
	if(PI[playerid][pStageDeath] == 2)
		return ErrorMessage(playerid, "Ваш персонаж не в состоянии разговаривать!");
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");

	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerDoFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerDoFix[playerid] = gettime() + 60;
	}

	new Text_[65], Deistvie_[129];
	if(sscanf(params, "p<*>s[64]s[110]", Text_, Deistvie_) || !(2 <= strlen(Text_) <= 62) || strlen(Deistvie_) < 4)
		return SendEsp(playerid, "/todo [текст]*[действие]");

	new string[156];
	format(string, sizeof(string), "\""W"%s{EB4986}\", - сказал(а) %s, %s", Text_, player_RP_name[playerid], Deistvie_);
	SendStreamMessage(13.0, playerid, string, 0xEB4986AA);
	return 1;
}
alias:b("n");
CMD:b(playerid, params[])
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(PI[playerid][pMuteOOC] > 0) return ErrorMessage(playerid, "У Вас бан чата (OOC)");
	new mes[128];
	if(sscanf(params, "s[81]", params[0])) return SendEsp(playerid, "/b [текст]");
	if(strlen(params[0]) > 80) return ErrorMessage(playerid, "Количество символов в команде не может быть более 80");
	format(mes, sizeof(mes), "(( %s[%d]: %s ))", player_name[playerid], playerid, params[0]);
	ProxDetector(13.0, playerid, mes, 0xcecf9cFF, .type = 1);
	return true;
}
CMD:ab(playerid, params[])
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	if(PI[playerid][pMuteOOC] > 0) return ErrorMessage(playerid, "У Вас бан чата (OOC)");
	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1)
	{
		if(PlayerMeFix[playerid] > gettime()) return ErrorMessage(playerid, "В казино нельзя так часто использовать эту возможность");
		PlayerMeFix[playerid] = gettime() + 60;
	}
	if(isnull(params) || strlen(params) > 80) return SendEsp(playerid, "/ame [действие]");
	//MeAction(playerid,params);
	format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), "(( %s[%d]: %s ))", player_name[playerid], playerid, params);
	SendClientMessage(playerid, 0xcecf9cFF, CHAT_GLOBAL);

	format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "(( %s ))", params);
	SetPlayerChatBubble(playerid, CHAT_GLOBAL, 0xcecf9cFF, 13.0, 7000), CHAT_GLOBAL[0] = EOS;
	return 1;
}
