	\
	"W"Игровой опыт каждый час\t"P"X%.2f\n\
	"W"Передача денег в банке до\t"P"%d\n\
	"W"Семейные поинты каждый час\t"P"%d\n\
	"W"Доплата при каждой зарплате\t"P"%d%s\n\
	"W"Аптечка востанавливает здоровье\t"P"%d\n\
	"W"Передача денег с помощью /pay до\t"P"$%d\n\
	"W"Наркотики востанавливают здоровье\t"P"%d\n\
	"W"При достижение нового уровня бонус\t"P"$%d",
		   Float:((DEFAULT_MAX_AFK_MIN + VipData[vip_list][VipAFK]) / 60.0),
		   VipData[vip_list][VipHeal],      str_percent,
		   VipData[vip_list][VipAuto],      str_percent,
		   VipData[vip_list][VipSkin],      str_percent,
		   VipData[vip_list][VipWeapon],        str_percent,
		   VipData[vip_list][VipHouse],         str_percent,
		   VipData[vip_list][VipBusiness],  str_percent,
		   VipData[vip_list][VipPerfomance],    str_percent,
		   VipData[vip_list][VipTunning],       str_percent,
		   VipData[vip_list][VipUpdateHouse],   str_percent,
		   VipData[vip_list][VipFixCar],        str_percent,
		   30 + VipData[vip_list][VipInventory],
		   VipData[vip_list][VipBan],       str_percent,
		   VipData[vip_list][VipMute],      str_percent,
		   VipData[vip_list][VipWarn],      str_percent,
		   VipData[vip_list][VipJail],      str_percent,
		   VipData[vip_list][VipHealing],       str_percent,
		   VipData[vip_list][VipDemorgan],  str_percent,
		   VipData[vip_list][VipChat] ?     ("Eсть") : ("Нет"),
		   VipData[vip_list][VipAdvertise] ?   ("Eсть") : ("Нет"),
		   VipData[vip_list][VipAdmins] ?     ("Eсть") : ("Нет"),
		   VipData[vip_list][VipCall] ?     ("Eсть") : ("Нет"),
		   VipData[vip_list][VipSms] ?       ("Eсть") : ("Нет"),
		   VipData[vip_list][VipReport] ?     ("Eсть") : ("Нет"),

		   VipData[vip_list][VipExperian],
		   VipData[vip_list][VipBank],
		   VipData[vip_list][VipFamily],
		   VipData[vip_list][VipPayDay],    str_percent,  
		   VipData[vip_list][VipUseHealme],
		   VipData[vip_list][VipPay],
		   VipData[vip_list][VipUseDrugs],
		   VipData[vip_list][VipLevel]);

	switch(vip_list)
	{
	case 0: ShowPlayerDialog(playerid, D_NEW_DONATE_VIP_INFO, DIALOG_STYLE_TABLIST_HEADERS, ""P"Информация о V.I.P Ruby", STRING_GLOBAL, "Купить", "Отмена");
	case 1: ShowPlayerDialog(playerid, D_NEW_DONATE_VIP_INFO, DIALOG_STYLE_TABLIST_HEADERS, ""P"Информация о V.I.P Sapphire", STRING_GLOBAL, "Купить", "Отмена");
	case 2: ShowPlayerDialog(playerid, D_NEW_DONATE_VIP_INFO, DIALOG_STYLE_TABLIST_HEADERS, ""P"Информация о V.I.P Emerald", STRING_GLOBAL, "Купить", "Отмена");
	case 3: ShowPlayerDialog(playerid, D_NEW_DONATE_VIP_INFO, DIALOG_STYLE_TABLIST_HEADERS, ""P"Информация о V.I.P Diamond", STRING_GLOBAL, "Купить", "Отмена");
	}
	return 0x1;
}
stock load_week()
{
	new dayid;
	new Cache: result;
	result = mysql_query(connects, "SELECT WEEKDAY(CURDATE()) as 'day'");
	new rows = cache_num_rows();
	if(rows)
	{
		cache_get_value_index_int(0, 0, dayid);

	}
	if(cache_is_valid(result)) cache_delete(result);
	return dayid;
}

stock PD2_CreateDynamicObject(modelid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = STREAMER_OBJECT_SD, Float:drawdistance = STREAMER_OBJECT_DD) {
	return CreateDynamicObject(modelid, x, y, z - 300.0, rx, ry, rz, worldid, interiorid, playerid, streamdistance, drawdistance);
}


stock load_hospital_door()
{
	for(new hospital_id = 0; hospital_id < sizeof (HospitalDoors); hospital_id++) {
