		UpdateBuildText(p_var);
		BildExit(playerid);
 
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `billboards` SET `bDay` = 0, `bOwned` = 0, `bOwner` = '-', `bText` = '-', `bFontSize` = 25, `bAligment` = 1, `bBackColor` = 1, `bFontFace` = 0 WHERE `id` = %i", p_var);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case D_BILL_AUNRENT: {
		if(!response) {
			BildExit(playerid);
			return pc_cmd_apanel(playerid);
		}
		new ID = GetPVarInt(playerid, "SelectBildID");
		BildInfo[ID][bFontSize] = 0;
		BildInfo[ID][bBackColor] = 0;
		BildInfo[ID][bFontFace] = 0;
		BildInfo[ID][bOwned] = 0;
