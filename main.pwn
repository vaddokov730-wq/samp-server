			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\n\nВведите цену за "P"1г"W" наркотиков:\nЗаказ на "P"%dг\n\n"NO"*"G" От $15 до $30\n\n", PlayerDrugsFix[playerid]);
			return ShowPlayerDialog(playerid, D_BAND_DRUGS, DSI, ""P"Заказ наркотиков", STRING_GLOBAL, "Далее", "Назад");
		}
		if(FI[GetTeamID(playerid)][fBank] - (price * GetPVarInt(playerid, "buy_gdrugs")) < 0)
		{

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\n\nВведите цену за "P"1г"W" наркотиков:\nЗаказ на "P"%dг\n\n"NO"*"G" Недостаточно средств в общаге банды\n\n", PlayerDrugsFix[playerid]);
			return ShowPlayerDialog(playerid, D_BAND_DRUGS, DSI, ""P"Заказ наркотиков", STRING_GLOBAL, "Далее", "Назад");
		}
		FI[GetTeamID(playerid)][fBank] -= (price * PlayerDrugsFix[playerid]);
		UpdateFraction(GetTeamID(playerid), "Bank", FI[GetTeamID(playerid)][fBank]);
		FI[GetTeamID(playerid)][fDrugsBuy] = PlayerDrugsFix[playerid];
		UpdateFraction(GetTeamID(playerid), "DrugsBuy", FI[GetTeamID(playerid)][fDrugsBuy]);
		FI[GetTeamID(playerid)][fDrugsPrice] = price;
		UpdateFraction(GetTeamID(playerid), "DrugsPrice", FI[GetTeamID(playerid)][fDrugsPrice]);
		PlayerDrugsFix[playerid] = 0;
