			ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Скиллы", "Введите ID игрока которому хотите выдать скиллы", "Принять", "Отмена");
			ErrorMessage(playerid, "Данный игрок не авторизован на сервере");
