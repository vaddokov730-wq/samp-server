	new type = PI[playerid][pPlayerSettings][PLAYER_SETTING_STYLE_CHAT];

	switch(type) {
		case 1: {
			format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), "- %s говорит: %s",
				player_RP_name[targetid], chat
			);
