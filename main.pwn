		new sum = floatround(gHotels[id][hotelPrice] / 100 * 80);

		FI[fWHITEHOUSE][fBank] += floatround(gHotels[id][hotelPrice] / 100 * 20);
		UpdateFraction(fWHITEHOUSE, "Bank", FI[fWHITEHOUSE][fBank]);

