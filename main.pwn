		if(price < 100 || price > 200) return ShowPlayerDialog(playerid, D_HOTEL_PRICE, DSI, ""P"Отель", ""W"Введите цену за сутки проживания\n\n"NO"*"G" От $100 до $200", "ОК", "Отмена");
