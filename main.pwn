				);
				SetVehicleZAngle(PlayerVehicleInfo[player_vehicle_id][carVehicle], vehiclePos[3]);

				SendOk(playerid, "Выбранный транспорт успешно доставлен к вам за "GREEN"$"#FIX_CAR_PLAYER_PRICE""G".");
			}*/
			case 3: { // to house
				if(!PI[playerid][pHouse]) return ErrorMessage(playerid, "У Вас нет дома");

				if(GetPlayerMoneyEx(playerid) < FIX_CAR_HOUSE_PRICE)
					return ErrorMessage(playerid, "У Вас недостаточно средств! ($"#FIX_CAR_HOUSE_PRICE")");

				new houseid = PI[playerid][pHouse] - 1;

				new Float:vehiclePos[3];
				for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
					if(GetVehicleVirtualWorld(i) != 0)
						continue;
					GetVehiclePos(i, vehiclePos[0], vehiclePos[1], vehiclePos[2]);

					if(GetDistanceBetweenPoints(
						vehiclePos[0], vehiclePos[1], vehiclePos[2],
						gHouses[houseid][houseParkX], gHouses[houseid][houseParkY], gHouses[houseid][houseParkZ]) <= 2.0
					) {
						ErrorMessage(playerid, "Место у дома занято другим авто!");
						isOccupied = true;
						break;

					}
				}
				if(isOccupied) return true;

				GiveMoney(playerid, -FIX_CAR_HOUSE_PRICE, "Доставка ТС к дому");

				VehicleInfo[PlayerVehicleInfo[player_vehicle_id][carVehicle]][vParkingFine] = 0;
				PlayerVehicleInfo[player_vehicle_id][carParked] = 1;

				PlayerVehicleInfo[player_vehicle_id][carPos][0] = gHouses[houseid][houseParkX];
				PlayerVehicleInfo[player_vehicle_id][carPos][1] = gHouses[houseid][houseParkY];
				PlayerVehicleInfo[player_vehicle_id][carPos][2] = gHouses[houseid][houseParkZ];
				PlayerVehicleInfo[player_vehicle_id][carPos][3] = gHouses[houseid][houseParkR];

				PlayerVehicleInfo[player_vehicle_id][carInterior] = 0;
				PlayerVehicleInfo[player_vehicle_id][carWorld] = 0;

				SetVehicleToRespawn(PlayerVehicleInfo[player_vehicle_id][carVehicle]);

				SavePlayerVehicle(player_vehicle_id);

				SendOk(playerid, "Выбранный транспорт успешно доставлен к дому за "GREEN"$"#FIX_CAR_HOUSE_PRICE""G".");
			}
