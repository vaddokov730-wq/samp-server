	#if defined _casino_included
	case D_CASINO_ROULETTE_BET: {
		if(!response)
			return true;
		new tableid = TI[playerid][tCasinoRouletteTable] - 1;
		if(CasinoRouletteTableInfo[tableid][tableTimer] <= 1)
			return ErrorMessage(playerid, "Рулетка уже запущена.");
		if(TI[playerid][tCasinoRouletteBet])
			return ErrorMessage(playerid, "Вы уже сделали ставку.");

		new amount = strval(inputtext);
		if(!(CasinoRouletteTableInfo[tableid][tableMinBet] <= amount <= CasinoRouletteTableInfo[tableid][tableMaxBet])) {
			format(STRING_GLOBAL, sizeof (STRING_GLOBAL),
				""W"Введите сумму ставки:\n\n\
				"G"Примечание:\n\
				"G"- Минимальная ставка: {d8284c}%d\n\
				"G"- Максимальная ставка: {d8284c}%d",
				CasinoRouletteTableInfo[tableid][tableMinBet],
				CasinoRouletteTableInfo[tableid][tableMaxBet]
			);
			ShowPlayerDialog(playerid, D_CASINO_ROULETTE_BET, DIALOG_STYLE_INPUT, ""P"Рулетка", STRING_GLOBAL, "Принять", "Отмена"), STRING_GLOBAL[0] = EOS;
			return true;
		}
		if(GetChips(playerid) < amount)
			return ErrorMessage(playerid, "У Вас недостаточно фишек!");

		new betType[22];
		switch(TI[playerid][tCasinoRouletteChipsPos]) {
			case 0..36: format(betType, sizeof (betType), "~r~~h~~h~~h~%d", TI[playerid][tCasinoRouletteChipsPos]);
			case 38: betType = "~r~~~RED";
			case 37: betType = "~y~~h~BLACK";
			case 39: betType = "~r~~h~~h~~h~1st 12";
			case 40: betType = "~r~~h~~h~~h~2nd 12";
			case 41: betType = "~r~~h~~h~~h~3rd 12";
			case 42: betType = "~r~~h~~h~~h~1 - 18";
			case 43: betType = "~r~~h~~h~~h~19 - 36";
			case 44: betType = "~r~~h~~h~~h~EVEN";
			case 45: betType = "~r~~h~~h~~h~ODD";
			case 46: betType = "~r~~h~~h~~h~1st LINE";
			case 47: betType = "~r~~h~~h~~h~2st LINE";
			case 48: betType = "~r~~h~~h~~h~3st LINE";
			default: return true;
		}
		GiveChips(playerid, -amount, "bet");
		TI[playerid][tCasinoRouletteBet] = amount;
		TI[playerid][tCasinoRouletteChips] = TI[playerid][tCasinoRouletteChipsPos];

		CasinoRouletteTableInfo[tableid][tableActiveBets]++;

		PlayerTextDrawSetString(playerid, InformationPTD[playerid][0], " ");
		PlayerTextDrawSetString(playerid, InformationPTD[playerid][1], " ");

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL),
			"~w~~h~YOUR BET: %s~n~\
			~w~~h~AMOUNT: ~p~%i",
			betType, TI[playerid][tCasinoRouletteBet]
		);
		PlayerTextDrawSetString(playerid, InformationPTD[playerid][2], COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;

		if(TI[playerid][tCasinoRouletteChipsObject] != -1)
			DestroyDynamicObject(TI[playerid][tCasinoRouletteChipsObject]);
		new modelid = 1930, Float:objectPos[3];
		if(30000 < amount <= 60000)
			modelid = 1931;
		else if(60000 < amount <= 100000)
			modelid = 1932;
		else if(amount > 100000)
			modelid = 1933;
		GetRouletteChipsPos(tableid, TI[playerid][tCasinoRouletteChipsPos], objectPos[0], objectPos[1], objectPos[2]);
		TI[playerid][tCasinoRouletteChipsObject] = CreateDynamicObject(modelid,
			objectPos[0], objectPos[1], objectPos[2], 0.0, 0.0, 0.0,
			CasinoRouletteTableInfo[tableid][tableWorld], CASINO_INTERIOR_ID, -1, 50, 50
		);
		foreach (new i: Player) {
			if(TI[i][tCasinoRouletteTable] != tableid + 1)
				continue;
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
		}
		/*format(dialog_string, sizeof(dialog_string), "~w~B‘ ЊOCTAB…‡… HA: ~y~%s~n~~w~BAЋA CTABKA: ~g~$%d",
		lstring, PlayerInfo[playerid][pCasinoRate]);
		PlayerTextDrawSetString(playerid, casino_roulette_PTD[playerid][1], dialog_string);*/
		return true;
	}
