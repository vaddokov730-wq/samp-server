	case D_ADMIN_RANK_CHANGE: {
		if(!response) return true;
		SelectFractionChange[playerid][1] = listitem + 1;
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "№\tНазвание команды\t"P"Доступ\n");
		new countcmd = 1 ;
		for(new i = 1; i <= MaxCommandFractionLoad; i++)
		{
			if(RightCommand[SelectFractionChange[playerid][1]][i] == 30) continue;
			if(i == MaxCommandFractionLoad)
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t/%s\t"P"%s", STRING_GLOBAL, countcmd, RightCommandName[i], GetRankName(SelectFractionChange[playerid][1], RightCommand[SelectFractionChange[playerid][1]][i]));
				break;
			}
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t/%s\t"P"%s\n", STRING_GLOBAL, countcmd, RightCommandName[i], GetRankName(SelectFractionChange[playerid][1], RightCommand[SelectFractionChange[playerid][1]][i]));
			CommandDialog[playerid][countcmd] = i;
			countcmd++;
		}
		ShowPlayerDialog(playerid, D_ADMIN_RANK_CHANGE_2, DIALOG_STYLE_TABLIST_HEADERS, ""P"Выберите команду", STRING_GLOBAL, "Выбрать", "Закрыть");
	}
	case D_ADMIN_RANK_CHANGE_2: {
		if(!response) return true;
		STRING_GLOBAL[0] = EOS;
		SelectFractionChange[playerid][0] = CommandDialog[playerid][listitem + 1];
		for(new i = 1; i <= FI[SelectFractionChange[playerid][1]][fMaxRang]; i++)
		{
			if(RightCommand[SelectFractionChange[playerid][1]][CommandDialog[playerid][listitem + 1]] == i)
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"P"%s (%i)\n", STRING_GLOBAL, GetRankName(SelectFractionChange[playerid][1], i), i);
			else
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"W"%s (%i)\n", STRING_GLOBAL, GetRankName(SelectFractionChange[playerid][1], i), i);
		}
		ShowPlayerDialog(playerid, D_ADMIN_RANK_CHANGE_3, DSL, ""P"Выберите ранг для изменения", STRING_GLOBAL, "Выбрать", "Закрыть");
	}
	case D_ADMIN_RANK_CHANGE_3: {
		if(!response) return true;
		MYSQL_GLOBAL[0] = EOS;
		if(listitem > FI[SelectFractionChange[playerid][1]][fMaxRang])  return ErrorMessage(playerid, "Такого ранга не существует");
		RightCommand[SelectFractionChange[playerid][1]][SelectFractionChange[playerid][0]] = listitem + 1;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `fractions_cmd` SET `frac_%d` = '%d' WHERE `id` = '%d';", SelectFractionChange[playerid][1], listitem + 1, SelectFractionChange[playerid][0]);
		mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;
		SendOk(playerid, "Права на использование команды изменено");
