		} // \n"P"2."W" Радиоцентр SF\n"P"3."W" Радиоцентр LV
		case 4: return ShowPlayerDialog(playerid, D_NEWS_SELECT, DSL, ""P"Эфиры", ""P"1."W" Радиоцентр LS\n"P"-"W" Выключить", "Выбрать", "Назад");
		case 5: return ShowPlayerDialog(playerid, D_CHAT, DSL, ""P"Стиль разговора", ""P"1."W" Стандартный\n"P"2."W" Стиль 1\n"P"3."W" Стиль 2\n"P"4."W" Стиль 3\n"P"5."W" Стиль 4\n"P"6."W" Стиль 5\n"P"7."W" Стиль 6", "Выбрать", "Назад");
		case 6: return ShowPlayerDialog(playerid, D_BOX, DSL, ""P"Стиль боя", ""P"1."W" Стандартный\n"P"2."W" Бокс\n"P"3."W" Кунг-Фу\n"P"4."W" Кик-Бокс", "Выбрать", "Назад");
		case 7: {
			if(PI[playerid][pSettings][6])
