		{
			static const f_str[] = ""W"Укажите количество наркотиков для покупки:\n\n\
			"O"Примечание:"W"\n\
			\tСтоимость "P"1г"W" наркотиков: "GREEN"$%d"W"\n\
	\tВ карман поместится: "P"%d"W"\n";
			new string[sizeof(f_str) + 1 + (-2 + 5) + (-2 + 5)];

