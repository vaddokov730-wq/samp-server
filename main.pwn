stock SaveHome(houseid)
{
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `houses` SET `owner` = '%s', `close` = '%d', `day` = '%d', `people1` = '%s', `people2` = '%s', `people3` = '%s', `safecode` = '%d' WHERE `id` = '%d' LIMIT 1",
				 gHouses[houseid][houseOwner], gHouses[houseid][houseClose], gHouses[houseid][houseDay], gHouseArendator[houseid][0], gHouseArendator[houseid][1], gHouseArendator[houseid][2], gHouses[houseid][houseSafeCode], gHouses[houseid][houseID]);
	mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	return 0x1;
}
