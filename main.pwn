	case D_FIX_CAR: {
		if(!response)
			return true;
		new player_vehicle_id = playerVehicleListitemID[playerid][listitem];

		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
			"P"1. "W"На место парковки "GREEN"[$"#FIX_CAR_PARK_PRICE"]\n\
			"P"2. "W"На автостоянку ЛС "GREEN"[$"#FIX_CAR_PARK_LS_PRICE"]"
		);
		if(PI[playerid][pHouse]) {
			new houseid = PI[playerid][pHouse] - 1;
			strcat(STRING_GLOBAL, "\n"P"3. "W"К дому "GREEN"[$"#FIX_CAR_HOUSE_PRICE"]");

			if(gHouses[houseid][houseImprove][2]) {
				strcat(STRING_GLOBAL, "\n"P"4. "W"В гараж "GREEN"[$"#FIX_CAR_GARAGE_PRICE"]");
			}
		}
		ShowPlayerDialog(playerid, D_FIX_CAR_2, DIALOG_STYLE_LIST, ""P"Выберите место доставки", STRING_GLOBAL, "Выбрать", "Отмена"), STRING_GLOBAL[0] = EOS;
		SetPVarInt(playerid, "player_vehicle_id", player_vehicle_id);

		return true;
	}
	case D_FIX_CAR_2: {
		if(!response) {
			DeletePVar(playerid, "player_vehicle_id");
			return ShowPlayerCarsList(playerid, D_FIX_CAR);
		}
		new
			player_vehicle_id = GetPVarInt(playerid, "player_vehicle_id"),
			Float:vehicleHealth, vpanels, vdoors, vlights, vtires;

		GetVehicleHealth(PlayerVehicleInfo[player_vehicle_id][carVehicle], vehicleHealth);
		if(vehicleHealth < PLAYER_VEHICLE_MIN_HEATH) vehicleHealth = PLAYER_VEHICLE_MIN_HEATH;
		GetVehicleDamageStatus(PlayerVehicleInfo[player_vehicle_id][carVehicle], vpanels, vdoors, vlights, vtires);
		/*new price_fixcar = 1000;
		if(TYPE_VIP[playerid] != VIP_STATE_NONE)
			price_fixcar = GetReasonMoneyPercentVip(playerid, TYPE_VIP_FIXCAR, 1000);*/
		new bool:isOccupied = false;
		for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
			if(!IsTrailerAttachedToVehicle(i))
				continue;
			if(GetVehicleTrailer(i) != PlayerVehicleInfo[player_vehicle_id][carVehicle])
				continue;
			isOccupied = true;
			break;
		}
		if(isOccupied || IsVehicleOccupied(PlayerVehicleInfo[player_vehicle_id][carVehicle]))
			return ErrorMessage(playerid, "Данный транспорт сейчас кем-то занят.");
		if(VehicleInfo[PlayerVehicleInfo[player_vehicle_id][carVehicle]][vParkingFine])
			return ErrorMessage(playerid, "Данный транспорт стоит на штрафстоянке.");

		switch(listitem + 1) {
			case 1: { // to park
				if(GetPlayerMoneyEx(playerid) < FIX_CAR_PARK_PRICE)
					return ErrorMessage(playerid, "У Вас недостаточно средств! ($"#FIX_CAR_PARK_PRICE")");
				GiveMoney(playerid, -FIX_CAR_PARK_PRICE, "Доставка ТС к паркингу");

				SetVehicleToRespawn(PlayerVehicleInfo[player_vehicle_id][carVehicle]);

				SendOk(playerid, "Выбранный транспорт успешно доставлен к месту парковки за "GREEN"$"#FIX_CAR_PARK_PRICE""G".");
			}
			case 2: { // to park LS
				if(GetPlayerMoneyEx(playerid) < FIX_CAR_PARK_LS_PRICE)
					return ErrorMessage(playerid, "У Вас недостаточно средств! ($"#FIX_CAR_PARK_LS_PRICE")");
				GiveMoney(playerid, -FIX_CAR_PARK_LS_PRICE, "Доставка ТС к парку ЛС");


				new random_spawn = random(sizeof (ticketVehicleSpawnPos));
				VehicleInfo[PlayerVehicleInfo[player_vehicle_id][carVehicle]][vParkingFine] = 0;
				PlayerVehicleInfo[player_vehicle_id][carParked] = 1;

				PlayerVehicleInfo[player_vehicle_id][carPos][0] = ticketVehicleSpawnPos[random_spawn][0];
				PlayerVehicleInfo[player_vehicle_id][carPos][1] = ticketVehicleSpawnPos[random_spawn][1];
				PlayerVehicleInfo[player_vehicle_id][carPos][2] = ticketVehicleSpawnPos[random_spawn][2];
				PlayerVehicleInfo[player_vehicle_id][carPos][3] = ticketVehicleSpawnPos[random_spawn][3];

				PlayerVehicleInfo[player_vehicle_id][carInterior] = 0;
				PlayerVehicleInfo[player_vehicle_id][carWorld] = 0;

				SetVehicleToRespawn(PlayerVehicleInfo[player_vehicle_id][carVehicle]);

				SavePlayerVehicle(player_vehicle_id);

				SendOk(playerid, "Выбранный транспорт успешно доставлен до автостоянки ЛВ за "GREEN"$"#FIX_CAR_PARK_LS_PRICE""G".");
			}
			/*case 4: { // to player
				if(GetPlayerInterior(playerid) || GetPlayerVirtualWorld(playerid))
					return ErrorMessage(playerid, "Вы должны находиться на улице.");
				if(GetPlayerMoneyEx(playerid) < FIX_CAR_PLAYER_PRICE)
					return ErrorMessage(playerid, "У Вас недостаточно средств! ($"#FIX_CAR_PLAYER_PRICE")");
				GiveMoney(playerid, -FIX_CAR_PLAYER_PRICE, "Доставка ТС к игроку");

				SetVehicleToRespawn(PlayerVehicleInfo[player_vehicle_id][carVehicle]);

				new Float:vehiclePos[4];
				GetPlayerPos(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);

				SetVehiclePos(PlayerVehicleInfo[player_vehicle_id][carVehicle],
