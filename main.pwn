			return ShowPlayerDialog(playerid, D_SUB_CREATE, DSI, ""P"Создание подразделения", ""W"Введите название подразделения от 1 до 15 символов:", "Далее", "Закрыть");
		}

		new header[10];
		if(Subdivision[SubdivisionDialog[playerid][listitem]][sub_tag_settings]) format(header, sizeof(header), "Выключить");
		else format(header, sizeof(header), "Включить");
