stock ShowAdminAdvertList(playerid)
{
	if(PI[playerid][pMute] > 0) return ErrorMessage(playerid, "У Вас бан чата");
	new data[3][30], index, string[128];

	format(data[0], 30, "{FF6347}Отправление"W"");
	format(data[1], 30, "{FFFF00}Проверка"W"");
	format(data[2], 30, "{33AA33}Ожидание"W"");

	STRING_GLOBAL[0] = EOS;
	STRING_GLOBAL = "№\tОтправитель\tСтатус\n";
	for(new i; i < MAX_ADVERT_COUNT; i++)
	{
		if(!gAdvert[i][adBusy])
		{
			format(string, sizeof(string), "%d\t-\t-\n", i + 1);
			strcat(STRING_GLOBAL, string);
		}
		else
		{
			if(gAdvert[i][adCheking]) index = 1;
			else if(gAdvert[i][adCheked]) index = 0;
			else index = 2;
			format(string, sizeof(string), "%d\t%s\t%s\n", i + 1, gAdvert[i][adSender], data[index]);
			strcat(STRING_GLOBAL, string);
		}
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, "Объявления", STRING_GLOBAL, "Принять", "Отмена");
	return 0x1;
}

