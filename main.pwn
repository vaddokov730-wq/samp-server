	new string[512];
	format(string, sizeof(string), ""W"Номер аккаунта: "P"%d\nДеньги наличными: "GREEN"$%d\nУровень: "P"%d\nREG-IP: "P"%s\nLAST-IP: "P"%s\n"W"Донат: "P"%d\nЗарегистрирован: "P"%s",
		   id, cash, level, ipreg, getonip, donate, datareg);
