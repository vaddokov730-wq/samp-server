		case 4: {
			static const f_str[] = ""W"Вы хотите продать отель государству за "GREEN"$%d?\n\n"G"Для продажи отеля игроку введите: /sellhotel [ID игрока] [Сумма]";
			new string[sizeof(f_str) + 1 + (-2 + 8)];
