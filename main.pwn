}


stock SetDynamicAreaType(areaid, type = AREA_TYPE_NONE, extra_id_1 = 0, extra_id_2 = 0) {
	if(!IsValidDynamicArea(areaid)) {
		printf("ERROR: SetDynamicAreaType | areaid = %d | type = %d | extra_id_1 = %d", areaid, type, extra_id_1);
		return 0;
	}
	new DynamicAreaData[AREA_DATA_TYPE + 1];
	DynamicAreaData[AREA_DATA_AREAID] = areaid;
	DynamicAreaData[AREA_DATA_EXTRA_ID_1] = extra_id_1;
	DynamicAreaData[AREA_DATA_EXTRA_ID_2] = extra_id_2;
	DynamicAreaData[AREA_DATA_TYPE] = type;

	Streamer_SetArrayData(STREAMER_TYPE_AREA, areaid, E_STREAMER_EXTRA_ID, DynamicAreaData, sizeof (DynamicAreaData));
	return type;
}
enum {
	PICKUP_TYPE_NONE = 0,
	PICKUP_TYPE_VG_LOAD,
}
enum {
	PICKUP_DATA_PICKUPID,
	PICKUP_DATA_EXTRA_ID,
	PICKUP_DATA_TYPE,
}

stock SetDynamicPickupType(pickupid, type = PICKUP_TYPE_NONE, extra_id = 0) {
	if(!IsValidDynamicPickup(pickupid)) {
		printf("ERROR: SetDynamicPickupType | pickupid = %d | type = %d | extra_id = %d", pickupid, type, extra_id);
		return 0;
	}
	new DynamicPickupData[AREA_DATA_TYPE + 1];
	DynamicPickupData[PICKUP_DATA_PICKUPID] = pickupid;
	DynamicPickupData[PICKUP_DATA_EXTRA_ID] = extra_id;
	DynamicPickupData[PICKUP_DATA_TYPE] = type;

	Streamer_SetArrayData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_EXTRA_ID, DynamicPickupData, sizeof (DynamicPickupData));
	return type;
}

