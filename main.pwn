				return 1;
			}
			}
		}
		if(!(3 <= strlen(inputtext) <= 16))
		{
			ShowPlayerDialog(playerid, D_PROMO_1, DSI, ""P"Создание промокода", "\n\n"W"Введите промокод который хотите создать\n\n"NO"*"G" От 3 до 16 символов\n\n", "Далее", "Назад");
			return 1;
