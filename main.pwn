				SendClientMessage(playerid, CGOLD, "Местоположение ближайшей АЗС успешно отмечено в вашем GPS");
				EnableGPSForPlayer(playerid, gBusiness[id_biz][bizzX], gBusiness[id_biz][bizzY], gBusiness[id_biz][bizzZ]);
