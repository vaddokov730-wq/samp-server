		else return ErrorMessage(playerid, "Данная одежда не подходит игроку из-за пола.");

		new string[156];
		format(string, sizeof(string), ""P"%s"G" предложил Вам вступить в организацию "ORANGE"%s", player_name[playerid], FI[PI[playerid][pMember]][fName]);
		SendUse(targetid, string);
		SendClientMessage(targetid, COLOR_BLUE, "Нажмите "YES"Y "BLUE"чтобы согласиться "NO"N "BLUE"для отказа");

		format(string, sizeof(string), "Вы предложили "P"%s"G" вступить в организацию "ORANGE"%s", player_name[targetid], FI[PI[playerid][pMember]][fName]);
		SendUse(playerid, string);

		PlayerInviteFix[targetid] = targetid;
