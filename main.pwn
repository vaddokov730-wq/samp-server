	case D_INVENTORY_RELOAD_WEAPON: {
		if(!response) {
			if(PI[playerid][pInventoryMenuType] != INVENTORY_MENU_DIALOG) return true;
			inventory_ShowDialogMenu(playerid);
			return false;
		}
		new slotid = InventoryTempInfo[playerid][tActionSelectedSlotID], amount = 1;

		if(sscanf(inputtext, "i", amount) || !(1 <= amount < 10000))
			return inventory_UseItem(playerid, slotid);

		new
			ammo_slotid = INVENTORY_SLOT_ID_AMMO_2,
			weapon_slotid = INVENTORY_SLOT_ID_WEAPON_2,
			itemid = PI[playerid][pItemsID][slotid];

		switch(itemid) {
			case 35 .. 40, 494 .. 499: {
				ammo_slotid = INVENTORY_SLOT_ID_AMMO_1;
				weapon_slotid = INVENTORY_SLOT_ID_WEAPON_1;
			}
		}
		new weapon_itemid = PI[playerid][pItemsID][weapon_slotid];

		if(weapon_itemid == 0)
			return ErrorMessage(playerid, "У вас нет подходящего оружия в руках.");
		if(PI[playerid][pItemsAmount][slotid] < amount)
			return ErrorMessage(playerid, "У вас недостаточно патрон.");
		new weapon_id = GetWeaponidByModel(InventoryItemInfo[weapon_itemid][itemModelID]);

		if(!IsSimilarityAmmo(weapon_itemid, itemid)) {
			inventory_NullSlots(playerid);
			return ErrorMessage(playerid, "Данный калибр не подходит для данного вида оружия!");
		}
		if(PI[playerid][pItemsID][ammo_slotid] && PI[playerid][pItemsID][ammo_slotid] != itemid) {
			inventory_NullSlots(playerid);
			return ErrorMessage(playerid, "Сначала разрядите текущие патроны оружия!");
		}
		PI[playerid][pItemsAmount][slotid] -= amount;
		if(PI[playerid][pItemsAmount][slotid] <= 0)
			inventory_DeleteItem(playerid, slotid);

		if(!PI[playerid][pItemsID][ammo_slotid])
			PI[playerid][pItemsAmount][ammo_slotid] = 0;

		PI[playerid][pItemsID][ammo_slotid] = itemid;
		PI[playerid][pItemsAmount][ammo_slotid] += amount;


		inventory_UpdateAmounts(playerid, slotid);
		inventory_UpdateWeapons(playerid); // SetPlayerAmmo(playerid, weapon_id, PI[playerid][pItemsAmount][ammo_slotid]);
		inventory_NullSlots(playerid);

		SetPlayerArmedWeapon(playerid, weapon_id);
		ApplyReloadAnimation(playerid, weapon_id);

		return true;
	}
	case D_INVENTORY_CHARGE_WEAPON: {
		if(!response) {
			if(PI[playerid][pInventoryMenuType] != INVENTORY_MENU_DIALOG) return true;
			inventory_ShowDialogMenu(playerid);
			return false;
		}
		new slotid = InventoryTempInfo[playerid][tActionSelectedSlotID], amount = 1;

		if(sscanf(inputtext, "i", amount) || !(1 <= amount < 10000))
			return inventory_ChargeItem(playerid, slotid);

		new
			ammo_slotid = slotid + 2,
			weapon_slotid = slotid,
			item_ammoid;

		new
			weapon_itemid = PI[playerid][pItemsID][weapon_slotid];

		if(weapon_itemid == 0)
			return ErrorMessage(playerid, "У вас нет подходящего оружия в руках.");

		for(new i = 0; i < sizeof (AmmoSimilarityWeapon); i++) {
			if(AmmoSimilarityWeapon[i][0] != weapon_itemid) continue;
			item_ammoid = AmmoSimilarityWeapon[i][1];
			break;
		}
		if(ItemCounts(playerid, item_ammoid) >= amount) { }
		else if(ItemCounts(playerid, item_ammoid + 459) >= amount) {
			item_ammoid += 459;
		}
		else {
			ErrorMessage(playerid, "У вас недостаточно патрон данного калибра.");
			inventory_NullSlots(playerid);
			return true;
		}
		new weapon_id = GetWeaponidByModel(InventoryItemInfo[weapon_itemid][itemModelID]);

		if(!IsSimilarityAmmo(weapon_itemid, item_ammoid)) {
			inventory_NullSlots(playerid);
			return ErrorMessage(playerid, "У вас нет подходящего калибра патрон для данного вида оружия!");
		}
		if(PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_1] && PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_1] != item_ammoid) {
			inventory_NullSlots(playerid);
			return ErrorMessage(playerid, "Сначала разрядите текущие патроны оружия!");
		}
		GivePlayerItem(playerid, item_ammoid, -amount, 2);
		inventory_UpdateSlots(playerid, InventoryTempInfo[playerid][tInventoryPageSlot]);

		if(!PI[playerid][pItemsID][ammo_slotid])
			PI[playerid][pItemsAmount][ammo_slotid] = 0;

		PI[playerid][pItemsID][ammo_slotid] = item_ammoid;
		PI[playerid][pItemsAmount][ammo_slotid] += amount;

		inventory_UpdateAmounts(playerid, slotid);
		inventory_UpdateWeapons(playerid); // SetPlayerAmmo(playerid, weapon_id, PI[playerid][pItemsAmount][ammo_slotid]);
		inventory_NullSlots(playerid);

		SetPlayerArmedWeapon(playerid, weapon_id);
		ApplyReloadAnimation(playerid, weapon_id);

		return true;
	}
	case D_INVENTORY_DROP_AMOUNT: {
		if(!response) {
			if(PI[playerid][pInventoryMenuType] != INVENTORY_MENU_DIALOG) return true;
			inventory_ShowDialogMenu(playerid);
			return false;
		}
		new
			slotid = InventoryTempInfo[playerid][tActionSelectedSlotID], amount = 1;

		if(sscanf(inputtext, "i", amount) || !(1 <= amount < 1000000))
			return inventory_DropItem(playerid, slotid);

		inventory_DropItemAction(playerid, slotid, amount);
		return true;
	}
	case D_INVENTORY_GIVE_ID_AMOUNT: {
