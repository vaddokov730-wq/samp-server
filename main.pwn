	case D_ORG_EDIT_CREATE: {
		if(!response)
			return org_ShowMenu(playerid, ORG_MENU_EDIT_MAIN);
		if(!(4 <= strlen(inputtext) <= 30))
			return org_ShowMenu(playerid, ORG_MENU_EDIT_CREATE);

		new organization_id;
		for(new org_id = 1; org_id <= TOTAL_ORGANIZATIONS; org_id++) {
			if(GetString(inputtext, OrganizationInfo[org_id][orgName])) {
				organization_id = org_id;
				break;
			}
		}
		if(organization_id && OrganizationInfo[organization_id][orgID])
			return ErrorMessage(playerid, "Организация с таким названием уже существует.");

		if(org_Create(inputtext)) {
			SendOk(playerid, "Вы успешно создали новую пользовательскую организацию.");
			org_ShowMenu(playerid, ORG_MENU_EDIT_MAIN);
		}
		else ErrorMessage(playerid, "Ошибка создания пользовательской организации! Обратитесь к разработчикам.");

		return true;
	}
