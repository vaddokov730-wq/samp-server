			PI[targetid][pGunSkill][0] = 100;
			PI[targetid][pGunSkill][1] = 100;
			PI[targetid][pGunSkill][2] = 100;
			PI[targetid][pGunSkill][3] = 100;
			PI[targetid][pGunSkill][4] = 100;
			PI[targetid][pGunSkill][5] = 100;
			SetPlayerSkills(playerid);
		}
		}

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы выдали скиллы игроку %s[%d]", player_name[targetid], targetid);
		SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вам выдали скиллы игрок %s[%d]", player_name[playerid], playerid);
		SendClientMessage(targetid, 0xCCCCCCFF, STRING_GLOBAL);

		new string_name[MAX_PLAYER_NAME];
		format(string_name, sizeof(string_name), "%s", player_name[playerid]);

		WriteLog(228, playerid, string_name, player_name[targetid], "Скиллы");
		return 0x1;
	}
