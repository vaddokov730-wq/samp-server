CMD:sellsim(playerid, params[])
{
	if(!PI[playerid][pPhone]) return ErrorMessage(playerid, "У Вас нет SIM-карты");
	new numbet_str[7];
	format(numbet_str, sizeof(numbet_str), "%d", PI[playerid][pPhone]);
	if(strlen(numbet_str) < 6) return ErrorMessage(playerid, "Данный номер нельзя продать");
	if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1) return ErrorMessage(playerid, "Нельзя использовать в казино");
	if(sscanf(params, "dd", params[0], params[1])) return SendEsp(playerid, "/sellsim [ID] [цена]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, not_id);
	if(playerid == params[0]) return ErrorMessage(playerid, not_id);
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "Вы далеко друг от друга");
	if(params[1] < 1 || params[1] > 1000000) return ErrorMessage(playerid, "Цена не может быть меньше $1 и больше $1.000.000");
	if(active_accept(params[0])) return ErrorMessage(playerid, "У игрока есть активное предложение");
	new string[144];

	format(string, sizeof(string), ""P"%s "G"предложил(а) Вам купить SIM-карту за "ORANGE"$%i", player_name[playerid], params[1]);
	SendUse(params[0], string);
	SendClientMessage(params[0], COLOR_BLUE, "Нажмите "YES"Y "BLUE"чтобы согласиться "NO"N "BLUE"для отказа");

	format(string, sizeof(string), "Вы предложили "P"%s "G"купить SIM-карту за "ORANGE"$%i", player_name[params[0]], params[1]);
	SendUse(playerid, string);

	SetPVarInt(params[0], "sim_id_sell", playerid + 1);
	SetPVarInt(params[0], "sim_summ", params[1]);
	return 1;
}

alias:usedrugs("drugs");
CMD:usedrugs(playerid, params[])
{
	if(PI[playerid][pStageDeath]) return true;
	if(TI[playerid][tDuel] != -1) return 1;
	if(GetPVarInt(playerid, "anti_sbiv_time") > unix) return 1;
	new drugs = ItemCounts(playerid, 007);
	if(drugs <= 0) return ErrorMessage(playerid, "У Вас нет наркотиков");
	if(TI[playerid][tDMArea][0]) return ErrorMessage(playerid, "Нельзя использовать на данном мероприятии");
	if(TI[playerid][tGunArea][0]) return ErrorMessage(playerid, "Нельзя использовать на данном мероприятии");
	if(player_to_golod[playerid]) return ErrorMessage(playerid, "Нельзя использовать на голодных играх");
	if(TI[playerid][tDuel] != -1) return ErrorMessage(playerid, "Нельзя использовать на дуэлях");

	new Float: PlayerHP;
	GetPlayerHealth(playerid, PlayerHP);

	if(sscanf(params, "i", params[0]))
	{
		if(PI[playerid][pAddiction] < 2000)
		{
			if(drugs >= 5) params[0] = 5;
			if(drugs > 0 && drugs < 5) params[0] = drugs;
		}
		else if(PI[playerid][pAddiction] < 5000)
		{
			if(drugs >= 10) params[0] = 10;
			if(drugs > 0 && drugs < 10) params[0] = drugs;
		}
		else if(PI[playerid][pAddiction] > 5000)
		{
			if(drugs >= 15) params[0] = 15;
			if(drugs > 0 && drugs < 15) params[0] = drugs;
		}
	}
	if(drugs < params[0]) return ErrorMessage(playerid, "У вас нет столько наркотиков");
	if(params[0] < 1) return ErrorMessage(playerid, "Значение не может быть менее 1");
	if(PI[playerid][pAddiction] < 2000 && params[0] > 5) return ErrorMessage(playerid, "Вы не можете принять более 5 грамм наркотиков");
	if(PI[playerid][pAddiction] < 5000 && params[0] > 10) return ErrorMessage(playerid, "Вы не можете принять более 10 грамм наркотиков");
	else if(params[0] > 15) return ErrorMessage(playerid, "Вы не можете принять более 15 грамм наркотиков");

	new ReasonHeal = 10;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		ReasonHeal = VipData[TYPE_VIP[playerid]][VipUseDrugs];
	}

	if(PI[playerid][pAddiction] < 2000 && (PlayerHP + (ReasonHeal * params[0])) > 120)
	{
		if(GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOk(playerid, "Уровень здоровья пополнен до 120 единиц");
			SetPlayerHealth(playerid, 120);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if(PI[playerid][pAddiction] < 5000 && (PlayerHP + (ReasonHeal * params[0])) > 140)
	{
		if(GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOk(playerid, "Уровень здоровья пополнен до 140 единиц");
			SetPlayerHealth(playerid, 140);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if(PI[playerid][pAddiction] > 5000 && (PlayerHP + (ReasonHeal * params[0])) > 160)
	{
		if(GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOk(playerid, "Уровень здоровья пополнен до 160 единиц");
			SetPlayerHealth(playerid, 160);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else
	{
		if(GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Уровень здоровья пополнен до %.0f единиц", (PlayerHP + (ReasonHeal * params[0])));
			SendClientMessage(playerid, 0xFFFFFFFF, STRING_GLOBAL);
			SetPlayerHealth(playerid, (PlayerHP + (ReasonHeal * params[0])));
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");

		if(PI[playerid][pAddiction] < 2000)
		{
			UsingDrugs[playerid] = 10;
			SetPlayerTime(playerid, 17, 0);
			SetPlayerWeather(playerid, -68);
			SetPlayerDrunkLevel(playerid, 3000);
		}
	}

	if(PI[playerid][pSex] == 1) {
		SetPlayerChatBubble(playerid, "употребил наркотик", COLOR_PURPLE, 30.0, 5000);
		MeAction(playerid, "употребил наркотик");
	} else {
		SetPlayerChatBubble(playerid, "употребила наркотик", COLOR_PURPLE, 30.0, 5000);
		MeAction(playerid, "употребила наркотик");
	}

	if(IsPlayerInRangeOfPoint(playerid, 20.0, 2628.4819, -589.2004, 2768.9805) == 0)
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT || GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
		{
			PlayerHealFix[playerid] = 1;
			PlayerHealExFix[playerid] = unix + 3;
			TogglePlayerControllable(playerid, false);
		}
	}

	if(IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
	else ApplyAnimation(playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1);
	SetPVarInt(playerid, "anti_sbiv_time", unix + 3);
	PI[playerid][pAddiction] += (5 * params[0]);

	GivePlayerItem(playerid, 007, -params[0], 2);
	PI[playerid][pStartLomka] = 0;
	PI[playerid][pNarcoLomka] = 0;
	return 0x1;
}

CMD:jobmisha(playerid, params[])
{
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return true;
	if(debug_job)
	{
		SendClientMessage(playerid, COLOR_REDD, "Вип включен новый");
		debug_job = 0;
	}
	else
	{
		SendClientMessage(playerid, COLOR_REDD, "Вип включен старый");
		debug_job = 1;
	}
	return 1;
}
stock ToggleArmyGates(playerid) {
	if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0) {
		switch(GetTeamID(playerid)) {
			case fARMYLV: if(IsPlayerInRangeOfPoint(playerid, 7.5, 1024.1565, -367.6729, 73.5627)) {
				for(new id = 40; id < 42; id++) {
					MovingDoorsInfo[id][doorIsOpened] = !MovingDoorsInfo[id][doorIsOpened];

					if(MovingDoorsInfo[id][doorIsOpened]) {
						MoveDynamicObject(MovingDoorsInfo[id][doorObjectID],
							MovingDoorsInfo[id][doorOpenedPos][0], MovingDoorsInfo[id][doorOpenedPos][1] + 0.001,
							MovingDoorsInfo[id][doorOpenedPos][2], 0.514,
							MovingDoorsInfo[id][doorOpenedPos][3], MovingDoorsInfo[id][doorOpenedPos][4],
							MovingDoorsInfo[id][doorOpenedPos][5]
						);
					} else {
						MoveDynamicObject(MovingDoorsInfo[id][doorObjectID],
							MovingDoorsInfo[id][doorClosedPos][0], MovingDoorsInfo[id][doorClosedPos][1] - 0.001,
							MovingDoorsInfo[id][doorClosedPos][2], 0.514,
							MovingDoorsInfo[id][doorClosedPos][3], MovingDoorsInfo[id][doorClosedPos][4],
							MovingDoorsInfo[id][doorClosedPos][5]
						);
					}
				}
				return true;
			}
			case fFBI: if(IsPlayerInRangeOfPoint(playerid, 7.5, MovingDoorsInfo[42][doorClosedPos][0], MovingDoorsInfo[42][doorClosedPos][1], MovingDoorsInfo[42][doorClosedPos][2])) {
				new id = 42;
				MovingDoorsInfo[id][doorIsOpened] = !MovingDoorsInfo[id][doorIsOpened];

				if(MovingDoorsInfo[id][doorIsOpened]) {
					MoveDynamicObject(MovingDoorsInfo[id][doorObjectID],
						MovingDoorsInfo[id][doorOpenedPos][0], MovingDoorsInfo[id][doorOpenedPos][1] + 0.001,
						MovingDoorsInfo[id][doorOpenedPos][2], 0.514,
						MovingDoorsInfo[id][doorOpenedPos][3], MovingDoorsInfo[id][doorOpenedPos][4],
						MovingDoorsInfo[id][doorOpenedPos][5]
					);
				} else {
					MoveDynamicObject(MovingDoorsInfo[id][doorObjectID],
						MovingDoorsInfo[id][doorClosedPos][0], MovingDoorsInfo[id][doorClosedPos][1] - 0.001,
						MovingDoorsInfo[id][doorClosedPos][2], 0.514,
						MovingDoorsInfo[id][doorClosedPos][3], MovingDoorsInfo[id][doorClosedPos][4],
						MovingDoorsInfo[id][doorClosedPos][5]
					);
				}
				return true;
			}
		}

	}
	return false;
}

