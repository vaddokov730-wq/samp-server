		}
		case 0: {
			if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_ALOGIN, DSP, ""P"Авторизация", ""W"Для доступа к админ привелегиям, Вам необходимо авторизоваться:", "Вход", "Отмена");

			MYSQL_GLOBAL[0] = EOS;

			mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "\
				SELECT * FROM `"TABLE_ADMIN"` WHERE `Name` = '%s' AND `password` = '%s' LIMIT 1", player_name[playerid], MD5_Hash(inputtext)
			);
			mysql_pquery(connects, MYSQL_GLOBAL, "password_adm", "ds", playerid, inputtext);
		}
		}
		MYSQL_GLOBAL[0] = EOS;
		return 1;
	}
	case D_GREENZONE: {
		if(!response) return true;
		switch(listitem)
		{
		case 0: ShowPlayerDialog(playerid, D_GREENZONE_ADD, DSI, ""P"Создать зеленую зону", "Введите название зоны и дистанцию через знак ','", "Далее", "Закрыть");
		default: {
			PlayerZoneFix[playerid] = listitem;
			ShowPlayerDialog(playerid, D_GREENZONE_EDIT, DSL, ""P"Редактирование зоны", "{59DE00}1."W" Изменить название\n{59DE00}2."W" Изменить положение\n{59DE00}3."W" Изменить дистанцию", "Далее", "Закрыть");
		}
		}
	}
	case D_GREENZONE_ADD: {
		if(!response) return true;
		new price, name[32];
		if(sscanf(inputtext, "p<,>s[32]i", name, price))
			return ShowPlayerDialog(playerid, D_GREENZONE_ADD, DSI, ""P"Создать зеленую зону", "Введите название зоны и дистанцию через знак ','", "Далее", "Закрыть");
		TOTALZONE++;

		GetPlayerPos(playerid, GREENZONE[TOTALZONE][grX], GREENZONE[TOTALZONE][grY], GREENZONE[TOTALZONE][grZ]);
		GREENZONE[TOTALZONE][grVirt] = GetPlayerVirtualWorld(playerid);

		STRING_GLOBAL[0] = EOS;

		mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL),
			"INSERT INTO `"TABLE_GREENZONE"` (`grx`,`gry`,`grz`,`grd`,`grname`,`grvirt`) VALUES \
   			('%f','%f','%f','%i','%s','%i')",
   			GREENZONE[TOTALZONE][grX], GREENZONE[TOTALZONE][grY], GREENZONE[TOTALZONE][grZ],
   			price, name, GREENZONE[TOTALZONE][grVirt]
   		);
		mysql_tquery(connects, STRING_GLOBAL, "", ""), STRING_GLOBAL[0] = EOS;

		strmid(GREENZONE[TOTALZONE][grName], name, 0, strlen(name), 32);
		GREENZONE[TOTALZONE][grid] = TOTALZONE;
		GREENZONE[TOTALZONE][grD] = float(price);

		static const f_str[] = "Зеленая зона под номером "ORANGE"%i"G" создана";
		new string[sizeof(f_str) + 1 + (-2 + 3)];

		format(string, sizeof(string), f_str, TOTALZONE);
		SendOk(playerid, string);
		return 1;
	}
	case D_GREENZONE_EDIT: {
		if(!response) return true;
		switch(listitem)
		{
		case 0: ShowPlayerDialog(playerid, D_GREENZONE_EDIT_NAME, DSI, ""P"Изменить название", "Введите название зоны:", "Далее", "Закрыть");
		case 1: {
			GetPlayerPos(playerid, GREENZONE[PlayerZoneFix[playerid]][grX], GREENZONE[PlayerZoneFix[playerid]][grY], GREENZONE[PlayerZoneFix[playerid]][grZ]);
			GREENZONE[PlayerZoneFix[playerid]][grVirt] = GetPlayerVirtualWorld(playerid);

			STRING_GLOBAL[0] = EOS;
			mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `"TABLE_GREENZONE"` SET `grx` = '%f', `gry` = '%f', `grz` = '%f', `grvirt` = '%i'\
   WHERE `id` = '%i'", GREENZONE[PlayerZoneFix[playerid]][grX], GREENZONE[PlayerZoneFix[playerid]][grY], GREENZONE[PlayerZoneFix[playerid]][grZ],
						 GREENZONE[PlayerZoneFix[playerid]][grVirt], GREENZONE[PlayerZoneFix[playerid]][grid]);
			mysql_tquery(connects, STRING_GLOBAL, "", "");
			SendOk(playerid, "Позиция изменена");
		}
		case 2: ShowPlayerDialog(playerid, D_GREENZONE_EDIT_DIST, DSI, ""P"Изменить дистанцию", "Введите дистанцию для зоны:", "Далее", "Закрыть");
		}
		return true;
	}
	case D_GREENZONE_EDIT_NAME: {
		if(!response) return true;
		strmid(GREENZONE[PlayerZoneFix[playerid]][grName], inputtext, 0, strlen(inputtext), 32);

		STRING_GLOBAL[0] = EOS;
		mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `"TABLE_GREENZONE"` SET `grname` = '%s' WHERE `id` = '%i'",
					 GREENZONE[PlayerZoneFix[playerid]][grName], GREENZONE[PlayerZoneFix[playerid]][grid]);
		mysql_tquery(connects, STRING_GLOBAL, "", "");
		SendOk(playerid, "Название изменено");
	}
	case D_GREENZONE_EDIT_DIST: {
		if(!response) return true;
		GREENZONE[PlayerZoneFix[playerid]][grD] = float(strval(inputtext));

		STRING_GLOBAL[0] = EOS;
		mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `"TABLE_GREENZONE"` SET `grd` = '%f' WHERE `id` = '%i'",
					 GREENZONE[PlayerZoneFix[playerid]][grD], GREENZONE[PlayerZoneFix[playerid]][grid]);
		mysql_tquery(connects, STRING_GLOBAL, "", "");
		SendOk(playerid, "Дистанция изменена");
	}
	case D_SEARCH_CAR: {
		if(!response)
			return true;
		new player_vehicle_id = playerVehicleListitemID[playerid][listitem], Float:vehiclePos[3];

		GetVehiclePos(PlayerVehicleInfo[player_vehicle_id][carVehicle], vehiclePos[0], vehiclePos[1], vehiclePos[2]);

		SendClientMessage(playerid, CGOLD, "Местоположение вашего транспорта успешно отмечено в вашем GPS");
		EnableGPSForPlayer(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);

		return true;
	}
	case D_UTILIZATION_CAR: {
		if(!response)
			return true;
		new
			player_vehicle_id = playerVehicleListitemID[playerid][listitem],
			modelid = PlayerVehicleInfo[player_vehicle_id][carModel] - 400;


		static const f_utilization_car[] = "\
			"W"Вы действительно хотите утилизировать - "P"%s [%s]"W"?\n \n\
			Государственная стоимость: "GREEN"$%d\n\
			"W"Сумма, которую Вы получите после утилизации - "GREEN"$%d "G"[10%%]";


		new str_utilization_car[sizeof(f_utilization_car) + (-2 + 25) + (-2 + 20) + (-2 + 12) + (-2 + 12)];
		format(str_utilization_car, sizeof (str_utilization_car), f_utilization_car,
			gTransport[modelid][trName],
			PlayerVehicleInfo[player_vehicle_id][carNumber],
			VehicleImportInfo[modelid][viPrice],
			VehicleImportInfo[modelid][viPrice] / 10
		);
		ShowPlayerDialog(playerid, D_UTILIZATION_CAR_2, DIALOG_STYLE_MSGBOX, ""P"Утилизация транспорта", str_utilization_car, "Да", "Отмена");
		SetPVarInt(playerid, "player_vehicle_id", player_vehicle_id);
		return true;
	}



	case D_UTILIZATION_CAR_2: {
		if(!response)
			return true;
		new
			player_vehicle_id = GetPVarInt(playerid, "player_vehicle_id"),
			modelid = PlayerVehicleInfo[player_vehicle_id][carModel] - 400,
			price = VehicleImportInfo[modelid][viPrice] / 10;

		if(!GetString(PlayerVehicleInfo[player_vehicle_id][carOwner], player_name[playerid]))
			return false;
		new Float:vehiclePos[3];
		GetVehiclePos(PlayerVehicleInfo[player_vehicle_id][carVehicle], vehiclePos[0], vehiclePos[1], vehiclePos[2]);
		if(!IsPlayerInRangeOfPoint(playerid, 15.0, vehiclePos[0], vehiclePos[1], vehiclePos[2]))
			return ErrorMessage(playerid, "Ваш транспорт далеко от вас!");

		if(!DestroyPlayerVehicle(playerid, player_vehicle_id)) return true;

		GiveMoney(playerid, price, "утилизация личного ТС");

		DeletePVar(playerid, "player_vehicle_id");
		GetPlayerVehicles(playerid);

		static const f_utilization_car[] = "\
			"GREEN"* "G"Вы успешно утилизировали свой транспорт - "P"%s [%s]"G" за "GREEN"$%d";

		new str_utilization_car[sizeof(f_utilization_car) + (-2 + 25) + (-2 + 20) + (-2 + 12)];
		format(str_utilization_car, sizeof (str_utilization_car),
			f_utilization_car,
			gTransport[modelid][trName],
			PlayerVehicleInfo[player_vehicle_id][carNumber],
			price
		);
		SendClientMessage(playerid, COLOR_GREY, str_utilization_car);
		return true;
	}
	case D_TUNING_MENU: {
		if(!response || !IsPlayerInRangeOfPoint(playerid, 4.5, 1905.1360, 59.3574, 1139.4918))
			return true;
		new vehicleid = GetPlayerVehicleID(playerid), price = (gTransport[GetVehicleModel(vehicleid) - 400][trPrice] * 30 / 100);
		if(price < 500) price = 500;

		switch(listitem + 1) {
			case 1: {
				if(GetPlayerMoneyEx(playerid) < TUNING_PRICE_REPAIR)
					return ErrorMessage(playerid, "У вас недостаточно средств");

				GiveMoney(playerid, -TUNING_PRICE_REPAIR, "d_tuning_menu 1");
				RepairVehicle(vehicleid);
				SetVehicleHealth(vehicleid, 1000.0);
				SendOk(playerid, "Ваш транспорт был починен.");
			}
			case 2: {
				if(VehicleInfo[vehicleid][vStatus] >= 90.0)
					return ErrorMessage(playerid, "Ваш ТС в хорошем состоянии.");
				if(GetPlayerMoneyEx(playerid) < price)
					return ErrorMessage(playerid, "У вас недостаточно средств");


				new player_vehicleid = -1;
				foreach (new i: playerVehicles) {
					if(PlayerVehicleInfo[i][carVehicle] != vehicleid)
						continue;
					player_vehicleid = i;
					break;
				}
				if(player_vehicleid == -1 || !GetString(player_name[playerid], PlayerVehicleInfo[player_vehicleid][carOwner]))
					return ErrorMessage(playerid, "Вы должны быть в личном ТС");
				GiveMoney(playerid, -price, "d_tuning_menu 2");

				RepairVehicle(vehicleid);
				SetVehicleHealth(vehicleid, 1000.0);

				VehicleInfo[vehicleid][vStatus] = 90.0;
				SavePlayerVehicle(player_vehicleid);

				SendOk(playerid, "Ваш транспорт был полностью починен, тех.состояние восстановлено.");
			}
			case 3: {
				if(!GetPVarInt(playerid, "TunningSaluna"))
				{
					SetPVarInt(playerid, "VehicleTunnSALON", GetPlayerVehicleID(playerid));
					SetPVarInt(playerid, "TunningSaluna", 1);

					for(new i = 0; i < 11; i++) TextDrawShowForPlayer(playerid, ColorTD[i]);
					new curcol;
					for(new i = 0; i < 2; i++)
					{
						curcol = VehicleInfo[vehicleid][vColor][i];
						PlayerTextDrawColor(playerid, ColorTDPl[playerid][2 + 3 * i], RGBArray[curcol]);
						curcol--;
						if(curcol < 0) curcol = 255;
						PlayerTextDrawColor(playerid, ColorTDPl[playerid][1 + 3 * i], RGBArray[curcol]);
						curcol += 2;
						if(curcol > 255) curcol = 0;
						PlayerTextDrawColor(playerid, ColorTDPl[playerid][3 + 3 * i], RGBArray[curcol]);
					}
					for(new i = 0; i < 6; i++)
						PlayerTextDrawShow(playerid, ColorTDPl[playerid][1 + i]);
					for(new i = 0, b = VehicleModelToPaintjobNum(GetVehicleModel(GetPlayerVehicleID(playerid))) + 1; i < b; i++)
						TextDrawShowForPlayer(playerid, ColorTD[11 + i]);
					VinylJob[playerid] = 0;
					TextDrawShowForPlayer(playerid, ColorTD[16]);
					PrimaryColor[playerid] = VehicleInfo[vehicleid][vColor][0];
					SecondaryColor[playerid] = VehicleInfo[vehicleid][vColor][1];
					RepaintValue[playerid] = 0;
					PlayerJobFix[playerid] = -1;
					ChangedPrimaryColor[playerid] = false;
					ChangedSecondaryColor[playerid] = false;
					ChangedVinylJob[playerid] = false;
					PlayerTextDrawSetString(playerid, ColorTDPl[playerid][0], "$0");
					PlayerTextDrawShow(playerid, ColorTDPl[playerid][0]);
					TextDrawShowForPlayer(playerid, ColorTD[15]);
					SelectTextDraw(playerid, 0xAA3333AA);
				}
				else
				{
					CancelSelectTextDraw(playerid);
					SetPVarInt(playerid, "TunningSaluna", 0);
					for(new h = 0; h < 20; h++)
					{
						if(h < 7)PlayerTextDrawHide(playerid, ColorTDPl[playerid][h]);
						TextDrawHideForPlayer(playerid, ColorTD[h]);
					}
					new cartune = GetPVarInt(playerid, "VehicleTunnSALON");
					ChangeVehicleColor(cartune, VehicleInfo[cartune][vColor][0], VehicleInfo[cartune][vColor][1]);
					ChangeVehiclePaintjob(cartune, VehicleInfo[cartune][vPaintJob]);
				}
			}

		}
		return true;
	}
	case D_CAR_LIST: {
		if(!response)
			return true;
		new player_vehicle_id = playerVehicleListitemID[playerid][listitem];

		if(VehicleInfo[PlayerVehicleInfo[player_vehicle_id][carVehicle]][vParkingFine])
			return ErrorMessage(playerid, "Данный транспорт стоит на штрафстоянке.");

		format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"Транспорт %s [%s]",
			gTransport[PlayerVehicleInfo[player_vehicle_id][carModel] - 400][trName],
			PlayerVehicleInfo[player_vehicle_id][carNumber]
		);
		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
			"P"1. {6B8E23}Завести "W"/ {B22222}заглушить "W"двигатель\n\
			"P"2. {6B8E23}Открыть "W"/ {B22222}закрыть "W"транспорт\n\
			"P"3. "W"Найти личный транспорт "ORANGE"[GPS]\n\
			"P"4. "W"Припарковать транспорт\n\
			"P"5. "W"Документы на транспорт\n\
			"P"6. "W"Управление дубликатами ключей\n\
			"P"7. {808000}Продать / обменять "W"транспорт\n\
			"P"8. "W"Доставить транспорт "GREEN"[$]\n\
			"P"9. {6B8E23}%s",
			(!PlayerVehicleInfo[player_vehicle_id][carOrganization]) ? ("Дать доступ для организации") : ("Забрать доступ у организации")
		);
		ShowPlayerDialog(playerid, D_CAR_MENU, DIALOG_STYLE_LIST, COMMAND_GLOBAL, STRING_GLOBAL, "Выбрать", "Отмена");
		STRING_GLOBAL[0] = COMMAND_GLOBAL[0] = EOS;

		SetPVarInt(playerid, "player_vehicle_id", player_vehicle_id);

		return true;
	}
	case D_CARS_KEYS: {
		if(!response) {
			ShowPlayerCarsList(playerid, D_CAR_LIST);
			return true;
		}
		new player_vehicle_id = GetPVarInt(playerid, "player_vehicle_id");
		if(playerListitemID[playerid][listitem] == 0) {
			format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""W"\
				Введите ID игрока, которому хотите передать дубликат ключей от "P"\"%s\"",
				gTransport[PlayerVehicleInfo[player_vehicle_id][carModel] - 400][trName]
			);
			ShowPlayerDialog(playerid, D_CARS_GIVE_KEY, DIALOG_STYLE_INPUT, ""P"Выдать дубликат ключей", STRING_GLOBAL, "Выдать", "Отмена"), STRING_GLOBAL[0] = EOS;
		} else {
			new key_id = playerListitemID[playerid][listitem];

			for(new keyid = 0; keyid < 3; keyid++) {
				if(PlayerVehicleInfo[player_vehicle_id][carKeys][keyid] != key_id)
					continue;
				PlayerVehicleInfo[player_vehicle_id][carKeys][keyid] = 0;
			}
			SendOk(playerid, "Вы успешно забрали ключи у игрока");
			SavePlayerVehicle(player_vehicle_id);
		}
		return true;
	}
	case D_CARS_GIVE_KEY: {
		if(!response)
			return true;
		new targetid, player_vehicle_id = GetPVarInt(playerid, "player_vehicle_id");

		if(sscanf(inputtext, "u", targetid) || !IsPlayerConnected(targetid) || !TI[targetid][tLogin] || !ProxDetectorS(5.0, playerid, targetid)) {
			format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""W"\
				Введите ID игрока, которому хотите передать дубликат ключей от "P"\"%s\"",
				gTransport[PlayerVehicleInfo[player_vehicle_id][carModel] - 400][trName]
			);
			ShowPlayerDialog(playerid, D_CARS_GIVE_KEY, DIALOG_STYLE_INPUT, ""P"Выдать дубликат ключей", STRING_GLOBAL, "Выдать", "Отмена"), STRING_GLOBAL[0] = EOS;
			ErrorMessage(playerid, "Данный игрок далеко от Вас!");
			return true;
		}
		new free_id = -1;
		for(new keyid = 0; keyid < 3; keyid++) {
			if(PlayerVehicleInfo[player_vehicle_id][carKeys][keyid] != 0)
				continue;
			free_id = keyid;
			break;
		}
		for(new keyid = 0; keyid < 3; keyid++) {
			if(PlayerVehicleInfo[player_vehicle_id][carKeys][keyid] != PI[targetid][pID])
				continue;
			free_id = -1;
			break;
		}
		if(free_id == -1) {
			return ErrorMessage(playerid, "Максимум можно выдать ключи только 3 игрокам!");
		}
		PlayerVehicleInfo[player_vehicle_id][carKeys][free_id] = PI[targetid][pID];
		SavePlayerVehicle(player_vehicle_id);

		SendOk(playerid, "Вы успешно выдали дубликат ключей игроку");
		return true;
	}
	case D_CAR_MENU: {
		if(!response) {
			DeletePVar(playerid, "player_vehicle_id");
			return ShowPlayerCarsList(playerid, D_CAR_LIST);
		}
		new
			player_vehicle_id = GetPVarInt(playerid, "player_vehicle_id"),
			vehicleid = PlayerVehicleInfo[player_vehicle_id][carVehicle];

		new Float:health, Float:vehiclePos[3];
		GetVehiclePos(vehicleid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);
		GetVehicleHealth(vehicleid, health);

		switch(listitem + 1) {
			case 1: {
				if(PlayerFuelFix[playerid] == 1 || IsAVelik(vehicleid) || IsAPlane(vehicleid) || IsABoat(vehicleid))
					return false;
				if(!IsPlayerInRangeOfPoint(playerid, 50.0, vehiclePos[0], vehiclePos[1], vehiclePos[2]))
					return ErrorMessage(playerid, "Вы находитесь слишком далеко от транспорта. (до 50 м.)");
				if((VehicleInfo[vehicleid][vFuel] <= 0.5 &&
					!IsAPlane(vehicleid) && !IsABoat(vehicleid) && !IsABike(vehicleid) && !IsAVelik(vehicleid)) ||
					(health <= PLAYER_VEHICLE_MIN_HEATH && !IsAPlane(vehicleid) && !IsABoat(vehicleid) && !IsABike(vehicleid) && !IsAVelik(vehicleid))
				) return ErrorMessage(playerid, "Не удалось завести двигатель!");

				engine = SetVehicleEngineStatus(vehicleid, playerid);
				if(engine)
					SendOk(playerid, "Вы завели двигатель личного транспорта.");
				else SendOk(playerid, "Вы заглушили двигатель личного транспорта.");
			}
			case 2: {
				if(!IsPlayerInRangeOfPoint(playerid, 50.0, vehiclePos[0], vehiclePos[1], vehiclePos[2]))
					return ErrorMessage(playerid, "Вы находитесь слишком далеко от транспорта. (до 50 м.)");
				doors = SetVehicleDoorStatus(vehicleid, playerid);
				if(doors)
					SendOk(playerid, "Вы закрыли двери личного транспорта.");
				else SendOk(playerid, "Вы открыли двери личного транспорта.");
			}
			case 3: {
				// ShowPlayerCarsList(playerid, D_SEARCH_CAR);
				SendClientMessage(playerid, CGOLD, "Местоположение вашего транспорта успешно отмечено в вашем GPS");
				EnableGPSForPlayer(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);
			}
			//case 4: callcmd::trunk(playerid);
			case 4: ParkPlayerVehicle(playerid);
			case 5: {
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
					"W"Владелец: \t"P"%s\n\
					"W"Автомобиль: \t"P"%s\n\
					"W"Техническое состояние: "P"%.1f / 100.0%%\n\n\
					\
					"ORANGE"Улучшения двигателя:\n\
					"W"Нагнетатель воздуха: \t\t\t\t"P"%s\n\
					"W"Кованные поршни двигателя: \t\t\t"P"%s\n\
					"W"Дроссельная заслонка увеличенного диаметра: \t"P"%s\n\
					"W"Воздушный фильтр нулевого сопротивления: \t"P"%s\n\
					"W"Спортивный распредвал: \t\t\t\t"P"%s\n\n\
					\
					"ORANGE"Улучшения тормозной системы:\n\
					"W"Тормозной шланг: \t\t\t\t\t"P"%s\n\
					"W"Спортивные тормозные диски: \t\t\t"P"%s\n\
					"W"Модифицированные тормозные колодки: \t\t"P"%s\n\
					"W"Тормозной цилинтр: \t\t\t\t\t"P"%s\n\
					"W"Вакуумный усилитель: \t\t\t\t"P"%s",
					player_name[playerid],
					gTransport[GetVehicleModel(vehicleid) - 400][trName],
					VehicleInfo[vehicleid][vStatus],

					VehicleInfo[vehicleid][vPEngine][0] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPEngine][1] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPEngine][2] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPEngine][3] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPEngine][4] ? ("Установлено") : ("Отсутствует"),

					VehicleInfo[vehicleid][vPBrake][0] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPBrake][1] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPBrake][2] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPBrake][3] ? ("Установлено") : ("Отсутствует"),
					VehicleInfo[vehicleid][vPBrake][4] ? ("Установлено") : ("Отсутствует")
				);
				ShowPlayerDialog(playerid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, "Технический паспорт транспорта", STRING_GLOBAL, "Скрыть", ""), STRING_GLOBAL[0] = EOS;
			}
			case 6: {
				STRING_GLOBAL[0] = EOS;
				// keys
				new keys;
				for(new keyid = 0, key_id, target_playername[MAX_PLAYER_NAME + 1]; keyid < 3; keyid++) {
					if(PlayerVehicleInfo[player_vehicle_id][carKeys][keyid] == 0)
						continue;
					key_id = playerListitemID[playerid][keys] = PlayerVehicleInfo[player_vehicle_id][carKeys][keyid];

					format(MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), 
						"SELECT `Name` FROM "TABLE_ACCOUNTS" WHERE `pID` = '%i' LIMIT 1", key_id
					);
					new Cache: result = mysql_query(connects, MYSQL_GLOBAL);
					MYSQL_GLOBAL[0] = EOS;


					if(!cache_num_rows()) {
						playerListitemID[playerid][keys] = -1;

					} else {
						cache_get_value_name(0, "Name", target_playername, sizeof (target_playername));
						playerListitemID[playerid][keys] = key_id;

						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s "G"[забрать]\n", 
							keys + 1, target_playername
						);
						strcat(STRING_GLOBAL, COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
						keys++; 
					}
					if(cache_is_valid(result)) cache_delete(result);
				}
				if(keys < 3) {
					playerListitemID[playerid][keys] = 0;
					strcat(STRING_GLOBAL, ""P"Выдать ключи игроку");
					keys++; 
				}
				ShowPlayerDialog(playerid, D_CARS_KEYS, DIALOG_STYLE_LIST, ""P"Управление дубликатами ключей", STRING_GLOBAL, "Выбрать", "Назад"), STRING_GLOBAL[0] = EOS;
			}
			case 7: {
				/*format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""P"Продажа / обмен %s [%s]",
					gTransport[PlayerVehicleInfo[player_vehicle_id][carModel] - 400][trName],
					PlayerVehicleInfo[player_vehicle_id][carNumber]
				);
				ShowPlayerDialog(playerid, D_CAR_MENU_2, DIALOG_STYLE_LIST, STRING_GLOBAL, "\
					"P"1. "W"Продать транспорт\n\
					"P"2. {C0C0C0}Обменять транспорт",
					"Выбрать", "Отмена"
				);
				STRING_GLOBAL[0] = EOS;*/

				if(TI[playerid][tTempChangeCarBuyerID] != INVALID_PLAYER_ID)
					return ErrorMessage(playerid, "Вы уже предложили сделку по продаже / обмену ТС.");
				TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
				TI[playerid][tTempChangeCarPrice] = 0;
				TI[playerid][tTempChangeCarVehicleID][0] = -1;
				TI[playerid][tTempChangeCarVehicleID][1] = -1;
				ShowPlayerCarsList(playerid, D_SELL_CAR);
			}
			case 8: {
				// ShowPlayerCarsList(playerid, D_FIX_CAR);
				ShowPlayerDialog(playerid, D_FIX_CAR_2, DIALOG_STYLE_LIST, ""P"Выберите место доставки", "\
					"P"1. "W"На место парковки "GREEN"[$"#FIX_CAR_PARK_PRICE"]\n\
					"P"2. "W"На автостоянку ЛС "GREEN"[$"#FIX_CAR_PARK_LS_PRICE"]\n\
					"P"3. "W"К дому "GREEN"[$"#FIX_CAR_HOUSE_PRICE"]",
					!"Выбрать", "Отмена"
				);
			}
			case 9: {
				if(PlayerVehicleInfo[player_vehicle_id][carOrganization]) {
					PlayerVehicleInfo[player_vehicle_id][carOrganization] = 0;
					VehicleInfo[vehicleid][vOrganization] = 0;

					return SendOk(playerid, "Вы забрали доступ к личному транспорту у пользовательской организации.");
				}
				new organization_id = PI[playerid][pOrgMember];
				if(!organization_id)
					return ErrorMessage(playerid, "Вы не состоите в пользовательской организации.");

				PlayerVehicleInfo[player_vehicle_id][carOrganization] =
				VehicleInfo[vehicleid][vOrganization] = organization_id;

				format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "Вы дали доступ к транспорту для организации - \"%s\".",
					OrganizationInfo[organization_id][orgName]
				);
				SendOk(playerid, STRING_GLOBAL);
			}
		}
		return true;

	}
	case D_CAR_MENU_2: {
		if(!response)
			return true;
		new
			player_vehicle_id = GetPVarInt(playerid, "player_vehicle_id"),
			vehicleid = PlayerVehicleInfo[player_vehicle_id][carVehicle];

		switch(listitem + 1) {
			case 1: {

				static const f_car_menu[] = "\
				"W"Введите ID игрока, которому хотите продать и стоимость транспорта через запятую:\n\
				"W"Например: "G"0, 10000\n \n\
				"G"Примечание: "W"стоимость транспорта от $0 до $%d";

				new str_car_menu[sizeof(f_car_menu) + (-2 + 12)];
				format(str_car_menu, sizeof (str_car_menu), f_car_menu,
					VehicleImportInfo[PlayerVehicleInfo[player_vehicle_id][carModel] - 400][viPrice] * 3
				);
				ShowPlayerDialog(playerid, D_SELL_CAR, DIALOG_STYLE_INPUT, ""P"Продажа транспорта", str_car_menu, "Далее", "Назад");
			}
			case 2: {
				ShowPlayerDialog(playerid, D_CHANGE_CAR, DIALOG_STYLE_INPUT, ""P"Обменять транспорт", "\
					"W"Введите ID игрока, с которым хотите обменяться транспортом:", "Далее", "Назад"
				);
			}
		}
		#pragma unused vehicleid

		return true;
	}
	case D_SELL_CAR: {
		if(!response) {
			TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
			return true;
		}
		switch(listitem + 1) {
			case 1: ShowPlayerCarsList(playerid, D_SELL_CAR_PLAYER);
			case 2: ShowPlayerCarsList(playerid, D_SELL_CAR_VEHICLE_1);
			case 3: {
				new targetid = TI[playerid][tTempChangeCarBuyerID];
				if(targetid == INVALID_PLAYER_ID) {
					TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
					return ErrorMessage(playerid, "Вы не выбрали игрока для сделки.");
				}
				ShowPlayerCarsList(playerid, D_SELL_CAR_VEHICLE_2);
			}
			case 4: ShowPlayerCarsList(playerid, D_SELL_CAR_PRICE);
			case 5: {
				new targetid = TI[playerid][tTempChangeCarBuyerID];
				if(targetid == INVALID_PLAYER_ID) {
					TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
					return ErrorMessage(playerid, "Вы не выбрали игрока для сделки.");
				}
				if(TI[playerid][tTempChangeCarPrice] < 1) {
					TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
					return ErrorMessage(playerid, "Вы не выбрали стоимость для сделки.");
				}
				new player_vehicleid = TI[playerid][tTempChangeCarVehicleID][0];
				if(player_vehicleid == -1) {
					TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
					return ErrorMessage(playerid, "Вы не выбрали свой транспорт для сделки.");
				}
				new target_vehicleid = TI[playerid][tTempChangeCarVehicleID][1];
				if(target_vehicleid == -1) {
					new vehicle_amount = GetPlayerVehicles(targetid);
					if(vehicle_amount + 1 > GetPlayerAvailableCars(targetid)) {
						TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
						ErrorMessage(playerid, "У игрока максимальное количество ТС.");
						return false;
					}
				}
				if(!IsPlayerConnected(targetid) || !ProxDetectorS(5.0, playerid, targetid)) {
					TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
					return ErrorMessage(playerid, "Игрок должен быть рядом с Вами!");
				}
				new vehicleid[2], modelid[2], classname[2], tuning[2][256];

				vehicleid[0] = PlayerVehicleInfo[player_vehicleid][carVehicle];
				modelid[0] = PlayerVehicleInfo[player_vehicleid][carModel];
				GetCarClassName(gTransport[modelid[0] - 400][trClass], classname[0]);

				if(PlayerVehicleInfo[player_vehicleid][carVehcom][00]) strcat(tuning[0], "\t[Спойлер]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][01]) strcat(tuning[0], "\t[Капот]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][02]) strcat(tuning[0], "\t[Воздухозаборник]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][03]) strcat(tuning[0], "\t[Боковая юбка]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][04]) strcat(tuning[0], "\t[Фары]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][05]) strcat(tuning[0], "\t[Нитро]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][06]) strcat(tuning[0], "\t[Выхлопная труба]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][07]) strcat(tuning[0], "\t[Диски]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][08]) strcat(tuning[0], "\t[Стерео]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][09]) strcat(tuning[0], "\t[Гидравлика]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][10]) strcat(tuning[0], "\t[Передний бампер]\n");
				if(PlayerVehicleInfo[player_vehicleid][carVehcom][11]) strcat(tuning[0], "\t[Задний бампер]\n");

				if(target_vehicleid != -1) {
					vehicleid[1] = PlayerVehicleInfo[target_vehicleid][carVehicle];
					modelid[1] = PlayerVehicleInfo[target_vehicleid][carModel];
					GetCarClassName(gTransport[modelid[1] - 400][trClass], classname[1]);

					if(PlayerVehicleInfo[target_vehicleid][carVehcom][00]) strcat(tuning[1], "\t[Спойлер]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][01]) strcat(tuning[1], "\t[Капот]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][02]) strcat(tuning[1], "\t[Воздухозаборник]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][03]) strcat(tuning[1], "\t[Боковая юбка]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][04]) strcat(tuning[1], "\t[Фары]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][05]) strcat(tuning[1], "\t[Нитро]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][06]) strcat(tuning[1], "\t[Выхлопная труба]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][07]) strcat(tuning[1], "\t[Диски]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][08]) strcat(tuning[1], "\t[Стерео]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][09]) strcat(tuning[1], "\t[Гидравлика]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][10]) strcat(tuning[1], "\t[Передний бампер]\n");
					if(PlayerVehicleInfo[target_vehicleid][carVehcom][11]) strcat(tuning[1], "\t[Задний бампер]\n");

					format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
						"P"Информация о сделке по обмену / продаже транспорта\n \
						\n\
						"YELLOW"Ваш личный транспорт:\n \n\
						"W"Марка: "P"%s "G"(ID: %i)\n\
						"W"Класс: "P"%s\n\
						"W"Пробег: "P"%.0f км.\n\
						"W"Бензобак: "P"%d л.\n\
						"W"Расход: "P"%d л. (100 км.)\n\
						"W"Техническое состояние: "P"%.1f / 100.0%%\n\
						"P"Установленный тюнинг:\n\
						"GREEN"%s\n\
						\n\
						"YELLOW"Личный транспорт %s [ID: %i]:\n \n\
						"W"Марка: "P"%s "G"(ID: %i)\n\
						"W"Класс: "P"%s\n\
						"W"Пробег: "P"%.0f км.\n\
						"W"Бензобак: "P"%d л.\n\
						"W"Расход: "P"%d л. (100 км.)\n\
						"W"Техническое состояние: "P"%.1f / 100.0%%\n\
						"P"Установленный тюнинг:\n\
						"GREEN"%s\n\
						\n\
						"W"Вы действительно хотите предложить обмен ТС с доплатой игрока %s: "GREEN"$%d"W"?",
						gTransport[modelid[0] - 400][trName], modelid[0],
						classname[0],
						PlayerVehicleInfo[player_vehicleid][carDrived],
						gTransport[modelid[0] - 400][trTank],
						gTransport[modelid[0] - 400][trConsumption],
						VehicleInfo[vehicleid[0]][vStatus],
						tuning[0],
						player_name[targetid], targetid,
						gTransport[modelid[1] - 400][trName], modelid[1],
						classname[1],
						PlayerVehicleInfo[player_vehicleid][carDrived],
						gTransport[modelid[1] - 400][trTank],
						gTransport[modelid[1] - 400][trConsumption],
						VehicleInfo[vehicleid[1]][vStatus],
						tuning[1],
						player_name[targetid],
						TI[playerid][tTempChangeCarPrice]
					);
				} else {
					format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
						"P"Информация о сделке по обмену / продаже транспорта\n \
						\n\
						"YELLOW"Ваш личный транспорт:\n \n\
						"W"Марка: "P"%s "G"(ID: %i)\n\
						"W"Класс: "P"%s\n\
						"W"Пробег: "P"%.0f км.\n\
						"W"Бензобак: "P"%d л.\n\
						"W"Расход: "P"%d л. (100 км.)\n\
						"W"Техническое состояние: "P"%.1f / 100.0%%\n\
						"P"Установленный тюнинг:\n\
						"GREEN"%s\n\
						\n\
						"W"Вы действительно хотите предложить продажу ТС с доплатой игрока %s: "GREEN"$%d"W"?",
						gTransport[modelid[0] - 400][trName], modelid[0],
						classname[0],
						PlayerVehicleInfo[player_vehicleid][carDrived],
						gTransport[modelid[0] - 400][trTank],
						gTransport[modelid[0] - 400][trConsumption],
						VehicleInfo[vehicleid[0]][vStatus],
						tuning[0],
						player_name[targetid],
						TI[playerid][tTempChangeCarPrice]
					);
				}
				ShowPlayerDialog(playerid, D_SELL_CAR_2, DIALOG_STYLE_MSGBOX, ""P"Продажа / обмен ТС", STRING_GLOBAL, "Да", "Отмена");
			}
		}
		return true;
	}
	case D_SELL_CAR_2: {
		if(!response) {
			TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
			return true;
		}
		new
			targetid = TI[playerid][tTempChangeCarBuyerID],
			player_vehicleid = TI[playerid][tTempChangeCarVehicleID][0],
			target_vehicleid = TI[playerid][tTempChangeCarVehicleID][1];

		if(!IsPlayerConnected(targetid) || !ProxDetectorS(5.0, playerid, targetid)) {
