			mysql_tquery(connects, MYSQL_GLOBAL, "player_register", "i", playerid), MYSQL_GLOBAL[0] = EOS;

			TI[playerid][tTempSkin] = skin_register[GetPVarInt(playerid, "join_ped_item")][0];

			return 1;
		}
