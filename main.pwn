	case D_LMENU_CHANGE_COMMAND: {
		if(!response) return 1;
		STRING_GLOBAL[0] = EOS;
		SelectFractionChange[playerid][0] = CommandDialog[playerid][listitem + 1];
		for(new i = 1; i <= FI[PI[playerid][pMember]][fMaxRang]; i++)
		{
			if(RightCommand[PI[playerid][pMember]][CommandDialog[playerid][listitem + 1]] == i)
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"P"%s (%i)\n", STRING_GLOBAL, GetRankName(PI[playerid][pMember], i), i);
			else
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"W"%s (%i)\n", STRING_GLOBAL, GetRankName(PI[playerid][pMember], i), i);
		}
		ShowPlayerDialog(playerid, D_LMENU_CHANGE_COMMAND_2, DSL, ""P"Выберите ранг для изменения", STRING_GLOBAL, "Выбрать", "Закрыть");
	}
	case D_LMENU_CHANGE_COMMAND_2: {
		if(!response) return 1;
		MYSQL_GLOBAL[0] = EOS;
		if(listitem > FI[PI[playerid][pMember]][fMaxRang])  return ErrorMessage(playerid, "Такого ранга не существует");
		RightCommand[PI[playerid][pMember]][SelectFractionChange[playerid][0]] = listitem + 1;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `fractions_cmd` SET `frac_%d` = '%d' WHERE `id` = '%d';", PI[playerid][pMember], listitem + 1, SelectFractionChange[playerid][0]);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
		SendOk(playerid, "Права на использование команды изменено");
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "№\tНазвание команды\t"P"Доступ\n");
		new countcmd = 1 ;
		for(new i = 1; i <= MaxCommandFractionLoad; i++)
		{
			if(RightCommand[PI[playerid][pMember]][i] == 30) continue;
			if(RightCommandControl[i] && PI[playerid][pAdmin] <= 4) continue;
			if(i == MaxCommandFractionLoad)
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t/%s\t"P"%s", STRING_GLOBAL, countcmd, RightCommandName[i], GetRankName(PI[playerid][pMember], RightCommand[PI[playerid][pMember]][i]));
				break;
			}
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t/%s\t"P"%s\n", STRING_GLOBAL, countcmd, RightCommandName[i], GetRankName(PI[playerid][pMember], RightCommand[PI[playerid][pMember]][i]));
			CommandDialog[playerid][countcmd] = i;
			countcmd++;
		}
		ShowPlayerDialog(playerid, D_LMENU_CHANGE_COMMAND, DIALOG_STYLE_TABLIST_HEADERS, ""P"Выберите команду", STRING_GLOBAL, "Выбрать", "Закрыть");
	}

