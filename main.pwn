			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\n"W"Доктор: "P"%s"W" предлагает вылечить Вас от болезни анорексия.\nСтоимость процедур: "GREEN"$%d.\n\n"YELLOW"\tВы согласны пройти курс лечения?", player_name[playerid], price_2);
			ShowPlayerDialog(i, D_DISEASE_2, DSM, ""P"Лечение", STRING_GLOBAL, "Да", "Нет");
		}
		case 2: {
			if(GetPlayerMoneyEx(i) < price_3) return ErrorMessage(playerid, "У игрока недостаточно средств");

			new string[128];
			format(string, sizeof(string), "Вы предложили "P"%s"G" лечение болезни наркозависимость", player_name[i]);
			SendUse(playerid, string);

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\n"W"Доктор: "P"%s"W" предлагает вылечить Вас от болезни наркозависимость.\nСтоимость процедур: "GREEN"$%d.\n\n"YELLOW"\tВы согласны пройти курс лечения?", player_name[playerid], price_2);
			ShowPlayerDialog(i, D_DISEASE_2, DSM, ""P"Лечение", STRING_GLOBAL, "Да", "Нет");
		}
		}
		SetPVarInt(i, "gheal2", take_items[playerid][listitem]);
		SetPVarInt(i, "gheal2p", playerid);
	}
