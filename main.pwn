UseLabrary(member, id, status)
{
	if(status == 1)
	{
		if(l_actor[member][id])
		{
			l_actors[member][id] = CreateActor(144, l_actor_pos[id][0], l_actor_pos[id][1], l_actor_pos[id][2], l_actor_pos[id][3]);
			if(member == 0) SetActorVirtualWorld(l_actors[member][id], 49);
			else if(member == 1) SetActorVirtualWorld(l_actors[member][id], 50);
			else if(member == 2) SetActorVirtualWorld(l_actors[member][id], 51);
			if(id >= 2) ApplyActorAnimation(l_actors[member][id], "BOMBER", "BOM_Plant", 4, 1, 0, 0, 1, 0);
			else ApplyActorAnimation(l_actors[member][id], "FLAME", "FLAME_FIRE", 4, 1, 0, 0, 1, 0);
		}
	}
	else
	{
		if(l_actors[member][id]) DestroyActor(l_actors[member][id]);
		SaveLabrary(member);
	}
}
stock SaveLabrary(member)
{
	new data[48], data_2[48];
	for(new i; i < 8; i++)
	{
		if(!i)
		{
			format(data, sizeof(data), "%d", l_actor[member][i]);
			format(data_2, sizeof(data_2), "%d", l_actort[member][i]);
		}
		else
		{
			format(data, sizeof(data), "%s|%d", data, l_actor[member][i]);
			format(data_2, sizeof(data_2), "%s|%d", data_2, l_actort[member][i]);
		}
	}

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `labrary` SET actor_%d = '%s',actor_t%d = '%s' LIMIT 1", member + 1, data, member + 1, data_2);
	mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	return true;
}
stock save_salary(member)
{
	new data[90];
	for(new i; i < 20; i++)
	{
		if(!i) format(data, sizeof(data), "%d", FracSalary[member][i]);
		else format(data, sizeof(data), "%s|%d", data, FracSalary[member][i]);
	}
	switch(member)
	{
	case 0: {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `economy` SET salary_pd = '%s' LIMIT 1", data);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case 1: {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `economy` SET salary_fbi = '%s' LIMIT 1", data);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case 3: {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `economy` SET salary_army = '%s' LIMIT 1", data);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case 4: {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `economy` SET salary_medics = '%s' LIMIT 1", data);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case 5: {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `economy` SET salary_news = '%s' LIMIT 1", data);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case 8: {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `economy` SET salary_whitehouse = '%s' LIMIT 1", data);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	}
	return true;
}
stock ACLoad(playerid)
{
	if(PI[playerid][pAdmin] > 0)
	{
		//for(new i; i < 10; i++) TextDrawShowForPlayer(playerid, CheatText[i]);
		//for(new i; i < 3; i++)   TextDrawShowForPlayer(playerid, CheatPanel[i]);
		UpdateAdminCP(playerid);
		for(new i = 53; i != -1; --i)  EnableAntiCheatForPlayer(playerid, i, 0);
		return true;
	}
	return true;
}
stock UpdateAdminCP(playerid, typeid = -1) {
	new type = PI[playerid][pAdminTypeCP];
	if(typeid != -1) type = typeid;
	if(PI[playerid][pAdmin] < 1 || !dostup[playerid]) type = 2;

	switch(type) {
		case 0: {
			for(new i; i < sizeof(CheatPanelTD); i++)
				TextDrawShowForPlayer(playerid, CheatPanelTD[i]);
			for(new td_id = 0; td_id < sizeof(AdminCP_TD); td_id++)
				TextDrawHideForPlayer(playerid, AdminCP_TD[td_id]);
		}
		case 1: {
			for(new i; i < sizeof(CheatPanelTD); i++)
				TextDrawHideForPlayer(playerid, CheatPanelTD[i]);
			for(new td_id = 0; td_id < sizeof(AdminCP_TD); td_id++)
				TextDrawShowForPlayer(playerid, AdminCP_TD[td_id]);
		}
		default: {
			for(new i; i < sizeof(CheatPanelTD); i++)
				TextDrawHideForPlayer(playerid, CheatPanelTD[i]);
			for(new td_id = 0; td_id < sizeof(AdminCP_TD); td_id++)
				TextDrawHideForPlayer(playerid, AdminCP_TD[td_id]);
		}
	}

}
CB:sad_temp_1(field)
{
	SI[field][sad_temp] = 2;
	DestroyDynamicObject(SI[field][sad_object][0]);
	SI[field][sad_object][0] = CreateDynamicObject(673, sad_objects[field][0], sad_objects[field][1], sad_objects[field][2], sad_objects[field][3], sad_objects[field][4], sad_objects[field][5], -1, -1, -1, 90.000);

	new string[128];
	format(string, sizeof(string), "Дерево\nСтадия - цветение\nФермер - %s", SI[field][sad_fermer]);
	UpdateDynamic3DTextLabelText(SI[field][sad_3dtext], -1, string);

	if(IsPlayerConnected(GetPlayerID(SI[field][sad_fermer]))) Streamer_Update(GetPlayerID(SI[field][sad_fermer]));

	SetTimerEx("sad_temp_2", 30000, false, "i", field);
	return 1;
}

CB:sad_temp_2(field)
{
	TimerCallFix[14] ++;
	SI[field][sad_temp] = 3;
