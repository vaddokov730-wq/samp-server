		cache_get_value_name_int(i - 1, "frac_25", RightCommand[25][id]);
		cache_get_value_name_int(i - 1, "frac_26", RightCommand[26][id]);
		//printf("Команда № %i (%s) Описание: %s Фракция1: %d Фракция2  %d",id,RightCommandName[id],Commandspecification[id],RightCommand[1][id],RightCommand[1][id]);
		MaxCommandFractionLoad++;
	}
	if(cache_is_valid(result)) cache_delete(result);
	printf("[Загрузка ...] Права для команд успешно загружены (%i шт.)", rows);
	return true;
}

