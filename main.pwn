			case 1: admin_FractionMenu(playerid, D_ADMIN_FRAC_NAME);
			case 2: admin_FractionMenu(playerid, D_ADMIN_FRAC_COLOR);
			case 3: admin_FractionMenu(playerid, D_ADMIN_FRAC_RANKS);
			case 4: admin_FractionMenu(playerid, D_ADMIN_FRAC_MAX_RANK);
			case 5: admin_FractionMenu(playerid, D_ADMIN_FRAC_SALARY);
			case 6: admin_FractionMenu(playerid, D_ADMIN_FRAC_PRELOAD_CMD);
			case 7: admin_FractionMenu(playerid, D_ADMIN_FRAC_DISBAND);
		}
		return true;
	}
	case D_ADMIN_FRAC_DISBAND: {
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			return true;
		}
		new number = GetPVarInt(playerid, "disbandRandom");
		DeletePVar(playerid, "disbandRandom");

		if(strval(inputtext) != number) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			ErrorMessage(playerid, "Вы ввели неверный код подтверждения!");
			return true;
		}
		new fractionid = GetPVarInt(playerid, "admin_FractionID");
		foreach(new giveplayerid: Player) {
			if(!TI[giveplayerid][tLogin] || AntiCheatIsKickedWithDecync(giveplayerid))
				continue;
			if(PI[giveplayerid][pMember] != fractionid) continue;

			PI[giveplayerid][pMember] = 0;
			PI[giveplayerid][pRank] = 0;
			PI[giveplayerid][pFracSkin] = 0;
			PI[giveplayerid][pLeader] = 0;
			start_work[giveplayerid] = 0;
			inventory_ClearFractionClothes(giveplayerid);
			inventory_ClearFractionWeapons(giveplayerid);
			SetPlayerColor(giveplayerid, TEAM_HIT_COLOR);
			inventory_UpdateClothes(giveplayerid);
			if(PI[giveplayerid][pHouse] > 0) PI[giveplayerid][pSpawn] = 1;
			else PI[giveplayerid][pSpawn] = 0;
			SaveAccount(giveplayerid);

			SendOk(giveplayerid, "Ваша организация была расформирована администрацией!");
		}


		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL),
			"UPDATE "TABLE_ACCOUNTS" SET pLeader=0,pMember=0,pRank=0 WHERE pMember=%i",
			fractionid
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;

		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "Вы успешно расформировали фракцию - \"%s\".",
			FI[fractionid][fName]
		);
		SendOk(playerid, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;
		admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
		return true;
	}
	case D_ADMIN_FRAC_NAME: { // Редактирование названия
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			return true;
		}
		if(!(3 < strlen(inputtext) < 32)) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_NAME);
			return ErrorMessage(playerid, "Введите название от 3 символов до 32.");
		}
		new fractionid = GetPVarInt(playerid, "admin_FractionID");

		strmid(FI[fractionid][fName], inputtext, 0, strlen(inputtext), 36);
		MYSQL_GLOBAL[0] = EOS;

		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
			"UPDATE `fractions` SET `Name` = '%e' WHERE `ID` = '%d';", inputtext, FI[fractionid][fID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;

		SendOk(playerid, "Название фракции изменено.");
		admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);

		return true;
	}
	case D_ADMIN_FRAC_COLOR: { // Выберите цвет
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			return true;
		}
		new fractionid = GetPVarInt(playerid, "admin_FractionID");

		FI[fractionid][frColor] = listitem;
		MYSQL_GLOBAL[0] = EOS;

		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
			"UPDATE `fractions` SET `Color` = '%d' WHERE `ID` = '%d';", listitem, FI[fractionid][fID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;

		foreach(new i: Player) {
			if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i))
				continue;
			if(PI[playerid][pMember] == i && start_work[playerid] && !TI[playerid][tClistDisabled]) {
				SetPlayerColor(playerid, color_fraction[FI[PI[playerid][pMember]][frColor]][fracColor]);
			}
		}
		SendClientMessage(playerid, color_fraction[FI[PI[playerid][pMember]][frColor]][fracColor], "Цвет фракции изменен.");
		admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
		return true;
	}
	case D_ADMIN_FRAC_RANKS: { // Выберите ранг
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			return true;
		}
		// new fractionid = GetPVarInt(playerid, "admin_FractionID");
		playerListitemID[playerid][0] = listitem;
		admin_FractionMenu(playerid, D_ADMIN_FRAC_RANK_NAME);
		return true;
	}
	case D_ADMIN_FRAC_RANK_NAME: { // Выберите ранг
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_RANKS);
			return true;
		}
		new fractionid = GetPVarInt(playerid, "admin_FractionID"), rankid = playerListitemID[playerid][0] + 1;

		if(!(3 <= strlen(inputtext) < 24)) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_RANK_NAME);
			return ErrorMessage(playerid, "Введите название от 3 символов до 24");
		}
		strmid(RankName[fractionid][rankid - 1], inputtext, 0, strlen(inputtext), 24);
		MYSQL_GLOBAL[0] = EOS;

		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
			"UPDATE `fractions` SET `Rank_%d` = '%e' WHERE `ID` = '%d';",
			rankid, inputtext, FI[fractionid][fID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;
		SendOk(playerid, "Название ранга изменено.");

		admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
		return true;
	}
	case D_ADMIN_FRAC_SALARY: {
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			return true;
		}
		new fractionid = GetPVarInt(playerid, "admin_FractionID"),  min_salary, max_salary;
		if(sscanf(inputtext, "p<,>ii", min_salary, max_salary) || !(100 <= min_salary <= 7000) || !(100 <= max_salary <= 7000) || max_salary < (min_salary + 500)) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_SALARY);
			return true;
		}
		new salaryid, max_rank = FI[fractionid][fMaxRang];
		switch(fractionid) {
			case fLSPD, fSFPD, fLVPD, fBCPD, fRCPD, fTRPD: salaryid = 0;
			case fFBI: salaryid = 1;
			case fMAYOR: salaryid = 2;
			case fARMYSF, fARMYLV: salaryid = 3;
			case fMEDICLS, fMEDICSF, fMEDICLV: salaryid = 4;
			case fLSNEWS, fSFNEWS, fLVNEWS: salaryid = 5;
			case fWHITEHOUSE: salaryid = 8;
			case fINSTRUCTORS: salaryid = 9;
		}
		new step_pay = (max_salary + min_salary) / 2 / (max_rank - 1);

		for(new rankid = 0, pay_count; rankid < max_rank; rankid++) {
			if(rankid == 0) pay_count = min_salary;
			else pay_count += step_pay;

			FracSalary[salaryid][rankid] = pay_count;
			if(FracSalary[salaryid][rankid] < 0) FracSalary[salaryid][rankid] = 0;
		}
		save_salary(salaryid);
		SendOk(playerid, "Вы изменили зарплату фракции");
		admin_FractionMenu(playerid, D_ADMIN_FRAC_SALARY);
		return true;
	}
	case D_ADMIN_FRAC_MAX_RANK: { // Редактирование кол-ва рангов
		if(!response) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
			return true;
		}
		new fractionid = GetPVarInt(playerid, "admin_FractionID"), amount = strval(inputtext);
		if(!(5 <= amount <= MAX_FRACTION_RANK) || FI[fractionid][fMaxRang] == amount) {
			admin_FractionMenu(playerid, D_ADMIN_FRAC_MAX_RANK);
			return ErrorMessage(playerid, "Введите количество от 5 символов до 15.");
		}
		if(FI[fractionid][fMaxRang] > amount) { // Ес
			new difference = (FI[fractionid][fMaxRang] - amount);

			for(new i = 1; i <= MaxCommandFractionLoad; i++) {
				if(RightCommand[fractionid][i] == 30)
					continue;
				if(RightCommand[fractionid][i] == 1)
					continue;
				RightCommand[fractionid][i] -= difference;
				if(RightCommand[fractionid][i] < 1) RightCommand[fractionid][i] = 1;
				mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
					"UPDATE `fractions_cmd` SET `frac_%d`=%i WHERE id=%d;",
					fractionid, RightCommand[fractionid][i], i
				);
				mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;
			}
		} else {
			new difference = (amount - FI[fractionid][fMaxRang]);

			for(new i = 1; i <= MaxCommandFractionLoad; i++) {
				if(RightCommand[fractionid][i] == 30)
					continue;
				if(RightCommand[fractionid][i] == 1)
					continue;
				RightCommand[fractionid][i] += difference;
				MYSQL_GLOBAL[0] = EOS;

				mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
					"UPDATE `fractions_cmd` SET `frac_%d`=%i WHERE id=%d;",
					fractionid, RightCommand[fractionid][i], i
				);
				mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;
			}
		}
		FI[fractionid][fMaxRang] = amount;

		foreach(new i: Player) {
			if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i))
				continue;
			if(PI[i][pMember] != fractionid)
				continue;
			if(PI[i][pLeader]) {
				PI[i][pRank] = FI[fractionid][fMaxRang];
			} else {
				PI[i][pRank] = 1;
			}
			SaveAccount(i);
		}
		SaveFraction(fractionid);

		SendOk(playerid, "Количество рангов фракции изменено.");
		admin_FractionMenu(playerid, D_ADMIN_FRAC_EDIT);
		return true;
	}
