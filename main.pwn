		// ShowPlayerDialog(playerid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, " ", ""G"Прогрузка анимаций, пожалуйста подождите..", "Закрыть", "");
		ReloadAllAnims(playerid);
		// ShowPlayerDialog(playerid, -1, 0, "", "", "", "");
	}
	#if defined _quests_included
	UpdateQuests(playerid);
	#endif

	if(TI[playerid][tTempSkin]) {
		PI[playerid][pItemsID][INVENTORY_SLOT_ID_SKIN] = TI[playerid][tTempSkin] + 180;
		PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_SKIN] = 1;
		inventory_UpdateClothes(playerid);
	}
	#if defined _radio_included
		radio_ChannelLoad(playerid);
	#endif
	TI[playerid][tLoginTime] = 0;
	TI[playerid][tLogin] = true;

