stock load_gangzone()
{
	new Cache: result, rows;
	result = mysql_query(connects, "SELECT * FROM `"TABLE_GANGZONE"`");
	rows = cache_num_rows();

	for(new i = 0; i < rows; i++)
	{
		cache_get_value_name_int(i, "id", GZInfo[i][gID]);

		cache_get_value_name_float(i, "coord_one", GZInfo[i][gCoords][0]);
		cache_get_value_name_float(i, "coord_two", GZInfo[i][gCoords][1]);
		cache_get_value_name_float(i, "coord_three", GZInfo[i][gCoords][2]);
		cache_get_value_name_float(i, "coord_four", GZInfo[i][gCoords][3]);

		cache_get_value_name_int(i, "gang_owner", GZInfo[i][gFrakVlad]);

		GZInfo[i][gZone] = GangZoneCreate(GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3]);

		VladGzone[GZInfo[i][gFrakVlad]]++;
		GZInfo[i][gTime] = -1;

		TOTALGZ++;
	}
	cache_delete(result);
	printf("[Загрузка ...] ГангЗоны успешно загружены (%i шт.)", TOTALGZ);
	return 1;
}


stock load_subdivision()
{
	for(new i = 1; i < MAX_FRACTIONS_SUBDIVISION; i ++)  Subdivision[i][sub_status] = 0;
	new Cache: result, rows;
	STRING_GLOBAL[0] = EOS;
	mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `subdivision`");
	result = mysql_query(connects, STRING_GLOBAL);
	rows = cache_num_rows();
	for(new i = 1; i <= rows; i ++)
	{
		cache_get_value_name_int(i - 1, "id", Subdivision[i][sub_id]);
		cache_get_value_name_int(i - 1, "fraction", Subdivision[i][sub_frac]);
		SubdivisionCount[Subdivision[i][sub_frac]]++;
		Subdivision[i][sub_status] = 1;

		cache_get_value_name(i - 1, "name", Subdivision[i][sub_name], 15);
		cache_get_value_name(i - 1, "short_name", Subdivision[i][sub_short_name], 7);
		cache_get_value_name_int(i - 1, "color", Subdivision[i][sub_color]);
		if(Subdivision[i][sub_color] == 0) {
			Subdivision[i][sub_color] = FI[Subdivision[i][sub_frac]][frColor];

			MYSQL_GLOBAL[0] = EOS;
			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
				"UPDATE `subdivision` SET `color` = '%d' WHERE `id` = '%d';",
				Subdivision[i][sub_color],
				Subdivision[i][sub_id]
			);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			printf("[subdivision] обновлен цвет у FRAC:%i на %i", Subdivision[i][sub_frac], Subdivision[i][sub_color]);
		}
		cache_get_value_name(i - 1, "tag", Subdivision[i][sub_tag], 5);

		cache_get_value_name_int(i - 1, "tag_settings", Subdivision[i][sub_tag_settings]);
		cache_get_value_name_int(i - 1, "leader", Subdivision[i][sub_leader]);
		cache_get_value_name_int(i - 1, "substituent", Subdivision[i][sub_substituent]);
		cache_get_value_name_int(i - 1, "substituent2", Subdivision[i][sub_substituent_2]);
		printf("№ %i (bd %d) Фракция: %d [%d] name: %s Фракция1: %d Фракция2  %d", i, Subdivision[i][sub_id], Subdivision[i][sub_frac], SubdivisionCount[Subdivision[i][sub_frac]], Subdivision[i][sub_name]);

	}
	if(cache_is_valid(result)) cache_delete(result);
	printf("[Загрузка ...] Подразделения успешно загружены (%i шт.)", rows);
	return true;
}



stock load_fraction_command()
{
	new Cache: result, rows;
	STRING_GLOBAL[0] = EOS;
	MaxCommandFractionLoad = 0;
	mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `fractions_cmd`");
	result = mysql_query(connects, STRING_GLOBAL);
	rows = cache_num_rows();
	new id;
	for(new i = 1; i <= rows; i ++)
	{
		cache_get_value_name_int(i - 1, "id", id);

		cache_get_value_name(i - 1, "cmd", RightCommandName[id], 15);
		cache_get_value_name(i - 1, "specification", Commandspecification[id], 60);


		cache_get_value_name_int(i - 1, "control", RightCommandControl[id]);

		cache_get_value_name_int(i - 1, "frac_1", RightCommand[1][id]);
		cache_get_value_name_int(i - 1, "frac_2", RightCommand[2][id]);
