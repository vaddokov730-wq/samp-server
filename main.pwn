				mysql_tquery(connects, query, "", "");
			}
			format(query, sizeof(query), "UPDATE `rooms` SET `owner` = 'None' WHERE `id` = '%d'", i + 1);
			mysql_tquery(connects, query, "", "");

			SetString(gRooms[i][roomsOwner], "None");
		}
	}
	for(new i = 0; i < gAirCount; i ++)
	{
		if(gAirs[i][airOwnerID] != 0 && gAirs[i][airDay] <= unix)
