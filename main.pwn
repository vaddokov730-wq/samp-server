stock KickEx(playerid) {
	new ac_gpp = GetPlayerPing(playerid) + 150;
	SetTimerEx("timer_Kick", (ac_gpp > 500 ? 500 : ac_gpp), false, "d", playerid);
	return true;
}
#define Kick(%0) KickEx(%0)
