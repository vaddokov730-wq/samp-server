			return ShowPlayerDialog(playerid, D_INVENTORY_PAY, DIALOG_STYLE_INPUT, ""P"Передача наличных", "\
					"W"Введите ID игрока и количество денег через запятую, которое хотите передать:\n \n\
					"G"Например: 0, 10000",
