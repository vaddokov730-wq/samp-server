	case D_ORG_WAREHOUSE_WEAPON_ACTION: {
		if(!response)
			return org_ShowMenu(playerid, ORG_MENU_WAREHOUSE_WEAPON);
		new
			amount = 1, organization_id = PI[playerid][pOrgMember],
			itemid = GetPVarInt(playerid, "organizationTempItemID");

		switch(listitem + 1) {
			case 1: {
				if(amount < 1 || amount > OrganizationInfo[organization_id][orgWarehouseItemAmount][itemid])
					return org_ShowMenu(playerid, ORG_MENU_WAREHOUSE_WEAPON_MENU);
				if(!GivePlayerItem(playerid, 20 + itemid))
					return true;
				OrganizationInfo[organization_id][orgWarehouseItemAmount][itemid] -= amount;
				SaveOrganizationWarehouse(organization_id);

				SendOk(playerid, "Вы взяли оружие со склада организации.");
			}
			case 2: {
				if(amount < 1 || ItemCounts(playerid, 20 + itemid) < amount) {
					org_ShowMenu(playerid, ORG_MENU_WAREHOUSE_WEAPON_MENU);
					return ErrorMessage(playerid, "У вас нет такого оружия.");
				}
				GivePlayerItem(playerid, 20 + itemid, -amount);

				OrganizationInfo[organization_id][orgWarehouseItemAmount][itemid] += amount;
				SaveOrganizationWarehouse(organization_id);

				SendOk(playerid, "Вы положили оружие на склад организации.");
			}
		}
		return true;
	}
