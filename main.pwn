	return false;
}*/
stock isAdminStatus(const name[], status = ADMIN_STATUS_OWNER) {
	switch(status) {
		case ADMIN_STATUS_GA:
			if(GetString(name, "")) return true;
		case ADMIN_STATUS_SPECADMIN:
			if(GetString(name, "")) return true;
		case ADMIN_STATUS_PR:
			if(GetString(name, "")) return true;
		case ADMIN_STATUS_TECH:
			if(GetString(name, "") || GetString(name, "")) return true;
		case ADMIN_STATUS_CODER: {
			if(GetString(name, "")) return true;
			else return false;
		}
	}
	if(GetString(name, "") || GetString(name, "")
	|| GetString(name, ""))
		return true;
	return false;
}
