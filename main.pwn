	case D_ORG_TELEPORT_2: {
		if(!response)
			return true;
		new 
			organization_id = GetPVarInt(playerid, "organizationTempID"), 
			tmpcar = GetPlayerVehicleID(playerid);

		switch(listitem + 1) {
			case 1: {
				if(!OrganizationInfo[organization_id][orgInterior])
					return ErrorMessage(playerid, "У организации нет интерьера (спавна).");
				if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
					SetVehiclePos(tmpcar,
						OrganizationInfo[organization_id][orgExitPos][0],
						OrganizationInfo[organization_id][orgExitPos][1],
						OrganizationInfo[organization_id][orgExitPos][2]
					);
				} else {
					SetPlayerPosAC(playerid,
						OrganizationInfo[organization_id][orgExitPos][0],
						OrganizationInfo[organization_id][orgExitPos][1],
						OrganizationInfo[organization_id][orgExitPos][2], 0, 0
					);
				}
				format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "Вы телепортировались к интерьеру %s.",
					OrganizationInfo[organization_id][orgName]
				);
			}
			case 2: {
				if(!OrganizationInfo[organization_id][orgRoomInterior])
					return ErrorMessage(playerid, "У организации нет рабочего помещения.");
				if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
					SetVehiclePos(tmpcar,
						OrganizationInfo[organization_id][orgRoomExitPos][0],
						OrganizationInfo[organization_id][orgRoomExitPos][1],
						OrganizationInfo[organization_id][orgRoomExitPos][2]
					);
				} else {
					SetPlayerPosAC(playerid,
						OrganizationInfo[organization_id][orgRoomExitPos][0],
						OrganizationInfo[organization_id][orgRoomExitPos][1],
						OrganizationInfo[organization_id][orgRoomExitPos][2], 0, 0
					);
				}
				format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "Вы телепортировались к рабочему помещению %s.",
					OrganizationInfo[organization_id][orgName]
				);
			}
		}
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);

		ErrorMessage(playerid, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;
		return true;
	}
	case D_TP_LIST: {
		if(!response) return 1;
		if(listitem == 1) {

			format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""P"#\t"P"Название\t"P"Лидер\n");

			for(new org_id = 1, idx; org_id <= TOTAL_ORGANIZATIONS; org_id++) {
				if(OrganizationInfo[org_id][orgID] == 0) {
					format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "%s"P"%d\t{800000}%s\t%s\n", STRING_GLOBAL,
						org_id, OrganizationInfo[org_id][orgName], OrganizationInfo[org_id][orgLeader]
					);
				} else {
					format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "%s"P"%d\t"W"%s\t%s\n", STRING_GLOBAL,
						org_id, OrganizationInfo[org_id][orgName], OrganizationInfo[org_id][orgLeader]
					);
				}
				playerListitemID[playerid][idx++] = org_id;
			}
			ShowPlayerDialog(playerid, D_ORG_TELEPORT, DIALOG_STYLE_TABLIST_HEADERS, ""P"Телепорт", STRING_GLOBAL, "Выбрать", "Отмена");
			return true;
		}
		new str[2048];
		if(listitem > 0) listitem--;
		for(new idx, i = 0; i < sizeof (TPLIST); i++) {
			if(TPLIST[i][tList] != listitem) continue;

			format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL),
				""P"%i. "W"%s\n", idx + 1, TPLIST[i][tName]
			);
			strcat(str, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;

			playerListitemID[playerid][idx] = i;
			idx++;
		}
		ShowPlayerDialog(playerid, D_TP_LIST_2, DSL, ""P"Телепорт", str, "Выбрать", "Отмена");
	}
