SetPlayerInteriorAC(playerid, interior) {
	if(!(0 <= playerid < MAX_PLAYERS))
		return 0;
	if(PI[playerid][pDescriptionTextID] != INVALID_DYNAMIC_3D_TEXT_ID)
		Streamer_SetIntData(STREAMER_TYPE_3D_TEXT_LABEL, PI[playerid][pDescriptionTextID], E_STREAMER_INTERIOR_ID, interior);
	return acc_SetPlayerInterior(playerid, interior);
}
#if defined SetPlayerInterior
	#undef SetPlayerInterior
#endif
#define SetPlayerInterior SetPlayerInteriorAC

stock SetPlayerHealthAC(playerid, Float:ac_health) {
	if(!SetPlayerHealth(playerid, ac_health))
		return 0;
	printf("SetPlayerHealthAC %d %.1f", playerid, ac_health);
	if(90.0 <= ac_health < 200.0 && TI[playerid][tAFK] < 3 && PI[playerid][pStageDeath]) {
		SetPlayerChatBubble(playerid, "поднялся с земли", COLOR_PURPLE, 13.0, 4000);
		OnPlayerUpdateDeathStage(playerid, 0);
		PI[playerid][pStageDeath] = 0;
		PI[playerid][pStageDeathTimer] = 0;
		ApplyAnimation(playerid, "PED", "getup_front", 4.1, 0, 1, 1, 0, 1);
		TogglePlayerControllable(playerid, true);
		SetPlayerChatBubble(playerid, " ", 0xFF0000FF, 10.0, 100);
	}
	return 1;
}
#undef SetPlayerHealth
#define SetPlayerHealth SetPlayerHealthAC
stock SetPlayerToFacePos(playerid, Float:X, Float:Y) {
	if(!IsPlayerConnected(playerid))
		return false;
	new Float:playerPos[4];
	GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);

	if(Y > playerPos[1]) playerPos[3] = (-acos((X - playerPos[0]) / floatsqroot((X - playerPos[0]) * (X - playerPos[0]) + (Y - playerPos[1]) * (Y - playerPos[1]))) - 90.0);
	else if(Y < playerPos[1] && X < playerPos[0])
		playerPos[3] = (acos((X - playerPos[0]) / floatsqroot((X - playerPos[0]) * (X - playerPos[0]) + (Y - playerPos[1]) * (Y - playerPos[1]))) - 450.0);
	else if(Y < playerPos[1])
		playerPos[3] = (acos((X - playerPos[0]) / floatsqroot((X - playerPos[0]) * (X - playerPos[0]) + (Y - playerPos[1]) * (Y - playerPos[1]))) - 90.0);
	if(X > playerPos[0])
		playerPos[3] = (floatabs(floatabs(playerPos[3]) + 180.0));
	else playerPos[3] = (floatabs(playerPos[3]) - 180.0);

	return SetPlayerFacingAngle(playerid, playerPos[3]);
}
stock aurora_ShowPlayerDialog(playerid, dialogid, style, const caption[], const info[], const button1[], const button2[]) {
	if(!TI[playerid][tLogin]) {
		switch(dialogid) {
			case D_LOGIN, D_REG, D_REG_MAIL, D_REG_FRIEND, D_REG_SEX, 402, 462, 463, D_GOOGLE_2: { }
			default: {
				ErrorMessage(playerid, "Вами открыт запрещенный диалог при авторизации/регистрации");
				Kick(playerid);
				return 0x1;
			}
		}
	}
	if(isnull(caption) || isnull(info)) return true;
	TI[playerid][tDialog] = true;
	if(OldDialogID[playerid] == INVALID_DIALOG_ID)
		PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	OldDialogID[playerid] = dialogid;
	return ShowPlayerDialog(playerid, dialogid, style, caption, info, button1, button2);
}
#if defined ShowPlayerDialog
	#undef ShowPlayerDialog
#endif
#define ShowPlayerDialog aurora_ShowPlayerDialog

