	#pragma unused amount
	if(ServerSettings[serverBetaTest]) {
		if(damagedid != INVALID_PLAYER_ID && GetPVarInt(damagedid, "godmode")) {
			SetPlayerHealth(damagedid, Float:0x7F800000);
