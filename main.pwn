enum  {
	TYPE_OBJECT_BUILDING = 0,
	TYPE_OBJECT_TREE,
	TYPE_OBJECT_PLANT,
	TYPE_OBJECT_OTHER
}
static const distance_object[][2] = {
	{500, 0}, 	/* здания, камни, заграждения */
	{350, 0}, 	/* деревья */
	{150, 0}, 	/* растительность */
	{100, 0} 	/* другое */
};
stock CreateDynamicObjectPlus(modelid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = STREAMER_OBJECT_SD, Float:drawdistance = STREAMER_OBJECT_DD, areaid = -1, priority = 0) {
	new c_object = CreateDynamicObject(modelid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, worldid, interiorid, playerid, streamdistance, drawdistance, areaid, priority);
	
	if(IsObjectRoad(modelid)) { }
	else if(IsObjectTree(modelid)) {
		if(streamdistance > distance_object[TYPE_OBJECT_TREE][0])
			Streamer_SetIntData(STREAMER_TYPE_OBJECT, c_object, E_STREAMER_STREAM_DISTANCE, distance_object[TYPE_OBJECT_TREE][0]);
		Streamer_SetIntData(STREAMER_TYPE_OBJECT, c_object, E_STREAMER_DRAW_DISTANCE, distance_object[TYPE_OBJECT_TREE][1]);
	}
	else if(IsObjectPlants(modelid)) {
		if(streamdistance > distance_object[TYPE_OBJECT_PLANT][0])
			Streamer_SetIntData(STREAMER_TYPE_OBJECT, c_object, E_STREAMER_STREAM_DISTANCE, distance_object[TYPE_OBJECT_PLANT][0]);
		Streamer_SetIntData(STREAMER_TYPE_OBJECT, c_object, E_STREAMER_DRAW_DISTANCE, distance_object[TYPE_OBJECT_PLANT][1]);
	}
	else if(IsObjectBuilding(modelid) || IsObjectRock(modelid) || IsObjectFence(modelid)) {
		if(streamdistance > distance_object[TYPE_OBJECT_BUILDING][0])
			Streamer_SetIntData(STREAMER_TYPE_OBJECT, c_object, E_STREAMER_STREAM_DISTANCE, distance_object[TYPE_OBJECT_BUILDING][0]);
		Streamer_SetIntData(STREAMER_TYPE_OBJECT, c_object, E_STREAMER_DRAW_DISTANCE, distance_object[TYPE_OBJECT_BUILDING][1]);
	}
	return c_object;
}

