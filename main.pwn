		}
		}
	}
	case D_NEWS_ETHER: {
		if(!response) return 1;
		switch(listitem)
		{
		case 0: {
			if(!TI[playerid][tEther]) return ErrorMessage(playerid, "Для приёма звонков необходимо находиться в прямом эфире");
			switch(PI[playerid][pMember])
			{
			case fLSNEWS: {
