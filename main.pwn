				"W"Вы действительно хотите совершить обмен ТС с вашей доплатой: "GREEN"$%d"W"?",
				player_name[playerid], playerid,
				gTransport[modelid[0] - 400][trName], modelid[0],
				classname[0],
				PlayerVehicleInfo[player_vehicleid][carDrived],
				gTransport[modelid[0] - 400][trTank],
				gTransport[modelid[0] - 400][trConsumption],
				VehicleInfo[vehicleid[0]][vStatus],
				tuning[0],
				gTransport[modelid[1] - 400][trName], modelid[1],
				classname[1],
				PlayerVehicleInfo[player_vehicleid][carDrived],
				gTransport[modelid[1] - 400][trTank],
				gTransport[modelid[1] - 400][trConsumption],
				VehicleInfo[vehicleid[1]][vStatus],
				tuning[1],
				TI[playerid][tTempChangeCarPrice]
			);
		} else {
			format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
				"P"Информация о сделке по обмену / продаже транспорта\n \
				\n\
				"YELLOW"Личный транспорт продавца %s [ID: %i]:\n \n\
				"W"Марка: "P"%s "G"(ID: %i)\n\
				"W"Класс: "P"%s\n\
				"W"Пробег: "P"%.0f км.\n\
				"W"Бензобак: "P"%d л.\n\
				"W"Расход: "P"%d л. (100 км.)\n\
				"W"Техническое состояние: "P"%.1f / 100.0%%\n\
				"P"Установленный тюнинг:\n\
				"GREEN"%s\n\
				\n\
				"W"Вы действительно хотите совершить покупку ТС с вашей доплатой: "GREEN"$%d"W"?",
				player_name[playerid], playerid,
				gTransport[modelid[0] - 400][trName], modelid[0],
				classname[0],
				PlayerVehicleInfo[player_vehicleid][carDrived],
				gTransport[modelid[0] - 400][trTank],
				gTransport[modelid[0] - 400][trConsumption],
				VehicleInfo[vehicleid[0]][vStatus],
				tuning[0],
				TI[playerid][tTempChangeCarPrice]
			);
		}
		ShowPlayerDialog(targetid, D_SELL_CAR_BUY, DIALOG_STYLE_MSGBOX, ""P"Продажа / обмен ТС", STRING_GLOBAL, "Да", "Отмена");

		TI[targetid][tTempChangeCarSellerID] = playerid;
		return true;
	}
	case D_SELL_CAR_BUY: {
		new sellerid = TI[playerid][tTempChangeCarSellerID];
		if(TI[sellerid][tTempChangeCarBuyerID] != playerid) {
			TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
			return true;
		}
		if(!IsPlayerConnected(sellerid) || !ProxDetectorS(5.0, playerid, sellerid)) {
			TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
			TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
			return ErrorMessage(playerid, "Игрок должен быть рядом с Вами!");
		}
		if(!response) {
			TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
			TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
			ErrorMessage(playerid, "Вы отказались от обмена / продажи ТС.");
			ErrorMessage(sellerid, "Игрок отказался от обмена / продажи ТС.");
			return true;
		}
		new
			player_vehicleid = TI[sellerid][tTempChangeCarVehicleID][0],
			target_vehicleid = TI[sellerid][tTempChangeCarVehicleID][1];

		if(target_vehicleid == -1) {
			new vehicle_amount = GetPlayerVehicles(playerid);
			if(vehicle_amount + 1 > GetPlayerAvailableCars(playerid)) {
				TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
				TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
				ErrorMessage(playerid, "У Вас максимальное количество ТС. (Вы можете его продать игроку, либо утилизировать)");
				ErrorMessage(sellerid, "У игрока максимальное количество ТС.");
				return false;
			}
		}
		if(GetPlayerMoneyEx(playerid) < TI[sellerid][tTempChangeCarPrice]) {
			TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
			TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
			ErrorMessage(playerid, "У Вас недостаточно средств.");
			return ErrorMessage(sellerid, "У игрока недостаточно средств.");
		}
		new Float:vehiclePos[3];
		GetVehiclePos(PlayerVehicleInfo[player_vehicleid][carVehicle], vehiclePos[0], vehiclePos[1], vehiclePos[2]);
		if(
			!GetString(PlayerVehicleInfo[player_vehicleid][carOwner], player_name[sellerid]) ||
			!IsPlayerInRangeOfPoint(sellerid, 10.0, vehiclePos[0], vehiclePos[1], vehiclePos[2])
		) {
			TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
			TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
			ErrorMessage(playerid, "Транспорт должен быть рядом с Вами.");
			return ErrorMessage(sellerid, "Транспорт должен быть рядом с Вами.");
		}
		if(target_vehicleid != -1) {
			GetVehiclePos(PlayerVehicleInfo[target_vehicleid][carVehicle], vehiclePos[0], vehiclePos[1], vehiclePos[2]);
			if(
				!GetString(PlayerVehicleInfo[target_vehicleid][carOwner], player_name[playerid]) ||
				!IsPlayerInRangeOfPoint(sellerid, 10.0, vehiclePos[0], vehiclePos[1], vehiclePos[2])
			) {
				TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
				TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
				ErrorMessage(playerid, "Транспорт должен быть рядом с Вами.");
				return ErrorMessage(sellerid, "Транспорт должен быть рядом с Вами.");
			}
		}
		TI[playerid][tTempChangeCarSellerID] = INVALID_PLAYER_ID;
		TI[sellerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;

		GiveMoney(playerid, -TI[sellerid][tTempChangeCarPrice], "sell_car_buy");
		GiveMoney(sellerid, TI[sellerid][tTempChangeCarPrice], "sell_car_buy");

		strmid(PlayerVehicleInfo[player_vehicleid][carOwner], player_name[playerid], 0, strlen(player_name[playerid]), MAX_PLAYER_NAME + 2);

		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
			"UPDATE `"TABLE_VEHICLES"` SET `owner` = '%e' WHERE id = %d LIMIT 1",
			PlayerVehicleInfo[player_vehicleid][carOwner],
			PlayerVehicleInfo[player_vehicleid][carID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;

		if(target_vehicleid != -1) {
			strmid(PlayerVehicleInfo[target_vehicleid][carOwner], player_name[sellerid], 0, strlen(player_name[sellerid]), MAX_PLAYER_NAME + 2);

			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),
				"UPDATE `"TABLE_VEHICLES"` SET `owner` = '%e' WHERE id = %d LIMIT 1",
				PlayerVehicleInfo[target_vehicleid][carOwner],
				PlayerVehicleInfo[target_vehicleid][carID]
			);
			mysql_tquery(connects, MYSQL_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;

			SendOk(playerid, "Вы успешно обменялись ТС.");
			SendOk(sellerid, "Вы успешно обменялись ТС.");
		} else {
			SendOk(playerid, "Вы успешно приобрели ТС.");
			SendOk(sellerid, "Игрок приобрел у Вас ТС.");
		}
		GetPlayerVehicles(playerid);
		GetPlayerVehicles(sellerid);
		return true;
	}
	case D_SELL_CAR_PLAYER: {
		if(!response)
			return ShowPlayerCarsList(playerid, D_SELL_CAR);
		new targetid;
		if(sscanf(inputtext, "u", targetid))
			return ShowPlayerCarsList(playerid, D_SELL_CAR_PLAYER);
		if(!IsPlayerConnected(targetid) || !ProxDetectorS(5.0, playerid, targetid)) {
			ErrorMessage(playerid, "Игрок должен быть рядом с Вами!");
			return ShowPlayerCarsList(playerid, D_SELL_CAR_PLAYER);
		}
		TI[playerid][tTempChangeCarBuyerID] = targetid;
		ShowPlayerCarsList(playerid, D_SELL_CAR);
		return true;
	}
	case D_SELL_CAR_PRICE: {
		if(!response)
