			inventory_ShowDialogMenu(playerid);
			return false;
		}
		new
			slotid = InventoryTempInfo[playerid][tActionSelectedSlotID], amount = 1, targetid;

		if(sscanf(inputtext, "p<,>ii", targetid, amount) || !(0 <= targetid < MAX_PLAYERS) || !(1 <= amount < 1000000))
			return inventory_GiveItem(playerid, slotid);
		if(targetid == playerid)
			return ErrorMessage(playerid, "Невозможно применить на себе.");
		if(!ProxDetectorS(5.0, playerid, targetid))
			return ErrorMessage(playerid, "Вы слишком далеко.");

		GivePlayerItemToPlayer(playerid, targetid, slotid, amount);
		return true;
	}
