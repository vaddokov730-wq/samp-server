				return true;
			}
			else SetPVarInt(playerid, "AmountMember", GetPVarInt(playerid, "AmountMember") + 30);
		}
		else if(response) {
			if(GetPVarInt(playerid, "AmountMember") < 30) return true;
			else SetPVarInt(playerid, "AmountMember", GetPVarInt(playerid, "AmountMember") - 30);
		}
