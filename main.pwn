stock to_default(playerid) {
	ac_1{playerid} = false;

	/*new tempInfo[4];

	tempInfo[0] = PI[playerid][pID];
	tempInfo[1] = PI[playerid][pKeyip];
	tempInfo[2] = PI[playerid][pGoogle];
	tempInfo[3] = PI[playerid][pGoogleSec];*/

	PI[playerid] = NULL_PI;

	/*PI[playerid][pID] = tempInfo[0];
	PI[playerid][pKeyip] = tempInfo[1];
	PI[playerid][pGoogle] = tempInfo[2];
	PI[playerid][pGoogleSec] = tempInfo[3];*/

	TI[playerid] = NULL_TI;

	#if defined _radio_included
	for(new i = 0; i < MAX_PLAYER_RADIO_CHANNELS; i++) {
		strmid(PlayerRadioPassword[playerid][i], "0", 0, strlen("0"), MAX_LOGIN_PASS_LENGHT + 2);
	}
	#endif
	#if defined _inventory_included
	InventoryTempInfo[playerid] = NULL_INVENTORY_TI;
	#endif
	#if defined _blackjack_included
		BJ_PlayerInfo[playerid] = NULL_BJ_PI;
	#endif
	#if defined _bank_robbery_included
	PI[playerid][pRobBankLastTime] = 0;

	RB_PlayerInfo[playerid][robBagTaken] =
	RB_PlayerInfo[playerid][robC4Bought] = 0;

	RB_PlayerInfo[playerid][robTextID] = Text3D:(-1);
	#endif
	#if defined _player_vehicles_included
	for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
		playerVehicleID[playerid][i] = -1;
	playerVehicleAmount[playerid] = 0;
	#endif
	#if defined _quests_included
	quests_PI[playerid][pBotTextTimer] = -1;
	quests_PI[playerid][pPlaneObjectID] = -1;
	quests_PI[playerid][pCopObjectID] = -1;

