					else ShowPlayerDialog(playerid, D_MAIL_CONTROL, DSI, ""P"E-Mail", ""W"Укажите Вашу "GREEN"почту"W"\n\nУкажите ваш реальный "P"Email"W". C помощью него вы сможете восстановить пароль", "Далее", "Закрыть");
				}
				else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"E-Mail", "\n\n"W"Подтвердите Ваш E-Mail адрес на сайте "YELLOW""NameSite"\n\n", "Закрыть", "");
				if(cache_is_valid(result)) cache_delete(result);
			}
			else ShowPlayerDialog(playerid, D_MAIL_CONTROL, DSI, ""P"E-Mail", ""W"Укажите Вашу "GREEN"почту"W"\n\nУкажите ваш реальный "P"Email"W". C помощью него вы сможете восстановить пароль", "Далее", "Закрыть");
		}
		case 3: {
