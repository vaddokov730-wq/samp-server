	case D_PIAR_DRUGS: {
		if(!response)
		{
			ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Наркотики", "Введите ID игрока которому хотите выдать наркотики", "Принять", "Отмена");
			return 0x1;
		}

		if(strlen(inputtext) == 0 || strval(inputtext) < 1 || strval(inputtext) > 5000)
		{
			ShowPlayerDialog(playerid, D_PIAR_DRUGS, DIALOG_STYLE_INPUT, ""P"Наркотики", "Введите количество наркотиков которое хотите выдать\nЗначения не могут быть менее 1 и более 5000", "Принять", "Отмена");
			return 0x1;
		}

		new targetid = PlayerPiarID[playerid];
		if(targetid == INVALID_PLAYER_ID || IsPlayerConnected(targetid) == 0 || TI[targetid][tLogin] == false)
		{
			ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Наркотики", "Введите ID игрока которому хотите выдать наркотики", "Принять", "Отмена");
			ErrorMessage(playerid, "Данный игрок не авторизован на сервере");
			return 0x1;
		}

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы выдали %d наркотиков игроку %s[%d]", strval(inputtext), player_name[targetid], targetid);
		SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вам выдали %d наркотиков", strval(inputtext));
		SendClientMessage(targetid, 0xCCCCCCFF, STRING_GLOBAL);

		/*PI[targetid][pDrugs] += strval(inputtext);
		UpdatePlayerData(targetid, "pDrugs", PI[targetid][pDrugs]);*/
		GivePlayerItem(targetid, 007, strval(inputtext));

		new string_logs[MAX_PLAYER_NAME];
		new string_name[MAX_PLAYER_NAME];

		format(string_name, sizeof(string_name), "%s", player_name[playerid]);
		format(string_logs, sizeof(string_logs), "Наркотиков %d", strval(inputtext));

		WriteLog(228, playerid, string_name, player_name[targetid], string_logs);
		return 0x1;
	}
	case D_PIAR_SKILL: {
