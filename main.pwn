		new price = strval(inputtext);
		if(!(1 <= price <= 1000000))
			return ShowPlayerCarsList(playerid, D_SELL_CAR_PRICE);
		TI[playerid][tTempChangeCarPrice] = price;
		ShowPlayerCarsList(playerid, D_SELL_CAR);
		return true;
	}
