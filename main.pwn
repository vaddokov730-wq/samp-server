			if(PI[playerid][pPlayerSettings][PLAYER_SETTING_ADMIN_ACTIONS]) {
				//
			}
			else {
				//
			}
		}
		case 15: {
			PI[playerid][pPlayerSettings][PLAYER_SETTING_NEWS_CNN] = !PI[playerid][pPlayerSettings][PLAYER_SETTING_NEWS_CNN];
			TogglePlayerSettings(playerid, PLAYER_SETTING_NEWS_CNN);
		}
		case 16: {
			PI[playerid][pPlayerSettings][PLAYER_SETTING_OOC_CHAT] = !PI[playerid][pPlayerSettings][PLAYER_SETTING_OOC_CHAT];
			TogglePlayerSettings(playerid, PLAYER_SETTING_OOC_CHAT);
		}
		case 17: {
			PI[playerid][pPlayerSettings][PLAYER_SETTING_CHANGENICK] = !PI[playerid][pPlayerSettings][PLAYER_SETTING_CHANGENICK];
			TogglePlayerSettings(playerid, PLAYER_SETTING_CHANGENICK);
