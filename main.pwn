		{
			switch(PlayerPiarListItem[playerid])
			{
			case 0: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Уровень", "Введите ID игрока которому хотите выдать уровень", "Принять", "Отмена");
			case 1: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Деньги", "Введите ID игрока которому хотите выдать деньги", "Принять", "Отмена");
			case 2: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Донат", "Введите ID игрока которому хотите выдать донат", "Принять", "Отмена");
			case 3: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Скиллы", "Введите ID игрока которому хотите выдать скиллы", "Принять", "Отмена");
			case 4: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Аптечки ", "Введите ID игрока которому хотите выдать аптечки", "Принять", "Отмена");
			case 5: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Боеприпасы", "Введите ID игрока которому хотите выдать боеприпасы", "Принять", "Отмена");
			case 6: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Маски", "Введите ID игрока которому хотите выдать маски", "Принять", "Отмена");
			case 9: ShowPlayerDialog(playerid, D_PIAR_ID, DIALOG_STYLE_INPUT, ""P"Наркотики", "Введите ID игрока которому хотите выдать наркотики", "Принять", "Отмена");
			}
			ErrorMessage(playerid, "Данный игрок не авторизован на сервере");
			return 0x1;
		}
		PlayerPiarID[playerid] = targetid;
		switch(PlayerPiarListItem[playerid])
		{
		case 0: ShowPlayerDialog(playerid, D_PIAR_LEVEL, DIALOG_STYLE_INPUT, ""P"Уровень", "Введите уровень который хотите выдать\nЗначения не могут быть менее 1 и более 10", "Принять", "Отмена");
		case 1: ShowPlayerDialog(playerid, D_PIAR_MONEY, DIALOG_STYLE_INPUT, ""P"Деньги", "Введите количество денег которое хотите выдать\nЗначения не могут быть менее 1 и более 1.000.000", "Принять", "Отмена");
		case 2: ShowPlayerDialog(playerid, D_PIAR_DONATE, DIALOG_STYLE_INPUT, ""P"Донат", "Введите количество доната которое хотите выдать\nЗначения не могут быть менее 1 и более 1000", "Принять", "Отмена");
		case 3: ShowPlayerDialog(playerid, D_PIAR_SKILL, DIALOG_STYLE_LIST, ""P"Скиллы", ""P"1."W" Silenced Pistol\n"P"2."W" Desert Eagle\n"P"3."W" ShotGun\n"P"4."W" MP5\n"P"5."W" AK47\n"P"6."W" M4A1\n"P"7."W" Весь набор", "Принять", "Отмена");
		case 4: ShowPlayerDialog(playerid, D_PIAR_HEALME, DIALOG_STYLE_INPUT, ""P"Аптечки ", "Введите количество аптечек которое хотите выдать\nЗначения не могут быть менее 1 и более 100", "Принять", "Отмена");
		case 5: ShowPlayerDialog(playerid, D_PIAR_MATS, DIALOG_STYLE_INPUT, ""P"Боеприпасы", "Введите количество боеприпасов которое хотите выдать\nЗначения не могут быть менее 1 и более 10000", "Принять", "Отмена");
		case 6: ShowPlayerDialog(playerid, D_PIAR_MASK, DIALOG_STYLE_INPUT, ""P"Маски", "Введите количество масок которое хотите выдать\nЗначения не могут быть менее 1 и более 50", "Принять", "Отмена");
		case 9: ShowPlayerDialog(playerid, D_PIAR_DRUGS, DIALOG_STYLE_INPUT, ""P"Наркотики", "Введите количество наркотиков которое хотите выдать\nЗначения не могут быть менее 1 и более 5000", "Принять", "Отмена");
		}
