stock ShowJobProcessTD(playerid) {
	if(!GetPVarInt(playerid, "jobProcessBarShowed")) {
		JobProcessPTD[playerid][0] = CreatePlayerTextDraw(playerid, 65.000000 + 482.0, 265.000000, "progress_bar");
		PlayerTextDrawLetterSize(playerid, JobProcessPTD[playerid][0], 0.000000, 0.219999);
		PlayerTextDrawTextSize(playerid, JobProcessPTD[playerid][0], 61.65, 0.000000);
		PlayerTextDrawAlignment(playerid, JobProcessPTD[playerid][0], 1);
		PlayerTextDrawColor(playerid, JobProcessPTD[playerid][0], -1);
		PlayerTextDrawUseBox(playerid, JobProcessPTD[playerid][0], 1);
		PlayerTextDrawBoxColor(playerid, JobProcessPTD[playerid][0], -1523959041);
		PlayerTextDrawSetShadow(playerid, JobProcessPTD[playerid][0], 0);
		PlayerTextDrawBackgroundColor(playerid, JobProcessPTD[playerid][0], 255);
		PlayerTextDrawFont(playerid, JobProcessPTD[playerid][0], 1);
		PlayerTextDrawSetProportional(playerid, JobProcessPTD[playerid][0], 1);

		JobProcessPTD[playerid][1] = CreatePlayerTextDraw(playerid, 27.122541 + 482.0, 260.952514, "PROCESS");
		PlayerTextDrawLetterSize(playerid, JobProcessPTD[playerid][1], 0.220449, 0.973333);
		PlayerTextDrawTextSize(playerid, JobProcessPTD[playerid][1], 151.000000 + 482.0, 0.000000);
		PlayerTextDrawAlignment(playerid, JobProcessPTD[playerid][1], 1);
		PlayerTextDrawColor(playerid, JobProcessPTD[playerid][1], -1);
		PlayerTextDrawSetShadow(playerid, JobProcessPTD[playerid][1], 0);
		PlayerTextDrawBackgroundColor(playerid, JobProcessPTD[playerid][1], 255);
		PlayerTextDrawFont(playerid, JobProcessPTD[playerid][1], 1);
		PlayerTextDrawSetProportional(playerid, JobProcessPTD[playerid][1], 1);
	}
	SetPVarInt(playerid, "jobProcessBarShowed", 1);

	for(new td_id = 0; td_id < sizeof(JobProcessTD); td_id++)
		TextDrawShowForPlayer(playerid, JobProcessTD[td_id]);
	for(new ptd_id = 0; ptd_id < 2; ptd_id++)
		PlayerTextDrawShow(playerid, JobProcessPTD[playerid][ptd_id]);
	return true;
}
stock UpdateJobProcessTD(playerid, process) {
	if(!GetPVarInt(playerid, "jobProcessBarShowed"))
		return;
	#define JOB_PROCESS_TD(%0) \
		(61.65 + (((116.00 - 61.65) / 100) * %0))
	new Float:processSize = JOB_PROCESS_TD(process);

	if(processSize < 61.65) processSize = 61.65;
	else if(processSize > 116.00) processSize = 116.00;

	#undef JOB_PROCESS_TD

	PlayerTextDrawTextSize(playerid, JobProcessPTD[playerid][0], processSize + 482.0, 0.000000);
	PlayerTextDrawShow(playerid, JobProcessPTD[playerid][0]);
}
stock HideJobProcessTD(playerid) {
	if(!GetPVarInt(playerid, "jobProcessBarShowed"))
		return false;
	if(FactoryJob_PI[playerid][factoryLoading]) {
		new cell_id = FactoryJob_PI[playerid][factoryCellID];
		FactoryCellInfo[cell_id][cellStatus] = FACTORY_CELL_STATUS_NONE;
		FactoryJob_PI[playerid][factoryLoading] = 0;
		factory_UpdateCellText(cell_id);
	}
	for(new td_id = 0; td_id < sizeof(JobProcessTD); td_id++)
		TextDrawHideForPlayer(playerid, JobProcessTD[td_id]);
	for(new ptd_id = 0; ptd_id < 2; ptd_id++)
		PlayerTextDrawDestroy(playerid, JobProcessPTD[playerid][ptd_id]);
	return DeletePVar(playerid, "jobProcessBarShowed");
}
stock CreateDynamicObjectCP(Float:x, Float:y, Float:z, Float:radius = 5.0, virtualworld = 0, interior = 0) {
	new objectid = CreateDynamicObject(1317,
		x, y, z - 1.9/*94*/, 0.0, 0.0, 0.0, virtualworld, interior, -1, radius
	);
    SetDynamicObjectMaterial(objectid, 0, 18646, "matcolours", "red", 0xAAFF0000);
}
stock IsPlayerFacingCoords(playerid, Float:destx, Float:desty, offset = 0) {
	new Float:px, Float:py, Float:pz, Float:a, Float:a2;
	GetPlayerPos(playerid, px, py, pz);
	GetPlayerFacingAngle(playerid, a);
	a2 = GetAngle(px, py, destx, desty);
	if((a2 + offset) > 360) a2 = 360 - offset;
	if((a2 - offset) < 0) a2 = 0 + offset;
	if(a < (a2 + offset) && a > (a2 - offset)) return 1;
	return 0;
}
IsLoginInvalid(const name[])
{
	if(strfind(name, "none", true) != -1) return true;
	if(strfind(name, "None", true) != -1) return true;
	if(strfind(name, "NONE", true) != -1) return true;
	if(strfind(name, "Server", true) != -1) return true;
	if(strfind(name, "'", true) != -1) return true;
	if(strfind(name, "/", true) != -1) return true;
	if(strfind(name, "%", true) != -1) return true;
	if(strfind(name, ".", true) != -1) return true;
	if(strfind(name, "%", true) != -1) return true;
	if(strfind(name, "&", true) != -1) return true;
	if(strfind(name, "*", true) != -1) return true;
	if(strfind(name, "@", true) != -1) return true;
	if(strfind(name, "(", true) != -1) return true;
	if(strfind(name, ")", true) != -1) return true;
	if(strlen(name) < 3) return true;
	return false;
}
alias:blackscreen("blackscrn", "bs", "black");
CMD:blackscreen(playerid) {
	if(TI[playerid][tTimerBS] != -1) {
		KillTimer(TI[playerid][tTimerBS]);
		printf("[KillTimer 32] TI[playerid][tTimerBS] = '%d' killed",
			TI[playerid][tTimerBS]
		);
		TI[playerid][tTimerBS] = -1;
		TextDrawHideForPlayer(playerid, BlackScreenTD);
		return true;
	}
	TI[playerid][tTimerBS] = SetTimerEx("HideBlackScreenTD", 4000, false, "i", playerid);
	TextDrawShowForPlayer(playerid, BlackScreenTD);

	return true;
}
CB:HideBlackScreenTD(playerid) {
	if(TI[playerid][tTimerBS] == -1) return;
	TextDrawHideForPlayer(playerid, BlackScreenTD);
	TI[playerid][tTimerBS] = -1;
}

alias:pame("mdo", "desc");
CMD:pame(playerid, params[]) {
	if(!isnull(params)) {
		if(PI[playerid][pDescriptionTextID] != INVALID_DYNAMIC_3D_TEXT_ID) {
			DestroyDynamic3DTextLabel(PI[playerid][pDescriptionTextID]);
			PI[playerid][pDescriptionTextID] = INVALID_DYNAMIC_3D_TEXT_ID;
			strmid(PI[playerid][pDescriptionSTR], "0", 0, strlen("0"), 144);
			ErrorMessage(playerid, "Информация о персонаже была удалена, используйте "P"/pame");
			return true;
		}
	}
	new pame_STR[144];
	if(sscanf(params, "s[124]", pame_STR) || strlen(pame_STR) < 4)
		return SendEsp(playerid, "/pame [описание персонажа]");
	if(PI[playerid][pMute] > 0)
		return ErrorMessage(playerid, "У Вас бан чата!");

	#define MAX_PAME_LENGHT (62)

	/*if(strlen(pame_STR) > MAX_PAME_LENGHT * 2) {
		new firstString[MAX_PAME_LENGHT + 20], secondString[MAX_PAME_LENGHT + 20], thirdString[MAX_PAME_LENGHT + 20];

		strmid(firstString, pame_STR, 0, MAX_PAME_LENGHT);
		strmid(secondString, pame_STR, MAX_PAME_LENGHT - 1, MAX_PAME_LENGHT * 2);
		strmid(secondString, pame_STR, (MAX_PAME_LENGHT * 2) - 1, sizeof (pame_STR) - 1);

		format(firstString, MAX_PAME_LENGHT, "%s..", firstString);
		format(secondString, MAX_PAME_LENGHT, "..%s", secondString);
		format(thirdString, MAX_PAME_LENGHT, "..%s", thirdString);

		format(pame_STR, sizeof (pame_STR), "%s\n%s\n%s", firstString, secondString, thirdString);
	}*/
	else if(strlen(pame_STR) > MAX_PAME_LENGHT) {
		new firstString[MAX_PAME_LENGHT + 24], secondString[MAX_PAME_LENGHT + 24];

		strmid(firstString, pame_STR, 0, MAX_PAME_LENGHT);
		strmid(secondString, pame_STR, MAX_PAME_LENGHT - 1, sizeof (pame_STR) - 1);

		format(firstString, sizeof (firstString), "%s..", firstString);
		format(secondString, sizeof (secondString), "..%s", secondString);

		format(pame_STR, sizeof (pame_STR), "%s\n%s", firstString, secondString);
	}
	#undef MAX_PAME_LENGHT
	SetString(PI[playerid][pDescriptionSTR], pame_STR);

	if(PI[playerid][pDescriptionTextID] == INVALID_DYNAMIC_3D_TEXT_ID) {
		PI[playerid][pDescriptionTextID] = CreateDynamic3DTextLabel(PI[playerid][pDescriptionSTR],
			0xA3A3A3FF, 0.0, 0.0, -0.5, 10.0, playerid, INVALID_VEHICLE_ID, 1,
			GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 10.0
		);
		foreach (new i: Player) {
			if(!IsPlayerConnected(i) || PI[i][pDescriptionType] != 0) continue;
			Streamer_ToggleItem(i, STREAMER_TYPE_3D_TEXT_LABEL, PI[playerid][pDescriptionTextID], false);
		}
	}
	else UpdateDynamic3DTextLabelText(PI[playerid][pDescriptionTextID], 0xA3A3A3FF, PI[playerid][pDescriptionSTR]);

	SendOk(playerid, "Данный текст прикреплен к вашему персонажу.");
	SendOk(playerid, "Вы можете скрыть / показать его в любой момент, с помощью повторного ввода "P"/pame");
	ErrorMessage(playerid, "Чтобы просмотреть описание персонажей других игроков, наведитесь с помощью "P"ПКМ"G".");

	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""G"Текущее описание персонажа:\n \n"P"- "W"%s", PI[playerid][pDescriptionSTR]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, ""P"Описание персонажа", STRING_GLOBAL, "Закрыть", ""), STRING_GLOBAL[0] = EOS;

	return true;
}
CB:OnPlayerCheckDescTarget(playerid) {
	new targetid = GetPlayerTargetPlayer(playerid);
	if(targetid != INVALID_PLAYER_ID && PI[targetid][pDescriptionTextID] != INVALID_DYNAMIC_3D_TEXT_ID) {
		PlayerTargetFix[playerid] = gettime() + 2;
		if(PI[playerid][pDescriptionTargetTimer] != -1) {
			KillTimer(PI[playerid][pDescriptionTargetTimer]);
			/*printf("[KillTimer 33] PI[playerid][pDescriptionTargetTimer] = '%d' killed",
				PI[playerid][pDescriptionTargetTimer]
			);*/
		}
		PI[playerid][pDescriptionTargetID] = targetid;
		Streamer_ToggleItem(playerid, STREAMER_TYPE_3D_TEXT_LABEL, PI[targetid][pDescriptionTextID], true);
		Streamer_Update(playerid, STREAMER_TYPE_3D_TEXT_LABEL);
		PI[playerid][pDescriptionTargetTimer] = SetTimerEx("HideDescriptionTimer", 4000, false, "i", playerid);
	}
	PI[playerid][pTargetCheckTimer] = -1;
}
CB:HideDescriptionTimer(playerid) {
	if(!IsPlayerConnected(playerid)) return;
	new targetid = PI[playerid][pDescriptionTargetID];
	PI[playerid][pDescriptionTargetID] = INVALID_PLAYER_ID;
	PI[playerid][pDescriptionTargetTimer] = -1;
	if(!IsPlayerConnected(targetid) || PI[targetid][pDescriptionTextID] == INVALID_DYNAMIC_3D_TEXT_ID) return;
	Streamer_ToggleItem(playerid, STREAMER_TYPE_3D_TEXT_LABEL, PI[targetid][pDescriptionTextID], false);
	Streamer_Update(playerid, STREAMER_TYPE_3D_TEXT_LABEL);
}
OnPlayerUpdateDeathStage(playerid, stage) {
	if(stage) {
		PI[playerid][pStageDeathLastTime] = gettime();
	}
	if(stage) {
		inventory_Hide(playerid);
		if(stage == 1) {
			if(!GetPlayerInterior(playerid))
				SetPlayerChatBubble(playerid, "падает на землю", COLOR_PURPLE, 13.0, 4000);
			else SetPlayerChatBubble(playerid, "падает на пол", COLOR_PURPLE, 13.0, 4000);
			DeletePVar(playerid, "call_wound");
		}

	} else {
		#if defined _damages_included
		damages_Clear(playerid);
		#endif
		PlayerTextDrawSetString(playerid, StageDeathPTD[playerid], " ");
		PlayerTextDrawHide(playerid, StageDeathPTD[playerid]);
	}
	return true;
}
CMD:hospital(playerid) {
	if(PI[playerid][pStageDeath] != 1)
		return ErrorMessage(playerid, "Вы должны находиться в тяжелой стадии ранений!");
	/*if(PI[playerid][pStageDeathTimer]) {
		format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы сможете появиться в больнице через %s.", Convert(PI[playerid][pStageDeathTimer]));
		ErrorMessage(playerid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
		return true;
	}*/
	OnPlayerUpdateDeathStage(playerid, 0);
	PI[playerid][pStageDeath] = 0;
	PI[playerid][pStageDeathTimer] = 0;
	SetPlayerChatBubble(playerid, " ", 0xFF0000FF, 10.0, 100);
	SetPlayerHospital(playerid, false);

	PlayerSpawn(playerid);

	SendOk(playerid, "Вы успешно отправились в ближайший госпиталь");

	return true;
}
stock AttachObjectToObjectEx(attachoid, Float:off_x, Float:off_y, Float:off_z, Float:rot_x, Float:rot_y, Float:rot_z, &Float:X, &Float:Y, &Float:Z, &Float:RX, &Float:RY, &Float:RZ, pobject = -1) {
	new Float:sin[3], Float:cos[3], Float:pos[3], Float:rot[3];

	switch(pobject) {
		case -1: { // dynamic object
			GetDynamicObjectPos(attachoid, pos[0], pos[1], pos[2]);
			GetDynamicObjectRot(attachoid, rot[0], rot[1], rot[2]);
		}
		default: { // player object
			GetPlayerObjectPos(pobject, attachoid, pos[0], pos[1], pos[2]);
			GetPlayerObjectRot(pobject, attachoid, rot[0], rot[1], rot[2]);
		}
	}
	AOP_FloatEulerFix(rot[0], rot[1], rot[2]);

	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	pos[0] = pos[0] + off_x * cos[1] * cos[2] - off_x * sin[0] * sin[1] * sin[2] - off_y * cos[0] * sin[2] + off_z * sin[1] * cos[2] + off_z * sin[0] * cos[1] * sin[2];
	pos[1] = pos[1] + off_x * cos[1] * sin[2] + off_x * sin[0] * sin[1] * cos[2] + off_y * cos[0] * cos[2] + off_z * sin[1] * sin[2] - off_z * sin[0] * cos[1] * cos[2];
	pos[2] = pos[2] - off_x * cos[0] * sin[1] + off_y * sin[0] + off_z * cos[0] * cos[1];
	rot[0] = asin(cos[0] * cos[1]); rot[1] = atan2(sin[0], cos[0] * sin[1]) + rot_z; rot[2] = atan2(cos[1] * cos[2] * sin[0] - sin[1] * sin[2], cos[2] * sin[1] - cos[1] * sin[0] * -sin[2]);
	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	rot[0] = asin(cos[0] * sin[1]); rot[1] = atan2(cos[0] * cos[1], sin[0]); rot[2] = atan2(cos[2] * sin[0] * sin[1] - cos[1] * sin[2], cos[1] * cos[2] + sin[0] * sin[1] * sin[2]);
	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	rot[0] = atan2(sin[0], cos[0] * cos[1]) + rot_x; rot[1] = asin(cos[0] * sin[1]); rot[2] = atan2(cos[2] * sin[0] * sin[1] + cos[1] * sin[2], cos[1] * cos[2] - sin[0] * sin[1] * sin[2]);
	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	rot[0] = asin(cos[1] * sin[0]); rot[1] = atan2(sin[1], cos[0] * cos[1]) + rot_y; rot[2] = atan2(cos[0] * sin[2] - cos[2] * sin[0] * sin[1], cos[0] * cos[2] + sin[0] * sin[1] * sin[2]);

	X = pos[0], Y = pos[1], Z = pos[2];
	RX = rot[0], RY = rot[1], RZ = rot[2];
}
stock AttachObjectToPosEx(Float:pos_x, Float:pos_y, Float:pos_z, Float:pos_rx, Float:pos_ry, Float:pos_rz, Float:off_x, Float:off_y, Float:off_z, Float:rot_x, Float:rot_y, Float:rot_z, &Float:X, &Float:Y, &Float:Z, &Float:RX, &Float:RY, &Float:RZ) {
	new Float:sin[3], Float:cos[3];

	AOP_FloatEulerFix(pos_rx, pos_ry, pos_rz);

	cos[0] = floatcos(pos_rx, degrees); cos[1] = floatcos(pos_ry, degrees); cos[2] = floatcos(pos_rz, degrees); sin[0] = floatsin(pos_rx, degrees); sin[1] = floatsin(pos_ry, degrees); sin[2] = floatsin(pos_rz, degrees);
	pos_x = pos_x + off_x * cos[1] * cos[2] - off_x * sin[0] * sin[1] * sin[2] - off_y * cos[0] * sin[2] + off_z * sin[1] * cos[2] + off_z * sin[0] * cos[1] * sin[2];
	pos_y = pos_y + off_x * cos[1] * sin[2] + off_x * sin[0] * sin[1] * cos[2] + off_y * cos[0] * cos[2] + off_z * sin[1] * sin[2] - off_z * sin[0] * cos[1] * cos[2];
	pos_z = pos_z - off_x * cos[0] * sin[1] + off_y * sin[0] + off_z * cos[0] * cos[1];
	pos_rx = asin(cos[0] * cos[1]); pos_ry = atan2(sin[0], cos[0] * sin[1]) + rot_z; pos_rz = atan2(cos[1] * cos[2] * sin[0] - sin[1] * sin[2], cos[2] * sin[1] - cos[1] * sin[0] * -sin[2]);
	cos[0] = floatcos(pos_rx, degrees); cos[1] = floatcos(pos_ry, degrees); cos[2] = floatcos(pos_rz, degrees); sin[0] = floatsin(pos_rx, degrees); sin[1] = floatsin(pos_ry, degrees); sin[2] = floatsin(pos_rz, degrees);
	pos_rx = asin(cos[0] * sin[1]); pos_ry = atan2(cos[0] * cos[1], sin[0]); pos_rz = atan2(cos[2] * sin[0] * sin[1] - cos[1] * sin[2], cos[1] * cos[2] + sin[0] * sin[1] * sin[2]);
	cos[0] = floatcos(pos_rx, degrees); cos[1] = floatcos(pos_ry, degrees); cos[2] = floatcos(pos_rz, degrees); sin[0] = floatsin(pos_rx, degrees); sin[1] = floatsin(pos_ry, degrees); sin[2] = floatsin(pos_rz, degrees);
	pos_rx = atan2(sin[0], cos[0] * cos[1]) + rot_x; pos_ry = asin(cos[0] * sin[1]); pos_rz = atan2(cos[2] * sin[0] * sin[1] + cos[1] * sin[2], cos[1] * cos[2] - sin[0] * sin[1] * sin[2]);
	cos[0] = floatcos(pos_rx, degrees); cos[1] = floatcos(pos_ry, degrees); cos[2] = floatcos(pos_rz, degrees); sin[0] = floatsin(pos_rx, degrees); sin[1] = floatsin(pos_ry, degrees); sin[2] = floatsin(pos_rz, degrees);
	pos_rx = asin(cos[1] * sin[0]); pos_ry = atan2(sin[1], cos[0] * cos[1]) + rot_y; pos_rz = atan2(cos[0] * sin[2] - cos[2] * sin[0] * sin[1], cos[0] * cos[2] + sin[0] * sin[1] * sin[2]);

	X = pos_x, Y = pos_y, Z = pos_z;
	RX = pos_rx, RY = pos_ry, RZ = pos_rz;
}
stock AOP_FloatEulerFix(&Float:rot_x, &Float:rot_y, &Float:rot_z) {
	AOP_FloatGetRemainder(rot_x, rot_y, rot_z);
	if(
		(!floatcmp(rot_x, 0.0) || !floatcmp(rot_x, 360.0)) &&
		(!floatcmp(rot_y, 0.0) || !floatcmp(rot_y, 360.0))
	) rot_y = 0.00000002;

	return true;
}
stock AOP_FloatGetRemainder(&Float:rot_x, &Float:rot_y, &Float:rot_z) {
	AOP_FloatRemainder(rot_x, 360.0);
	AOP_FloatRemainder(rot_y, 360.0);
	AOP_FloatRemainder(rot_z, 360.0);

	return true;
}
stock AOP_FloatRemainder(&Float:remainder, Float:value) {
	if(remainder >= value) {
		while (remainder >= value) {
			remainder = remainder - value;
		}
	}
	else if(remainder < 0.0) {
		while (remainder < 0.0) {
			remainder = remainder + value;
		}
	}
	return true;
}
stock anticheat_SendCP(const text[]) {
	strdel(ServerSettings[serverBufferCP], 0, (strfind(ServerSettings[serverBufferCP], "~n~", true) + 3));
	strcat(ServerSettings[serverBufferCP], "~n~"), strcat(ServerSettings[serverBufferCP], text);

	COMMAND_GLOBAL[0] = EOS;
	for(new lineid = 0, n_symbolid[MAX_CHEAT_PANEL_LINE]; lineid < MAX_CHEAT_PANEL_LINE; lineid++) {
		for(new idx = 0, i = 2; i != strlen(ServerSettings[serverBufferCP]); i++) {
			if(
				(ServerSettings[serverBufferCP][i - 0] == '~') &&
				(ServerSettings[serverBufferCP][i - 1] == 'n') &&
				(ServerSettings[serverBufferCP][i - 2] == '~') &&
				(++idx) < sizeof (n_symbolid)
			) n_symbolid[idx] = i;
		}
		if(0 == lineid)
			strmid(COMMAND_GLOBAL, ServerSettings[serverBufferCP], 0, (n_symbolid[1] - 2));
		else if((sizeof (n_symbolid) - 1) == lineid) {
			strmid(COMMAND_GLOBAL, ServerSettings[serverBufferCP], (n_symbolid[lineid] + 1), strlen(ServerSettings[serverBufferCP]));
			format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), "~>~ %s", COMMAND_GLOBAL);
		}
		else strmid(COMMAND_GLOBAL, ServerSettings[serverBufferCP], (n_symbolid[lineid] + 1), (n_symbolid[lineid + 1] - 2));

		TextDrawSetString(AdminCP_TD[lineid], COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
	}
	return true;
}
stock anticheat_ClearCP() {
	strmid(ServerSettings[serverBufferCP], "_~n~_~n~_~n~_~n~_~n~_~n~_~n~_~n~_~n~_",  0, strlen("_~n~_~n~_~n~_~n~_~n~_~n~_~n~_~n~_~n~_"), sizeof (ServerSettings[serverBufferCP]));
}
CMD:attach(playerid) {
	if(!(1 <= PI[playerid][pMember] <= fFBI || (fBCPD <= PI[playerid][pMember] <= fRCPD)))
		return ErrorMessage(playerid, "Данная команда не доступна для вас!");
	/*if(!start_work[playerid])
		return ErrorMessage(playerid, "Вам необходимо начать рабочий день.");*/
	ShowPoliceAttachMenu(playerid);
	return true;
}
stock ApplyPoliceAttach(playerid, attachid) {
	new type = PoliceAttachObjectInfo[attachid][attachType], id = 9 * type;
	SetPlayerAttachedObject(playerid, PoliceAttachObjectInfo[attachid][attachAttachSlot],
		PoliceAttachObjectInfo[attachid][attachModel], PoliceAttachObjectInfo[attachid][attachBone],
		TI[playerid][tPoliceAttachPos][0 + id], TI[playerid][tPoliceAttachPos][1 + id], TI[playerid][tPoliceAttachPos][2 + id],
		TI[playerid][tPoliceAttachPos][3 + id], TI[playerid][tPoliceAttachPos][4 + id], TI[playerid][tPoliceAttachPos][5 + id],
		TI[playerid][tPoliceAttachPos][6 + id], TI[playerid][tPoliceAttachPos][7 + id], TI[playerid][tPoliceAttachPos][8 + id]
	);
}
stock StopEditPoliceAttach(playerid, showMessage = 1) {
	if(!TI[playerid][tPoliceAttachEditID]) return false;
	new attachid = (TI[playerid][tPoliceAttachEditID] - 1);

	TI[playerid][tPoliceAttachEditID] = 0;
	ApplyPoliceAttach(playerid, attachid);

	if(showMessage)
		ErrorMessage(playerid, "Вы отменили редактирование снаряжения.");
	return true;
}
stock ClearPoliceAttach(playerid) {
	new idx = 0;
	for(new i = ATTACH_TYPE_HEAD, attachid; i <= ATTACH_TYPE_BODY; i++) {
		attachid = TI[playerid][tPoliceAttachID][i];
		if(attachid == -1)
			continue;
		RemovePlayerAttachedObject(playerid, PoliceAttachObjectInfo[attachid][attachAttachSlot]);
		TI[playerid][tPoliceAttachID][i] = -1;
		idx++;
	}
	return idx;
}
stock ShowPoliceAttachMenu(playerid, menuid = 1) {
	switch(menuid) {
		case 1: {
			STRING_GLOBAL[0] = EOS;
			for(new i = 0, attach_type; i < sizeof (PoliceAttachObjectInfo); i++) {
				attach_type = PoliceAttachObjectInfo[i][attachType];
				format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s %s\n",
					i + 1, PoliceAttachObjectInfo[i][attachName],
					(TI[playerid][tPoliceAttachID][attach_type] == i) ? ("{6B8E23}[управление]") : (""G"[надеть]")
				);
				strcat(STRING_GLOBAL, COMMAND_GLOBAL);
			}
			strcat(STRING_GLOBAL, ""P"- "G"Снять всё снаряжение");

			ShowPlayerDialog(playerid, D_POLICE_ATTACH_LIST, DIALOG_STYLE_LIST, ""P"Полицейское снаряжение", STRING_GLOBAL, "Выбрать", "Отмена"), STRING_GLOBAL[0] = EOS;
		}
		case 2: {
			ShowPlayerDialog(playerid, D_POLICE_ATTACH_MENU, DIALOG_STYLE_LIST, ""P"Полицейское снаряжение", "\
				"P"1. "W"Снять снаряжение\n\
				"P"2. "W"Изменить положение",
				!"Выбрать", "Назад"
			);
		}
	}
	return true;
}

stock ShowAnimlistMenu(playerid, category = 0) {
	STRING_GLOBAL[0] = EOS;

	switch(category) {
		case 0: {
			new amount[ANIM_TYPE_SIZEOF];
			for(new i = 0, type; i < sizeof (animationList); i++) {
				type = animationList[i][anim_type];
				amount[type]++;
			}
			format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
				"P"1. "W"Танцы "G"[%i шт.]\n\
				"P"2. "W"Сесть "G"[%i шт.]\n\
				"P"3. "W"Лечь "G"[%i шт.]\n\
				"P"4. "W"Жесты "G"[%i шт.]\n\
				"P"5. "W"Разговор "G"[%i шт.]\n\
				"P"6. "W"Приветствие "G"[%i шт.]\n\
				"P"7. "W"Стоять "G"[%i шт.]\n\
				"P"8. "W"Плохое состояние "G"[%i шт.]\n\
				"P"9. "W"Походки "G"[%i шт.]\n\
				"P"10. "W"Читать рэп "G"[%i шт.]\n\
				"P"11. "W"Поцеловать "G"[%i шт.]\n\
				"P"12. "W"Эмоции "G"[%i шт.]\n\
				"P"13. "W"Курить "G"[%i шт.]\n\
				"P"14. "W"Диллер "G"[%i шт.]\n\
				"P"15. "W"Другое "G"[%i шт.]",
				amount[ANIM_TYPE_DANCE],
				amount[ANIM_TYPE_SIT],
				amount[ANIM_TYPE_LIE],
				amount[ANIM_TYPE_GESTURES],
				amount[ANIM_TYPE_TALK],
				amount[ANIM_TYPE_HI],
				amount[ANIM_TYPE_STAND],
				amount[ANIM_TYPE_BAD_CONDITION],
				amount[ANIM_TYPE_WALK],
				amount[ANIM_TYPE_RAP],
				amount[ANIM_TYPE_KISS],
				amount[ANIM_TYPE_EMOJI],
				amount[ANIM_TYPE_SMOKE],
				amount[ANIM_TYPE_DEALER],
				amount[ANIM_TYPE_OTHER]
			);
			ShowPlayerDialog(playerid, D_ANIMLIST_CATEGORY, DIALOG_STYLE_LIST, ""P"Выберите категорию анимаций", STRING_GLOBAL, "Выбрать", "Отмена");
		}
		default: {
			for(new i = 0, idx = 0; i < sizeof (animationList); i++) {
				if(animationList[i][anim_type] != category)
					continue;
				format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "%s\
					"P"%i. "W"%s "G"[ID: %i]\n", STRING_GLOBAL, idx + 1, animationList[i][anim_text], i + 1
				);
				playerListitemID[playerid][idx++] = i;
			}
			ShowPlayerDialog(playerid, D_ANIMLIST_SELECT, DIALOG_STYLE_LIST, ""P"Выберите анимацию", STRING_GLOBAL, "Выбрать", "Назад");
		}
	}
	STRING_GLOBAL[0] = EOS;

	return true;
}
stock ApplyAnimlistID(playerid, anim_id) {
	if(!(0 <= anim_id < sizeof (animationList)))
		return false;

	switch(animationList[anim_id][anim_time]) {
		case 101: SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DANCE1);
		case 102: SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DANCE4);
		default: {
			GoAnim(playerid,
				animationList[anim_id][anim_lib], animationList[anim_id][anim_name],
				animationList[anim_id][anim_fDelta], animationList[anim_id][anim_loop],
				animationList[anim_id][anim_lockx], animationList[anim_id][anim_locky],
				animationList[anim_id][anim_Freeze], animationList[anim_id][anim_time], 1
			);
		}
	}
	SetPVarInt(playerid, "Animation", 2);
	TextDrawShowForPlayer(playerid, AnimDraw);

	return true;
}
