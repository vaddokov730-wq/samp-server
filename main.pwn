public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float: x, Float: y, Float: z) {
	if(IsValidDynamicObject(objectid) && ShootingStart[playerid] == 1) {
		switch(Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_MODEL_ID)) {
			case 2699: {
				if(IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -26.7718, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -25.3172, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -23.8203, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -22.3058, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -20.8235, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -19.3367, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -17.8579, 1001.1633) || IsPlayerInRangeOfPoint(playerid, 2.0, 256.7452, -16.2935, 1001.1633)) {
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -26.7718, 1001.1633) && objectid != ShootingObject[0]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -25.3172, 1001.1633) && objectid != ShootingObject[1]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -23.8203, 1001.1633) && objectid != ShootingObject[2]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -22.3058, 1001.1633) && objectid != ShootingObject[3]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -20.8235, 1001.1633) && objectid != ShootingObject[4]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -19.3367, 1001.1633) && objectid != ShootingObject[5]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -17.8579, 1001.1633) && objectid != ShootingObject[6]) return 0x1;
					if(IsPlayerInRangeOfPoint(playerid, 1.2, 256.7452, -16.2935, 1001.1633) && objectid != ShootingObject[7]) return 0x1;

					new skills = 1;
					switch(weaponid) {
						case 23: {
							if(PI[playerid][pGunSkill][0] < 100) {
								PI[playerid][pGunSkillCount][0]++;
								if(PI[playerid][pGunSkillCount][0] == 10) {
									PI[playerid][pGunSkill][0] += skills;
									if(PI[playerid][pGunSkill][0] > 100) PI[playerid][pGunSkill][0] = 100;
									PI[playerid][pGunSkillCount][0] = 0;
									SetPlayerSkills(playerid);
									texdraw_skill(playerid, 0);
								}
							}
						}
						case 24: {
							if(PI[playerid][pGunSkill][1] < 100) {
								PI[playerid][pGunSkillCount][1]++;
								if(PI[playerid][pGunSkillCount][1] == 7) {
									PI[playerid][pGunSkill][1] += skills;
									if(PI[playerid][pGunSkill][1] > 100) PI[playerid][pGunSkill][1] = 100;
									PI[playerid][pGunSkillCount][1] = 0;
									SetPlayerSkills(playerid);
									texdraw_skill(playerid, 1);
								}
							}
						}
						case 25: {
							if(PI[playerid][pGunSkill][2] < 100) {
								PI[playerid][pGunSkillCount][2]++;
								if(PI[playerid][pGunSkillCount][2] == 7) {
									PI[playerid][pGunSkill][2] += skills;
									if(PI[playerid][pGunSkill][2] > 100) PI[playerid][pGunSkill][2] = 100;
									PI[playerid][pGunSkillCount][2] = 0;
									SetPlayerSkills(playerid);
									texdraw_skill(playerid, 2);
								}
							}
						}
						case 29: {
							if(PI[playerid][pGunSkill][3] < 100) {
								PI[playerid][pGunSkillCount][3]++;
								if(PI[playerid][pGunSkillCount][3] == 15) {
									PI[playerid][pGunSkill][3] += skills;
									if(PI[playerid][pGunSkill][3] > 100) PI[playerid][pGunSkill][3] = 100;
									PI[playerid][pGunSkillCount][3] = 0;
									SetPlayerSkills(playerid);
									texdraw_skill(playerid, 3);
								}
							}
						}
						case 30: {
							if(PI[playerid][pGunSkill][4] < 100) {
								PI[playerid][pGunSkillCount][4]++;
								if(PI[playerid][pGunSkillCount][4] == 15) {
									PI[playerid][pGunSkill][4] += skills;
									if(PI[playerid][pGunSkill][4] > 100) PI[playerid][pGunSkill][4] = 100;
									PI[playerid][pGunSkillCount][4] = 0;
									SetPlayerSkills(playerid);
									texdraw_skill(playerid, 4);
								}
							}
						}
						case 31: {
							if(PI[playerid][pGunSkill][5] < 100) {
								PI[playerid][pGunSkillCount][5]++;
								if(PI[playerid][pGunSkillCount][5] == 15) {
									PI[playerid][pGunSkill][5] += skills;
									if(PI[playerid][pGunSkill][5] > 100) PI[playerid][pGunSkill][5] = 100;
									PI[playerid][pGunSkillCount][5] = 0;
									SetPlayerSkills(playerid);
									texdraw_skill(playerid, 5);
								}
							}
						}
					}
				}
			}
		}
	}
	return true;
}

stock ghetto_info(playerid)
{
	new graff[5];
	for(new i; i < CountGraffity; i++)
	{
		if(GrafInfo[i][gFrak] == fBALLAS) graff[0]++;
		if(GrafInfo[i][gFrak] == fVAGOS) graff[1]++;
		if(GrafInfo[i][gFrak] == fGROVE) graff[2]++;
		if(GrafInfo[i][gFrak] == fAZTEC) graff[3]++;
		if(GrafInfo[i][gFrak] == fRIFA) graff[4]++;
	}

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\t\t{8813E7}Ballas"W"\n\
			  Граффити: {8813E7}%d/120"W"\n\n\
			  \t\t{DBD604}Vagos"W"\n\
			  Граффити: {8813E7}%d/120"W"\n\n\
			  \t\t{009F00}Grove"W"\n\
			  Граффити: {8813E7}%d/120"W"\n\n\
			  \t\t{01FCFF}Aztecas"W"\n\
			  Граффити: {8813E7}%d/120"W"\n\n\
			  \t\t{83BFBF}Rifa"W"\n\
			  Граффити: {8813E7}%d/120"W"", graff[0], graff[1], graff[2], graff[3], graff[4]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Информация", STRING_GLOBAL, "Закрыть", "");
}
stock leave_robhouse(playerid)
{
	if(rob_veh[playerid] != INVALID_VEHICLE_ID)
	{
		A_DestroyVehicle(rob_veh[playerid]);
		rob_veh[playerid] = INVALID_VEHICLE_ID;
	}
	if(IsValidDynamicPickup(RobPlayer[playerid][RobPickup]))
	{
		DestroyDynamicPickup(RobPlayer[playerid][RobPickup]);
		DestroyDynamicArea(RobPlayer[playerid][RobArea]);
		DestroyDynamic3DTextLabel(RobPlayer[playerid][RobText]);
	}
}
