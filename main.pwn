stock IsValid3DTextLabel(Text3D: textid)
{
	if(textid != Text3D: INVALID_3DTEXT_ID) return true;
	else return false;
}
stock DestroyDynamic3DTextLabelEx(&Text3D: text)
{
	DestroyDynamic3DTextLabel(text);
	text = Text3D:    INVALID_3DTEXT_ID;
}
CB:GunReady(playerid)
{
	for(new id = 0; id < 24; id++)
	{
		if(!IsPlayerInDynamicCP(playerid, gun_pickup[id]) && GetPVarInt(playerid, "loadid") == id)
		{
			GameTextForPlayer(  playerid, ("~r~FAILED"), 5000, 1);
			TI[playerid][tJobGun][2] = 0;
			if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_1);
			ClearAnimations(playerid);
			TI[playerid][tJobGun][1] = 1;
			return true;
		}
	}

	if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_2)) RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2);
	TI[playerid][tJobGun][2] = 1;
	ClearAnimations(playerid);
	ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);
	if(!IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_2)) SetPlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2, 2358, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0);
	SendOk(playerid, "Оружие собрано. Отнесите его на склад");
	EnableGPSForPlayer(playerid, 2731.9482, -2398.6021, 13.6328);
	return true;
}
CB:clothes_timer(playerid)
{
	new objectid = PlayerObjectFix[playerid];
	PlayerObjectFix[playerid] = 0;
	if(!IsPlayerInDynamicArea(playerid, gAreas[arClothes][GetPVarInt(playerid, "clothes_id")]))
	{
		GameTextForPlayer(playerid, ("~r~FAILED"), 5000, 1);
		if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_2)) RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2);
		ClearAnimations(playerid);
		TI[playerid][tClothesWork][1] = 1;
		DestroyDynamicObject(objectid);
		return true;
	}
	DestroyDynamicObject(objectid);
	if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_2)) RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2);
	TI[playerid][tClothesWork][1] = 3;
	ClearAnimations(playerid);
	ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);
	if(!IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_2)) SetPlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2, 2386, 5,  0.100000, 0.100000, 0.200000,  100.000000, 170.0, 100.000000,  1.000000, 1.000000, 1.000000);
	SendOk(playerid, "Одежда сшита. Отнесите ее на склад");
	new rand = random(10);
	if(rand == 5)
	{
		TI[playerid][tAlcotraz][1] = 1;
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Побег", ""W"Мысли...\n\nТак-так, маникен, возьму-ка я его себе..\nНадо подумать, куда его можно подложить..\nГлавное не спалиться..", "Закрыть", "");
	}
	return true;
}

