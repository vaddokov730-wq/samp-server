	case D_HOSPITAL_MENU: {
		if(!response)
			return true;
		switch(listitem + 1) {
			case 1: { // Что это за место?
				ShowPlayerDialog(playerid, D_HOSPITAL_MENU_BACK, DIALOG_STYLE_MSGBOX, ""P"Что это за место?", "\
					"W"Больниица — вид гражданского стационарного медицинского учреждения, \n\
					направленного на лечение больных и/или специализированную углубленную \n\
					дифференциальную диагностику заболеваний в стационарных условиях.",
					"Назад", ""
				);
			}
			case 2: { // Информация о болезнях
				ShowPlayerDialog(playerid, D_HOSPITAL_MENU_BACK, DIALOG_STYLE_MSGBOX, ""P"Информация о болезнях", "\
					"W"На территории штата действует особый вид гриппа, он распространяется в определенных, \n\
					благоприятных условиях и передаётся воздушно-капельным путём. Вы можете узнать о местах \n\
					распространения гриппа в больницах штата. Болезнь передаётся от какого-либо физического контакта. \n \n\
					Анорексия, в свою очередь, развивается в условиях постоянной нехватки пищи. Человек достаточно \n\
					быстро теряет вес, как и силы. Состояние здоровья постоянно уменьшается и может привести к \n\
					необратимым последствиям. Для излечения анорексии необходимо пройти медикаментозное лечение, \n\
					а также активно питаться.\n \n\
					В любой региональной больнице вам может быть оказана необходимая медицинская помощь.",
					"Назад", ""
				);

			}
			case 3: { // Сотрудники на
				new idx = 1;
				COMMAND_GLOBAL[0] = EOS;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""P"Сотрудники на смене:\n \n");

				foreach(new i: Player) {
					if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i))
						continue;
					if(!IsAMedic(i) || !start_work[i])
						continue;
					format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "\
						"P"%i. "W"%s "G"(ID: %i) "W"- %s "G"(%i)\n", idx++,
						player_name[i], i,
						GetRankName(PI[i][pMember], PI[i][pRank]), PI[i][pRank]
					);
					strcat(STRING_GLOBAL, COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
				}
				format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), " \n"W"Всего на смене сотрудников: "P"%i", idx - 1);
				strcat(STRING_GLOBAL, COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;

				ShowPlayerDialog(playerid, D_HOSPITAL_MENU_BACK, DIALOG_STYLE_MSGBOX, ""P"Сотрудники на смене", STRING_GLOBAL, "Назад", "");
				STRING_GLOBAL[0] = COMMAND_GLOBAL[0] = EOS;
			}
			case 4: { // Получение мед. карты
				if(PI[playerid][pMedCard]) {
					ErrorMessage(playerid, "У Вас уже есть мед. карта");
					return true;
				}
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
					"W"Стоимость медицинмской карты - "GREEN"$200\n"W"Вы действительно хотите получить мед. карту?", 200
				);
				ShowPlayerDialog(playerid, D_MEDCARD, DIALOG_STYLE_MSGBOX, ""P"Медицинская карта", STRING_GLOBAL, "Да", "Назад"), STRING_GLOBAL[0] = EOS;
			}
			case 5: { // Покупка аптечек
				ShowPlayerDialog(playerid, D_HOSPITAL_MENU_MEDKIT, DIALOG_STYLE_INPUT, ""P"Покупка аптечек", "\
					"W"Введите количество аптечек, которое хотите купить (максимум 10 шт.):\n \n\
					"W"Стоимость одной аптечки: "GREEN"$150",
					"Купить", "Назад"
				);
			}
		}
		return true;
	}
	case D_HOSPITAL_MENU_MEDKIT: {
		if(!response) {
