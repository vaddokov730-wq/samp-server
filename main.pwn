		case 1: ShowPlayerDialog(playerid, D_MP_1, DSI, ""P"Выдача оружия", "\n\n"W"Введите "P"ID"W" оружия и патроны\nПример: 31,500\nГде 31 M4, а 500 патроны\n\n", "Выдать", "Выход");
