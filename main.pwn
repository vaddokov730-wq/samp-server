			format(id_str_set_gun, sizeof(id_str_set_gun), ""P"%d."W" Бронежилет\n", i + 1);
			strcat(STRING_GLOBAL, id_str_set_gun);
			continue;
		}
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"P"%d."W" %s\t%d\n", STRING_GLOBAL, i + 1, FW[i][team][fwName], FW[i][team][fwGunAmmo]);
	}*/
	ShowPlayerDialog(playerid, D_GETGUN_MENU, DIALOG_STYLE_LIST, ""P"Склад организации", STRING_GLOBAL, "Выбрать", "Отмена");
	return true;
}
