stock Float:GetDefaultWeaponDamage(weaponid) {
	new Float:amount = 2.0;
	switch(weaponid) {
		case WEAPON_COLT45: amount = 25 * 0.33; //8.25
		case WEAPON_SILENCED: amount = 40 * 0.33; //13.200012
		case WEAPON_DEAGLE: amount = 140 * 0.33; //46.200013
		case WEAPON_SHOTGUN: amount = 10 * 0.33; //30.0 (probably because of pellets)
		case WEAPON_SAWEDOFF: amount = 10 * 0.33; //30.0 (probably because of pellets)
		case WEAPON_SHOTGSPA: amount = 15 * 0.33; //30.0 (probably because of pellets)
		case WEAPON_UZI: amount = 20 * 0.33; //6.599976
		case WEAPON_TEC9: amount = 20 * 0.33; //6.599976
		case WEAPON_MP5: amount = 25 * 0.33; //8.25
		case WEAPON_AK47: amount = 30 * 0.33; //9.900024
		case WEAPON_M4: amount = 30 * 0.33; //9.900024
		case WEAPON_RIFLE: amount = 75 * 0.33; //24.799987
		case WEAPON_SNIPER: amount = 125 * 0.33; //41.299987
		case WEAPON_MINIGUN: amount = 140 * 0.33; //46.200013
	}
	return amount;
}
public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float: fX, Float: fY, Float: fZ) {
	/*format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[debug] OnPlayerWeaponShot(%d, weaponid=%d, hittype=%d, hitid=%d, x=%.1f, y=%.1f, z=%.1f",
		playerid, weaponid, hittype, hitid, fX, fY, fZ
	);
	SendClientMessageToAll(-1, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;*/
	printf("OnPlayerWeaponShot 1");
	if(hittype > 4)
		return 0;
	if(
		(hittype == BULLET_HIT_TYPE_PLAYER && ! IsPlayerConnected(hitid)) ||
		(hittype == BULLET_HIT_TYPE_VEHICLE && !IsValidVehicle(hitid)) ||
		(hittype == BULLET_HIT_TYPE_OBJECT && !IsValidVehicle(hitid)) ||
		(hittype == BULLET_HIT_TYPE_PLAYER_OBJECT && !IsValidPlayerObject(playerid, hitid))
	) return 0;

	new bool:checkWeaponInventory = true, Float:armour;

	if(
		TI[playerid][tDMArea][0] || 
		TI[playerid][tGunArea][0] ||
		TI[playerid][tDuel] != -1 || 
		player_to_game[playerid] || 
		player_to_golod[playerid]) {
		checkWeaponInventory = false;
	}
	if(checkWeaponInventory) {
		if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID) {
			if(PI[hitid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]) {
				GetPlayerArmour(hitid, armour);

				if(armour > PI[hitid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR])
					armour = PI[hitid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR];
				
				new Float:amount = GetDefaultWeaponDamage(weaponid);

				PI[hitid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] = floatround(armour)-floatround(amount);
				if(PI[hitid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] <= 0) {
					PI[hitid][pItemsID][INVENTORY_SLOT_ID_ARMOUR] = 0;
					PI[hitid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] = 0;
					SetPlayerArmour(hitid, 0);
				}
			}
		}
		switch(weaponid) {
			case 22 .. 34: {
				if(
					weaponid != GetWeaponidByModel(InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_WEAPON_1]][itemModelID]) &&
					weaponid != GetWeaponidByModel(InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_WEAPON_2]][itemModelID])
				) {
					inventory_UpdateWeapons(playerid);
					return 0;
				} 
			}
		}
		new
			slot_id = INVENTORY_SLOT_ID_WEAPON_1,
			slot_ammo = INVENTORY_SLOT_ID_AMMO_1,
			item_id = PI[playerid][pItemsID][slot_id],
			weapon_id = GetWeaponidByModel(InventoryItemInfo[item_id][itemModelID]);

		if(weaponid && weaponid == weapon_id) {
			new item_ammo = PI[playerid][pItemsID][slot_ammo];
			if(item_ammo) {
				PI[playerid][pItemsAmount][slot_ammo]--;
				if(
					PI[playerid][pItemsID][slot_ammo] != 0 &&
					PI[playerid][pItemsAmount][slot_ammo] <= 0
				) {
					PI[playerid][pItemsID][slot_ammo] = 0;
					PI[playerid][pItemsAmount][slot_ammo] = 0;
					AC_SetPlayerAmmo(playerid, weapon_id, 0);
					inventory_UpdateWeapons(playerid);
				}
			}
		}
		slot_id = INVENTORY_SLOT_ID_WEAPON_2;
		slot_ammo = INVENTORY_SLOT_ID_AMMO_2;
		item_id = PI[playerid][pItemsID][slot_id];
		weapon_id = GetWeaponidByModel(InventoryItemInfo[item_id][itemModelID]);

		if(weaponid && weaponid == weapon_id) {
			new item_ammo = PI[playerid][pItemsID][slot_ammo];
			if(item_ammo) {
				PI[playerid][pItemsAmount][slot_ammo]--;
				if(
					PI[playerid][pItemsID][slot_ammo] != 0 &&
					PI[playerid][pItemsAmount][slot_ammo] <= 0
				) {
					PI[playerid][pItemsID][slot_ammo] = 0;
					PI[playerid][pItemsAmount][slot_ammo] = 0;
					AC_SetPlayerAmmo(playerid, weapon_id, 0);
					inventory_UpdateWeapons(playerid);
				}
			}
		}
	}
	/*if(AnticheatToggle[1] && PlayerSpawnTime[playerid] <= 0) {
		if(hittype == BULLET_HIT_TYPE_PLAYER && weaponid >= 22 && weaponid <= 34) {
		    new Float:HitPosX, Float:HitPosY, Float:HitPosZ, Float:Temp;
		    GetPlayerLastShotVectors(playerid, Temp, Temp, Temp, HitPosX, HitPosY, HitPosZ);
		    new damager_angle_max = 11;

		    if(weaponid == 28 || weaponid == 32) damager_angle_max += 5;
		    if(
		    	!IsPlayerInRangeOfPoint(playerid, 3.0, HitPosX, HitPosY, HitPosZ) &&
		    	!IsPlayerFacingCoords(playerid, HitPosX, HitPosY, damager_angle_max)
		    ) {

		    	if(++AnticheatDetectCount[playerid][0] > 3) {
		    		AnticheatDetectCount[playerid][0] = 0;
					ErrorMessage(playerid, "Вы были кикнуты по ошибке #352! Обратитесь к администрации");
					Kick(playerid);
		    	}

				return 0;
		    }
		}
		else AnticheatDetectCount[playerid][0] = 0;
	}*/
	if(0 <= weaponid <= 46 && hitid != 0xFFFF && hittype == BULLET_HIT_TYPE_PLAYER) {
		if(TI[playerid][tAFK] >= 3 || PI[playerid][pJailTime]) return 0;
	}
	static
		Float: fOriginX,  Float: fOriginY, Float: fOriginZ,
		Float: fHitPosX, Float: fHitPosY, Float: fHitPosZ;

	GetPlayerLastShotVectors(playerid, fOriginX, fOriginY, fOriginZ, fHitPosX, fHitPosY, fHitPosZ);

	if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != 0xFFFF) {
		/*if(0 <= weaponid <= 46 && hitid != INVALID_PLAYER_ID)
		{
			if(TI[hitid][tAFK] >= 3 || PI[hitid][pJailTime] || player_gm{hitid})
				return false;
			
			if(weaponid != 43 && weaponid != 9 && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DRINK_SPRUNK && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DRINK_WINE && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_SMOKE_CIGGY && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DRINK_BEER)
			{
				if(!IsACop(playerid) && !IsAArm(playerid) && PI[playerid][pMember] != fWHITEHOUSE && IsAGreenZone(playerid))
				{
					return false;
				}
				if(IsPlayerInRangeOfPoint(hitid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1) {
					return 0x0;
				}
				if(anti_tk)
				{
					if(PI[playerid][pMember] == PI[hitid][pMember] && FI[PI[hitid][pMember]][fAntiTK] && TI[hitid][tDuel] == -1 && TI[playerid][tDuel] == -1 && player_to_game[playerid] == 0 && player_to_golod[playerid] == 0 && TI[playerid][tGunArea][0] == 0 && TI[playerid][tDMArea][0] == 0)
					{
						return false;
					}
				}
			}
		}*/

		new
			string[90],
			Float: PosIgnore,
			Float: PosPlayerZ;

		GetPlayerPos(playerid, PosIgnore, PosIgnore, PosPlayerZ);

		if(fOriginZ == fHitPosZ) {
			if(PlayerWarningTimeSilent[playerid][0] < gettime()) {
				format(string, sizeof(string), "<< Warning >> %s[%d]: подозрение на Silent Aim", player_name[playerid], playerid);
				SendAdminMessage(0xFF0000FF, string);
				PlayerWarningTimeSilent[playerid][0] = gettime() + 5;
				return 0;
			}
		}

		new Float:ReasonCheat = floatsub(PosPlayerZ, fHitPosZ);
		if(floatabs(ReasonCheat) < 0.03) {
			if(++PlayerWarningSilent[playerid] >= 3) {
				if(PlayerWarningTimeSilent[playerid][1] < gettime()) {
					format(string, sizeof(string), "<< Warning >> %s[%d]: подозрение на Silent Aim v12+", player_name[playerid], playerid);
					SendAdminMessage(0xFF0000FF, string);
					PlayerWarningTimeSilent[playerid][1] = gettime() + 5;
					return 0;
				}
			}
		}
		else PlayerWarningSilent[playerid] = 0;
	}
	if(ServerSettings[serverBetaTest]) {
		if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID && GetPVarInt(hitid, "godmode")) {
			SetPlayerHealth(hitid, Float:0x7F800000);
			return 0;
		}
	}
	if(hittype == BULLET_HIT_TYPE_PLAYER && IsPlayerConnected(hitid) && weaponid == 3 || (TI[playerid][tTazers][0] > 0 && weaponid == TI[playerid][tTazers][1]))
	{
		if(!TI[hitid][tTazer] && IsACop(playerid))
		{
			if(TI[playerid][tTazers][0] > 0 && weaponid != 3)
			{
				TI[playerid][tTazers][0]--;
				if(TI[playerid][tTazers][0] == 0)
				{
					ErrorMessage(playerid, "Парализующие боеприпасы закончены. Следующая зарядка через 2 минуты");
					PlayerTazerFix[hitid] = unix + (60 * 2);
					TI[playerid][tTazers][0] = 0;
					TI[playerid][tTazers][1] = 0;
				}
			}
			switch(GetPlayerAnimationIndex(playerid))
			{
			case 17: PlayerUnTazerFix[hitid] = 5;
			case 18: PlayerUnTazerFix[hitid] = 10;
			case 19: PlayerUnTazerFix[hitid] = 15;
			default: PlayerUnTazerFix[hitid] = 10;
			}
			SendClientMessage(playerid, COLOR_GREY, "Нажмите "P"N"G" около игрока чтобы сковать его");
			TI[hitid][tTazers][2] = playerid;
			TI[playerid][tTazers][2] = hitid;
			TI[hitid][tTazer] = true;
			TogglePlayerControllable(hitid, false);
			ApplyAnimation(hitid, "PED", "FLOOR_hit_f", 4.0, 0, 1, 1, 1, 0, 1);
			new string[60];
			format(string, sizeof(string), "оглушил(а) %s", player_name[hitid]);
			MeAction(playerid, string);
			return false;
		}
	}
	if(
		hittype == BULLET_HIT_TYPE_PLAYER && IsPlayerConnected(hitid) && 
		TI[hitid][tLogin] && 
		!IsPlayerOnCapture(hitid) && !IsPlayerOnCapture(playerid) && 
		TI[hitid][tDuel] == -1 && 
		!player_to_golod[playerid] && 
		!player_to_game[hitid] && 
		!TI[playerid][tDMArea][0] && 
		!TI[playerid][tGunArea][0] 
	) {
		new Float:playerHealth;
		GetPlayerHealth(hitid, playerHealth);

		// Стадия-1
		//#if !defined _INC_WEAPON_CONFIG
		new Float:amount = GetDefaultWeaponDamage(weaponid);
		GetPlayerArmour(hitid, armour);

		if(
			PI[hitid][pStageDeath] == 0 && ((playerHealth - amount) <= STAGE_1_DEATH_MIN_HEALTH && playerHealth > 0.0) && 
			armour <= 0.0
		) {
			OnPlayerUpdateDeathStage(hitid, 1);

			PI[hitid][pStageDeath] = 1;
			PI[hitid][pStageDeathTimer] = (60 * 4);
			// PI[hitid][pStageDeathTick] = GetTickCount();

			GetPlayerPos(hitid, PI[hitid][pDeathPos][0], PI[hitid][pDeathPos][1], PI[hitid][pDeathPos][2]);
			GetPlayerFacingAngle(hitid, PI[hitid][pDeathPos][3]);

			PI[hitid][pDeathWorld] = GetPlayerVirtualWorld(hitid);
			PI[hitid][pDeathInterior] = GetPlayerInterior(hitid);

			if(IsPlayerInAnyVehicle(hitid)) {
				SetPlayerPosAC(hitid, PI[hitid][pDeathPos][0] + 0.2, PI[hitid][pDeathPos][1], PI[hitid][pDeathPos][2],  PI[hitid][pDeathWorld], PI[hitid][pDeathInterior]);
				SetPlayerFacingAngle(hitid, PI[hitid][pDeathPos][3]);
			}
			TogglePlayerControllable(hitid, true);
			ApplyAnimation(hitid, "WUZI", "CS_Dead_Guy", 4.0, 0, 1, 1, 1, 0);

			SendClientMessage(hitid, 0xCCCCCCFF, "{A52A2A}(( Вы получили легкие ранения и можете вызвать врачей, чтобы не погибнуть: /ambulance ))");
			SendClientMessage(hitid, 0xCCCCCCFF, "{A52A2A}(( Чтобы отправиться в больницу: /hospital ))");

			SetPlayerChatBubble(hitid, "{A52A2A}(( Игрок ранен ))", 0xFF0000FF, 10.0, 30000);//, /dm для информации
			SetPlayerHealth(hitid, STAGE_1_DEATH_MIN_HEALTH);

			//damages_Record(hitid, 3, amount, weaponid);
		 	return 0;
		}
		//else
		//#endif
		// Стадия-2
		//else if(PI[hitid][pStageDeath] == 1 && GetTickCount() - PI[hitid][pStageDeathTick] < 500) return 0;
	}
	return 1;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid) {
	gettime(tmphour, tmpminute, tmpsecond);
	if(newinteriorid == 0) {
		SetPlayerTime(playerid, ConvertHoursToGame(tmphour, tmpminute), ConvertMinutesToGame(tmpminute, tmpsecond));
		Streamer_VisibleItems(STREAMER_TYPE_OBJECT, 600, playerid);
	}
	else {
		SetPlayerTime(playerid, 11, 00);
		Streamer_VisibleItems(STREAMER_TYPE_OBJECT, 990, playerid);
	}

	if(newinteriorid > 0 && oldinteriorid == 0)
		SetPlayerWeather(playerid, 1);
	else if(newinteriorid == 0 && oldinteriorid > 0)
		SetPlayerWeather(playerid, 2);
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
    if(result == -1) return ErrorMessage(playerid, "[Ошибка]{FFFFFF} Неизвестная команда! Посмотреть команды Вы можете в /menu - Команды сервера.");
    return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	if(TI[playerid][tDialog])
	{
		ErrorMessage(playerid, "Нельзя использовать команды при открытом диалоге");
		return 0;
	}
	if(!TI[playerid][tLogin])
	{
		ErrorMessage(playerid, "Необходимо авторизоваться");
		return 0;
	}
	if(GetTickCount() - PlayerFloodFix[playerid] < 500)
	{
		if(CountFloodForPlayer[playerid] >= 2)
		{
			if(CountFloodForPlayer[playerid] >= 3)
			{
				ErrorMessage(playerid, "Пожалуйста не флудите");
				Kick(playerid);
				return 0x0;
			}
			CountFloodForPlayer[playerid]++;
			ErrorMessage(playerid, "Пожалуйста не флудите");
			return 0x0;
		}
		CountFloodForPlayer[playerid]++;
		ErrorMessage(playerid, "Пожалуйста, не флудите");
		return 0;
	}
	printf("[DEBUG] %s command: \"/%s %s\"", player_name[playerid], cmd, params);

	PlayerFloodFix[playerid] = GetTickCount();
	return TI[playerid][tLogin];
}
public OnPlayerConnect(playerid) {
	if(playerid == 65535)
		return Kick(playerid);
	GetPlayerName(playerid, player_name[playerid], sizeof (player_name[]));
	if(GetString(player_name[playerid], "Quick_Logic")) return Kick(playerid);
	strmid(player_RP_name[playerid], player_name[playerid], 0, strlen(player_name[playerid]), sizeof (player_name[]));

    for(new i = 0, len = strlen(player_RP_name[playerid]); i < len; i++) {
        if(player_RP_name[playerid][i] == '_') player_RP_name[playerid][i] = ' ';
	}
	if(IsLoginInvalid(player_name[playerid])) return Kick(playerid);

	SetPlayerVirtualWorld(playerid, playerid + 1);
	GetPlayerIp(playerid, player_ip_check[playerid], 16);

	to_default(playerid);
	
	#if defined _sampvoice_included
	if(SvGetVersion(playerid) == SV_NULL) {
		SendClientMessage(playerid, -1, "Не удалось обнаружить плагин sampvoice");
	}
	else if(SvHasMicro(playerid) == SV_FALSE) {
		SendClientMessage(playerid, -1, "Не удалось обнаружить микрофон");
	}
	else {
		if(gstream != SV_NULL) {
			SvAttachListenerToStream(gstream, playerid);
			SvAddKey(playerid, SV_KEY_B);
		}
	}
	#endif
	#if defined _casino_included
		casino_OnPlayerConnect(playerid);
	#endif
	#if defined _ghetto_included
		ghetto_OnPlayerConnect(playerid);
	#endif

	static const f_check_ip_ban[] = "\
	SELECT * FROM `"TABLE_BANIP"` WHERE `IP` = '%s' LIMIT 1";

	new str_check_ip_ban[sizeof(f_check_ip_ban) + (-2 + 16)];
	format(str_check_ip_ban, sizeof(str_check_ip_ban), f_check_ip_ban, player_ip_check[playerid]);
	mysql_tquery(connects, str_check_ip_ban, "check_ip_ban", "i", playerid);
	
	for(new i=0; i<10; i++) {
		TextDrawShowForPlayer(playerid, LOGO[i]);
	}

	GangZoneShowForPlayer(playerid, SFa, COLOR_YELLOW2);
	GangZoneShowForPlayer(playerid, Army, COLOR_YELLOW2);

	//if((strcmp(player_ip_check[playerid], "127.0.0.1", true) && strcmp(player_ip_check[playerid], "192.168.1.111", true)) && GetServerVarAsInt("port") == 4444)
	RemoveBuildings(playerid);
	PlayerFixDiceCount[playerid] = 2;
	PlayerClearDelay[playerid] = 0;

	/*if(PlayerSecondTimer[playerid] != -1) {
		KillTimer(PlayerSecondTimer[playerid]);
		PlayerSecondTimer[playerid] = -1;
	}*/
	#if defined _INC_WEAPON_CONFIG
		// SetDamageFeedForPlayer(playerid, 0);
	#endif
	#if defined _flymode_inc
		flymode_OnPlayerConnect(playerid);
	#endif

	if(!PI[playerid][pID])
	{
		TI[playerid][tJoined] = true;
		ac_1{playerid} = true;

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT `pID`, `pKey`, `pKeyip`, `GoogleCode`, `pGoogle`, `pvIp` FROM `accounts` WHERE `Name` = '%s' LIMIT 1", player_name[playerid]);
		mysql_tquery(connects, MYSQL_GLOBAL, "OnPlayerRequestDetect", "d", playerid);
	}
	PlayerSecondTimer[playerid] = SetTimerEx("OnPlayerSecondUpdate", 1000, false, "i", playerid);

	return true;
}
stock IsVehicleOccupiedEx(vehicleid)
{
	foreach(new i: Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(GetPlayerState(i) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(i) == vehicleid) return 1;
	}
	return 0;
}
public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger) {
	if(VehicleInfo[vehicleid][vLocked] && !ispassenger) {
		ClearAnimations(playerid);
		FreezePlayerForTime(playerid, 2);
	}
	new arend_id = INVALID_PLAYER_ID;
	if(GetArendCarID(vehicleid, arend_id) != -1) {
		if(arend_id == INVALID_PLAYER_ID || !IsPlayerConnected(arend_id)) {

		}
		else if(arend_id != playerid) {
			ErrorMessage(playerid, "Этот транспорт уже арендуют");
			if(!ispassenger) ClearAnimations(playerid, 1);
		}
	}
	if(VehicleInfo[vehicleid][vBizz] && !ispassenger) {
		for(new i = 0; i < 20; i++) {
			if(vehicleid == FuncBizz[VehicleInfo[vehicleid][vBizz]][funcbCars][i]) FuncBizz[VehicleInfo[vehicleid][vBizz]][funcbCarID][i] = playerid;
		}
	}
	SetPlayerArmedWeapon(playerid, 0);

	if(PI[playerid][pAdmin] < 1) {
		if(PlayerHealFix[playerid] != 0) {
			if(PlayerHealExFix[playerid] > unix) {
				ClearAnimations(playerid);
				OnPlayerCheckFailedAnim(playerid);
			}
		}
	}
	if(PI[playerid][pStageDeath]) {
		/*GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
		SetVehicleParamsForPlayer(vehicleid, playerid, objective, true); */
		TogglePlayerControllable(playerid, false);
		if(!ac_AntiCheatIsFrozen(playerid))
			ClearAnimations(playerid);
		switch(PI[playerid][pStageDeath]) {
			case 1: ApplyAnimation(playerid, "WUZI", "CS_Dead_Guy", 4.0, 0, 1, 1, 1, 0);
			case 2: ApplyAnimation(playerid, "PED", "FLOOR_hit_f", 4.0, 0, 1, 1, 1, 0);
		}
	}
	return true;
}
CB:PlayerSpawn(playerid) {
	if(IsPlayerNPC(playerid))
		return true;
	/*if(IsPlayerInAnyVehicle(playerid)) {
		new Float:X, Float:Y, Float: Z;
		GetPlayerPos(playerid, X, Y, Z);
		SetPlayerPosAC(playerid, X, Y, Z, TI[playerid][tVirtualWorld], TI[playerid][tInterior]);
		// SetTimerEx("PlayerSpawn", 50, false, "i", playerid);
		return true;
	}
	else SettingSpawn(playerid);*/
	TI[playerid][tSpecSpawn] = false;

	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || TI[playerid][tSpectate] == true) {
		TI[playerid][tSpecSpawn] = true;
		SpecPl(playerid, false);

		SetSpawnInfoEx(playerid, TI[playerid][pOldSkin], TI[playerid][Admin_X], TI[playerid][Admin_Y], TI[playerid][Admin_Z], 0);
		TI[playerid][tVirtualWorld] = avir[playerid];
		TI[playerid][tInterior] = aint[playerid];

		SetPlayerVirtualWorld(playerid, TI[playerid][tVirtualWorld]);
		SetPlayerInterior(playerid, TI[playerid][tInterior]);
		
		SetTimerEx("PlayerSpawn", 250, false, "i", playerid);
	}
	else SpawnPlayer(playerid);
	return true;
}
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	for(new guard_iterator = strlen(inputtext) - 1; guard_iterator > -1; --guard_iterator)
	{
		if(inputtext[guard_iterator] == '%') inputtext[guard_iterator] = '#';
	}
	TI[playerid][tDialog] = false;
	new bool: olddialog = true;
	if(dialogid != OldDialogID[playerid]) olddialog = false;
	new text_length = strlen(inputtext);
	for(new i = 0; i < text_length; i ++)
	{
		if(inputtext[i] == '{')
		{
			inputtext[i] = ' ';
		}
		if(inputtext[i] == '}')
		{
			inputtext[i] = ' ';
		}
		if(inputtext[i] == '%')
		{
			inputtext[i] = ' ';
		}
	}
	if(!olddialog) return 1;
	OldDialogID[playerid] = INVALID_DIALOG_ID;
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	switch(dialogid)
	{
	case D_AREND_BIKE: {
		if(!response) return true;
		if(TI[playerid][tArendKey] != -1) return ErrorMessage(playerid, "Вы уже арендуете велосипед.");
		
		new Float:x, Float:y, Float:z, Float:fa;
		GetPlayerPos(playerid, x, y, z);
		GetPlayerFacingAngle(playerid, fa);
		x += 1.5;
		
		SendOk(playerid, "Вы успешно аредовали велосипед.");
		SendOk(playerid, "Чтобы отменить аренду велосипеда, введите: /unrentbike.");
		
		new vehicleid = CreateVehicle(509, x, y, z, fa, 1, 1, -1);
		SetVehicleParamsEx(vehicleid, false, false, false, false, false, false, false);
		LinkVehicleToInterior(vehicleid, GetPlayerInterior(playerid));
		SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
		PutPlayerInVehicle(playerid, vehicleid, PLAYER_STATE_DRIVER);
		TI[playerid][tArendKey] = vehicleid;
		VehicleInfo[vehicleid][vFuel] = 100;
		GiveMoney(playerid, -50, "аренда велосипеда");
	}
	case D_OBT_MENU: {
		if(!response)
			return true;
		if(!ServerSettings[serverBetaTest])
			return true;
		switch(listitem + 1) {
			case 1:	{
			    if(PlayerTimerCash[playerid] > gettime()) return ErrorMessage(playerid, "[Ошибка] Получать деньги можно раз в 10 минут");
				ShowPlayerDialog(playerid, D_OBT_MONEY, DIALOG_STYLE_INPUT, ""P"Получить деньги", ""W"Введите количество денег, которое хотите получить:", "Принять", "Назад");
			}
			case 2: {
			    if(PlayerTimerDonate[playerid] > gettime()) return ErrorMessage(playerid, "[Ошибка] Получать донат можно раз в 10 минут");
				ShowPlayerDialog(playerid, D_OBT_DONATE, DIALOG_STYLE_INPUT, ""P"Получить донат", ""W"Введите количество доната, которое хотите получить:", "Принять", "Назад");
			}
			case 3: ShowPlayerDialog(playerid, D_OBT_LEVEL, DIALOG_STYLE_INPUT, ""P"Изменить уровень", ""W"Введите новый уровень аккаунта (1-10):", "Принять", "Назад");
			case 4: {
				if((lic[playerid][0] + lic[playerid][1] + lic[playerid][2] + lic[playerid][3]) == 4)
					return ErrorMessage(playerid, "У вас уже есть все лицензии.");
				lic[playerid][0] = lic[playerid][1] = lic[playerid][2] = lic[playerid][3] = 1;

				UpdateLicenses(playerid);
				#if defined _quests_included
				quest_OnPlayerComplete(playerid, QUESTS_TYPE_MASON, 1);
				#endif

				SendOk(playerid, "Лицензии получены.");
			}
			//case 4: ShowPlayerDialog(playerid, D_OBT_VEHICLE, DIALOG_STYLE_INPUT, ""P"Получить временный транспорт", ""W"Введите ID модели транспорта:", "Принять", "Назад"); // Временный транспорт
			case 5: ShowPlayerDialog(playerid, D_TP_LIST, DSL, ""P"Телепорт", ""P"1."W" Организации\n"P"2."W" Работы\n"P"3."W" Вокзалы\n"P"4."W" Банки\n"P"5."W" Транспортные компании\n"P"6."W" Таксопарки\n"P"7."W" Прочее", "Выбрать", "Отмена");
			case 6: {
				STRING_GLOBAL[0] = EOS;
				strcat(STRING_GLOBAL, "№\tОрганизация\tЛидер\n");

				for(new FracID = 1, idx; FracID < MAX_FRACTIONS; FracID++) {
					switch(FracID) {
						case fINSTRUCTORS, fMAYOR, fLCN..fRIFA: continue;
					}
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t%s\t%s\n",
						STRING_GLOBAL, idx + 1, FI[FracID][fName], FI[FracID][fLeader]
					);
					playerListitemID[playerid][idx++] = FracID;
				}
				ShowPlayerDialog(playerid, D_OBT_INVITEME, DSTH, "Лидеры организаций", STRING_GLOBAL, "Выбрать", "Отмена");

			} // Вступить во фракцию
			case 7: {
				//
				if(!ServerSettings[serverVehicleOBT])
					return ErrorMessage(playerid, "В данный момент запрещено создавать транспорт.");
				ShowPlayerDialog(playerid, D_OBT_VEHICLE, DIALOG_STYLE_INPUT, ""P"Создать временный транспорт", ""W"Введите ID модели транспорта, который хотите создать (400 - 611):", "Принять", "Отмена");

			} // vehicle
			case 8: {
				ShowPlayerDialog(playerid, D_OBT_GIVEGUN,  DIALOG_STYLE_INPUT, ""P"Выдать себе оружие", ""W"Введите ID оружия и патроны через запятую:", "Выбрать", "Отмена");
				//
			} // givegun
			case 9: {
				//
				if(GetPVarInt(playerid, "godmode")) {
					SetPVarInt(playerid, "godmode", 0);
					SetPlayerHealth(playerid, 100);
					SendOk(playerid, "Вы выключили бессмертие.");
				}
				else {
					SetPVarInt(playerid, "godmode", 1);
					SetPlayerHealth(playerid, Float:0x7F800000);
					SendOk(playerid, "Вы включили бессмертие.");
				}
			} // godmode
		}
		return true;
	}
	case D_OBT_VEHICLE: {
		if(!response)
			return true;
		new modelid = strval(inputtext);
		if(!(400 <= modelid < 611)) {
			ErrorMessage(playerid, "Данный транспорт недоступен.");
			ShowPlayerDialog(playerid, D_OBT_VEHICLE, DIALOG_STYLE_INPUT, ""P"Создать временный транспорт", ""W"Введите ID модели транспорта, который хотите создать (400 - 611):", "Принять", "Отмена");
			return true;
		}
		if(GetPlayerVirtualWorld(playerid) + GetPlayerInterior(playerid) != 0) {
			ErrorMessage(playerid, "Вы должны находиться на улице.");
			return true;
		}
		new bool:isReturn = false;
		for(new i = 0; i < sizeof (DefaultImportInfo); i++) {
			if(DefaultImportInfo[i][viModel] == modelid) {
				isReturn = true;
				break;
			}
		}
		if(!isReturn) {
			ErrorMessage(playerid, "Данное авто нельзя создать.");
			return true;
		}
		if(TempPlayerVehicleTimer[playerid]) {
			A_DestroyVehicle(TempPlayerVehicleID[playerid]);
			TempPlayerVehicleID[playerid] = INVALID_VEHICLE_ID;
		}
		new Float:X, Float:Y, Float:Z, Float: A;
		GetPlayerPos(playerid, X, Y, Z);
		GetPlayerFacingAngle(playerid, A);

		X += 1.5;

		new vehicleid = A_CreateVehicle(modelid, X, Y, Z, A, random(256), random(256), -1, VEHICLE_TYPE_OBT);
		SetVehicleParamsEx(vehicleid, false, false, false, false, false, false, false);
		SetVehicleNumberPlate(vehicleid, "Test Car");
		LinkVehicleToInterior(vehicleid, GetPlayerInterior(playerid));
		VehicleInfo[vehicleid][veX] = X;
		VehicleInfo[vehicleid][veY] = Y;
		VehicleInfo[vehicleid][veZ] = Z;
		VehicleInfo[vehicleid][vFuel] = 100.0;

		TempPlayerVehicleID[playerid] = vehicleid;
		TempPlayerVehicleTimer[playerid] = 20 * 60;
		return true;
	}
	case D_OBT_GIVEGUN: {
		if(!response)
			return true;
		new weaponid, ammo;
		if(sscanf(inputtext, "p<,>ii", weaponid, ammo) || !(0 <= ammo <= 300) || !(22 <= weaponid <= 34)) {
			ShowPlayerDialog(playerid, D_OBT_GIVEGUN,  DIALOG_STYLE_INPUT, ""P"Выдать себе оружие", ""W"Введите ID оружия и патроны через запятую:", "Выбрать", "Отмена");
			return true;
		}
		// give
		inventory_GiveWeapon(playerid, weaponid); // Оружие
		inventory_GiveWeapon(playerid, weaponid, ammo); // Патроны

		SendOk(playerid, "Вы выдали себе оружие");
		return true;
	}
	case D_OBT_DONATE: {
		if(!response) {
			callcmd::obt(playerid);
			return true;
		}
		new amount;
		if(sscanf(inputtext, "i", amount) || amount < 1)
			return ShowPlayerDialog(playerid, D_OBT_DONATE, DIALOG_STYLE_INPUT, ""P"Получить донат", ""W"Введите количество доната, которое хотите получить:", "Принять", "Назад");
		if(amount + PI[playerid][pRouble] > 5000)
			return ErrorMessage(playerid, "Нельзя выдать себе больше 5000 доната.");
		PI[playerid][pRouble] += amount;
		UpdatePlayerData(playerid, "donatemoney", PI[playerid][pRouble]);
		
		PlayerTimerDonate[playerid] = gettime() + 600;
		return true;
	}
	case D_OBT_LEVEL: {
		if(!response) {
			callcmd::obt(playerid);
			return true;
		}
		new amount;
		if(sscanf(inputtext, "i", amount) || !(1 <= amount <= 10))
			return ShowPlayerDialog(playerid, D_OBT_LEVEL, DIALOG_STYLE_INPUT, ""P"Изменить уровень", ""W"Введите новый уровень аккаунта (1-10):", "Принять", "Назад");

		UpdatePlayerData(playerid, "pLevel", PI[playerid][pLevel] = amount);
		DollahScoreUpdate(playerid);
		return true;
	}
	case D_OBT_MONEY: {
		if(!response) {
			callcmd::obt(playerid);
			return true;
		}
		new amount;
		if(sscanf(inputtext, "i", amount) || amount < 1)
			return ShowPlayerDialog(playerid, D_OBT_MONEY, DIALOG_STYLE_INPUT, ""P"Получить деньги", ""W"Введите количество денег, которое хотите получить:", "Принять", "Назад");
		if(amount + PI[playerid][pCash] > 10000000)
			return ErrorMessage(playerid, "Нельзя выдать себе больше $1000000.");

		GiveMoney(playerid, amount, "обт.наличные");
		
		PlayerTimerCash[playerid] = gettime() + 600;
		return true;
	}
	case D_OBT_INVITEME: {
		if(!response) {
			callcmd::obt(playerid);
			return true;
		}
		if(!ServerSettings[serverBetaTest])
			return true;
		if(PI[playerid][pOrgMember])
			return ErrorMessage(playerid, "Вы уже состоите в пользовательской организации. (/leave)");
		new FracID = playerListitemID[playerid][listitem];
		/*if(FracID == fINSTRUCTORS || FracID == fMAYOR)
			return ErrorMessage(playerid, "Данная фракция не доступна");*/

		start_work[playerid] = 1;
		PI[playerid][pMember] = FracID;
		PI[playerid][pLeader] = 0;
		PI[playerid][TempLeader] = 0;
		// // UpdateDiscordData(playerid);

		PI[playerid][pRank] = FI[FracID][fMaxRang] - 1;

		SendClientMessage(playerid, 0xCCCCCCFF, "Для увольнения введите: "W"/leave");
		PI[playerid][pFracSkin] = FI[FracID][fSkin];
		A_SetPlayerSkin(playerid, PI[playerid][pFracSkin]); 
		inventory_ClearFractionClothes(playerid);
		//GivePlayerSkin(playerid, FI[FracID][fSkin], 2);
		SetPlayerColor(playerid, gFractionSpawn[PI[playerid][pMember]][fracColor]);


		static const f_invite_frac[] = "\
		Вы вступили временно во фракцию "P"%s";

		new str_invite_frac[sizeof(f_invite_frac) + (-2 + 25) + (-2 + MAX_PLAYER_NAME + 1)];
		format(str_invite_frac, sizeof(str_invite_frac), f_invite_frac, FI[FracID][fName]);
		SendClientMessage(playerid, 0xCCCCCCFF, str_invite_frac);

		format(str_invite_frac, sizeof(str_invite_frac), "%s вступил временно во фракцию %s", player_name[playerid], FI[FracID][fName]);
		SendAdminMessage(0xCCCCCCFF, str_invite_frac);

		return true;
	}
	#if defined _organizations_included
	case D_ORG_MAKEGUN: {
		if(!response)
			return false;
		new materialAmount[sizeof (OrganizationMakegunInfo)];

		for(new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 3); slotid++) {
			for(new weapon_id = 0; weapon_id < sizeof (OrganizationMakegunInfo); weapon_id++) {
				if(PI[playerid][pItemsID][slotid] != weapon_id + 168) continue;
				materialAmount[weapon_id] += PI[playerid][pItemsAmount][slotid];
			}
		}
		if(materialAmount[listitem] < OrganizationMakegunInfo[listitem][orgMaterialAmount]) {

			static const f_make_weapon[] = "\
			У вас недостаточно заготовок для сборки данного оружия. Необходимо: %i.";

			new str_make_weapon[sizeof(f_make_weapon) + (-2 + 10)];
			format(str_make_weapon, sizeof (str_make_weapon), f_make_weapon, OrganizationMakegunInfo[listitem][orgMaterialAmount]);
			ErrorMessage(playerid, str_make_weapon);

			return true;
		}
		new organization_id = PI[playerid][pOrgMember];
		if(!OrganizationInfo[organization_id][orgAccess][ORG_ACCESS_CREATE_WEAPON]) {
			ErrorMessage(playerid, "У вашей организации закрыт доступ к производству оружия.");
			return true;
		}
		SetPVarInt(playerid, "MakegunWeaponID", listitem);
		new work_position_id = 0;

		for(new gun_position_id = 0; gun_position_id < sizeof (OrganizationIntGunWorkPos); gun_position_id++) {
			if(!IsPlayerInRangeOfPoint(playerid, 0.5,
				OrganizationIntGunWorkPos[gun_position_id][0],
				OrganizationIntGunWorkPos[gun_position_id][1],
				OrganizationIntGunWorkPos[gun_position_id][2])
			) continue;
			work_position_id = gun_position_id;
			break;
		}
		SetPlayerPosAC(playerid,
			OrganizationIntGunWorkPos[work_position_id][0],
			OrganizationIntGunWorkPos[work_position_id][1],
			OrganizationIntGunWorkPos[work_position_id][2],
			organization_id, GetPlayerInterior(playerid)
		);
		SetPlayerFacingAngle(playerid, OrganizationIntGunWorkPos[work_position_id][3]);

		SetPlayerAttachedObject(playerid, ATTACH_SLOT_JOB_1, InventoryItemInfo[listitem + 20][itemModelID], 6);
		// SetPlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2, 1577, 5, 0.035000, 0.090000, -0.015000, 75.400024, 82.899986, -95.299987, 0.528000, 0.571000, 0.568999);

		ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 1, 1, 1, 1);

		JobTempProcess[playerid] = ORG_GUN_WORK_PROCESS_ID;
		TI[playerid][tProcess][0] = 0;
		TI[playerid][tProcess][1] = 5;
		PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
		for(new YN = 0; YN < 3; YN++)
		{
			TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
			if(YN < 2) PlayerTextDrawShow(playerid, YandNsysTDPlayer[playerid][YN]);
		}
		RandomYareNforJOBS(playerid);
		TogglePlayerControllable(playerid, false);

		GivePlayerItem(playerid, (listitem + 168), -OrganizationMakegunInfo[listitem][orgMaterialAmount], 2);

		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "Вы начал сборку оружия \"%s\".");
		SendOk(playerid, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;

		return true;
	}
	case D_ORG_WAREHOUSE_MAIN: {
