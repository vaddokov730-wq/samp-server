			static const f_str[] = ""G"Добро пожаловать на сервер: "ORANGE""FullServName""G"\n\
	  "ORANGE"Регистрация нового персонажа"G"\n\n\
	  Логин: "P"%s"G"\n\
	  Введите пароль:\n\n\
	  "P"Примечание:\n\t\
