		if(strlen(inputtext) < 6 || strlen(inputtext) > 20) return ShowPlayerDialog(playerid, D_CHANGE_PASS_SELECT, DSI, ""P"Смена пароля", "\n\n"W"Введите свой старый пароль:\n\n"NO"*"G" От 6 до 20 символов\n\n", "Ввод", "Назад");
		if(!CheckPassword(inputtext)) return ShowPlayerDialog(playerid, D_CHANGE_PASS_SELECT, DSI, ""P"Смена пароля", "\n\n"W"Введите свой старый пароль:\n\n", "Ввод", "Назад");

