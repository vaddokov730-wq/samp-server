				  "W"Имя:\t\t\t"GREEN"%s\n\
				  "W"Пол:\t\t\t"GREEN"%s\n\
				  "W"Наркозависимость:\t"GREEN"%d", player_name[playerid], (PI[playerid][pSex] == 1) ? ("Мужской") : ("Женский"), PI[playerid][pAddiction]);
