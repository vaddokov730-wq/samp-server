public OnPlayerText(playerid, text[])
{
	if(!TI[playerid][tLogin]) return 0;
	new string[150];
	if(PI[playerid][pMute] > 0)
	{
		ErrorMessage(playerid, "У Вас бан чата!");
		SetPlayerChatBubble(playerid, "пытается что-то сказать", COLOR_REDD, 30.0, 10000);
		return 0;
	}
	if(TI[playerid][tGag])
	{
		ErrorMessage(playerid, "У Вас кляп!");
		SetPlayerChatBubble(playerid, "пытается что-то сказать", COLOR_REDD, 30.0, 10000);
		return 0;
	}
	if(PI[playerid][pStageDeath] == 2) {
		ErrorMessage(playerid, "Ваш персонаж не в состоянии разговаривать.");
		return 0;
	}
	/*if(CountFloodForPlayer[playerid] >= 2)
	{
		if(CountFloodForPlayer[playerid] >= 3)
		{
			ErrorMessage(playerid, "Пожалуйста не флудите");
			Kick(playerid);
			return 0x0;
		}
		CountFloodForPlayer[playerid]++;
		ErrorMessage(playerid, "Пожалуйста не флудите");
		return 0x0;
	}*/
	if(GetTickCount() - PlayerFloodFix[playerid] < 500)
	{
		if(CountFloodForPlayer[playerid] >= 3)
		{
			if(CountFloodForPlayer[playerid] >= 4)
			{
				ErrorMessage(playerid, "Пожалуйста не флудите");
				Kick(playerid);
				return 0x0;
			}
			CountFloodForPlayer[playerid]++;
			ErrorMessage(playerid, "Пожалуйста не флудите");
			return 0x0;
		}
		CountFloodForPlayer[playerid]++;
		ErrorMessage(playerid, "Пожалуйста, не флудите");
		return 0;
	}
	// CountFloodForPlayer[playerid]++;

	if(TI[playerid][tEther])
	{
		format(string, sizeof(string), "[%s] %s: %s", FI[PI[playerid][pMember]][fName], player_RP_name[playerid], text);
		foreach(new i: Player)
		{
			if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
			if(PI[i][pSettings][2] != PI[playerid][pMember]) continue;
			SendClientMessageEx(i, 0xFF9900AA, string);
		}
		return 0;
	}
	if(TI[playerid][tPhoneNews])
	{
		for(new i; i < sizeof(calls_ether); i++)
		{
			if(calls_ether[i] == playerid && calls_news[i])
			{
				new mes[128];
				format(mes, sizeof(mes), "[%s] %s [тел.]: %s", FI[PI[calls_news[i]][pMember]][fName], player_RP_name[playerid], text);
				new subid = PI[calls_news[i]][pMember];
				foreach(new r: Player)
				{
					if(!TI[r][tLogin] || AntiCheatIsKickedWithDecync(r)) continue;
					if(PI[r][pSettings][2] == subid || r == playerid) SendClientMessageEx(r, 0xFF9900AA, mes);
				}
				return false;
			}
		}
	}
	if(TI[playerid][tPhone] == true)
	{
		new id, mes[128];
		if(TI[playerid][tPhoneCaller] == playerid) id = TI[playerid][tPhoneCalled];
		else if(TI[playerid][tPhoneCalled] == playerid) id = TI[playerid][tPhoneCaller];

		format(mes, sizeof(mes), "[тел] %s: %s", player_RP_name[playerid], text);
		SendClientMessageEx(playerid, COLOR_YELLOW, mes);

		format(mes, sizeof(mes), "[тел] %s: %s", player_RP_name[playerid], text);
		SendClientMessageEx(id, COLOR_YELLOW, mes);

		SetPlayerChatBubble(playerid, mes, COLOR_WHITE, 10.0, 10000);
		return false;
	}
	
	if(GetString(text, ")"))
	{
		MeAction(playerid, "улыбается");
		return false;
	}
	if(GetString(text, "))"))
	{
		MeAction(playerid, "смеётся");
		return false;
	}
	if(GetString(text, "xD") || GetString(text, "XD"))
	{
		MeAction(playerid, "хохочет во весь голос");
		return false;
	}
	if(GetString(text, "("))
	{
		if(PI[playerid][pSex] == 1) MeAction(playerid, "расстроился");
		else MeAction(playerid, "расстроилась");
		return false;
	}
	if(GetString(text, "(("))
	{
		if(PI[playerid][pSex] == 1) MeAction(playerid, "сильно расстроился");
		else MeAction(playerid, "сильно расстроилась");
		return false;
	}
	if(GetString(text, ":D") || GetString(text, "=D"))
	{
		MeAction(playerid, "хохочет");
		return false;
	}
	if(GetString(text, "O_o"))
	{
		MeAction(playerid, "удивлен(а)");
		return false;
	}
	if(GetString(text, ">_<"))
	{
		if(PI[playerid][pSex] == 1) MeAction(playerid, "сморщился от злости");
		else MeAction(playerid, "сморщилась от злости");
		return false;
	}
	if(GetString(text, ";)"))
	{
		MeAction(playerid, "подмигивает");
		return false;
	}
	if(GetString(text, "q"))
	{
		if(GetPVarInt(playerid, "anti_sbiv_time") > unix) return 1;
		if(isAdminStatus(player_name[playerid], ADMIN_STATUS_OWNER))
		{
			MeAction(playerid, "показал распальцовку {FF0000}Developer Team");
			ApplyAnimation(playerid, "GHANDS", "gsign1LH", 4.0, 0, 0, 0, 0, 0, 1);
			return 0x0;
		}
		if(PI[playerid][pAdmin] >= 1)
		{
			MeAction(playerid, "показал(а) распальцовку {33AA33}Admins Team");
			ApplyAnimation(playerid, "GHANDS", "gsign1LH", 4.0, 0, 0, 0, 0, 0, 1);
			return false;
		}
		new member[20];
		switch(PI[playerid][pMember])
		{
		case fBALLAS, fVAGOS, fGROVE, fAZTEC, fRIFA: {
			format(string, sizeof(string), "показал(а) распальцовку %s", member);
			MeAction(playerid, string);
			ApplyAnimation(playerid, "GHANDS", "gsign1LH", 4.0, 0, 0, 0, 0, 1, 1);
		}
		case fARMYSF, fARMYLV: {
			MeAction(playerid, "выполнил(а) воинское приветствие");
			ApplyAnimation(playerid, "VENDING", "VEND_Drink2_P", 4.0, 0, 0, 0, 0, 1000, 1);
		}
		}
		return false;
	}
	if(Casino_Flag[playerid][select_casino_table] != -1)
	{
		new string_casino[144];
		format(string_casino, sizeof(string_casino), "- %s: %s", player_RP_name[playerid], text);
		foreach(new i: Player)
		{
			if(Casino_Flag[i][select_casino_table] == Casino_Flag[playerid][select_casino_table])
			{
				SendClientMessageEx(i, 0x1E90FFFF, string_casino);
			}
		}
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && !PI[playerid][pStageDeath])
		{
			if(PI[playerid][pSettings][4] == 0)
			{
				ApplyAnimation(playerid, "PED", Talk[PI[playerid][pSettings][4]], 8.1, 0, 1, 1, 1, 1, 0);
				PlayerChatFix[playerid] = (GetTickCount() + (100 * strlen(text)));
				PlayerChatExFix[playerid] = 1;
			}
			else if(PI[playerid][pSettings][4] != 0)
			{
				ApplyAnimation(playerid, "GANGS", Talk[PI[playerid][pSettings][4]], 4.1, 1, 1, 1, 1, 1, 1);
				PlayerChatFix[playerid] = (GetTickCount() + (100 * strlen(text)));
				PlayerChatExFix[playerid] = 1;
			}
		}
		SetPlayerChatBubble(playerid, text, COLOR_WHITE, 20.0, 10000);
		return 0x0;
	}
	if(PI[playerid][pMember] == 0 || start_work[playerid] == 0)
	{
		format(string, sizeof(string), "- [%d] %s"W": %s",
			playerid, player_RP_name[playerid], text
		);
	}
	else if(TI[playerid][tMasked])
	{
		format(string, sizeof(string), "- [%d] {%06x}%s"W": %s",
			playerid, (GetPlayerColor(playerid) >>> 8), player_RP_name[playerid], text
		);
	}
	else if(TI[playerid][tMaskTime])
	{
		format(string, sizeof(string), "- [%d] {7a7667}%s"W": %s",
			playerid, player_RP_name[playerid], text
		);
		// SendChatMessage(playerid, playerid, text);
	}
	else
	{
		/*switch(PI[playerid][pMember])
		{
		case 1, 2, 3, 4, 6, 7: format(string, sizeof(string), "- %s {%06x}(%s) [%d]", text, (GetPlayerColor(playerid) >>> 8), player_name[playerid], playerid);

		default: format(string, sizeof(string), "- %s {%06x}(%s) [%d]", text, (GetPlayerColor(playerid) >>> 8), player_name[playerid], playerid);
		}*/
		format(string, sizeof(string), "- [%d] {%06x}%s"W": %s",
			playerid, (GetPlayerColor(playerid) >>> 8), player_RP_name[playerid], text
		);
	}
	ProxDetector(12.5, playerid, string, -1);

	if(GetPVarInt(playerid, "Animation") != 2 && !PI[playerid][pStageDeath] && !TI[playerid][tTazer] && !TI[playerid][tCuffedTime] && GetPVarInt(playerid, "anti_sbiv_time") < unix && !TI[playerid][tTied] && !GetPVarInt(playerid, "Animation"))
	{
		if(PI[playerid][pSettings][4] == 0)
		{
			ApplyAnimation(playerid, "PED", Talk[PI[playerid][pSettings][4]], 8.1, 0, 1, 1, 1, 1, 0);
			PlayerChatFix[playerid] = (GetTickCount() + (100 * strlen(text)));
			PlayerChatExFix[playerid] = 1;
		}
		else if(PI[playerid][pSettings][4] != 0)
		{
			ApplyAnimation(playerid, "GANGS", Talk[PI[playerid][pSettings][4]], 4.1, 1, 1, 1, 1, 1, 1);
			PlayerChatFix[playerid] = (GetTickCount() + (100 * strlen(text)));
			PlayerChatExFix[playerid] = 1;
		}
	}
	SetPlayerChatBubble(playerid, text, COLOR_WHITE, 15.0, 10000);
	return false;
}
stock GetColor(playerid)
{

	new str[8];
	switch(PI[playerid][pMember])
	{
	case 1, 2, 3, 4, 6, 7: {
		if(PI[playerid][pSubdivision] && Subdivision[SubdivisionPlayer[playerid][0]][sub_color])
			format(str, 8, "%06x", color_fraction[Subdivision[SubdivisionPlayer[playerid][0]][sub_color]][fracColor] >>> 8);
		else format(str, 8, "%06x", color_fraction[FI[PI[playerid][pMember]][frColor]][fracColor] >>> 8);
	}
	default: format(str, 8, "%06x", color_fraction[FI[PI[playerid][pMember]][frColor]][fracColor] >>> 8);
	}

	return str;
}
stock GetColorFrac(id)
{
	new str[8];
	format(str, 8, "%06x", color_fraction[FI[id][frColor]][fracColor] >>> 8);
	return str;
}
new OnPlayerUpdateTick[MAX_PLAYERS];
public OnPlayerUpdate(playerid) {
	TI[playerid][tAFK] = 0;

	#if defined _flymode_inc
		flymode_OnPlayerUpdate(playerid);
	#endif
	#if defined _casino_included
	if(
		TI[playerid][tCasinoRouletteTable] && TI[playerid][tCasinoRouletteChipsObject] != -1 &&
		TI[playerid][tCasinoRouletteBet] == 0 && GetPlayerInterior(playerid) == CASINO_INTERIOR_ID
	) {
		new Keys, ud, ld;
		GetPlayerKeys(playerid, Keys, ud, ld);
		if(ud < 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_UP);
		else if(ud > 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_DOWN);
		if(ld < 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_LEFT);
		else if(ld > 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_RIGHT);
	}
	#endif
	if(OnPlayerUpdateTick[playerid] <= GetTickCount()) {
		OnPlayerUpdateTick[playerid] = GetTickCount() + 250;
		if(!TI[playerid][tLogin] || AntiCheatIsKickedWithDecync(playerid))
			return false;
		if(PlayerGunFix[playerid]) {
			SetPlayerArmedWeapon(playerid, 0);
		}
		#if defined _inventory_included
			inventory_OnPlayerUpdate(playerid);
		#endif

		#if defined _bank_robbery_included
		if(ROB_BANK_ENABLE && (IsAMafia(playerid) || IsAGang(playerid)) && RB_AntiFloodUpdate[playerid] <= gettime()) {
			new actorid = GetPlayerTargetActor(playerid);
			switch(GetPlayerWeapon(playerid)) {
				case 22..34: if(actorid == RobBankInfo[robActorID]) {
					if(RB_STATUS_NONE == RobBankInfo[robStatus] && RobBankInfo[robActorAnimID] == 0) {
						new RB_COP_amount = 0, RB_ROB_amount = 0, bool:RB_C4_TAKEN = false;
						foreach(new i: Player) {
							if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i))
								continue;
							if(IsAGang(i) || IsAMafia(i)) {
								if(PI[i][pRobBankLastTime] > gettime()) continue;
								if(
									IsPlayerInRangeOfPoint(i, 30.0, 2406.1443,-34.2138,1029.625) ||
									IsPlayerInRangeOfPoint(i, 30.0, 184.2615, -270.0170, 1000.976)
								) {
									if(RB_PlayerInfo[i][robC4Bought]) RB_C4_TAKEN = true;
									RB_ROB_amount++;
								}
							}
							if(!IsACop(i)) continue;
							RB_COP_amount++;
						}
						if(PI[playerid][pRobBankLastTime] > gettime()) {
							RB_AntiFloodUpdate[playerid] = (gettime() + 30);
							ErrorMessage(playerid, "Участвовать в ограблении можно раз в 2 часа!");
						}
						else if(RB_COP_amount < RB_MINIMUM_COP_COUNT) {
							RB_AntiFloodUpdate[playerid] = (gettime() + 15);
							ErrorMessage(playerid, "Вы не можете начать ограбление, потому что в сети недостаточно сотрудников полиции (мин. "#RB_MINIMUM_COP_COUNT").");
						}
						else if(!RB_C4_TAKEN) {

							RB_AntiFloodUpdate[playerid] = (gettime() + 15);
							ErrorMessage(playerid, "Никто из грабителей не купил 'C4' на черном рынке.");
						}
						else if(RB_ROB_amount < RB_MINIMUM_ROB_COUNT) {
							RB_AntiFloodUpdate[playerid] = (gettime() + 15);
							ErrorMessage(playerid, "Вы не можете начать ограбление, потому что с вами недостаточно игроков для ограбления (мин. "#RB_MINIMUM_ROB_COUNT").");
							ErrorMessage(playerid, "Возможно кто-то из грабителей уже участвовал в ограблении (в течении 2 ч.).");
						}
						else {
							if(PI[playerid][pRobBankLastTime] > gettime()) {

								RB_AntiFloodUpdate[playerid] = (gettime() + 30);
								ErrorMessage(playerid, "Участвовать в ограблении можно раз в 2 часа!");
							}
							else {

								foreach(new i: Player) {
									if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i))
										continue;

									if(RB_PlayerInfo[i][robTextID] != Text3D:(-1)) {
										DestroyDynamic3DTextLabel(RB_PlayerInfo[i][robTextID]);
										RB_PlayerInfo[i][robTextID] = Text3D:(-1);
									}
									if(IsAGang(i) || IsAMafia(i)) {
										if(
											IsPlayerInRangeOfPoint(i, 30.0, 2406.1443,-34.2138,1029.625) ||
											IsPlayerInRangeOfPoint(i, 30.0, 184.2615, -270.0170, 1000.976)
										) {
											SendClientMessage(i, 0xB22222FF, "[Внимание] В банке г.ЛС сработала сигнализация, полиция уже в пути!");
										}
									}
								}
								SendTeamMessage(CDEPARTMENT, "[Внимание] В банке г.ЛС сработала сигнализация, возможно это ограбление!");

								SendClientMessage(playerid, CBADINFO, "Вы были объявлены в розыск. Причина: Ограбление / проникновение банка");
								PI[playerid][pSearch] = 6;
								SetPlayerCriminal(playerid, player_name[playerid], "Ограбление банка");
								format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[Внимание] %s объявлен(а) в розыск [%d/6]. Обвинитель: %s. Причина: Ограбление / проникновение банка",
									player_name[playerid], PI[playerid][pSearch], player_name[playerid]
								);
								SendTeamMessage(CDEPARTMENT, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;
								SetPlayerWantedLevel(playerid, PI[playerid][pSearch]);


								SendOk(playerid, "Внимание! Ограбление начато, идите в хранилище.");
								RB_Start(playerid);

								RobBankInfo[robActorAnimID] = 1;
								RobBankInfo[robActorAnimTimer] = 10;

								SetActorFacingAngle(RobBankInfo[robActorID], 290.0);
								ApplyActorAnimation(RobBankInfo[robActorID], "PED", "handsup", 4.1, 0, 0, 0, 1, 0);

								RB_AntiFloodUpdate[playerid] = (gettime() + 3);
							}
						}
					}
					else if(1 == RobBankInfo[robActorAnimID] && RobBankInfo[robActorAnimTimer] >= 2) {
						RobBankInfo[robActorAnimTimer] = 10;
						RB_AntiFloodUpdate[playerid] = (gettime() + 5);
					}
					else if(RobBankInfo[robStatus]) {
						ErrorMessage(playerid, "В данный момент уже идет ограбление.");
						RB_AntiFloodUpdate[playerid] = (gettime() + 30);

					}

				}
			}
		}
		#endif
		if(PlayerChatExFix[playerid] == 1)
		{
			if(PlayerChatFix[playerid] < GetTickCount())
			{
				PlayerChatExFix[playerid] = 0;
				ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1);
			}
		}
	}
	return 1;
}
public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(!TI[playerid][tLogin]) return 1;

	#if defined _angars_included
		if(angar_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _bank_robbery_included
		if(RB_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _mapeditor_included
		if(ME_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _quests_included
		if(quests_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _farmjob_included
		if(farm_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _organizations_included
		if(org_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _key_minigame_inc
		if(km_OnPlayerKeyStateChange(playerid, newkeys)) return true;
	#endif
	#if defined _factoryjob_included
		if(factory_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _poker_included
		if(poker_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _blackjack_included
		if(blackjack_OnPlayerKStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _casino_included
		if(casino_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _cargo_ship_inc
		if(cargo_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _player_vehicles_included
	if((newkeys & KEY_WALK) && !(oldkeys & KEY_WALK)) {
		if(IsPlayerInRangeOfPoint(playerid, 1.5, 2255.6689, -2387.5527, 17.4219/*-1649.1649, 1209.0283, 7.2500*/)) {
			if(PI[playerid][pBusiness] < 1 || gBusiness[PI[playerid][pBusiness] - 1][bizzType] != 8)
				return ErrorMessage(playerid, "У Вас нет своего автосалона!");
			cs_ShowPlayerMenu(playerid, CS_MENU_IMPORT_MAIN);
			return true;
		}
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetVehicleModel(GetPlayerVehicleID(playerid)) == 402 && HOLDING(KEY_CROUCH)) {
		new vehicleid = GetPlayerVehicleID(playerid);
		if(fBCPD <= VehicleInfo[vehicleid][vTeam] <= fRCPD) {
			VehicleInfo[vehicleid][vSirenLights] = !VehicleInfo[vehicleid][vSirenLights];

			if(VehicleInfo[vehicleid][vSirenLights]) {
				SetDynamicObjectMaterial(VehicleInfo[vehicleid][vSirenObject][0], 0, -1, "none", "none", 0x00000000);
				SetDynamicObjectMaterial(VehicleInfo[vehicleid][vSirenObject][1], 0, -1, "none", "none", 0x00000000);
			} else {
				SetDynamicObjectMaterial(VehicleInfo[vehicleid][vSirenObject][0], 0, -1, "none", "none", -14540254);
				SetDynamicObjectMaterial(VehicleInfo[vehicleid][vSirenObject][1], 0, -1, "none", "none", -14540254);
			}
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
		}
	}

	if(PI[playerid][pDescriptionType] == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && PlayerTargetFix[playerid] <= gettime() && newkeys & KEY_HANDBRAKE) {
		if(PI[playerid][pTargetCheckTimer] != -1) {
			KillTimer(PI[playerid][pTargetCheckTimer]);
			/*printf("[KillTimer 21] PI[playerid][pTargetCheckTimer] = '%d' killed",
				PI[playerid][pTargetCheckTimer]
			);*/
		}
		PI[playerid][pTargetCheckTimer] = SetTimerEx("OnPlayerCheckDescTarget", 275, false, "i", playerid);
	}
	if((newkeys & KEY_CROUCH) && !(oldkeys & KEY_CROUCH)) {
		new vehicleid = GetPlayerVehicleID(playerid);
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && ToggleArmyGates(playerid)) return true;
		if(IsPlayerInRangeOfPoint(playerid, 2.0, 2800.7239, -1464.1243, 16.2241) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && IsAPD(playerid) && GetVehicleModel(vehicleid) == 525) {
			if(
				VehicleInfo[vehicleid][vTeam] != fLSPD && VehicleInfo[vehicleid][vTeam] != fSFPD &&
				VehicleInfo[vehicleid][vTeam] != fLVPD && VehicleInfo[vehicleid][vTeam] != fFBI &&
				VehicleInfo[vehicleid][vTeam] != fBCPD &&
				VehicleInfo[vehicleid][vTeam] != fTRPD && VehicleInfo[vehicleid][vTeam] != fRCPD
			) return true;

			if(!IsTrailerAttachedToVehicle(vehicleid))
				return ErrorMessage(playerid, "Сначала прицепите транспорт к эвакуатору.");
			new target_vehicleid = GetVehicleTrailer(vehicleid), player_vehicleid = -1;
			foreach (new i: playerVehicles) {
				if(PlayerVehicleInfo[i][carVehicle] != target_vehicleid)
					continue;
				player_vehicleid = i;
				break;
			}
			if(player_vehicleid == -1)
				return ErrorMessage(playerid, "Сначала прицепите транспорт к эвакуатору.");
		 	DetachTrailerFromVehicle(vehicleid);

			GetVehicleParamsEx(PlayerVehicleInfo[player_vehicleid][carVehicle],
				engine, lights, alarm, doors, bonnet, boot, objective
			);
			SetVehicleParamsEx(PlayerVehicleInfo[player_vehicleid][carVehicle],
				engine, lights, alarm, VEHICLE_PARAMS_ON, bonnet, boot, objective
			);
		 	PlayerVehicleInfo[player_vehicleid][carPos][0] = PlayerVehicleInfo[player_vehicleid][carPos][1] = 0.0;
			UpdatePlayerVehiclePosition(player_vehicleid, 1);
			SetVehicleToRespawn(PlayerVehicleInfo[player_vehicleid][carVehicle]);
			VehicleInfo[PlayerVehicleInfo[player_vehicleid][carVehicle]][vParkingFine] = 1;

			SavePlayerVehicle(player_vehicleid);
			SendOk(playerid, "Вы выставили транспорт на штрафстоянку.");
			return true;
		}
	}
	if((newkeys & KEY_WALK) && !(oldkeys & KEY_WALK)) {

		new cop_vehicleid = GetPVarInt(playerid, "CopTruckID");
		if(cop_vehicleid && IsAPD(playerid) && GetVehicleModel(cop_vehicleid) == 525 && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0) {
			if(
				VehicleInfo[cop_vehicleid][vTeam] != fLSPD && VehicleInfo[cop_vehicleid][vTeam] != fSFPD &&
				VehicleInfo[cop_vehicleid][vTeam] != fLVPD && VehicleInfo[cop_vehicleid][vTeam] != fFBI &&
				VehicleInfo[cop_vehicleid][vTeam] != fBCPD &&
				VehicleInfo[cop_vehicleid][vTeam] != fTRPD && VehicleInfo[cop_vehicleid][vTeam] != fRCPD
			) return true;

			new Float:x, Float:y, Float:z;
			GetVehicleShiftPos(cop_vehicleid, 1, x, y, z, 2.0);
			if(IsPlayerInRangeOfPoint(playerid, 2.0, x, y, z)) {
				GetVehicleParamsEx(cop_vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
				// if(!engine) return ErrorMessage(playerid, "Прежде чем прицепить трансопрт, заведите двигатель.");

				new Float:X, Float:Y, Float: Z, Float:iX, Float:iY, Float:iZ;//, Float:iA;
				GetVehiclePos(cop_vehicleid, X, Y, Z);
				if(PlayerToKvadrat(playerid, 2257.3931/* (x1) */, 1383.0959/* (y1) */, 2357.5547/* (x2) */, 1523.1483/* (y2) */) && Z < 100.0)
					return true;

				if(!IsTrailerAttachedToVehicle(cop_vehicleid)) {
				/*	new target_vehicleid = GetVehicleTrailer(cop_vehicleid);

					GetVehiclePos(target_vehicleid, iX, iY, iZ);
					GetVehicleZAngle(target_vehicleid, iA);

				 	DetachTrailerFromVehicle(cop_vehicleid);

					SetVehiclePos(target_vehicleid, iX, iY, iZ);
					SetVehicleZAngle(target_vehicleid, iA);

				} else {*/
					for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
						if(i == cop_vehicleid || VehicleInfo[i][vType] != VEHICLE_TYPE_PLAYER)
							continue;
						GetVehiclePos(i, iX, iY, iZ);
						if((floatabs(iX - X) < 7.0) && (floatabs(iY - Y) < 7.0) && (floatabs(iZ - Z) < 7.0)) {
							if(!IsTrailerAttachedToVehicle(i)) {
								if(VehicleInfo[i][vParkingFine]) {
									ErrorMessage(playerid, "Данный транспорт уже стоит на штрафстоянке.");
									break;
								}
								MeAction(playerid, "прицепил транспорт к эвакуатору");
								SetPlayerChatBubble(playerid, "прицепил транспорт к эвакуатору", COLOR_PURPLE, 13.0, 7000);

								SetPlayerFaceToPoint(playerid, X, Y);
								ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 1, 1, 1, 1);
								SetTimerEx("ClearAnims", 1000, false, "i", playerid);
								AttachTrailerToVehicle(i, cop_vehicleid);
								break;
							}
						}
					}
				}
				return true;
			}
		}

		if(
			GetPlayerState(playerid) == PLAYER_STATE_ONFOOT &&
			(IsPlayerInRangeOfPoint(playerid, 1.5, 2820.2314, -1469.8209, 16.2568))
		) {
			return ShowPlayerParkingFineList(playerid);
		}
		if(
			GetPlayerState(playerid) == PLAYER_STATE_ONFOOT &&
			IsPlayerInRangeOfPoint(playerid, 2.0, -1896.9404, -1677.2861, 23.0156)
		) {
			return ShowPlayerCarsList(playerid, D_UTILIZATION_CAR);
		}
	}
	if((newkeys & KEY_FIRE) && !(oldkeys & KEY_FIRE)) {
		new vehicleid = GetPlayerVehicleID(playerid);
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && IsAPD(playerid) && GetVehicleModel(vehicleid) == 525 && GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0) {
			if(
				VehicleInfo[vehicleid][vTeam] != fLSPD && VehicleInfo[vehicleid][vTeam] != fSFPD &&
				VehicleInfo[vehicleid][vTeam] != fLVPD && VehicleInfo[vehicleid][vTeam] != fFBI &&
				VehicleInfo[vehicleid][vTeam] != fBCPD &&
				VehicleInfo[vehicleid][vTeam] != fTRPD && VehicleInfo[vehicleid][vTeam] != fRCPD
			) return true;

			GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
			if(!engine) return ErrorMessage(playerid, "Прежде чем прицепить трансопрт, заведите двигатель.");

			new Float:X, Float:Y, Float: Z, Float:iX, Float:iY, Float:iZ, Float:iA;
			GetVehiclePos(vehicleid, X, Y, Z);
			if(PlayerToKvadrat(playerid, 2257.3931/* (x1) */, 1383.0959/* (y1) */, 2357.5547/* (x2) */, 1523.1483/* (y2) */) && Z < 100.0)
				return true;

			if(IsTrailerAttachedToVehicle(vehicleid)) {
				new target_vehicleid = GetVehicleTrailer(vehicleid);

				GetVehiclePos(target_vehicleid, iX, iY, iZ);
				GetVehicleZAngle(target_vehicleid, iA);

			 	DetachTrailerFromVehicle(vehicleid);

				SetVehiclePos(target_vehicleid, iX, iY, iZ);
				SetVehicleZAngle(target_vehicleid, iA);

			}
			/*else {
				for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
					if(i == vehicleid || VehicleInfo[i][vType] != VEHICLE_TYPE_PLAYER)
						continue;
					GetVehiclePos(i, iX, iY, iZ);
					if((floatabs(iX - X) < 7.0) && (floatabs(iY - Y) < 7.0) && (floatabs(iZ - Z) < 7.0)) {
						if(!IsTrailerAttachedToVehicle(vehicleid)) {
							if(VehicleInfo[i][vParkingFine]) {
								ErrorMessage(playerid, "Данный транспорт уже стоит на штрафстоянке.");
								break;
							}
							AttachTrailerToVehicle(i, vehicleid);
							break;
						}
					}
				}
			}*/
			return true;
		}
	}
	#endif
	#if defined _ghetto_included
		if(ghetto_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _metro_stop_included
	if((newkeys & KEY_YES) && !(oldkeys & KEY_YES)) {
		for(new ms_id = 0; ms_id < MAX_METRO_STOP; ms_id++) {
			if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT &&
				IsPlayerInRangeOfPoint(playerid, METRO_STATION_DISTANCE,
					MetroStationInfo[ms_id][msPos][0], MetroStationInfo[ms_id][msPos][1], MetroStationInfo[ms_id][msPos][2]
				)
			) return ms_SelectStop(playerid);
		}
	}
	#endif
	if(TI[playerid][tTazer]) ApplyAnimation(playerid, "CRACK", "crckidle2", 4.1, 0, 1, 1, 1, 1, 0);
	if((oldkeys & KEY_SECONDARY_ATTACK) && !(newkeys & KEY_SECONDARY_ATTACK))
	{
		if(SERIU[playerid][sID] != INVALID_PLAYER_ID)
		{
			SpecPlayer(playerid, SERIU[playerid][sID]);
			TogglePlayerControllable(playerid, 1);
		}
		if(!TI[playerid][tHeal])
		{
			for(new i = 0; i < sizeof (med_heal); i++)
			{
				if(PlayerToPoint(1.7, playerid, med_heal[i][0], med_heal[i][1], med_heal[i][2]))
				{
					new Float: health;
					GetPlayerHealth(playerid, health);
					if(health >= 75) return ErrorMessage(playerid, "Вы не нуждаетесь в лечении");
					SetPlayerPosAC(playerid, med_heal[i][0], med_heal[i][1], med_heal[i][2], TI[playerid][tVirtualWorld], TI[playerid][tInterior], false);
					SetPlayerFacingAngle(playerid, med_heal[i][3]);
					ApplyAnimation(playerid, "CRACK", "Crckidle2", 4.1, 1, 0, 0, 0, 0, 0);
					TI[playerid][tHeal] = true;
					break;
				}
			}
		}
		else
		{
			TI[playerid][tHeal] = false;
			ClearAnimations(playerid);
		}
		for(new i; i < gRoomsCount; i++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 2, gRooms[i][roomsEnterX], gRooms[i][roomsEnterY], gRooms[i][roomsEnterZ]) && gRooms[i][roomsWorld] == GetPlayerVirtualWorld(playerid))
			{
				if(gRooms[i][roomsDoors] == 1) return ErrorMessage(playerid, "Номер закрыт. У Вас нет ключей");
				SetPlayerPosAC(playerid, 11.8101, 760.6392, 1064.6791, i + 1, 81);
				SetPlayerFacingAngle(playerid, 125.2149);
				SetCameraBehindPlayer(playerid);
				OnPlayerUpdateLoadingMode(playerid);
				return true;
			}
			else if(IsPlayerInRangeOfPoint(playerid, 3, 11.8101, 760.6392, 1064.6791))
			{
				new x = GetPlayerVirtualWorld(playerid) - 1;
				if(x == -1)
				{
					printf("[WARNING ROOM]: x == -1");
					x = 0;
				}
				SetPlayerPosAC(playerid, gRooms[x][roomsEnterX], gRooms[x][roomsEnterY], gRooms[x][roomsEnterZ], gRooms[x][roomsWorld], 80);
				SetPlayerFacingAngle(playerid, gRooms[x][roomsEnterR]);
				updaterooms(playerid, gRooms[x][roomsWorld]);
				SetCameraBehindPlayer(playerid);
				OnPlayerUpdateLoadingMode(playerid);
				return true;
			}
		}
		if(GetPVarInt(playerid, "Animation") == 2)
		{
			ApplyAnimation(playerid, "CARRY", "null", 1.0, 0, 0, 0, 0, 0, 0);
			PlayerClearAnim[playerid] = 1;
