		}
		case 2: ShowPlayerDialog(playerid, D_BILL_FONT, DSL, ""P"Шрифт", ""P"1."W" Arial\n"P"2."W" Calibri\n"P"3."W" Tahoma\n"P"4."W" Verdana", "Выбрать", "Назад");
		case 3: ShowPlayerDialog(playerid, D_BILL_SIZE, DSI, ""P"Размер текста", "\n\n"W"Укажите размер текста (от 1 до 255):\n\n", "Изменить", "Назад");
		case 4: ShowPlayerDialog(playerid, D_BILL_TEXT_2, DSL, ""P"Выравнивания текста", ""P"1."W" По левому краю\n"P"2."W" По центру\n"P"3."W" По правому краю", "Выбрать", "Назад");
		case 5: ShowPlayerDialog(playerid, D_BILL_UNRENT, DSM, ""P"Расторжение договора", "\n\n"W"Вы действительно хотите разорвать договор аренды с этим билбордом?\n\n", "Да", "Нет");
		}
	}
	case D_BILL_TEXT: {
		if(!response) return ShowPlayerEditMenu(playerid);
		new query[256], p_var = GetPVarInt(playerid, "SelectBildID");
		for(new i; i < 5; i++)
		{
			new pos = strfind(inputtext, "/", false);
			if(pos != -1) strdel(inputtext, pos, pos + 1), strins(inputtext, "\n", pos, 2);
