		new str[120];

		STRING_GLOBAL[0] = EOS;
		for(new adm = 0; adm < sizeof (AdminCommand); adm++)
		{
			if(AdminCommand[adm][cmdLVL] != listitem + 1) continue;
			format(str, sizeof(str), "\n\t{70c425}%s"W" - %s", AdminCommand[adm][cmdName], AdminCommand[adm][cmdInfo]);
			strcat(STRING_GLOBAL, str);
		}
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Админ команды", STRING_GLOBAL, "Закрыть", "");
	}
	case D_MP: {
