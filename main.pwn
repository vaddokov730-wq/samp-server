		if(PlayerVehicleInfo[player_vehicleid][carVehcom][03]) strcat(tuning[0], "\t[Боковая юбка]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][04]) strcat(tuning[0], "\t[Фары]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][05]) strcat(tuning[0], "\t[Нитро]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][06]) strcat(tuning[0], "\t[Выхлопная труба]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][07]) strcat(tuning[0], "\t[Диски]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][08]) strcat(tuning[0], "\t[Стерео]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][09]) strcat(tuning[0], "\t[Гидравлика]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][10]) strcat(tuning[0], "\t[Передний бампер]\n");
		if(PlayerVehicleInfo[player_vehicleid][carVehcom][11]) strcat(tuning[0], "\t[Задний бампер]\n");

