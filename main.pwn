						continue;
					if(VehicleInfo[vehicleid][vOrganization] != PI[playerid][pOrgMember]) continue;
					format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), "\t"P"%i. "G"%s [ID:%i] "P"[%s]", count++,
