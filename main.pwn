		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "INSERT `history` (`name_1`, `number_1`,`ip_1`,`number_2`,`status`, `money`, `gcash`, `date`) VALUES('%s', '%d', '%s', '%d', '2', '%d','%d', '%d')", player_name[playerid], gBanks[playerid][bankNumber][GetPVarInt(playerid, "select_score")], playerip, GetPVarInt(playerid, "select_number"), GetPVarInt(playerid, "select_money"), gcash, gettime());
		return mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	}
	case D_BANK_CHANGE_PIN: {
		if(!response) return bank_score(playerid);
		if(strlen(inputtext) != 4 || isNumeric(inputtext)) return ShowPlayerDialog(playerid, D_BANK_CHANGE_PIN, DSI, ""P"Смена PIN-кода", "\n\n"W"Введите новый PIN-код состоящий из 4 цифр:\n\n", "Изменить", "Назад");
		gBanks[playerid][bankPassword][GetPVarInt(playerid, "select_score")] = strval(inputtext);

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `bank` SET `code` = '%d' WHERE `number` = '%d'", gBanks[playerid][bankPassword][GetPVarInt(playerid, "select_score")], gBanks[playerid][bankNumber][GetPVarInt(playerid, "select_score")]);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");

		static const f_str[] = ""W"PIN-код успешно изменён\nВаш новый PIN - "P"%s";
		new string[sizeof(f_str) + 1 + (-2 + 5)];
		format(string, sizeof(string), f_str, inputtext);
		ShowPlayerDialog(playerid, D_BANK_LIST, DSM, ""P"Смена PIN-кода", string, "Назад", "");

		new playerip[17];
		GetPlayerIp(playerid, playerip, sizeof(playerip));
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "INSERT `history` (`name_1`, `number_1`,`ip_1`,`status`, `date`) VALUES('%s','%d','%s','1','%d')", player_name[playerid], gBanks[playerid][bankNumber][GetPVarInt(playerid, "select_score")], playerip, gettime());
