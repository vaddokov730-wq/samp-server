				INSERT INTO `"TABLE_ACCOUNTS"` (`Name`, `pKey`, `pSex`, `pDataReg`, `pIpReg`, `pDrug`, `pEmail`,`Skin`, `pLevel`, `pCash`, `donatemoney`) VALUES \
				('%s', MD5('%s'), '%i', '%02i/%02i/%02i', '%s', '%s', '%s', '%i', '%d', '%d', '%d')",
				player_name[playerid], player_pass[playerid], PI[playerid][pSex], day, month, year, 
				PI[playerid][pIpReg], PI[playerid][pDrug], PI[playerid][pEmail], 
				skin_register[GetPVarInt(playerid, "join_ped_item")][0],
				BONUSLVL, BONUSMONEY, BONUSDONATE
