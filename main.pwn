				}
			}
			}
		}
		case 1: {
			if(PI[playerid][pMember] < 9) return ErrorMessage(playerid, "Данная функция Вам недоступна");
			ShowPlayerDialog(playerid, D_NEWS_ETHER_PRICE, DSI, ""P"Цена за звонки", ""W"Введите стоимость за звонки:", "Далее", "Отмена");
		}
