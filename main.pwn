		case 9: ShowPlayerDialog(playerid, D_MP_2, DIALOG_STYLE_INPUT, "Название", "\n\n"W"Введите название мероприятия:\n\n", "Ввод", "Отмена");
		case 10: ShowPlayerDialog(playerid, D_MP_4, DIALOG_STYLE_INPUT, "Кол-во участников", "\n\n"W"Введите количество участников:\n\n", "Ввод", "Отмена");
