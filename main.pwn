	}
	case D_CONTROL_EDIT: {
		if(!response) return pc_cmd_menu(playerid, "");
		switch(listitem)
		{
		case 0: ShowPlayerDialog(playerid, D_CHANGE_PASS_SELECT, DSP, "Смена пароля", "\n\n"W"Введите свой старый пароль:\n\n", "Ввод", "Назад");
		case 1: {
