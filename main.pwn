CMD:invsquad(playerid, params[])
{
	if(PI[playerid][pMember] == 1 || PI[playerid][pMember] == 2 || PI[playerid][pMember] == 3 || PI[playerid][pMember] == 4 || PI[playerid][pMember] == 6 || PI[playerid][pMember] == 7)
