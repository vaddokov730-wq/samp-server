			DeletePVar(playerid, "veh");
			return 1;
		}
		switch(listitem)
		{
		case 0: {
			if(GetPVarInt(playerid, "tipster"))
			{
				ErrorMessage(playerid, "У Вас уже есть жучок");
				GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
