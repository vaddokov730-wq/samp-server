		case 0: ShowPlayerDialog(playerid, D_BILL_TEXT, DSI, ""P"Изменение текста", "\n\n"W"Введите текст объявления в поле ниже:\n\n", "Изменить", "Назад");
		case 1: {
			new str[24];

			STRING_GLOBAL[0] = EOS;
			for(new i, z = sizeof(Colors_LOW); i < z; i++)
			{
				format(str, 24, "{%s}Фон\n", Colors_LOW[i]);
				strcat(STRING_GLOBAL, str);
