	UpdateDynamic3DTextLabelText(gMenu[3], -1, string);
	format(string, sizeof(string), "Склад банды {83BFBF}Rifa"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d", TotalGZ[3], FI[fRIFA][fMats], FI[fRIFA][fDrugs], FI[fRIFA][fBank], TotalGZ[3] * 65);
	UpdateDynamic3DTextLabelText(gMenu[4], -1, string);


	format(string, sizeof(string), "Аптечка банды {8813E7}Ballas"W"\nДоступно аптечек: "P"%d", FI[fBALLAS][fHealth]);
	UpdateDynamic3DTextLabelText(gHealth[0], -1, string);
	format(string, sizeof(string), "Аптечка банды {DBD604}Vagos"W"\nДоступно аптечек: "P"%d", FI[fVAGOS][fHealth]);
