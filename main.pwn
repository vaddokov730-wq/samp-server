stock destroy_amb_ptd(playerid)
{
	if(GetPVarInt(playerid, "create_amb_ptd"))
	{
		for(new i; i < 13; i++)
		{
			PlayerTextDrawHide(playerid, amb_ptd[playerid][i]);
			PlayerTextDrawDestroy(playerid, amb_ptd[playerid][i]);
		}

		DeletePVar(playerid, "create_amb_ptd");
	}
}

stock send_disease(playerid)
{
	SendOk(playerid, "Вы попали в зону распространения болезни");
	SendOk(playerid, "Советуем Вам обратиться к медикам в любой из пунктов больницы");
	SendOk(playerid, "(( Внимание! Состояние Вашей жизни (HP) будет падать значительно быстрее ))");
	PI[playerid][pDisease][0] = 1;
	UpdatePlayerData(playerid, "pDisease_0", 1);
	return 1;
}
stock active_accept(playerid)
{
	if(TI[playerid][tDiceID] != INVALID_PLAYER_ID ||
			TI[playerid][tRaceID] != INVALID_PLAYER_ID ||
			GetPVarInt(playerid, "race_offer") ||
			GetPVarInt(playerid, "hi") ||
			PlayerInviteFix[playerid] != -1 ||
			GetPVarInt(playerid, "lices") ||
			GetPVarInt(playerid, "skills") ||
			GetPVarInt(playerid, "uds") ||
			GetPVarInt(playerid, "udjur") ||
			GetPVarInt(playerid, "pass") ||
			GetPVarInt(playerid, "fpass") ||
			GetPVarInt(playerid, "medcard") ||
			GetPVarInt(playerid, "taxi_id") ||
			GetPVarInt(playerid, "tk_id") ||
			HealOffer[playerid] != INVALID_PLAYER_ID ||
			GetPVarInt(playerid, "repairoffee") ||
			GetPVarInt(playerid, "kiss") ||
			GetPVarInt(playerid, "drugoffee") ||
			GetPVarInt(playerid, "gunoffee") ||
			PlayerZoneOfferFix[playerid] != 0xFFFF ||
			GetPVarInt(playerid, "sim_id_sell") ||
			GetPVarInt(playerid, "bizzProdaet") ||
			GetPVarInt(playerid, "hotelProdaet") ||
			GetPVarInt(playerid, "airProdaet") ||
			GetPVarInt(playerid, "houseSeller") ||
			GetPVarInt(playerid, "carProdaet")) return 1;
	else return 0;
}
CMD:a(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new string[144], text[130];
	if(sscanf(params, "s[110]", text)) return SendEsp(playerid, "/a [текст]");
	if(strlen(params[0]) > 110) return ErrorMessage(playerid, "Допустимое количество символов в сообщение не более 80");
	if(gAdmin[playerid][9] == 1)
	format(string, sizeof(string), "[A-4.5]{7FC7FF} %s(%i): %s", player_name[playerid], playerid, text);
	else format(string, sizeof(string), "[A-%d]{7FC7FF} %s(%i): %s", PI[playerid][pAdmin], player_name[playerid], playerid, text);
	SendAdminMessage(PP, string);

	return true;
}
CMD:kick(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	if(PlayerAdminFix[playerid] > gettime()) return ErrorMessage(playerid, "Можно раз в 10 секунд");
	PlayerAdminFix[playerid] = gettime() + 10;

	new text[130], string[356], giveplayerid;
	if(sscanf(params, "us[128]", giveplayerid, text)) return SendEsp(playerid, "/kick [playerid] [причина]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	if(giveplayerid == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	if(PI[playerid][pAdmin] < PI[giveplayerid][pAdmin]) return 1;
	if(isAdminStatus(player_name[giveplayerid], ADMIN_STATUS_OWNER)) return 1;
	if(IsAIP(text))return 1;
	if(strlen(text) > 30) return ErrorMessage(playerid, "Не больше 30 символов");
	format(string, 128, "Администратор %s кикнул %s. Причина: %s", player_name[playerid], player_name[giveplayerid], text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	WriteLog(LOG_KICK, playerid, player_name[playerid], player_name[giveplayerid], text);
	gAdmin[playerid][ADMIN_KICK] ++;
	new hour, minute;
	new year, month, day;

	getdate(year, month, day);
	gettime(hour, minute);
	static const f_str[] = "\
	  "W"Внимание! Вы были "NO"кикнуты"W" с сервера.\n\n\
	  "W"Кикнул: "NO"%s\n\
	  "W"Дата: "ORANGE"%d-%d-%d %02d:%02d\n\
	  "W"Причина: "ORANGE"%s\n\n\
	  "W"Если вы считаете, что это ошибка, сделайте скриншот(F8) данного окна,\n\
	  иначе Ваша жалоба будет не принята.";
	format(string, sizeof(string), f_str, player_name[playerid], day, month, year, hour, minute, text);

	new str[MAX_PLAYER_NAME + 1];
	format(str, sizeof(str), "%s", player_name[giveplayerid]);
	ShowPlayerDialog(giveplayerid, DIALOG_NONE, DSM, str, string, "Закрыть", "");
	Kick(giveplayerid);
	return true;
}
alias:an("ans", "reps", "ot");
CMD:an(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0)
		return true;
	new targetid, text[81];

	if(sscanf(params, "is[81]", targetid, text) || targetid < 0 ) {
		if(!report_Show(playerid) && strlen(params) > 2) {
			SendEsp(playerid, "/an [playerid / reportid] [текст / ответ]");
		}
		return true;
	}
	if(targetid >= MAX_PLAYERS) {

		new report_id = targetid, status = REPORT_STATUS_ANSWERED;

		MYSQL_GLOBAL[0] = EOS;

		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT * FROM "TABLE_REPORTS" \
			WHERE status=0 AND id=%i", report_id
		);
		new Cache:result = mysql_query(connects, MYSQL_GLOBAL);

		cache_get_value_name_int(0, "player_id", targetid);
		cache_get_value_name(0, "text", TempReportInfo[playerid][reportText], 144);
		cache_get_value_name(0, "date", TempReportInfo[playerid][reportDate], 20);

		MYSQL_GLOBAL[0] = EOS;

		if(!cache_num_rows()) {
			if(cache_is_valid(result)) cache_delete(result);
			ErrorMessage(playerid, "На данный запрос уже был дан ответ!");
			return false;
		}
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE "TABLE_REPORTS" SET \
			status=%i, answer='%e' WHERE status=0 AND id=%i", status, text, report_id
		);
		mysql_query(connects, MYSQL_GLOBAL);

		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "\
			"W"Дата запроса: "G"%s\n \n\
			"W"Ваш запрос #%i:\n\
			"G"| "G"%s\n \n\
			"W"Ответ от администрации:\n\
			"G"| "P"%s",
			TempReportInfo[playerid][reportDate], report_id, TempReportInfo[playerid][reportText], text
		);
		ShowPlayerDialog(targetid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, ""P"Ответ администрации", STRING_GLOBAL, "Спасибо", "");

		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""P"Ваш запрос #%i: "W"%s", report_id, TempReportInfo[playerid][reportText]);
		SendClientMessage(targetid, COLOR_YELLOW, STRING_GLOBAL);
		format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""P"Ответ от администратора %s [%i]: "W"%s", player_name[playerid], playerid, text);
		SendClientMessage(targetid, COLOR_YELLOW, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;

		format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), ""G"%s [%i] ответил игроку %s[%i]: %s",
			player_name[playerid], playerid, player_name[targetid], targetid, text
		);
		SendAdminMessage(0xFfa500AA, CHAT_GLOBAL);

		gAdmin[playerid][ADMIN_PM]++;
		PlayerPlaySound(targetid, 4203, 0.0, 0.0, 0.0);

		if(cache_is_valid(result)) cache_delete(result);

	} else {
		if(!IsPlayerConnected(targetid))
			return ErrorMessage(playerid, not_id);
		if(strlen(text) > 80)
			return ErrorMessage(playerid, "Нельзя писать больше 80 символов!");
		if(IsAIP(text))
			return true;
		if(targetid == playerid)
			return ErrorMessage(playerid, "Нельзя ответить самому себе");
		format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), ""P"Ответ от администратора %s [%i]: "W"%s",
			player_name[playerid], playerid, text
		);
		SendClientMessage(targetid, 0xffa141FF, CHAT_GLOBAL);

		format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), ""G"%s [%i] ответил игроку %s[%i]: %s",
			player_name[playerid], playerid, player_name[targetid], targetid, text
		);
		SendAdminMessage(0xFfa500AA, CHAT_GLOBAL);

		PlayerPlaySound(targetid, 4203, 0.0, 0.0, 0.0);

		CHAT_GLOBAL[0] = EOS;
	}
	return true;
}

CMD:gg(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendEsp(playerid, "/gg [id]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	new string[128];
	format(string, sizeof(string), "Ответ от %s[%i]: Приятной Вам игры на сервере "FullServName"", player_name[playerid], playerid);
	SendClientMessage(giveplayerid, 0xffa141FF, string);
	format(string, sizeof(string), ""W"%s[%i] {FFa500}К "W"%s[%i]: {FFa500}Приятной Вам игры на сервере "FullServName"", player_name[playerid], playerid, player_name[giveplayerid], giveplayerid);
	SendAdminMessage(0xFfa500AA, string);
	PlayerPlaySound(giveplayerid, 4203, 0.0, 0.0, 0.0);
	return true;
}
CMD:mute(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new time, text[33], string[144], giveplayerid;
	if(sscanf(params, "uds[32]", giveplayerid, time, text) || time < 1) return SendEsp(playerid, "/mute [playerid] [минуты] [причина]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	if(giveplayerid == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	if(PI[giveplayerid][pMute]) return ErrorMessage(playerid, "У игрока уже имеется блокировка чата");
	if(IsAIP(text))return 1;
	if(PI[playerid][pAdmin] < PI[giveplayerid][pAdmin]) return 1;
	if(isAdminStatus(player_name[giveplayerid], ADMIN_STATUS_OWNER)) return 1;
	if(strlen(text) < 2 || strlen(text) > 30) return ErrorMessage(playerid, "Причина должна быть меньше 30 символов");
	if(time < 1 ||time > 300) return ErrorMessage(playerid, "Выдать бан чата можно максимум на 300 минут");
	if(PlayerAdminFix[playerid] > gettime()) return ErrorMessage(playerid, "Можно раз в 10 секунд");
	PlayerAdminFix[playerid] = gettime() + 10;

	new TotalTime;
	new ReasonTime = time * 60;

	if(TYPE_VIP[giveplayerid] != VIP_STATE_NONE)
	{
		new FakeTime = (100 - VipData[TYPE_VIP[giveplayerid]][VipMute]);
		TotalTime = (ReasonTime / 100) * FakeTime;
	}
	if(TYPE_VIP[giveplayerid] == VIP_STATE_NONE)
	{
		TotalTime = ReasonTime;
	}

	PI[giveplayerid][pMute] = TotalTime;
	UpdatePlayerData(giveplayerid, "mute", PI[giveplayerid][pMute]);
	format(string, sizeof(string), "Администратор %s заблокировал чат %s на %d мин. Причина: %s", player_name[playerid], player_name[giveplayerid], time, text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	SendOk(giveplayerid, "Время до снятия бана чата: "W"/time");
	gAdmin[playerid][ADMIN_MUTE] ++;
	WriteLog(LOG_MUTE, playerid, player_name[playerid], player_name[giveplayerid], text);
	return true;
}
