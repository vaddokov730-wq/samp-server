				if(calls_news[0] == INVALID_PLAYER_ID) str = "Приём звонков - ["GREEN"Отсутствует"W"]";
				else format(str, sizeof(str), "Приём звонков - ["P"%s]", player_name[calls_news[0]]);
			}
