		if(put < 500 || put > gBusiness[bizid][bizzUpgrade][0])
		{
			static const f_str[] = "\n\n"W"Введите кол-во продуктов, которое хотите заказать:\n\n"NO"*"G" Минимум 500 максимум %d\n\n";
