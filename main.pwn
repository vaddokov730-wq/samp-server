		PlayerBuyProdFix[playerid] = put;
		ShowPlayerDialog(playerid, dBusinessProd2, DSI, ""P"Заказ продуктов", "\n\n"W"Введите цену за "P"10"W" продуктов:\nПримечание: от "GREEN"$2"W" до "GREEN"$4\n\n", "Заказать", "Отмена");
		return 1;
	}
	case dBusinessProd2: {
		if(!response) return pc_cmd_bpanel(playerid), PlayerBuyProdFix[playerid] = 0;
		new put;
		new bizid = PI[playerid][pBusiness] - 1;
		if(sscanf(inputtext, "i", put)) return ShowPlayerDialog(playerid, dBusinessProd2, DSI, ""P"Заказ продуктов", "\n\n"W"Введите цену за "P"10"W" продуктов:\nПримечание: от "GREEN"$2"W" до "GREEN"$4\n\n", "Заказать", "Отмена");
		if(put < 2 || put > 4) return ShowPlayerDialog(playerid, dBusinessProd2, DSI, ""P"Заказ продуктов", "\n\n"W"Введите цену за "P"10"W" продуктов:\nПримечание: от "GREEN"$2"W" до "GREEN"$4\n\n", "Заказать", "Отмена");

		new string[144];
		new prod = PlayerBuyProdFix[playerid] * put / 10;
		if(gBusiness[bizid][bizzBank] < prod)
		{
			format(string, sizeof(string), "Недостаточно средств на счету бизнеса. Для оплаты необходимо: "NO"$%d", prod);
			ErrorMessage(playerid, string);
			PlayerBuyProdFix[playerid] = 0;
			return 1;
		}
		gBusiness[bizid][bizzBank] -= prod;
		gBusiness[bizid][bizzProdOrder] = PlayerBuyProdFix[playerid];
		gBusiness[bizid][bizzProdOrderPrice] = put;

		SaveBusiness(bizid);

		format(string, sizeof(string), ""W"Заказано продуктов: "O"%d\n"W"Оплачено со счёта бизнеса: "GREEN"$%d", gBusiness[bizid][bizzProdOrder], gBusiness[bizid][bizzProdOrderPrice]*gBusiness[bizid][bizzProdOrder]);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Заказ продуктов", string, "Закрыть", "");
		PlayerBuyProdFix[playerid] = 0;
		return 1;
	}
	case D_BIZZ_STATS: return pc_cmd_bpanel(playerid);
	case D_AMMO_2: {
		if(!response) {
			if(!lic[playerid][3])
				return ErrorMessage(playerid, "У Вас нет лицензии на оружие");
			new id = TI[playerid][tSelectedBusinessID];
			STRING_GLOBAL = ""P"Название\t"P"Стоимость\n";

			for(new i = 0, itemid; i < sizeof (gSellGunItems); i++) {
				itemid = gSellGunItems[i];

				format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s\t"GREEN"$%i\n", i + 1,
					InventoryItemInfo[itemid][itemName], floatround(gSellGunPrices[i] * gBusiness[id][bizzPrice])
				);
				strcat(STRING_GLOBAL, COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
			}
			ShowPlayerDialog(playerid, D_AMMO, DSTH, ""P"Магазин оружия", STRING_GLOBAL, "Купить", "Отмена"), STRING_GLOBAL[0] = EOS;
			return 1;
		}
		listitem = GetPVarInt(playerid, "temp_listitemid");
		new
			amount = strval(inputtext),
			bizid = TI[playerid][tSelectedBusinessID],
			itemid = gSellGunItems[listitem],
			price = floatround(amount * gSellGunPrices[listitem] * gBusiness[bizid][bizzPrice]);

		if(!(1 <= amount <= 1000)) {
			ShowPlayerDialog(playerid, D_AMMO_2, DIALOG_STYLE_INPUT, ""P"Покупка патрон", "\
				"W"Введите количество, которое хотите купить:",
				"Купить", "Назад"
			);
			return true;
		}
		if(gBusiness[bizid][bizzProduct] < gSellGunProds[listitem] * amount)
			return ErrorMessage(playerid, "В магазине недостаточно продуктов!");
		if(GetPlayerMoneyEx(playerid) < price)
			return ErrorMessage(playerid, "Недостаточно денег!");
		if(!GivePlayerItem(playerid, itemid, amount))
			return true;
		GiveMoney(playerid, -price, "buy ammo menu.2");

		format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы купили "P"\"%s\" (%i шт.) "G"за "ORANGE"$%i",
			InventoryItemInfo[itemid][itemName], amount, price
		);
		SendOk(playerid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;

		if(gBusiness[bizid][bizzProduct] - gSellGunProds[listitem] * amount > 0) {
			gBusiness[bizid][bizzProduct] -= gSellGunProds[listitem] * amount;
			bizz_pay(bizid, floatround(gSellGunPrices[listitem] * gBusiness[bizid][bizzPrice] * amount));
		}
		UpdateBusinessText(bizid);

		return 1;
	}
	case D_AMMO: {
		if(!response)
			return 1;
		new
			bizid = TI[playerid][tSelectedBusinessID],
			itemid = gSellGunItems[listitem],
			price = floatround(gSellGunPrices[listitem] * gBusiness[bizid][bizzPrice]);

