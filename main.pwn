			ShowPlayerDialog(playerid, D_BUYNARKO, DSI, ""P"Покупка наркотиков", string, "Купить", "Отмена");
			return 1;
		}
		new MaximalValue = GetVipReasonMaximalValue(playerid, TYPE_VIP_VALUE_DRUGS);
		if(ItemCounts(playerid, 007) + strval(inputtext) > MaximalValue) return ErrorMessage(playerid, "Вы не можете взять слишком много");
		if(GetPlayerMoneyEx(playerid) < pricedrugs * strval(inputtext)) return ErrorMessage(playerid, "У Вас недостаточно средств.");
