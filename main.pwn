	new Float:X, Float:Y, Float: Z;
	GetPlayerPos(playerid, X, Y, Z);
	foreach(new i: Player) {
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		switch(type) {
			case 1:	if(!PI[i][pPlayerSettings][PLAYER_SETTING_OOC_CHAT]) continue;
		}
		if(IsPlayerInRangeOfPoint(i, radi, X, Y, Z) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid)) SendClientMessageEx(i, color, string);
	}
	return true;
}*/
stock ProxDetectorS(Float: radi, playerid, targetid)
{
	if(IsPlayerConnected(playerid) && IsPlayerConnected(targetid))
	{
		new Float:posx, Float:posy, Float: posz;
		new Float:oldposx, Float:oldposy, Float: oldposz;
		new Float:tempposx, Float:tempposy, Float: tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		GetPlayerPos(targetid, posx, posy, posz);
		tempposx = (oldposx - posx);
		tempposy = (oldposy - posy);
		tempposz = (oldposz - posz);
		if(((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) return 1;
	}
	return 0;
}
stock DamageActive(playerid) {
	if(PI[playerid][pSettings][10]) return true;
	return false;
}
stock PlayerSpectate(playerid) {
	return TI[playerid][tSpectr];
}

//public OnPlayerDamage(&playerid, &Float: amount, &issuerid, &weapon, &bodypart)

#if !defined _INC_WEAPON_CONFIG
public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
#else
public OnPlayerDamage(&playerid, &Float: amount, &issuerid, &weapon, &bodypart)
#endif
{
	printf("OnPlayerDamage 1");

	if(!IsPlayerConnected(playerid) || !TI[playerid][tLogin])
		return false;
	#if !defined _INC_WEAPON_CONFIG
		new weapon = weaponid;
	#endif
	new Float:playerHealth;
	GetPlayerHealth(playerid, playerHealth);

	if(TI[playerid][tAFK] >= 3 || PI[playerid][pJailTime]) {
		// SetPlayerHealth(playerid, playerHealth);
		return false;
	}
	else if(player_gm{playerid} || IsPlayerInvisible(playerid)) {
		// SetPlayerHealth(playerid, playerHealth);
		return false;
	}
	else if(issuerid != INVALID_PLAYER_ID)
	{
		#if defined _invisible_inc
			if(IsPlayerInvisible(issuerid)) return false;
		#endif
		if(0 <= weapon <= 46 && playerid != INVALID_PLAYER_ID)
		{
			ghetto_OnPlayerDMG(issuerid, playerid, amount);

			if(TI[playerid][tGymSkill] && (PlayerToPoint(2.0, playerid, 768.5205, -2.8860, 1000.7214) || PlayerToPoint(2.0, playerid, 769.8723, 14.4393, 1000.6978))) {
				SetPlayerHealth(playerid, playerHealth);
				if(playerHealth < STAGE_1_DEATH_MIN_HEALTH + 10) SetPlayerHealth(playerid, STAGE_1_DEATH_MIN_HEALTH + 10);
			}
			if(weapon != 43 && weapon != 9 && GetPlayerSpecialAction(issuerid) != SPECIAL_ACTION_DRINK_SPRUNK && GetPlayerSpecialAction(issuerid) != SPECIAL_ACTION_DRINK_WINE && GetPlayerSpecialAction(issuerid) != SPECIAL_ACTION_SMOKE_CIGGY && GetPlayerSpecialAction(issuerid) != SPECIAL_ACTION_DRINK_BEER) {
				if(!IsACop(issuerid) && !IsAArm(issuerid) && PI[issuerid][pMember] != fWHITEHOUSE && IsAGreenZone(issuerid)) {
					ShowPlayerDialog(issuerid, DIALOG_NONE, DSM, ""P"Предупреждение", "\n\n"W"В данном месте запрещено драться\n"NO"*"G" В случае повторных нарушений Вы будете кикнуты", "Закрыть", "" );
					if(++anti_dm{issuerid} >= 5) {
						ErrorMessage(issuerid, "Вы были кикнуты за попытки DM в зеленой зоне");
						Kick(issuerid);
					}
					// SetPlayerHealth(playerid, playerHealth);
					return false;
				}
				if(IsPlayerInRangeOfPoint(playerid, 100.0, 1960.0000, 1015.0000, 995.0000) == 1) {
					// SetPlayerHealth(playerid, playerHealth);
					return 0x0;
				}
				if(anti_tk) {
					if(PI[issuerid][pMember] == PI[playerid][pMember] && FI[PI[playerid][pMember]][fAntiTK] && TI[playerid][tDuel] == -1 && TI[issuerid][tDuel] == -1 && player_to_game[issuerid] == 0 && player_to_golod[issuerid] == 0 && TI[issuerid][tGunArea][0] == 0 && TI[issuerid][tDMArea][0] == 0) {
						// SetPlayerHealth(playerid, playerHealth);
						ErrorMessage(issuerid, "Запрещено наносить урон членам своей организации");
						return false;
					}
				}
			}
		}
		// Стадия-1
		if(
			PI[playerid][pStageDeath] == 0 && !(22 <= weapon <= 34) && 
			(playerHealth <= STAGE_1_DEATH_MIN_HEALTH && (playerHealth-amount) > 0.0) && 
			!IsPlayerOnCapture(playerid) && !IsPlayerOnCapture(issuerid) && 
			TI[playerid][tDuel] == -1 && 
			!player_to_golod[playerid] && 
			!player_to_game[playerid] && 
			!TI[playerid][tDMArea][0] && 
			!TI[playerid][tGunArea][0] 
		) {
			OnPlayerUpdateDeathStage(playerid, 1);

			PI[playerid][pStageDeath] = 1;
			PI[playerid][pStageDeathTimer] = (60 * 4);

			GetPlayerPos(playerid, PI[playerid][pDeathPos][0], PI[playerid][pDeathPos][1], PI[playerid][pDeathPos][2]);
			GetPlayerFacingAngle(playerid, PI[playerid][pDeathPos][3]);
			PI[playerid][pDeathWorld] = GetPlayerVirtualWorld(playerid);
			PI[playerid][pDeathInterior] = GetPlayerInterior(playerid);

			if(IsPlayerInAnyVehicle(playerid)) {
				SetPlayerPosAC(playerid, PI[playerid][pDeathPos][0] + 0.2, PI[playerid][pDeathPos][1], PI[playerid][pDeathPos][2], PI[playerid][pDeathWorld], PI[playerid][pDeathInterior]);
				SetPlayerFacingAngle(playerid, PI[playerid][pDeathPos][3]);
			}
			TogglePlayerControllable(playerid, true);
			ApplyAnimation(playerid, "WUZI", "CS_Dead_Guy", 4.0, 0, 1, 1, 1, 0);

			SendClientMessage(playerid, 0xCCCCCCFF, "{A52A2A}(( Вы получили легкие ранения и можете вызвать врачей, чтобы не погибнуть: /ambulance ))");
			SendClientMessage(playerid, 0xCCCCCCFF, "{A52A2A}(( Чтобы отправиться в больницу: /hospital ))");

			SetPlayerChatBubble(playerid, "{A52A2A}(( Игрок ранен ))", 0xFF0000FF, 10.0, 30000);//, /dm для информации
			SetPlayerHealth(playerid, STAGE_1_DEATH_MIN_HEALTH);

			return false;
		}
	}
	#if defined _damages_included
		if(PI[playerid][pStageDeath] < 2 && issuerid != INVALID_PLAYER_ID && (0 <= weaponid < 50)) {
			damages_Record(playerid, bodypart, amount, weaponid/*, issuerid*/);
		}
	#endif
	return true;
}
