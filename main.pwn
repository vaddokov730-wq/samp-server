			ErrorMessage(leader_id, "Вы были сняты с поста лидера пользовательской организации.");
		if(!GetString(inputtext, "None")) {
			if(new_leader_id == INVALID_PLAYER_ID || !TI[new_leader_id][tLogin])
				return ErrorMessage(playerid, "Данного игрока нет на сервере в сети.");
			PI[new_leader_id][pOrgMember] = organization_id;
			PI[new_leader_id][pOrgRank] = OrganizationInfo[organization_id][orgRankCount];

			UpdatePlayerData(new_leader_id, "orgMember", OrganizationInfo[organization_id][orgID]);
			UpdatePlayerData(new_leader_id, "orgRank", PI[new_leader_id][pOrgRank]);

			for(new i = 0; i < (ORG_ACCESS_CMD_CAPTURE + 1); i++)
				PI[playerid][pOrgAccess][i] = 0;
			format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вас назначили лидером пользовательской организации - \"%s\".",
				OrganizationInfo[organization_id][orgName]
			);
			SendOk(new_leader_id, CHAT_GLOBAL);
		}
		format(OrganizationInfo[organization_id][orgLeader], MAX_PLAYER_NAME, inputtext);

		org_ShowMenu(playerid, ORG_MENU_EDIT_SELECT);
		SaveOrganization(organization_id);

