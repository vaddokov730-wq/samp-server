			return cs_ShowPlayerMenu(playerid, CS_MENU_IMPORT_CLASS);
		new cars_show_id = GetPlayerCarsShowID(playerid) - 1;
		if(cars_show_id < 0) return true;

		new i = GetPVarInt(playerid, "SelectedClassID"), bizz = CarsShowInfo[cars_show_id][csBizzID];

		new amount = strval(inputtext), warehouse_amount = 0;
		for(new slot = 0; slot < MAX_CAR_SLOT_SALE; slot++) {
			if(CarsShowInfo[cars_show_id][csCarsWarehouseID][slot] != i + 400)
				continue;
			warehouse_amount += CarsShowInfo[cars_show_id][csCarsWarehouseAmount][slot];
		}
		if(!(1 <= amount < MAX_CAR_SLOT_WAREHOUSE) || amount > VehicleImportInfo[i][viAmount] || amount > (MAX_CAR_SLOT_WAREHOUSE - warehouse_amount)) {
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
				"W"Введите количество ТС, которое хотите закупить:\n \n\
				"W"Выбранная марка транспорта: "P"%s "G"[ID: %d]\n\
				"W"Доступно для закупки: "P"%i шт.\n\
				"W"Стоимость: "GREEN"$%d\n \n\
				"G"На складе еще поместится %i/"#MAX_CAR_SLOT_WAREHOUSE" шт.",
				gTransport[i][trName], i + 400,
				VehicleImportInfo[i][viAmount],
				VehicleImportInfo[i][viPrice],
				MAX_CAR_SLOT_WAREHOUSE - warehouse_amount
			);
			return ShowPlayerDialog(playerid, D_CARS_SHOW_IMPORT_INPUT, DIALOG_STYLE_INPUT, ""P"Закупка транспорта", STRING_GLOBAL, "Принять", "Отмена");
		}
		if(gBusiness[bizz][bizzBank] < VehicleImportInfo[i][viPrice]) {
			///printf("bizzid %d csid %d", bizz, cars_show_id);
			return ErrorMessage(playerid, "На счету автосалона недостаточно средств!");
		}
		new found = 0;
		for(new slot = 0; slot < MAX_CAR_SLOT_SALE; slot++) {
			if(CarsShowInfo[cars_show_id][csCarsWarehouseID][slot] != i + 400)
				continue;
			CarsShowInfo[cars_show_id][csCarsWarehouseID][slot] = (i + 400);
			CarsShowInfo[cars_show_id][csCarsWarehouseAmount][slot] += amount;
			found = 1;

			break;
		}
		if(0 == found) {
			for(new slot = 0; slot < MAX_CAR_SLOT_SALE; slot++) {
				if(CarsShowInfo[cars_show_id][csCarsWarehouseID][slot] != 0)
					continue;
				CarsShowInfo[cars_show_id][csCarsWarehouseID][slot] = (i + 400);
				CarsShowInfo[cars_show_id][csCarsWarehouseAmount][slot] += amount;
				found = 1;

				break;
			}
		}
		gBusiness[bizz][bizzBank] -= VehicleImportInfo[i][viPrice];
		UpdateBusinessData(bizz + 1, "bank", gBusiness[bizz][bizzBank]);
		SaveCarsShow(cars_show_id);
		VehicleImportInfo[i][viAmount] -= amount;

		gTransport[i][trAmount] = VehicleImportInfo[i][viAmount];

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL),
			"UPDATE `transport` SET price=%i, amount=%i WHERE model=%i LIMIT 1",
			gTransport[i][trPrice], gTransport[i][trAmount], i + 400
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");

		SendOk(playerid, "Вы успешно закупили выбранный транспорт в автосалон.");
		return true;
	}
