				}
				DestroyDynamic3DTextLabel(quests_PI[playerid][pBotText]);
			}
			quests_PI[playerid][pBotText] = CreateDynamic3DTextLabel(!"Алекс значит? Мы про тебя наслышаны, ..\n..пока информации не ждем. Встретимся позже.", 0xFFFFFFFF,
