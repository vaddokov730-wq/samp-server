}
stock IsAArm(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	switch(GetTeamID(playerid))
	{
	case fARMYSF, fARMYLV: return 1;
	}
	return 0;
}
stock IsATaxi(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	switch(PI[playerid][bizz_work])
	{
	case 2..4: return 1;
	}
	return 0;
}
stock IsATK(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	switch(PI[playerid][bizz_work])
	{
	case 5..7: return 1;
	}
	return 0;
}



