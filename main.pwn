	case D_ORG_PANEL_RANK_COUNT: {
		if(!response)
			return org_ShowMenu(playerid, ORG_MENU_PANEL_MAIN);
		new amount = strval(inputtext), organization_id = PI[playerid][pOrgMember];
		if(!(MIN_ORGANIZATION_RANK <= amount <= MAX_ORGANIZATION_RANK))
			return org_ShowMenu(playerid, ORG_MENU_PANEL_RANK_COUNT);
		OrganizationInfo[organization_id][orgRankCount] = amount;
		SaveOrganization(organization_id);
		foreach(new i: Player) {
			if(!TI[i][tLogin] || i == playerid)
				continue;
			if(PI[i][pOrgMember] != organization_id)
				continue;
			if(PI[i][pOrgRank] > OrganizationInfo[organization_id][orgRankCount])
				PI[i][pOrgRank] = OrganizationInfo[organization_id][orgRankCount]; // Save
			UpdatePlayerData(i, "orgRank", PI[i][pOrgRank]);
		}
		PI[playerid][pOrgRank] = OrganizationInfo[organization_id][orgRankCount];
		UpdatePlayerData(playerid, "orgRank", PI[playerid][pOrgRank]);

		org_ShowMenu(playerid, ORG_MENU_PANEL_MAIN);
