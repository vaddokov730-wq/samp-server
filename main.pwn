	case D_DISEASE: {
		if(!response) return true;
		new i = PlayerGHealFix[playerid];

		new price_1 = 300;
		new price_2 = 500;
		new price_3 = PI[i][pAddiction] * 3;
		if(TYPE_VIP[i] != VIP_STATE_NONE)
		{
			price_1 = GetReasonMoneyPercentVip(i, TYPE_VIP_HEAL, price_1);
			price_2 = GetReasonMoneyPercentVip(i, TYPE_VIP_HEAL, price_2);
			price_3 = GetReasonMoneyPercentVip(i, TYPE_VIP_HEAL, PI[i][pAddiction] * 1);
		}

		switch(take_items[playerid][listitem])
		{
		case 0: {
			if(GetPlayerMoneyEx(i) < price_1) return ErrorMessage(playerid, "У игрока недостаточно средств");

			new string[128];
			format(string, sizeof(string), "Вы предложили "P"%s"G" лечение болезни грипп", player_name[i]);
