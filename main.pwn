		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT * FROM `accounts` WHERE `orgMember` = %i",
			OrganizationInfo[organization_id][orgID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "org_MemberList", "d", playerid), MYSQL_GLOBAL[0] = EOS;

		return true;
