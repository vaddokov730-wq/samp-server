	SendAdminActionMessage(COLOR_LIGHTRED, string);
	WriteLog(LOG_UNMUTE, playerid, player_name[playerid], player_name[giveplayerid], "снял бан OOC-чата");
	return true;
}
CMD:offmute(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new name[MAX_PLAYER_NAME], time, reason[31], giveplayerid;

	if(sscanf(params, "s[20]is[30]", name, time, reason)) return SendEsp(playerid, "/offmute [ник] [минуты] [причина]");
	if(strlen(reason) > 30) return ErrorMessage(playerid, "Причина должна быть меньше 30 символов");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return ErrorMessage(playerid, "Данный игрок онлайн");
	if(time > 300 || time < 5) return ErrorMessage(playerid, "От 5 до 300 минут");
	if(PlayerAdminFix[playerid] > gettime()) return ErrorMessage(playerid, "Можно раз в 10 секунд");
	PlayerAdminFix[playerid] = gettime() + 10;
	new query[128];
	format(query, sizeof(query), "SELECT * FROM `accounts` WHERE `Name` = '%s' LIMIT 1", name);
	new Cache: result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) {
		if(cache_is_valid(result)) cache_delete(result);
		return ErrorMessage(playerid, "Данный игрок не найден");
	}

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `accounts` SET mute = '%d' WHERE Name = '%s'", time * 60, name);
	mysql_tquery(connects, MYSQL_GLOBAL);
	if(cache_is_valid(result)) cache_delete(result);

	new string[144];
	format(string, sizeof(string), "Вы выдали мут игроку %s на %d минут", name, time);
	SendClientMessage(playerid, COLOR_LIGHTRED, string);

	format(string, sizeof(string), "[A] (OFFMUTE) %s[%d] выдал мут игроку %s на %d минут. Причина: %s", player_name[playerid], playerid, name, time, reason);
	AdmMSG(0xAFAFAFAA, string, 1);
	gAdmin[playerid][ADMIN_MUTE] ++;
	WriteLog(LOG_MUTE, playerid, player_name[playerid], name, reason);
	return 1;
}
CMD:weap(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendEsp(playerid, "/weap [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	new Gun[13], Ammos[13];

	STRING_GLOBAL[0] = EOS;
	for(new i = 0; i < 13; i++)
	{
		GetPlayerWeaponData(giveplayerid, i, Gun[i], Ammos[i]);
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"W"Slot: %i\t Weaponid: %i\t Ammo: %i\n", STRING_GLOBAL, i, Gun[i], Ammos[i]);
		if(i == 12) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n", STRING_GLOBAL);
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, player_name[giveplayerid], STRING_GLOBAL, "Закрыть", "");
	return 1;
}
CMD:cweap(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return true;
	new id;
	if(sscanf(params, "u", id)) return SendEsp(playerid, "/cweap [id]");
	new string[150];
	inventory_ResetWeapons(id, RESET_WEAPON_TYPE_FULL);
	format(string, sizeof(string), "Вы отобрали оружие у игрока %s[%d]", player_name[id], id);
	SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
	return true;
}
CMD:admins(playerid)
{
	if(PI[playerid][pAdmin] < 1 && TYPE_VIP[playerid] == VIP_STATE_NONE) return true;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE && PI[playerid][pAdmin] == 0 && VipData[TYPE_VIP[playerid]][VipAdmins] == 0) return 0x1;
	new countleader = 0;
	new str[156];
	new Admin[32];

	foreach(new i: Player)
	{
		if(!IsPlayerConnected(i) || (!TI[i][tLogin]) || (PI[i][pAdmin] <= 0)) continue;
		format(Admin, sizeof (Admin), GetAdminRankName(i, .color = 1));

		if(TI[i][tAFK] >= 3) {
			format(str, sizeof(str), ""W"%s - %s - %s - %s - %s - lvl:%d",
				player_name[i],
				TI[i][tAFK] >= 3 ? ("{ffa800}[AFK]") : (""),
				FlyMode[i] ? ("{FFE4B5}[FLY]") : ("{FFE4B5}[NO FLY]"),
				IsPlayerInvisible(i) ? ("{5F9EA0}[INV]") : ("{FFE4B5}[NO INV]"),
				Admin, PI[i][pAdmin]
			);
		}
		else if(TI[i][tAFK] < 3) {
		    format(str, sizeof(str), ""W"%s - %s - %s - %s - lvl:%d",
				player_name[i],
				FlyMode[i] ? ("{FFE4B5}[FLY]") : ("{FFE4B5}[NO FLY]"),
				IsPlayerInvisible(i) ? ("{5F9EA0}[INV]") : ("{FFE4B5}[NO INV]"),
				Admin, PI[i][pAdmin]
			);
		}
		SendClientMessage(playerid, 0xFFFFFFFF, str);
		countleader++;
	}
	if(countleader > 0)
	{
		new str_adm[128];
		format(str_adm, sizeof(str_adm), "В сети "W"%i"G" администратор(ов)", countleader);
		SendOk(playerid, str_adm);
	}
	else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Администрация", ""W"Нет администраторов в сети", "Закрыть", "");
	return 1;
}
CMD:afklist(playerid)
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new count = 0 ;

	STRING_GLOBAL[0] = EOS;
	foreach(new i : Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(TI[i][tAFK] < 3) continue;
		new str[128];
		format(str, sizeof(str), ""W"%s[%d] | %d LVL | "NO"AFK: %d\n", player_name[i], i, PI[i][pLevel], TI[i][tAFK]);
		strcat (STRING_GLOBAL, str);
		count++;
	}
	if(count == 0) return ErrorMessage(playerid, "Нет игроков в AFK");
	else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Игроки в AFK", STRING_GLOBAL, "Закрыть", "");
	return 1 ;
}
CMD:jail(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new time, text[31], string[144], giveplayerid;
	if(sscanf(params, "uds[30]", giveplayerid, time, text)) return SendEsp(playerid, "/jail [playerid] [минуты] [причина]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	if(PI[giveplayerid][pJailTime]) return ErrorMessage(playerid, "Игрок в тюрьме");
	if(time > 300 || time < 5) return ErrorMessage(playerid, "От 5 до 300 минут");
	if(strlen(text) > 30) return ErrorMessage(playerid, "Причина должна быть меньше 30 символов");
	if(IsAIP(text))return 1;
	format(string, sizeof(string), "Вы посадили %s в тюрьму", player_name[giveplayerid]);
	SendClientMessage(playerid, COLOR_LIGHTRED, string);

	format(string, sizeof(string), "Администратор %s посадил в ДеМорган %s на %d минут. Причина: %s", player_name[playerid], player_name[giveplayerid], time, text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);

	if(player_to_game[giveplayerid] == 1)
	{
		players_in_game--;
	}

	if(player_to_golod[giveplayerid] == 1)
	{
		players_in_golod--;
		golod_deatch(giveplayerid, players_in_golod);
	}

	// inventory_ResetWeapons(giveplayerid, RESET_WEAPON_TYPE_FULL);
	PI[giveplayerid][pJail] = 5;


	new TotalTime;
	new ReasonTime = time * 60;

	if(TYPE_VIP[giveplayerid] != VIP_STATE_NONE)
	{
		new FakeTime = (100 - VipData[TYPE_VIP[giveplayerid]][VipDemorgan]);
		TotalTime = (ReasonTime / 100) * FakeTime;
	}
	if(TYPE_VIP[giveplayerid] == VIP_STATE_NONE)
	{
		TotalTime = ReasonTime;
	}
	PI[giveplayerid][pJailTime] = TotalTime;

	if(PI[giveplayerid][pStageDeath]) {
		OnPlayerUpdateDeathStage(giveplayerid, 0);
		PI[giveplayerid][pStageDeath] = 0;
		PI[giveplayerid][pStageDeathTimer] = 0;
		SetPlayerChatBubble(giveplayerid, " ", 0xFF0000FF, 10.0, 100);
		TogglePlayerControllable(giveplayerid, true);
	}
	UpdatePlayerData(giveplayerid, "pJailTime", PI[giveplayerid][pJailTime]);
	UpdatePlayerData(giveplayerid, "pJail", 5);

	GameTextForPlayer(giveplayerid, "~w~YOU IN ~R~JAIL", 5000, 4);
	format(string, sizeof(string), "Вы были посажены в тюрьму администратором %s на %i минут(ы). Причина: %s", player_name[playerid], time, text);
	SendOk(giveplayerid, string);
	SendOk(giveplayerid, "Время до выхода на свободу: "W"/time");
	PlayerSpawn(giveplayerid);
	if(giveplayerid != playerid) gAdmin[playerid][ADMIN_JAIL] ++;
	WriteLog(LOG_JAIL, playerid, player_name[playerid], player_name[giveplayerid], text);
	return true;
}
CMD:offunjail(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new string[220], giveplayerid;
	if(isnull(params) || strlen(params) > 25) return SendEsp(playerid, "/offunjail [Nick Name]");
	sscanf(params, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return ErrorMessage(playerid, "Данный игрок онлайн");
	format(string, sizeof(string), "SELECT `pJailTime` FROM `accounts` WHERE `Name` = '%s' LIMIT 1", params);
	new jail = 0;
	new Cache: result = mysql_query(connects, string);
	new rows = cache_num_rows();
	if(rows > 0)
	{
		cache_get_value_int(0, "pJailTime", jail);
		if(jail == 0)
		{
			ErrorMessage(playerid, "Данный игрок не находится в КПЗ");
			if(cache_is_valid(result)) cache_delete(result);
			return 1;
		}
		MYSQL_GLOBAL[0] = EOS;
		format(MYSQL_GLOBAL, sizeof MYSQL_GLOBAL, "UPDATE `accounts` SET `pJailTime` = '0',`pJail` = '0' WHERE `Name` = '%s' LIMIT 1", params);
		mysql_pquery(connects, MYSQL_GLOBAL);
		new str[128];
		format(str, sizeof(str), "[A] %s[%d] вытащил из КПЗ в оффлайн игрока %s", player_name[playerid], playerid, params);
		AdmMSG(0xAFAFAFAA, str, 1);
	}
	if(cache_is_valid(result)) cache_delete(result);
	return 1;
}
CMD:offjail(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new name[MAX_PLAYER_NAME], time, reason[31], giveplayerid;
	if(sscanf(params, "s[20]is[30]", name, time, reason)) return SendEsp(playerid, "/offjail [ник] [минуты] [причина]");
	if(strlen(reason) > 30) return ErrorMessage(playerid, "Причина должна быть меньше 30 символов");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return ErrorMessage(playerid, "Данный игрок онлайн");
	if(time > 300 || time < 5) return ErrorMessage(playerid, "От 5 до 300 минут");

	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM `accounts` WHERE `Name` = '%e' LIMIT 1", name);
	new Cache: result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) {
		if(cache_is_valid(result)) cache_delete(result);
		return ErrorMessage(playerid, "Данный игрок не найден");
	}

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `accounts` SET pJail = '5',pJailTime = '%d' WHERE Name = '%s'",  time * 60, name);
	mysql_tquery(connects, MYSQL_GLOBAL);
	if(cache_is_valid(result)) cache_delete(result);

	new string[128];
	format(string, sizeof(string), "Вы посадили %s в тюрьму на %d минут", name, time);
	SendClientMessage(playerid, COLOR_LIGHTRED, string);

	format(string, sizeof(string), "Администратор %s посадил в ДеМорган %s на %d минут. Причина: %s", player_name[playerid], name, time, reason);
	SendAdminActionMessage(COLOR_LIGHTRED, string);

	gAdmin[playerid][ADMIN_JAIL] ++;
	WriteLog(LOG_JAIL, playerid, player_name[playerid], name, reason);
	return 1;
}
CMD:unjail(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendEsp(playerid, "/unjail [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	if(!PI[giveplayerid][pJailTime] && PI[giveplayerid][pJail] == 0) return ErrorMessage(playerid, "Игрок не в тюрьме");
	new string[128];
	format(string, sizeof(string), "Вы освободили %s", player_name[giveplayerid]);
	SendClientMessage(playerid, 0x09B000AA, string);
	format(string, sizeof(string), "[A] %s[%d] выпустил игрока %s[%d] из тюрьмы.", player_name[playerid], playerid, player_name[giveplayerid], giveplayerid);
	AdmMSG(CADMIN_INFO, string, 3);
	format(string, sizeof(string), "Администратор %s[%d] выпустил Вас на свободу!", player_name[playerid], playerid);
	SendOk(giveplayerid, string);
	PI[giveplayerid][pJailTime] = 0;
	PI[giveplayerid][pJail] = 0;
	UpdatePlayerData(giveplayerid, "pJailTime", 0);
	UpdatePlayerData(giveplayerid, "pJail", 0);
	PlayerSpawn(giveplayerid);
	WriteLog(LOG_UNJAIL, playerid, player_name[playerid], player_name[giveplayerid], "выпустил из тюрьмы");
	return 1;
}
CMD:prisoners(playerid, const params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;

	STRING_GLOBAL[0] = EOS;
	foreach(new i: Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(!PI[i][pJailTime]) continue;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"ORANGE"%s"W" | ID: "P"%d"W" | Время: "GREEN"%d\n", STRING_GLOBAL, player_name [i], i, PI[i][pJailTime]);
	}
	if(isnull(STRING_GLOBAL)) ErrorMessage(playerid, "Заключенных нет");
	else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Список заключенных", STRING_GLOBAL, "Закрыть", "");
	return 1;
}
alias:aad("msg");
CMD:aad(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2 || dostup[playerid] == 0) return true;
	if(isnull(params) || strlen(params) > 100) return SendEsp(playerid, "/aad [сообщение]");
	if(GetPVarInt(playerid, "aad") > gettime() && PI[playerid][pAdmin] < 4) return ErrorMessage(playerid, "Можно раз в 15 секунд");

	SetPVarInt(playerid, "aad", gettime() + 15);

	format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "%s %s: %s", 
		GetAdminRankName(playerid, .color = 0), player_name[playerid], params
	);
	SendClientMessageToAll(0xFFCD00AA, COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
	
	return 1;
}

CMD:checkedit(playerid)
{
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return true;
	ShowAdminAdvertList(playerid);
	return 0x1;
}
CMD:endcrupie(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/endcrupie [ID]");
	if(params[0] == INVALID_PLAYER_ID || IsPlayerConnected(params[0]) == 0) return ErrorMessage(playerid, "Данный игрок не авторизован на сервере");
	if(Casino_Flag[params[0]][casino_crup] == 0) return ErrorMessage(playerid, "Данный игрок не работает крупье");

	if(Casino_Flag[params[0]][select_casino_table] != -1)
	{
		for(new c = 0; c < MAX_DICE_TABLES; c++)
		{
			if(IsPlayerInDynamicArea(params[0], InfoDice[c][dice_area]))
			{
				if(Casino_Flag[params[0]][casino_crup] == 1 && InfoDice[c][dice_crup] == params[0]) InfoDice[c][dice_crup] = INVALID_PLAYER_ID;
				if(Casino_Flag[params[0]][select_casino_table] != -1 )
				{
					ShowCasino_TD(params[0], Casino_Flag[params[0]][select_casino_table]);
					Casino_Flag[params[0]][select_casino_table] = -1;
				}
				UpdateTextCasino(c);
				break;
			}
		}
	}

	Casino_Flag[params[0]][casino_crup] = 0;
	A_SetPlayerSkin(params[0], GetPVarInt(params[0], "oldskinkrup"));
	SetPVarInt(params[0], "krup", false);
	InventoryTempInfo[params[0]][tClothesSlotBlocked] = 0;

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Администратор %s закончил ваш рабочий день крупье", player_name[playerid]);
	SendClientMessage(params[0], 0xFFFF00FF, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы закончили рабочий день крупье %s", player_name[params[0]]);
	SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
	return 0x1;
}
CMD:gettime(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2 || dostup[playerid] == 0) return true;
	if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/gettime [ид игрока]");
	if(params[0] == 0xFFFF) return ErrorMessage(playerid, "Данный игрок не авторизован на сервере");
	if(IsPlayerConnected(params[0]) == 0) return ErrorMessage(playerid, "Данный игрок не авторизован на сервере");

	if(PI[params[0]][pMute] > 0)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, 128, "Осталось молчать: "P"%d секунд", PI[params[0]][pMute]);
		SendOk(playerid, STRING_GLOBAL);
	}
	if(PI[params[0]][pJailTime] > 0)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, 128, "Осталось сидеть: "P"%d секунд", PI[params[0]][pJailTime]);
		SendUse(playerid, STRING_GLOBAL);
	}
	new hour, minuite, second, year, month, day;
	gettime(hour, minuite, second);
	getdate(year, month, day);

	static const Names_Months[12][12] = {"января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"};
	static const Names_Days[7][12] = {"понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"};

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"W"Текущее время: "P"%02d:%02d\n\
		"W"Сегодняшняя дата: {33AA33}%s, %d %s %04d г.\n\n\
		"W"Время в игре за час:\t\t"YELLOW"%d мин\n\
		"W"Время в игре за сегодня:\t"P"%s\n\
		"W"Время в игре за вчера:\t"P"%s\n\
		"W"AFK за сегодня:\t\t"ORANGE"%s\n\
		"W"AFK за вчера:\t\t\t"ORANGE"%s",
		hour, minuite,
		Names_Days[weekcurrent], day, Names_Months[month - 1], year,
		PI[params[0]][pPlayTime][0],
		ConvertsCmdTime(gOnlinePlayer[params[0]][0]),
		ConvertsCmdTime(gOnlinePlayer[params[0]][1]),
		ConvertsCmdTime(gOnlinePlayerAFK[params[0]][0]),
		ConvertsCmdTime(gOnlinePlayerAFK[params[0]][1])
	);
	if(PI[params[0]][pMember] == 11 || PI[params[0]][pMember] == 12 || PI[params[0]][pMember] == 13) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"W"Отредактированных объявлений сегодня: "ORANGE"%d\n", STRING_GLOBAL, RepFractionLoad[params[0]][0]);

	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Точное время", STRING_GLOBAL, "Закрыть", "");
	return 1;
}
CMD:acpanel(playerid) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0)
		return true;
	PI[playerid][pAdminTypeCP]++;
	if(PI[playerid][pAdminTypeCP] == 3)
		PI[playerid][pAdminTypeCP] = 0;
	UpdatePlayerData(playerid, "AdminTypeCP", PI[playerid][pAdminTypeCP]);
	UpdateAdminCP(playerid);
	switch(PI[playerid][pAdminTypeCP]) {
		case 0: {
			SendOk(playerid, "Вы изменили тип панели читеров (стандарт - табличка).");
		}
		case 1: {
			SendOk(playerid, "Вы изменили тип панели читеров (текстовые строки).");
		}
		case 2: {
			SendOk(playerid, "Вы изменили тип панели читеров (выключено).");
		}
	}
	
	return true;
}
CMD:gm(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	if(player_gm{playerid})
	{
		player_gm{playerid} = 0;
		SendOk(playerid, "ГМ отключен");
	}
	else player_gm{playerid} = 1, SendOk(playerid, "ГМ включен");
	return 1;
}
CMD:alock(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	if(GetNearestVehicle(playerid) == -1) return 0x1;
	GetVehicleParamsEx(GetNearestVehicle(playerid), engine, lights, alarm, doors, bonnet, boot, objective);
	PlayerPlaySound(playerid, 24600, 0.0, 0.0, 0.0);
	switch(doors)
	{
	case 0: {
		GameTextForPlayer(playerid, "~r~LOCK", 5000, 3);
		SetVehicleDoorStatus(GetNearestVehicle(playerid), playerid);
	}
	case 1: {
		GameTextForPlayer(playerid, "~g~UNLOCK", 5000, 3);
		SetVehicleDoorStatus(GetNearestVehicle(playerid), playerid);
	}
	}
	return true;
}
CMD:ram(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new houseid = TI[playerid][tSelectHouse];

	if(!houseid && !IsPlayerInRangeOfPoint(playerid, 3.0, gHouses[houseid][houseX], gHouses[houseid][houseY], gHouses[houseid][houseZ]))
		return ErrorMessage(playerid, "Вы должны находиться у двери дома!");
	SetPlayerPosAC(playerid,
		hinterior_info[gHouses[houseid][houseHint]][h_pos_exit][0],
		hinterior_info[gHouses[houseid][houseHint]][h_pos_exit][1],
		hinterior_info[gHouses[houseid][houseHint]][h_pos_exit][2],
		houseid + 1, hinterior_info[gHouses[houseid][houseHint]][h_interior]
	);
	SetPlayerFacingAngle(playerid, hinterior_info[gHouses[houseid][houseHint]][h_pos_exit][3]);
	TI[playerid][tInHouse] = true;
	return true;
}
CMD:tp(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	ShowPlayerDialog(playerid, D_TP_LIST, DSL, ""P"Телепорт", "\
		"P"1."W" Организации\n\
		"P"2."W" Пользовательские организации\n\
		"P"3."W" Работы\n\
		"P"4."W" Вокзалы\n\
		"P"5."W" Банки\n\
		"P"6."W" Транспортные компании\n\
		"P"7."W" Таксопарки\n\
		"P"8."W" Прочее",
		"Выбрать", "Отмена"
	);
	return true;
}
CMD:relist(playerid)
{
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 0x1;

	new string[128];
	new count_recon = 0;
	foreach(new i: Player)
	{
		if(PI[i][pAdmin] > 0 && i != playerid && SERIU[i][sID] != 0xFFFF)
		{
			new Admin[32];
			format(Admin, sizeof (Admin), GetAdminRankName(i, .color = 0));

			format(string, sizeof(string), "%s(%d) %s[%d] следит за игроком %s[%d]", Admin, PI[i][pAdmin], player_name[i], i, player_name[SERIU[i][sID]], SERIU[i][sID]);
			SendClientMessage(playerid, 0xFFFF00FF, string);
			count_recon ++;
		}
	}
	if(count_recon == 0) return ErrorMessage(playerid, "Администрации в наблюдение нету");
	return 0x1;
}

CMD:re(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "Запрещено начинать слежку с транспорта");
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendEsp(playerid, "/re(con) [ид игрока]");
	if(giveplayerid == INVALID_PLAYER_ID) return ErrorMessage(playerid, not_id);
	if(!TI[giveplayerid][tLogin]) return ErrorMessage(playerid, "Игрок не авторизован");

	if(PI[giveplayerid][pAdmin] && GetPlayerState(giveplayerid) == PLAYER_STATE_SPECTATING && SERIU[giveplayerid][sID] != INVALID_PLAYER_ID && TI[SERIU[giveplayerid][sID]][tLogin]) {
		ErrorMessage(playerid, "Данный администратор в данный момент в режиме слежки.");
		giveplayerid = SERIU[giveplayerid][sID];
	}

	// if(isAdminStatus(player_name[giveplayerid], ADMIN_STATUS_OWNER)) return ErrorMessage(playerid, "Не надо тебе за ним наблюдать");

	if(SERIU[playerid][sID] == INVALID_PLAYER_ID)
	{
		//if(TI[playerid][tSpectate]==true) SpecPl(playerid,false);
		TI[playerid][preOrg] = PI[playerid][pMember];
		TI[playerid][preOrgg] = PI[playerid][pRank];
		GetPlayerPos(playerid, TI[playerid][Admin_X], TI[playerid][Admin_Y], TI[playerid][Admin_Z]);
		avir[playerid] = GetPlayerVirtualWorld(playerid);
		aint[playerid] = GetPlayerInterior(playerid);
		//TogglePlayerControllable(playerid,true);
		PlayerTextDrawShow(playerid, RECON[playerid]);
	}
	start_work[playerid] = true;
	PI[playerid][pMember] = PI[giveplayerid][pMember];
	PI[playerid][pRank] = 1;
	TI[playerid][pOldSkin] = GetPlayerSkin(playerid);
	SpecPlayer(playerid, giveplayerid);
	ShowMenuForPlayer(specmenu, playerid);
	
	new string[128];
	format(string, sizeof(string), "[A] %s[%d] начал слежку за игроком %s[%d]", player_name[playerid], playerid, player_name[giveplayerid], giveplayerid);
	AdmMSG(0xAFAFAFAA, string, 1);
	return 1;
}
CMD:reoff(playerid, const params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	Lastspec[playerid] = SERIU[playerid][sID];
	HideMenuForPlayer(specmenu, playerid);
	printf("[id:%d] avir = %d SERIU[playerid][sID] %d", playerid, avir[playerid], SERIU[playerid][sID]);
	PlayerSpawn(playerid);
	return 1;
}
CMD:getskills(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendEsp(playerid, "/getskills [id игрока]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	new strname[56];
	format(strname, sizeof(strname), "{ffcf00}Навыки владения оружия %s", player_name[giveplayerid]);
	new strkill[1006];
	new points[6];
	points[0] = 100 - PI[giveplayerid][pGunSkill][0];
	points[1] = 100 - PI[giveplayerid][pGunSkill][1];
	points[2] = 100 - PI[giveplayerid][pGunSkill][2];
	points[3] = 100 - PI[giveplayerid][pGunSkill][3];
	points[4] = 100 - PI[giveplayerid][pGunSkill][4];
	points[5] = 100 - PI[giveplayerid][pGunSkill][5];
	format(strkill, 1000, ""W"SD-Pistol:\t"P"%s "W"%d/100%%\nDesert Eagle:\t"P"%s "W"%d/100%%\nShotGun:\t"P"%s "W"%d/100%%\nMP5\t\t"P"%s "W"%d/100%%\nAK47:\t\t"P"%s "W"%d/100%%\nM4:\t\t"P"%s "W"%d/100%%",
		   ToDevelopSkills(PI[giveplayerid][pGunSkill][0], points[0]), PI[giveplayerid][pGunSkill][0],
		   ToDevelopSkills(PI[giveplayerid][pGunSkill][1], points[1]), PI[giveplayerid][pGunSkill][1],
		   ToDevelopSkills(PI[giveplayerid][pGunSkill][2], points[2]), PI[giveplayerid][pGunSkill][2],
		   ToDevelopSkills(PI[giveplayerid][pGunSkill][3], points[3]), PI[giveplayerid][pGunSkill][3],
		   ToDevelopSkills(PI[giveplayerid][pGunSkill][4], points[4]), PI[giveplayerid][pGunSkill][4],
		   ToDevelopSkills(PI[giveplayerid][pGunSkill][5], points[5]), PI[giveplayerid][pGunSkill][5]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, strname, strkill, "Закрыть", "");
	return 1;
}
//-----------------------------------------[2 уровень]-------------------------------------------//

CMD:aimcheck(playerid)
{
	if(PI[playerid][pAdmin] < 2 || dostup[playerid] == 0) return true;
	if(SERIU[playerid][sID] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "Вы ни за кем не следите");
	new targetid = GetPlayerTargetPlayer(SERIU[playerid][sID]);
	if(targetid != INVALID_PLAYER_ID && GetPlayerState(targetid) == 1 && TI[targetid][tAFK] < 3)
	{
		new Float:x[2], Float:y[2], Float:z[2], Float: a;
		GetPlayerPos(SERIU[playerid][sID], x[0], y[0], z[0]);
		GetPlayerFacingAngle(SERIU[playerid][sID], a);
		GetXYInFrontOfPoint(x[0], y[0], a, -3.0);
		new Float: aimhp;
		GetPlayerHealth(targetid, aimhp);
		SetPVarFloat(targetid, "aimtest", aimhp);
		GetPlayerPos(targetid, x[1], y[1], z[1]);
		SetPlayerPosAC(targetid, x[0], y[0], z[0], TI[targetid][tVirtualWorld], TI[targetid][tInterior]);
		SetPlayerHealth(targetid, 300);
		SendClientMessage(targetid, COLOR_YELLOW, "Не волнуйтесь! Это обычная проверка на аим");
		SetTimerEx("onPTMCheck", 500, false, "iifffi", SERIU[playerid][sID], targetid, x[1], y[1], z[1], playerid);
		new string[128];
		format(string, sizeof string, "[A] %s[%d] проверяет игрока %s[%d] на аим", player_name[playerid], playerid, player_name[SERIU[playerid][sID]], SERIU[playerid][sID]);
		SendAdminMessage(COLOR_GREY, string);
	}
	else ErrorMessage(playerid, "Игрок ни в кого не целится");
	return 1;
}
CB:onPTMCheck(playerid, targetid, Float: x, Float: y, Float: z, checker)
{
	TimerCallFix[19] ++;
	SetPlayerHealth(targetid, GetPVarFloat(targetid, "aimtest"));
	DeletePVar(targetid, "aimtest");
	SetPlayerPosAC(targetid, x, y, z, TI[targetid][tVirtualWorld], TI[targetid][tInterior]);
	SendClientMessage(checker, -1, "Если игрок повернулся на {FF9900}180 градусов"W", то он использует AIM");
}
CMD:get(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2 || dostup[playerid] == 0) return true;
	if(isnull(params) || strlen(params) > 23)  return SendEsp(playerid, "/get [Nick Name]");

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT `pID`, `Name`, `pCash`, `pLevel`, `pIpReg`, `pvIp`, `pDataReg`, `donatemoney` FROM `accounts` WHERE `Name` = '%s' LIMIT 1", params);
	mysql_tquery(connects, MYSQL_GLOBAL, "get_info_player", "i", playerid);
	return 1;
}
alias:spcar("scar");
CMD:spcar(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2 || dostup[playerid] == 0) return true;
	SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	return true;
}
CMD:gotocar(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return true;
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/gotocar [id]");
	new Float:x, Float:y, Float: z;
	GetVehiclePos(params[0], x, y, z);
	#if defined _flymode_inc
	if(FlyMode[playerid]) {
		SetFlyModePos(playerid, x, y, z);
		SetPlayerInterior(playerid, ac_AntiCheatGetVehicleInterior(params[0]));
		SetPlayerVirtualWorld(playerid, GetVehicleVirtualWorld(params[0]));
		return true;	
	}
	#endif
	SetPlayerPosAC(playerid, x, y, z, GetVehicleVirtualWorld(params[0]), ac_AntiCheatGetVehicleInterior(params[0]));
	return true;
}
CMD:getherecar(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new id, string[150], Float:X, Float:Z, Float: Y;
	if(sscanf(params, "d", id)) return SendEsp(playerid, "/getherecar [id]");
	GetPlayerPos(playerid, X, Y, Z);
	SetVehicleVirtualWorld(id, GetPlayerVirtualWorld(playerid));
	LinkVehicleToInterior(id, GetPlayerInterior(playerid));
	SetVehiclePos(id, X - 4, Y, Z + 1);
	format(string, sizeof(string), "Вы телепортировали к себе авто ID: "W"%d", id);
	SendOk(playerid, string);
	return true;
}

cmd:virtualworld(playerid, params[])
{
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0)
		return true;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Current VirtualWorld: %d", GetPlayerVirtualWorld(playerid));
	SendClientMessage(playerid, 0xADC7E7FF, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;
	return true;
}
cmd:gotopos(playerid, params[])
{

	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0)
		return true;
	new Float: x, Float: y, Float: z, int, world;
	if(sscanf(params, "fffii", x, y, z, int, world))
		return SendEsp(playerid, "/gotopos [X] [Y] [Z] [Interior] [World]");

	SetPlayerPosAC(playerid, x, y, z);
	SetPlayerInterior(playerid, int);
	SetPlayerVirtualWorld(playerid, world);

	SendOk(playerid, "Вы телепортировались по указанным координатам.");
	return true;
}
