	case dGiveGunTD: {
		if(!response) return true;
		if(!PI[playerid][pMember]) return 1;

		if(strfind(inputtext, "Бронежилет") != -1)
		{
			//SetPlayerArmour(playerid, 100.0);
			GivePlayerItem(playerid, 500, 100);
			return true;
		}
		if(listitem == 9 && PI[playerid][pMember] == 4)  AC_GivePlayerWeapon(playerid, 31, 100),	FI[fFBI][fMats] -= 100, UpdateFraction(fFBI, "Mats", FI[fFBI][fMats]);
		if(listitem >= 10) return true;
		if(GunTickGet[playerid][listitem] > unix) return ErrorMessage(playerid, "Нельзя брать оружие слишком часто");

		new team;
		switch(GetPlayerVirtualWorld(playerid))
		{
		case 40: team = fLSPD;
		case 41: team = fSFPD;
		case 42: team = fLVPD;
		case 43: team = fFBI;
		}
		for(new i = 0 ; i < 10 ; i++)
		{
			if(strfind(inputtext, FW[i][team][fwName]) != -1)
			{
				new count_minus = 100;
				switch(FW[i][team][fwGunID])
				{
				case 24: count_minus = 60;
				case 25: count_minus = 60;
				case 29: count_minus = 80;
				case 31: count_minus = 100;
				case 30: count_minus = 100;
				case 34: count_minus = 250;
				case 99: count_minus = 30;
				default: count_minus = 90;
				}
				if(FI[team][fMats] < count_minus)
					return ErrorMessage(playerid, "Недостаточно боеприпасов");
				if(IsACop(playerid) && PI[playerid][pRank] == 1 && FW[i][team][fwGunID] != 3) {
					ErrorMessage(playerid, "Для Вашего ранга доступна только дубинка");
					return true;
				}
				if(FW[i][team][fwGunID] == 99) {
					GunTickGet[playerid][listitem] = unix + 20;
					FI[team][fMats] -= count_minus;
					UpdateFraction(team, "Mats", FI[team][fMats]);
					new MaximalValue = GetVipReasonMaximalValue(playerid, TYPE_VIP_VALUE_MASK);
					if(PI[playerid][pMask] >= MaximalValue)
					{
						new string[128];
						format(string, sizeof(string), "Нельзя хранить больше %d масок", MaximalValue);
						ErrorMessage(playerid, string);
						return 1;
					}
					/*PI[playerid][pMask] += 1;
					UpdatePlayerData(playerid, "pMask", PI[playerid][pMask]);*/
					GivePlayerItem(playerid, 4, 1);
					SendUse(playerid, "Использовать маску - "W"/mask");
					return 1;
				}
				if(!inventory_GiveWeapon(playerid, FW[i][team][fwGunID], FW[i][team][fwGunAmmo], 2)) return true;

				GunTickGet[playerid][listitem] = unix + 20;
				FI[team][fMats] -= count_minus;
				UpdateFraction(team, "Mats", FI[team][fMats]);
				break;
			}
		}
		ShowGetGun(playerid);
		return true;
	}
	case D_GETGUN_MENU: {
