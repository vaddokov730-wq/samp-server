			return ErrorMessage(playerid, "У вас нет доступа! (6)");
		new organization_id = GetPVarInt(playerid, "organizationTempID");

		foreach (new i: Player) {
			if(!TI[i][tLogin]) continue;
			if(PI[i][pOrgMember] != organization_id) continue;
			PI[i][pOrgMember] = PI[i][pOrgRank] = 0;
			ErrorMessage(i, "Внимание! Ваша организация была расформирована администрацией.");
		}

		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "\
			UPDATE `accounts` SET `orgMember`=0,`orgRank`=0 WHERE `orgMember`=%i",
			OrganizationInfo[organization_id][orgID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL), MYSQL_GLOBAL[0] = EOS;

		format(OrganizationInfo[organization_id][orgLeader], MAX_PLAYER_NAME, "None");
		SaveOrganization(organization_id);

		SendOk(playerid, "Вы успешно расформировали пользовательскую организацию.");

		return true;
	}
	case D_ORG_EDIT_DELETE: {
		if(!response)
			return org_ShowMenu(playerid, ORG_MENU_EDIT_SELECT);
		if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0)
			return ErrorMessage(playerid, "У вас нет доступа! (7)");
		new organization_id = GetPVarInt(playerid, "organizationTempID");

		foreach (new i: Player) {
			if(!TI[i][tLogin]) continue;
			if(PI[i][pOrgMember] != organization_id) continue;
			PI[i][pOrgMember] = PI[i][pOrgRank] = 0;
			ErrorMessage(i, "Внимание! Ваша организация была удалена администрацией.");
		}

		MYSQL_GLOBAL[0] = EOS;

		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `accounts` SET `orgMember`=0,`orgRank`=0 WHERE `orgMember`=%i",
			OrganizationInfo[organization_id][orgID]
		);
		mysql_tquery(connects, MYSQL_GLOBAL), MYSQL_GLOBAL[0] = EOS;

