		case 1: ShowPlayerDialog(playerid, D_OBC_BD_NUMBER, DSI, ""P"База данных", "\n\n"W"Введите гос. номер автомобиля:\n"G"Примечание: X XXX XX - формат номера\n\n", "Выбрать", "Отмена");
