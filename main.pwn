		PI[playerid][pDeathPos][0], PI[playerid][pDeathPos][1], PI[playerid][pDeathPos][2], PI[playerid][pDeathPos][3],
		PI[playerid][pDeathInterior], PI[playerid][pDeathWorld]
	);
	strcat(STRING_GLOBAL, str, sizeof(STRING_GLOBAL));

	format(str, sizeof(str), "stageDeathLastTime='%i',",
