				else if(GetChips(playerid) < money)
				{
					ErrorMessage(playerid, "У Вас недостаточно фишек");
					SendOk(id, "У игрока недостаточно фишек");
					return 1;
				}
				else if(GetChips(id) < money)
				{
					SendOk(playerid, "У игрока недостаточно фишек");
					ErrorMessage(id, "У Вас недостаточно фишек");
					return 1;
				}
				else if(GetPlayerInterior(playerid) != CASINO_INTERIOR_ID || GetPlayerVirtualWorld(playerid) != 1)
					return ErrorMessage(playerid, "Вы должны находиться в казино!");

				new dice_table_id = -1;
				for(new dice_tableid = 0; dice_tableid < sizeof (CasinoDiceTableInfo); dice_tableid++) {
					if(!IsPlayerInRangeOfPoint(playerid, 4.0, CasinoDiceTableInfo[dice_tableid][0], CasinoDiceTableInfo[dice_tableid][1], CasinoDiceTableInfo[dice_tableid][2]))
						continue;
					dice_table_id = dice_tableid;
					break;
				}
				if(dice_table_id == -1)  {
					SendOk(id, "Игрок отклонил Ваше предложение");
					return ErrorMessage(playerid, "Вы должны находиться у игрового стола!");
				}
				new dice = random(6) + 1, dice1 = random(6) + 1;
				new string[128];
				format(string, sizeof(string), "%s и %s бросили кости. Результат: {CC9900}%i:%i", player_name[id], player_name[playerid], dice, dice1);
				ProxDetector(15.0, playerid, string, 0x44b2ffff);
				SetTimerEx("DiceOff", 5000, false, "ii", playerid, id);
				TI[id][tKubik] = 1;
				TI[playerid][tKubik] = 1;
				TI[playerid][tDiceTime] = TI[id][tDiceTime] = unix + 10;
				format(string, sizeof(string), "Выпало: %i", dice1);
				SetPlayerChatBubble(playerid, string, COLOR_ORANGE, 30.0, 10000);
				format(string, sizeof(string), "Выпало: %i", dice);
				SetPlayerChatBubble(id, string, TEAM_GROVE_COLOR, 30.0, 10000);

				ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);
				ApplyAnimation(id, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);

				//SetPlayerAttachedObject(playerid, ATTACH_SLOT_OTHER, 1851, 1, 0.062400, 0.453750, 0.000000, 0.000000, 94.689310, 0.000000);
				//SetPlayerAttachedObject(id, ATTACH_SLOT_OTHER, 1851, 1, 0.062400, 0.453750, 0.000000, 0.000000, 94.689310, 0.000000);

				SetPlayerAttachedObject(playerid, ATTACH_SLOT_OTHER, 1851, 6, 0.028000, 0.126000, -0.199999,
					casinoDiceAttachOffset[dice1 - 1][0], casinoDiceAttachOffset[dice1 - 1][1],
					casinoDiceAttachOffset[dice1 - 1][2], 1.000000, 1.000000, 1.100999
				);
				SetPlayerAttachedObject(id, ATTACH_SLOT_OTHER, 1851, 6, 0.028000, 0.126000, -0.199999,
					casinoDiceAttachOffset[dice - 1][0], casinoDiceAttachOffset[dice - 1][1],
					casinoDiceAttachOffset[dice - 1][2], 1.000000, 1.000000, 1.100999
				);

				if(dice > dice1)
				{
					GiveChips(id, money, "выиграл в dice");
					GiveChips(playerid, -money, "проиграл в dice");
