		SetDynamicAreaType(gTeleportsToD[i][tpArea], AREA_TYPE_TELEPORT_PICKUP, i, gTeleportsToD[i][tpID]);
		CreateDynamicPickup(1318, 1, gTeleportsToD[i][tpEnterPos_X], gTeleportsToD[i][tpEnterPos_Y], gTeleportsToD[i][tpEnterPos_Z], gTeleportsToD[i][tpEnterWorld], gTeleportsToD[i][tpEnterInt]);
	}
	for(new pickupid = 0, area; pickupid < sizeof (gPickups); pickupid++) {
		CreateDynamicPickup(gPickups[pickupid][picModel], 23,
			gPickups[pickupid][picPosition][0], gPickups[pickupid][picPosition][1], gPickups[pickupid][picPosition][2],
			gPickups[pickupid][picWorld], gPickups[pickupid][picInterior]
		);
		area = gPickups[pickupid][picArea] = CreateDynamicSphere(
			gPickups[pickupid][picPosition][0], gPickups[pickupid][picPosition][1], gPickups[pickupid][picPosition][2], 1.0,
			gPickups[pickupid][picWorld], gPickups[pickupid][picInterior]
		);
		SetDynamicAreaType(area, AREA_TYPE_PICK_ID, pickupid, gPickups[pickupid][picID]);

		if(!GetString(gPickups[pickupid][picName], "None")) {
			CreateDynamic3DTextLabel(gPickups[pickupid][picName],
				gPickups[pickupid][picColor], gPickups[pickupid][picPosition][0], gPickups[pickupid][picPosition][1],
