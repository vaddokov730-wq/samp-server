CMD:offstats(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return true;
	new text = strlen(params);
	if(!text) return SendEsp(playerid, "/offstats [Nick Name]");
	if(text < 3 || text > 24) return ErrorMessage(playerid, "От 3 до 24 символов");

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT * FROM `accounts` WHERE `Name` = '%e' LIMIT 1", params);
	mysql_tquery(connects, MYSQL_GLOBAL, "AGetStats", "is", playerid, params);
	return 1;
}
CMD:getid(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendEsp(playerid, "/getid [ID]");

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT * FROM `accounts` WHERE `pID` = '%d' LIMIT 1", giveplayerid);
	mysql_tquery(connects, MYSQL_GLOBAL, "AGetID", "ii", playerid, giveplayerid);
	return 1;
}
