stock save_slotitem(playerid)
{

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE accounts SET pSlotItem = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `pID` = '%d' LIMIT 1", PI[playerid][pSlotItem][0], PI[playerid][pSlotItem][1], PI[playerid][pSlotItem][2],
		   PI[playerid][pSlotItem][3], PI[playerid][pSlotItem][4], PI[playerid][pSlotItem][5], PI[playerid][pSlotItem][6], PI[playerid][pSlotItem][7], PI[playerid][pID]);
	mysql_tquery(connects, MYSQL_GLOBAL);
