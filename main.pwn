		"ORANGE"--------------------------------\n\
		"W"Зарплата\t"P"%d%s\n\
		"W"Игровой опыт\t"P"X%d\n\
		"W"Создание оружия\t"P"X%d",
				   BonusData[BonusVip] ? ("Включено") : ("Отключено"),
				   DonateData[DonateMoney] * DonateData[DonateUpdate],
				   BonusData[BonusMoney], string_percent,
