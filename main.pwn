				TextDrawHideForPlayer(playerid, CustomTD[h]);
			}
			new vehicleid = GetPlayerVehicleID(playerid);
			for(new p = 1000; p < 1194; p++)
			{
				RemoveVehicleComponent(vehicleid, p);
