	CreateJobVehicle(50, 530, 269.2901, 1459.4288, 10.3161, 177.4821, 1, 1, RES_CAR_TIME); // Погрузочник
*/

	for(new i = GetVehiclePoolSize() + 1, tmpobjid, modelid; --i != 0;)
	{
		SignalTick[i][1] = -1;
		LightsObject[i][0] = -1;
		LightsObject[i][1] = -1;
		SetVehicleParamsEx(i, false, false, false, false, false, false, false);
		if(!VehicleInfo[i][vJob] && !VehicleInfo[i][vTeam])
			continue;
		modelid = GetVehicleModel(i);
		VehicleInfo[i][vFuel] = gTransport[modelid - 400][trTank];
		VehicleInfo[i][vPlayer] = -1;

		VehicleInfo[i][vWorld] = 0;
		VehicleInfo[i][vInterior] = 0;

		switch(VehicleInfo[i][vTeam]) {
			case fTRPD, fBCPD, fRCPD: {
				switch(modelid) {
					case 402: {
