			ShowPlayerDialog(playerid, dArendatorAction, DSI, ""P"Жители", "\n\n"W"Введите ID игрока, которого хотите подселить в дом:\n\n", "Ввод", "Закрыть");
		}
		else ShowPlayerDialog(playerid, dZhitelSettings, DSL, ""P"Жители", "Выселить жителя", "Выбрать", "Закрыть");
		PlayerArendaFix[playerid] = listitem + 1;
