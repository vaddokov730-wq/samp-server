	case D_DONATE_BANK_3: {
		if(!response) return 1;
		switch(listitem)
		{
		case 0: ShowPlayerDialog(playerid, D_BANK, DSL, ""P"Банк", "Активные счета\nОткрыть новый счет", "Выбрать", "Назад");
		case 1: {
			#if defined _angars_included
				return ShowPlayerDialog(playerid, D_BANK_OPLATA, DSL, ""P"Оплата недвижимости", ""P"1."W" Дом\n"P"2."W" Бизнес\n"P"3."W" Отель\n"P"4."W" Аэропорт\n"P"5."W" Ангар", "Выбрать", "Отмена");
			#else
				return ShowPlayerDialog(playerid, D_BANK_OPLATA, DSL, ""P"Оплата недвижимости", ""P"1."W" Дом\n"P"2."W" Бизнес\n"P"3."W" Отель\n"P"4."W" Аэропорт", "Выбрать", "Отмена");
			#endif
		}
		}
	}
	case D_FAKE_PROMO_CREATE: {
		if(!response) return 0x1;
		if(!strlen(inputtext)) return pc_cmd_createbonus(playerid);
		if(strlen(inputtext) < 1 || strlen(inputtext) > 15)
		{
			ErrorMessage(playerid, "Длина бонус-кода должна быть от 1 до 15 символов");
			pc_cmd_createbonus(playerid);
			return 0x1;
		}
		format(PlayerPromoText[playerid], 16, "%s", inputtext);
		ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_1, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество активаций бонус-кода", "Принять", "Отмена");
		return 0x1;
	}
	case D_FAKE_PROMO_CREATE_1: {
		if(!response) return 0x1;
		if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_1, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество активаций бонус-кода", "Принять", "Отмена");
		if(strval(inputtext) < 1) return ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_1, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество активаций бонус-кода", "Принять", "Отмена");

		PlayerPromoCount[playerid] = strval(inputtext);
		ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_2, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество денег которое будет выдаваться при вводе бонус-кода", "Принять", "Отмена");
		return 0x1;
	}
	case D_FAKE_PROMO_CREATE_2: {
		if(!response) return 0x1;
		if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_2, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество денег которое будет выдаваться при вводе бонус-кода", "Принять", "Отмена");
		if(strval(inputtext) < 0) return ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_2, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество денег которое будет выдаваться при вводе бонус-кода", "Принять", "Отмена");

		PlayerPromoMoney[playerid] = strval(inputtext);
		ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_3, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество доната которое будет выдаваться при вводе бонус-кода", "Принять", "Отмена");
		return 0x1;
	}
	case D_FAKE_PROMO_CREATE_3: {
		if(!response) return 0x1;
		if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_3, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество доната которое будет выдаваться при вводе бонус-кода", "Принять", "Отмена");
		if(strval(inputtext) < 0) return ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_3, DIALOG_STYLE_INPUT, ""P"Создание бонус-кода", "Введите количество доната которое будет выдаваться при вводе бонус-кода", "Принять", "Отмена");

		PlayerPromoDonate[playerid] = strval(inputtext);

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
	"W"Бонус-код: "P"%s\n\n\
	\
	"W"Количество активаций: "P"%d\n\
	"W"Количество Donate Coint: "P"%d\n\
	"W"Количество Виртуальной валюты: "P"%d\n\n\
	\
	Вы уверены что хотите создать бонус-код", PlayerPromoText[playerid], PlayerPromoCount[playerid], PlayerPromoDonate[playerid], PlayerPromoMoney[playerid]);
		ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE_4, DIALOG_STYLE_MSGBOX, ""P"Создание бонус-кода", STRING_GLOBAL, "Принять", "Отмена");
		return 0x1;
	}
	case D_FAKE_PROMO_CREATE_4: {
		if(!response) return 0x1;

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "INSERT INTO `fake_promo` (`Code`, `Money`, `Donate`, `UseCode`) VALUES ('%s', '%d', '%d', '%d')", PlayerPromoText[playerid], PlayerPromoMoney[playerid], PlayerPromoDonate[playerid], PlayerPromoCount[playerid]);
		mysql_pquery(connects, MYSQL_GLOBAL, "", "");

		SendClientMessage(playerid, 0xFFFF00FF, "Бонус-Код успешно создан");
		return 0x1;
	}
	case D_FAKE_PROMO: {
		if(!response) return 0x1;
		if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_FAKE_PROMO, DIALOG_STYLE_INPUT, ""P"Ввод бонус-кода", ""W"Введите ваш бонус-код", "Принять", "");
		if(strlen(inputtext) < 1 || strlen(inputtext) > 15) return ErrorMessage(playerid, "Длина бонус-кода должна быть от 1 до 15 символов");
		if(is_text_invalid(inputtext)) return ErrorMessage(playerid, "Присутствуют запрещенные символы");

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "SELECT * FROM `fake_promo` WHERE `Code` = '%s'", inputtext);
		mysql_tquery(connects, MYSQL_GLOBAL, "OnMemoryCheckFakePromo", "is", playerid, inputtext);
	}
	default: {
		#if defined _events_inc
			if(events_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _diary_inc
			if(diary_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
	}
	}
	while (strfind(inputtext, "%s", true) != -1)
	{
		strdel(inputtext, strfind(inputtext, "%s", true), strfind(inputtext, "%s", true) + 2);
	}
	return true;
}//диалоги

CB:OnMemoryCheckFakePromo(playerid, fake_promo[])
{

	new rows;
	cache_get_row_count(rows);

	if(!rows) return ErrorMessage(playerid, "Данный бонус-код не обнаружен");

	new Money;
	new Donate;
	new UseFakeCode;

	cache_get_value_name_int(0,  "Money",      Money);
	cache_get_value_name_int(0,  "Donate",    Donate);
	cache_get_value_name_int(0,  "UseCode",  UseFakeCode);

	new string;
	STRING_GLOBAL[0] = EOS;
	mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `fake_promo_use` WHERE `ID` = '%d' AND `Code` = '%s'", PI[playerid][pID], fake_promo);
	new Cache: result = mysql_query(connects, STRING_GLOBAL);
	cache_get_row_count(string);
	if(!string)
	{
		UseFakeCode -= 1;
		if(cache_is_valid(result)) cache_delete(result);

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"W"Вы использовали бонус код "P"%s\n\n\
		\
		"W"В качестве бонуса вам начислено:\n\
		"W"Donate Coin: "P"%d\n\
		"W"Виртуальной валюты: "P"%d", fake_promo, Donate, Money);
		ShowPlayerDialog(playerid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, ""P"Активация бонус-кода", STRING_GLOBAL, "Скрыть", "");

		GiveMoney(playerid, Money, "Активация бонус-кода");
		PI[playerid][pRouble] += Donate;
		UpdatePlayerData(playerid, "donatemoney", PI[playerid][pRouble]);

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "INSERT INTO `fake_promo_use` (`ID`, `Code`) VALUES ('%d', '%s')", PI[playerid][pID], fake_promo);
		mysql_pquery(connects, MYSQL_GLOBAL, "", "");

		if(UseFakeCode <= 0)
		{
			MYSQL_GLOBAL[0] = EOS;
			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "DELETE FROM `fake_promo` WHERE `Code` = '%s'", fake_promo);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			return 0x1;
		}
		if(UseFakeCode >= 0)
		{
			MYSQL_GLOBAL[0] = EOS;
			mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `fake_promo` SET `UseCode` = '%d' WHERE `Code` = '%s'", UseFakeCode, fake_promo);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			return 0x1;
		}
	}
	else
	{
		ErrorMessage(playerid, "Вы уже использовали данный бонус-код");
		if(cache_is_valid(result)) cache_delete(result);
		return 0x1;
	}
	return 0x1;
}
public OnPlayerEnterDynamicArea(playerid, areaid) {
	if(!TI[playerid][tLogin] || SERIU[playerid][sID] != INVALID_PLAYER_ID)
		return true;
	if(PlayerSkinFix[playerid]) {
		inventory_UpdateClothes(playerid);
		cancel_skin(playerid);
	}
	new DynamicAreaData[AREA_DATA_TYPE + 1];
	Streamer_GetArrayData(STREAMER_TYPE_AREA, areaid, E_STREAMER_EXTRA_ID, DynamicAreaData);

	new area_type = DynamicAreaData[AREA_DATA_TYPE];
	if(DynamicAreaData[AREA_DATA_AREAID] != areaid)
		area_type = AREA_TYPE_NONE;
	new pstate = GetPlayerState(playerid);

	if(areaid == tk_wood_area || areaid == tk_gun_area) {
		if(TK_Trailer[playerid] != INVALID_VEHICLE_ID &&
			(GetVehicleModel(GetPlayerVehicleID(playerid)) == 403 ||
			GetVehicleModel(GetPlayerVehicleID(playerid)) == 514 ||
			GetVehicleModel(GetPlayerVehicleID(playerid)) == 515)
		) DisableRemoteVehicleCollisions(playerid, true);
	}
	#if defined _organizations_included
	switch(area_type) {
		#if defined _casino_included
		case AREA_TYPE_ACTOR: {
			new id = DynamicAreaData[AREA_DATA_EXTRA_ID_1];
			if(!Iter_Contains(Actors, id))
				return true;
			SetDynamicActorPos(AI[id][actorID], AI[id][actorPos][0], AI[id][actorPos][1], AI[id][actorPos][2]);

			for(new i = 0; i < sizeof (CasinoActorsID); i++) {
				if(AI[id][actorID] != CasinoActorsID[i])
					continue;
				switch(i) {
					case 0, 3: ApplyDynamicActorAnimation(AI[id][actorID], "strip", "STR_Loop_A", 4.1, 1, 1, 1, 1, 1);
					case 1, 4: ApplyDynamicActorAnimation(AI[id][actorID], "strip", "STR_Loop_C", 4.1, 1, 1, 1, 1, 1);
					case 2, 5: ApplyDynamicActorAnimation(AI[id][actorID], "strip", "strip_d", 4.1, 1, 1, 1, 1, 1);
				}
				break;
			}
		}
		#endif
		case AREA_TYPE_ORG_ENTER: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				org_id = DynamicAreaData[AREA_DATA_EXTRA_ID_1],
				org_interiorid = OrganizationInfo[org_id][orgInterior] - 1;
			if(OrganizationInfo[org_id][orgInteriorDoorType] && PI[playerid][pOrgMember] != org_id) {
				ErrorMessage(playerid, "Вход только для членов данной организации.");
				return true;
			}
			SetPlayerPosAC(playerid,
				OrganizationInteriorInfo[org_interiorid][intEnterPos][0],
				OrganizationInteriorInfo[org_interiorid][intEnterPos][1],
				OrganizationInteriorInfo[org_interiorid][intEnterPos][2],
				org_id, OrganizationInteriorInfo[org_interiorid][intInterior]
			);
			SetPlayerFacingAngle(playerid, OrganizationInteriorInfo[org_interiorid][intEnterPos][3]);

			new freeze_time = OrganizationInteriorInfo[org_interiorid][intFreezeTime];
			if(freeze_time) FreezePlayerForTime(playerid, freeze_time);

			SetCameraBehindPlayer(playerid);
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
			return true;
		}
		case AREA_TYPE_ORG_ENTER_ROOM: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				org_id = DynamicAreaData[AREA_DATA_EXTRA_ID_1],
				org_interiorid = OrganizationInfo[org_id][orgRoomInterior] - 1;

			if(OrganizationInfo[org_id][orgRoomInteriorDoorType] && PI[playerid][pOrgMember] != org_id) {
				ErrorMessage(playerid, "Вход только для членов данной организации.");
				return true;
			}
			SetPlayerPosAC(playerid,
				OrganizationRoomInteriorInfo[org_interiorid][intEnterPos][0],
				OrganizationRoomInteriorInfo[org_interiorid][intEnterPos][1],
				OrganizationRoomInteriorInfo[org_interiorid][intEnterPos][2],
				org_id, OrganizationRoomInteriorInfo[org_interiorid][intInterior]
			);
			SetPlayerFacingAngle(playerid, OrganizationRoomInteriorInfo[org_interiorid][intEnterPos][3]);

			new freeze_time = OrganizationRoomInteriorInfo[org_interiorid][intFreezeTime];
			if(freeze_time) FreezePlayerForTime(playerid, freeze_time);

			SetCameraBehindPlayer(playerid);
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
			return true;
		}
		case AREA_TYPE_ORG_EXIT: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				interior_id = DynamicAreaData[AREA_DATA_EXTRA_ID_1],
				org_id = GetPlayerVirtualWorld(playerid);

			if(OrganizationInfo[org_id][orgInterior] != interior_id + 1)
				return true;
			SetPlayerPosAC(playerid,
				OrganizationInfo[org_id][orgExitPos][0],
				OrganizationInfo[org_id][orgExitPos][1],
				OrganizationInfo[org_id][orgExitPos][2], 0, 0
			);
			SetPlayerFacingAngle(playerid, OrganizationInfo[org_id][orgExitPos][3]);
			SetCameraBehindPlayer(playerid);
			return true;
		}
		case AREA_TYPE_ORG_EXIT_WAREHOUSE: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				org_id = GetPlayerVirtualWorld(playerid),
				org_interiorid = OrganizationInfo[org_id][orgInterior] - 1;

			/* if(OrganizationInfo[org_id][orgInterior] != interior_id + 1)
				return true; */
			SetPlayerPosAC(playerid,
				OrganizationInteriorInfo[org_interiorid][intExitWarehousePos][0],
				OrganizationInteriorInfo[org_interiorid][intExitWarehousePos][1],
				OrganizationInteriorInfo[org_interiorid][intExitWarehousePos][2],
				org_id, OrganizationInteriorInfo[org_interiorid][intInterior]
			);
			SetPlayerFacingAngle(playerid, OrganizationInteriorInfo[org_interiorid][intExitWarehousePos][3]);

			new freeze_time = OrganizationInteriorInfo[org_interiorid][intFreezeTime];
			if(freeze_time) FreezePlayerForTime(playerid, freeze_time);
			SetCameraBehindPlayer(playerid);
			return true;
		}
		case AREA_TYPE_ORG_ENTER_WAREHOUSE: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				org_id = GetPlayerVirtualWorld(playerid),
				org_interiorid = OrganizationInfo[org_id][orgInterior] - 1;

			if(PI[playerid][pOrgMember] != org_id)
				return ErrorMessage(playerid, "Вы не состоите в данной пользовательской организации.");
			/* if(OrganizationInfo[org_id][orgInterior] != interior_id + 1)
				return true; */
			SetPlayerPosAC(playerid, 928.8009, 352.5970, 1500.0322, org_id, ORG_WAREHOUSE_INTERIORID);
			SetPlayerFacingAngle(playerid, 358.7551);

			new freeze_time = OrganizationInteriorInfo[org_interiorid][intFreezeTime];
			if(freeze_time) FreezePlayerForTime(playerid, freeze_time);
			SetCameraBehindPlayer(playerid);
			return true;
		}
		case AREA_TYPE_ORG_EXIT_ROOM: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				interior_id = DynamicAreaData[AREA_DATA_EXTRA_ID_1],
				org_id = GetPlayerVirtualWorld(playerid);

			if(OrganizationInfo[org_id][orgRoomInterior] != interior_id + 1)
				return true;
			SetPlayerPosAC(playerid,
				OrganizationInfo[org_id][orgRoomExitPos][0],
				OrganizationInfo[org_id][orgRoomExitPos][1],
				OrganizationInfo[org_id][orgRoomExitPos][2], 0, 0
			);
			SetPlayerFacingAngle(playerid, OrganizationInfo[org_id][orgRoomExitPos][3]);
			SetCameraBehindPlayer(playerid);
			return true;
		}
		case AREA_TYPE_ORG_WAREHOUSE: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				interior_id = DynamicAreaData[AREA_DATA_EXTRA_ID_1],
				org_id = GetPlayerVirtualWorld(playerid);

			if(OrganizationInfo[org_id][orgInterior] != interior_id + 1)
				return true;
			if(PI[playerid][pOrgMember] != org_id)
				return ErrorMessage(playerid, "Вы не состоите в данной пользовательской организации.");
			if(PI[playerid][pOrgRank] < OrganizationInfo[org_id][orgWarehouseRank])
				return ErrorMessage(playerid, "У вас нет доступа.");
			else org_ShowMenu(playerid, ORG_MENU_WAREHOUSE_MAIN);
			return true;
		}
	}
	#endif
	switch(area_type) {
		case AREA_TYPE_CARGO_SHIP: {
			/*format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "[debug] Вы подошли к контейнеру: %i", id);
			SendClientMessage(playerid, -1, STRING_GLOBAL);*/
	
			new id = DynamicAreaData[AREA_DATA_EXTRA_ID_1];
			TI[playerid][tContainerID] = id + 1;
		
			if(!CargoContainerInfo[id][containerStatus]) {
    			GameTextForPlayer(playerid, "~w~PRESS_~y~~k~~GROUP_CONTROL_BWD~", 3000, 1);
			}
		}
		case AREA_TYPE_CARGO_SCRAP: {
			if(IsAGang(playerid) || IsAMafia(playerid)) {
				new id = DynamicAreaData[AREA_DATA_EXTRA_ID_1];
				TI[playerid][tCargoFindScrapID] = id + 1;
    			GameTextForPlayer(playerid, "~w~PRESS_~y~~k~~GROUP_CONTROL_BWD~", 3000, 1);
			}
		}
		case AREA_TYPE_CARGO_CONTAINER: {
			if((IsAArm(playerid) || IsAGang(playerid) || IsAMafia(playerid)) && !PlayerGunFix[playerid]) {

				new id = DynamicAreaData[AREA_DATA_EXTRA_ID_1];
				if(CargoContainerInfo[id][containerBoxAmount]) {
					ClearAnimations(playerid);
					ApplyAnimation(playerid, "CARRY", "liftup", 1.0, 0, 1, 1, 0, 0, 1);
					PlayerClearDelay[playerid] = 1;
					SetPlayerAttachedObject(playerid, ATTACH_SLOT_JOB_1, 2358, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0);
					PlayerGunFix[playerid] = 1;

					// ErrorMessage(playerid, "Вы взяли ящик с боеприпасами, загрузите его в фургон.");
					CargoContainerInfo[id][containerBoxAmount]--;
					UpdateContainerText(id);

					if(CargoContainerInfo[id][containerBoxAmount] <= 0) CheckCargoContainers();
				}
			}
		}
		case AREA_TYPE_CARS_SHOW: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			new
				cars_show_id = DynamicAreaData[AREA_DATA_EXTRA_ID_1],
				slotid = DynamicAreaData[AREA_DATA_EXTRA_ID_2];

			// printf(">> case AREA_TYPE_CARS_SHOW:1(id = %d, slot = %d): model = %d, world = %d", cars_show_id, slotid, CarsShowInfo[cars_show_id][csCarsSaleID][slotid], CarsShowInfo[cars_show_id][csWorld]);

			if(GetPlayerVirtualWorld(playerid) != CarsShowInfo[cars_show_id][csWorld])
				return true;
			// printf(">> case AREA_TYPE_CARS_SHOW:2(id = %d, slot = %d): model = %d, world = %d", cars_show_id, slotid, CarsShowInfo[cars_show_id][csCarsSaleID][slotid], CarsShowInfo[cars_show_id][csWorld]);
			if(!CarsShowInfo[cars_show_id][csCarsSaleID][slotid])
				return true;
			// printf(">> case AREA_TYPE_CARS_SHOW:3(id = %d, slot = %d): model = %d, world = %d", cars_show_id, slotid, CarsShowInfo[cars_show_id][csCarsSaleID][slotid], CarsShowInfo[cars_show_id][csWorld]);

			new
				// bizz = CarsShowInfo[cars_show_id][csBizzID],
				model = CarsShowInfo[cars_show_id][csCarsSaleID][slotid],
				modelid = model - 400, classname[10];

			if(model) {
				switch(VehicleImportInfo[modelid][viClass]) {
					case VEHICLE_CLASS_ECONOMY: strcat(classname, "эконом");
					case VEHICLE_CLASS_BUSINESS: strcat(classname, "бизнес");
					case VEHICLE_CLASS_EXCLUSIVE: strcat(classname, "спорт");
					case VEHICLE_CLASS_MOTO: strcat(classname, "мото");
					case VEHICLE_CLASS_CARGO: strcat(classname, "грузовой");
				}
				SetPVarInt(playerid, "car_number", slotid);
				SetPVarInt(playerid, "SelectedCarsShowID", cars_show_id);

				new price = CarsShowInfo[cars_show_id][csCarsSalePrice][slotid];
				if(!price) return ErrorMessage(playerid, "Произошла ошибка, обратитесь к администрации! (#211)");
				if(TYPE_VIP[playerid] != VIP_STATE_NONE)
					price = GetReasonMoneyPercentVip(playerid, TYPE_VIP_AUTO, price);
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Марка транспорта: "P"%s "W"[%s класс]\n\n\
					"W"Стоимость транспорта: "GREEN"$%d\n\
					"W"В наличии: "P"%d шт.\n\
					"W"Вместимость бензобака: "O"%d\n\
					"W"Расход топлива на 100 КМ: "O"%d",
					gTransport[modelid][trName],
					classname, price,
					CarsShowInfo[cars_show_id][csCarsSaleAmount][slotid],
					gTransport[modelid][trTank],
					gTransport[modelid][trConsumption]
				);
				ShowPlayerDialog(playerid, D_BUY_CAR, DSM, ""P"Информация", STRING_GLOBAL, "Купить", "Отмена"), STRING_GLOBAL[0] = EOS;
				return true;
			}
		}
		case AREA_TYPE_DROPPED_ITEM: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			InventoryTempInfo[playerid][tDroppedItemArea] = areaid;
		}
		case AREA_TYPE_SAD_JOB: {
			if(pstate != PLAYER_STATE_ONFOOT) return true;
			if(!TI[playerid][tJobSad][0]) return true;
			new id = DynamicAreaData[AREA_DATA_EXTRA_ID_1];
			if(SI[id][sad_temp] != 0 && !GetString(SI[id][sad_fermer], player_name[playerid]))
				return ErrorMessage(playerid, "Вы не ухаживаете за этим деревом");
			if(SI[id][sad_temp] == 0 || SI[id][sad_temp] == 4)
			{
				if(SI[id][sad_temp] == 0)
				{
					if(GetPVarInt(playerid, "sad_uxod") == 1) return ErrorMessage(playerid, "Вы уже ухаживаете за деревом");
					if(!GetPVarInt(playerid, "bailer")) return ErrorMessage(playerid, "У Вас нет лейки в руках");
					if(GetPVarInt(playerid, "bailer_3")) return ErrorMessage(playerid, "Вы не можете полить дерево с ящиком яблок в руках");
					JobTempProcess[playerid] = 1;
					SI[id][sad_temp] = 1;
					SetString(SI[id][sad_fermer], player_name[playerid]);
					new string[70];
					format(string, sizeof(string), "Дерево\nСтадия - сохнет\nФермер - %s", SI[id][sad_fermer]);
					UpdateDynamic3DTextLabelText(SI[id][sad_3dtext], -1, string);
				}
				if(SI[id][sad_temp] == 4 && GetString(SI[id][sad_fermer], player_name[playerid]))
				{
					if(!GetPVarInt(playerid, "bailer_2")) return ErrorMessage(playerid, "У Вас нет ящика для сбора яблок в руках");
					JobTempProcess[playerid] = 2;
					if(SI[id][sad_temp] == 4)
					{
						if(GetPVarInt(playerid, "bailer_4")) return 1;
						SetPVarInt(playerid, "bailer_4", 1);
					}
				}
				TI[playerid][tJobSad][1] = id + 1;
				TI[playerid][tProcess][0] = 0;
				TI[playerid][tProcess][1] = 10;
				PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
				for(new YN = 0; YN < 3; YN++)
				{
					TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
					if(YN < 2) PlayerTextDrawShow(playerid, YandNsysTDPlayer[playerid][YN]);
				}
				RandomYareNforJOBS(playerid);
			}
			else ErrorMessage(playerid, "Ожидайте стадии - сбор яблок");
		}
		case AREA_TYPE_BUSINESS_BUY_INT: {
