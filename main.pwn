alias:cc("alias");
CMD:cc(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return true;
	for(new i = 0; i < 20; i++) SendClientMessageToAll(COLOR_WHITE, " ");
	SendClientMessageToAll(-1, "Игровой чат очищен администрацией сервера");
