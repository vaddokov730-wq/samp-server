					);
					playerListitemID[playerid][0] = itemid;
					playerListitemID[playerid][1] = listitem;
					return true;
				}
				if(!GivePlayerItem(playerid, itemid, 2)) return true;
				GunTickGet[playerid][listitem] = unix + 30;
				SendOk(playerid, "Вы взяли оружие со склада организации.");
			}
			default: {
				if(listitem == 10) {
					SendClientMessage(playerid, 0xCCCCCCFF, "Вы вернули оружие на склад");
					inventory_ClearFractionWeapons(playerid, 1);
					return true;
				}
				new itemid = DefaultGetGunID[listitem - 1];

				if(InventoryItemInfo[itemid][itemType] == ITEM_TYPE_AMMO) {
					ShowPlayerDialog(playerid, D_GETGUN_AMMO, DIALOG_STYLE_INPUT, ""P"Взять патроны", "\
						"W"Введите количество патрон, которое хотите взять:\n \n\
						"G"Примечание: количество должно быть не более 100 шт.", "Взять", "Назад"
					);
					playerListitemID[playerid][0] = itemid;
					playerListitemID[playerid][1] = listitem;
					return true;
				}
				if(!GivePlayerItem(playerid, itemid, 2)) return true;
				GunTickGet[playerid][listitem] = unix + 30;
				SendOk(playerid, "Вы взяли оружие со склада организации.");
			}
		}
		return true;
	}
