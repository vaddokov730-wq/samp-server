	case D_GANG_POINT: {
		if(!response) return 1;
		switch(listitem)
		{
		case 0: {
			new str[128], idx = 1;
			new year, month, day, hour, minute, second;

			STRING_GLOBAL[0] = EOS;
			strcat(STRING_GLOBAL, "№\tАвтомобиль\tОкончание аренды\n");
			for(new i; i < 50; i ++)
			{
				if(FracVehicle[i][fvehFrac] != GetTeamID(playerid)) continue;
				if(FracVehicle[i][fvehTime] > unix)
				{
					timestamp_to_date(FracVehicle[i][fvehTime] - unix, year, month, day, hour, minute, second);
					format(str, sizeof(str), "%d\t%s\t%d д. %d ч. %d м.\n", idx, gTransport[FracVehicle[i][fvehModelNew] - 400][trName], day - 1, hour, minute), strcat(STRING_GLOBAL, str);
				}
				else format(str, sizeof(str), "%d\t%s\t-\n", idx, gTransport[FracVehicle[i][fvehModel] - 400][trName]), strcat(STRING_GLOBAL, str);
				idx++;
			}
			ShowPlayerDialog(playerid, D_GANG_POINT_CAR, DSTH, "Управление автомобилями", STRING_GLOBAL, "Выбрать", "Отмена");
		}
		case 1: ShowPlayerDialog(playerid, D_GANG_POINT_GUN, DIALOG_STYLE_INPUT, ""P"Боеприпасы", ""W"Введите количество боеприпасов к обмену за "P"G-POINT"W"\nКурс обмена 50 "P"G-POINT"W" = 500 боеприпасов", "Принять", "Отмена");
		case 2: ShowPlayerDialog(playerid, D_GANG_POINT_HEAL, DIALOG_STYLE_INPUT, ""P"Аптечки", ""W"Введите количество аптечек к обмену за "P"G-POINT"W"\nКурс обмена 20 "P"G-POINT"W" = 1 аптечка", "Принять", "Отмена");
		case 3: ShowPlayerDialog(playerid, D_GANG_POINT_DRUGS, DIALOG_STYLE_INPUT, ""P"Наркотики", ""W"Введите количество наркотиков к обмену за "P"G-POINT"W"\nКурс обмена 50 "P"G-POINT"W" = 1000 наркотиков", "Принять", "Отмена");
		}
	}
	case D_GANG_POINT_DRUGS: {
		if(!response) return pc_cmd_lmenu(playerid);
		if(strlen(inputtext) == 0) return ShowPlayerDialog(playerid, D_GANG_POINT_DRUGS, DIALOG_STYLE_INPUT, ""P"Наркотики", ""W"Введите количество наркотиков к обмену за "P"G-POINT"W"\nКурс обмена 50 "P"G-POINT"W" = 1000 наркотиков", "Принять", "Отмена");
		if(strval(inputtext) < 1000 || strval(inputtext) > 10000)
		{
			ShowPlayerDialog(playerid, D_GANG_POINT_DRUGS, DIALOG_STYLE_INPUT, ""P"Наркотики", ""W"Введите количество наркотиков к обмену за "P"G-POINT"W"\nКурс обмена 50 "P"G-POINT"W" = 1000 наркотиков", "Принять", "Отмена");
			ErrorMessage(playerid, "Значения не могут быть менее 1000 и более 10.000");
			return 0x1;
		}
		if(strval(inputtext) != 1000 && strval(inputtext) != 2000 && strval(inputtext) != 3000 && strval(inputtext) != 4000 && strval(inputtext) != 5000 && strval(inputtext) != 6000 && strval(inputtext) != 7000 && strval(inputtext) != 8000 && strval(inputtext) != 9000 && strval(inputtext) != 10000)
		{
			ShowPlayerDialog(playerid, D_GANG_POINT_DRUGS, DIALOG_STYLE_INPUT, ""P"Наркотики", ""W"Введите количество наркотиков к обмену за "P"G-POINT"W"\nКурс обмена 50 "P"G-POINT"W" = 1000 наркотиков", "Принять", "Отмена");
			ErrorMessage(playerid, "Значения должны быть целыми. К примеру: 1000 или 5000");
			return 0x1;
		}
		if((FI[GetTeamID(playerid)][fDrugs] + strval(inputtext)) > 10000) return ErrorMessage(playerid, "На ваш склад не влезет столько наркотиков");
		if(FI[GetTeamID(playerid)][fPoints] < ((strval(inputtext) / 1000) * 50)) return ErrorMessage(playerid, "В Вашей банде недостаточно G-POINTS для покупки стольки наркотиков");

		FI[GetTeamID(playerid)][fPoints] -= ((strval(inputtext) / 1000) * 50);
		switch(GetTeamID(playerid))
		{
		case 18: {
			FI[fBALLAS][fDrugs] += strval(inputtext);
			UpdateFraction(fBALLAS, "Drugs", FI[fBALLAS][fDrugs]);
			UpdateFraction(fBALLAS, "fPoints", FI[fBALLAS][fPoints]);
		}
		case 19: {
			FI[fVAGOS][fDrugs] += strval(inputtext);
			UpdateFraction(fVAGOS, "Drugs", FI[fVAGOS][fDrugs]);
			UpdateFraction(fBALLAS, "fPoints", FI[fBALLAS][fPoints]);
		}
		case 20: {
			FI[fGROVE][fDrugs] += strval(inputtext);
			UpdateFraction(fGROVE, "Drugs", FI[fGROVE][fDrugs]);
			UpdateFraction(fBALLAS, "fPoints", FI[fBALLAS][fPoints]);
		}
		case 21: {
			FI[fAZTEC][fDrugs] += strval(inputtext);
			UpdateFraction(fAZTEC, "Drugs", FI[fAZTEC][fDrugs]);
			UpdateFraction(fBALLAS, "fPoints", FI[fBALLAS][fPoints]);
