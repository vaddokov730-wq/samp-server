	case D_EDIT_VEH_IMPORT_2: {
		if(!response) {
			cs_ShowEditMenu(playerid, GetPVarInt(playerid, "cs_ShowEditPage"));
			return true;
		}
		new vehicle_id = GetPVarInt(playerid, "cs_ShowEditID");
		switch(inputtext[0]) {
			case '+': {
				strdel(inputtext, 0, 1);
				new amount = strval(inputtext);

				VehicleImportInfo[vehicle_id][viAmount] += amount;
				gTransport[vehicle_id][trAmount] = VehicleImportInfo[vehicle_id][viAmount];

				format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы изменили количество %s [ID: %d] теперь = %d шт.",
					gTransport[vehicle_id][trName], vehicle_id + 400, VehicleImportInfo[vehicle_id][viAmount]
				);
				SendClientMessage(playerid, -1, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
			}
			case '-': {
				strdel(inputtext, 0, 1);
				new amount = strval(inputtext);

				VehicleImportInfo[vehicle_id][viAmount] -= amount;
				gTransport[vehicle_id][trAmount] = VehicleImportInfo[vehicle_id][viAmount];

				format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы изменили количество %s [ID: %d] теперь = %d шт.",
					gTransport[vehicle_id][trName], vehicle_id + 400, VehicleImportInfo[vehicle_id][viAmount]
				);
				SendClientMessage(playerid, -1, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
			}
			case '$': {
				strdel(inputtext, 0, 1);
				new price = strval(inputtext);

				VehicleImportInfo[vehicle_id][viPrice] = gTransport[vehicle_id][trPrice] = price;
				format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы изменили гос.стоимость %s [ID: %d] на $%d.",
					gTransport[vehicle_id][trName], vehicle_id + 400,price
				);
				SendClientMessage(playerid, -1, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
			}
		}
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL),
			"UPDATE `transport` SET price=%i, amount=%i WHERE model=%i LIMIT 1",
			gTransport[vehicle_id][trPrice], gTransport[vehicle_id][trAmount], vehicle_id + 400
		);
		mysql_tquery(connects, MYSQL_GLOBAL, "", "");

		cs_ShowEditMenu(playerid, GetPVarInt(playerid, "cs_ShowEditPage"));
		return true;
	}
