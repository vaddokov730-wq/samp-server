}
stock ShowSettings(playerid) {
	new talk[25], style[25], radio[30], spawn[30];

	switch(PI[playerid][pSettings][4]) {
		case 0:		talk = "[стандартный]";
		case 7:		talk = "[нет]";
		default:	format(talk, sizeof(talk), "[стиль %d]", PI[playerid][pSettings][4]);
	}
	switch(PI[playerid][pSettings][5]) {
		case 0:	style = "[стандартный]";
		case 1:	style = "[бокс]";
		case 2:	style = "[кунг-фу]";
		case 3:	style = "[кик-бокс]";
	}
	switch(PI[playerid][pSettings][2]) {
		case fLSNEWS:	radio = "[радиоцентр ЛС]";
		case fSFNEWS:	radio = "[радиоцентр СФ]";
		case fLVNEWS:	radio = "[радиоцентр ЛВ]";
		case 0:			radio = "[отключены]";
	}
	switch(PI[playerid][pSpawn]) {
		case 0:	spawn = "[вокзал]";
		case 1:	spawn = "[дом / отель]";
		case 2:	spawn = "[организация]";
		case 3:	spawn = "[дом семьи]";
	}
	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""P"Наименование\t"P"Статус\n\
		"P"1."W" Ники игроков\t"ORANGE"%s\n\
		"P"2."W" Чат организации\t"ORANGE"%s\n\
		"P"3."W" Чат компании(ТК, Такси)\t"ORANGE"%s\n\
		"P"4."W" Эфиры\t"ORANGE"%s\n\
		"P"5."W" Стиль разговора\t"ORANGE"%s\n\
		"P"6."W" Стиль боя\t"ORANGE"%s\n\
		"P"7."W" Показывать голод\t"ORANGE"%s\n\
		"P"8."W" Показывать кейс\t"ORANGE"%s\n\
		"P"9."W" Прогрузка текстур\t"ORANGE"%s\n\
		"P"10."W" Дамаг информер\t"ORANGE"%s\n\
		"P"11."W" Место спавна\t"ORANGE"%s\n\
		"P"12."W" Интерфейс инвентаря\t"ORANGE"%s\n\
		"P"13."W" Описания персонажей\t"ORANGE"%s\n\
		"P"14. "W"Действия от администрации\t"ORANGE"%s\n\
		"P"15. "W"Новости CNN\t"ORANGE"%s\n\
		"P"16. "W"ОOC чат\t"ORANGE"%s\n\
		"P"17. "W"Показ смену никнеймов\t"ORANGE"%s\n\
		"P"18. "W"Маркеры домов на карте\t"ORANGE"%s\n\
		"P"19. "W"Маркеры бизнесов на карте\t"ORANGE"%s\n\
		"P"20. "W"Получение сообщений PM\t"ORANGE"%s",
		PI[playerid][pSettings][0] ? ("[вкл]") : ("[выкл]"),
		PI[playerid][pSettings][1] ? ("[вкл]") : ("[выкл]"),
		// PI[playerid][pVipChat] ? ("[вкл]") : ("[выкл]"),
		PI[playerid][pSettings][3] ? ("[вкл]") : ("[выкл]"),
		radio, talk, style, PI[playerid][pSettings][6] ? ("[вкл]") : ("[выкл]"),
		PI[playerid][pSettings][7] ? ("[вкл]") : ("[выкл]"),
		PI[playerid][pSettings][8] ? ("[вкл]") : ("[выкл]"),
		PI[playerid][pSettings][10] ? ("[вкл]") : ("[выкл]"),
		spawn,
		PI[playerid][pInventoryMenuType] == INVENTORY_MENU_DIALOG ? ("[обычный]") : ("[графический]"),
		PI[playerid][pDescriptionType] == 0 ? ("[при наведении]") : ("[отображать рядом]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_ADMIN_ACTIONS] == 0) ? ("[выкл]") : ("[вкл]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_NEWS_CNN] == 0) ? ("[выкл]") : ("[вкл]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_OOC_CHAT] == 0) ? ("[выкл]") : ("[вкл]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_CHANGENICK] == 0) ? ("[выкл]") : ("[вкл]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_MARKES_HOUSE] == 0) ? ("[выкл]") : ("[вкл]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_MARKERS_BUSINESS] == 0) ? ("[выкл]") : ("[вкл]"),
		(PI[playerid][pPlayerSettings][PLAYER_SETTING_PM_CHAT] == 0) ? ("[выкл]") : ("[вкл]"),
		PI[playerid][pPlayerSettings][PLAYER_SETTING_STYLE_CHAT] + 1
	);
		//"P"21. "W"Изменить стиль чата\t"ORANGE"[стиль %i]
	ShowPlayerDialog(playerid, D_MENU_SETTING, DSTH, ""P"Настройки", STRING_GLOBAL, "Изменить", "Назад"), STRING_GLOBAL[0] = EOS;
	return 1;
}
CB:OnPlayerSelectPassword(playerid, password[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows) ShowPlayerDialog(playerid, D_CHANGE_PASS, DSI, ""P"Смена пароля", "\n\n"W"Введите новый пароль:\n\n", "Ввод", "Назад");
	else ShowPlayerDialog(playerid, D_CHANGE_PASS_SELECT, DSI, ""P"Смена пароля", "\n\n"W"Введите свой старый пароль:\n\n"NO"*"G" Пароль введён неверно\n\n", "Ввод", "Назад");
	return 1;
}
CB:OnPlayerAttachTrailer(playerid, vehicleid, trailerid)
{
	if((trailerid != PlayerTrailer[playerid] && PI[playerid][pJob] != 2) && (trailerid != Factory_Trailer[playerid] && GetPVarInt(playerid, "factoryJob") != 2) && (trailerid != TK_Trailer[playerid] && (PI[playerid][bizz_work] == 5 || PI[playerid][bizz_work] == 6 || PI[playerid][bizz_work] == 7)))
	{
		ErrorMessage(playerid, "Данный прицеп принадлежит другому игроку");
		return DetachTrailerFromVehicle(vehicleid);
	}
	else if(trailerid == PlayerTrailer[playerid]) SetPVarInt(playerid, "attach_trailer", 1);
	else if(trailerid == TK_Trailer[playerid]) TI[playerid][tTrucker][3] = 0;
	else if(trailerid == Factory_Trailer[playerid]) Factory_TrailerTime[playerid] = 0;
	return 1;
}

CB:OnPlayerDeattachTrailer(playerid, vehicleid, trailerid)
{
	if(trailerid == PlayerTrailer[playerid])
	{
		DeletePVar(playerid, "attach_trailer");
		PlayerTrailerTime[playerid] = 30;
	}
	else if(trailerid == TK_Trailer[playerid])
	{
		TI[playerid][tTrucker][3] = 120;
	}
	else if(trailerid == Factory_Trailer[playerid])
	{
		Factory_TrailerTime[playerid] = 120;
	}
	return 1;
}
stock IsPlayerStream(Float: radi, playerid, targetid)
{
	if(!IsPlayerConnected(targetid)) return 0;
	new Float:X, Float:Y, Float: Z;
	GetPlayerPos(targetid, X, Y, Z);
	return PlayerToPoint(radi, playerid, X, Y, Z);
}
stock IntToStr(value)
{
	new tmp[30];
	valstr(tmp, value);
	return tmp;
}
stock GoPlayerAnimation(playerid, Float: X, Float: Y, Float: Z)
{
	if(IsPlayerInAnyVehicle(playerid)) return false;
	else if(IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "IDLE_STANCE", 4.1, 0, 1, 1, 0, 0, 1);
	else if(IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "WALK_PLAYER", 4.1, 0, 1, 1, 0, 0, 1);
	else if(IsPlayerInRangeOfPoint(playerid, 7.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "RUN_GANG1", 4.1, 0, 1, 1, 0, 0, 1);
	ApplyAnimation(playerid, "PED", "SPRINT_PANIC", 4.1, 0, 1, 1, 0, 0, 1);
	return true;
}
stock load_heal()
{
	new name[24], rows;
	new heal;
	new Cache: result = mysql_query(connects, "\
		SELECT (SELECT `Name` FROM `accounts` WHERE `pID` = `uid`) as \
		`name`, SUM(`rating`) as `rating` FROM `fracrating` WHERE `date` BETWEEN (CURDATE() - INTERVAL 1 WEEK - INTERVAL WEEKDAY(CURDATE()) DAY) AND \
		(CURDATE() - INTERVAL WEEKDAY(CURDATE()) DAY - INTERVAL 1 SECOND) AND `frac` = 8 group by uid ORDER BY `rating` DESC LIMIT 5"
	);
	cache_get_row_count(rows);
	if(rows)
	{
		new str[128], text[400];
		strcat(text, ""W"Лучшие работники (прошлую неделю):\n\n");
		for(new i; i < rows; i ++)
		{
			cache_get_value_name(i, "name", name, MAX_PLAYER_NAME);
			cache_get_value_name_int(i, "rating", heal);


			format(str, sizeof(str), ""ORANGE"%d. "G"%s [%d]\n", i + 1, name, heal), strcat(text, str);
			UpdateDynamic3DTextLabelText(med_turn_text[0], -1, text);
		}
	}
	if(rows == 0) UpdateDynamic3DTextLabelText(med_turn_text[0], -1, ""W"Лучшие работники не определены\nза прошлую неделю");
	if(cache_is_valid(result)) cache_delete(result);

	new rand = random(3);
	disease = rand;
	new text[300];
	strcat(text, ""W"Зона заражения:");
	switch(rand)
	{
	case 0: {
		format(text, sizeof(text), "%s\n"P"Гетто", text);
		UpdateDynamic3DTextLabelText(med_turn_text[3], -1, text);
	}
	case 1: {
		format(text, sizeof(text), "%s\n"P"Заброшеный аэропорт", text);
		UpdateDynamic3DTextLabelText(med_turn_text[3], -1, text);
	}
	case 2: {
		format(text, sizeof(text), "%s\n"P"Карьер", text);
		UpdateDynamic3DTextLabelText(med_turn_text[3], -1, text);
	}
	}
	load_heal_2();
	return 1;
}
