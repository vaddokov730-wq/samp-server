stock srace_end(playerid, type)
{
	DestroyDynamicCP(TI[playerid][tRaceCP]);
	DestroyDynamicCP(TI[TI[playerid][tRaceID]][tRaceCP]);
	DisablePlayerCheckpoint(playerid);
	DisablePlayerCheckpoint(TI[playerid][tRaceID]);
	switch(type)
	{
	case 0: {

		static const f_race_victory[] = "\
		Вы одержали победу в уличных гонках над "W"%s"G". Вознаграждение: "ORANGE"$%d";

		new str_race_victory[sizeof(f_race_victory) + (-2 + MAX_PLAYER_NAME + 1) + (-2 + 8)];
		format(str_race_victory, sizeof(str_race_victory), f_race_victory, player_name[TI[playerid][tRaceID]], TI[playerid][tRaceMoney] * 2);
		SendOk(playerid, str_race_victory);

		format(str_race_victory, sizeof(str_race_victory), "Вы проиграли в уличных гонках "W"%s", player_name[playerid], TI[playerid][tRaceMoney] * 2);
		ErrorMessage(TI[playerid][tRaceID], str_race_victory);

		GiveMoney(playerid, TI[playerid][tRaceMoney] * 2, "победа в уличных гонках");
		if(PI[playerid][pMember]) add_gang_points(PI[playerid][pMember], 1);
	}
	case 1, 2: {
		static const f_race_lose[] = "\
		Игрок покинул сервер. Вы одержали победу в уличных гонках над "W"%s"G". Вознаграждение: "ORANGE"$%d";

		new str_race_lose[sizeof(f_race_lose) + (-2 + MAX_PLAYER_NAME + 1) + (-2 + 8)];
		if(type == 1)
		{
			format(str_race_lose, sizeof(str_race_lose), f_race_lose, player_name[playerid], TI[playerid][tRaceMoney] * 2);
			SendOk(TI[playerid][tRaceID], str_race_lose);
		}
		if(type == 2)
		{
			format(str_race_lose, sizeof(str_race_lose), "Игрок покинул Т/С. Вы одержали победу в уличных гонках над "W"%s"G". Вознаграждение: "ORANGE"$%d", player_name[playerid], TI[playerid][tRaceMoney] * 2);
			SendOk(TI[playerid][tRaceID], str_race_lose);

			format(str_race_lose, sizeof(str_race_lose), "Вы покинули Т/С во время гонки. Победитель гонки: "W"%s", player_name[TI[playerid][tRaceID]]);
			ErrorMessage(playerid, str_race_lose);
		}
		GiveMoney(TI[playerid][tRaceID], TI[playerid][tRaceMoney] * 2, "победа в уличных гонках");
		if(PI[TI[playerid][tRaceID]][pMember]) add_gang_points(PI[TI[playerid][tRaceID]][pMember], 1);
	}
	}
	TI[playerid][tRaceMoney] = TI[TI[playerid][tRaceID]][tRaceMoney] = 0;
	TI[playerid][tRaceID] = TI[TI[playerid][tRaceID]][tRaceID] = INVALID_PLAYER_ID;
}
stock save_fracveh(slot)
{
	A_DestroyVehicle(FracVehicle[slot][fvehCar]);
	FracVehicle[slot][fvehCar] = INVALID_VEHICLE_ID;
	if(FracVehicle[slot][fvehTime] > unix)
	{
		UpdateFractionVehicle(slot, "fvehModelNew", FracVehicle[slot][fvehModelNew]);
		FracVehicle[slot][fvehCar] = CreateOrgsVehicle(FracVehicle[slot][fvehFrac], 1, FracVehicle[slot][fvehModelNew], FracVehicle[slot][fvehcCoords][0], FracVehicle[slot][fvehcCoords][1], FracVehicle[slot][fvehcCoords][2], FracVehicle[slot][fvehcCoords][3], FracVehicle[slot][fvehColor][0], FracVehicle[slot][fvehColor][1], RES_CAR_TIME);
	}
	else FracVehicle[slot][fvehCar] = CreateOrgsVehicle(FracVehicle[slot][fvehFrac], 1, FracVehicle[slot][fvehModel], FracVehicle[slot][fvehcCoords][0], FracVehicle[slot][fvehcCoords][1], FracVehicle[slot][fvehcCoords][2], FracVehicle[slot][fvehcCoords][3], FracVehicle[slot][fvehColor][0], FracVehicle[slot][fvehColor][1], RES_CAR_TIME);
	UpdateFractionVehicle(slot, "fvehTime", FracVehicle[slot][fvehTime]);
}
stock add_gang_points(member, points)
{
	FI[member][fPoints] += points;
	UpdateFraction(member, "fPoints", FI[member][fPoints]);
	FI[member][fRating] += points;
	UpdateFraction(member, "fRating", FI[member][fRating]);
}
stock dialog_lmenu(playerid, listitem)
{
	switch(listitem)
	{
	case 0: {
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "№\tНазвание команды\t"P"Доступ\n");
		new countcmd = 1 ;
		for(new i = 1; i <= MaxCommandFractionLoad; i++)
		{
			if(RightCommand[PI[playerid][pMember]][i] == 30) continue;
			if(RightCommandControl[i]) continue;
			if(RightCommandControl[i] && PI[playerid][pAdmin] <= 4) continue;
			if(i == MaxCommandFractionLoad)
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t/%s\t"P"%s", STRING_GLOBAL, countcmd, RightCommandName[i], GetRankName(PI[playerid][pMember], RightCommand[PI[playerid][pMember]][i]));
				break;
			}
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i\t/%s\t"P"%s\n", STRING_GLOBAL, countcmd, RightCommandName[i], GetRankName(PI[playerid][pMember], RightCommand[PI[playerid][pMember]][i]));
			CommandDialog[playerid][countcmd] = i;
			countcmd++;
		}
		ShowPlayerDialog(playerid, D_LMENU_CHANGE_COMMAND, DIALOG_STYLE_TABLIST_HEADERS, ""P"Выберите команду", STRING_GLOBAL, "Выбрать", "Закрыть");
	}
	case 1:   //Установить сообщение фракции
	{
		ShowPlayerDialog(playerid, D_LMENU_TEXT, DSI, ""P"Сообщение фракции", "\n\n"W"Введите сообщение, которое будет показано членам Вашей организации при входе:\nДля удаления сообщения введите: "ORANGE"None\n\n", "Ввод", "Отмена");
	}
	case 2:  //Банк фракции
	{
		static const f_str[] = "\
		"W"Состояние счета: "ORANGE"$%d";

		new string[sizeof(f_str) + 1 + (-2 + 10)];
		format(string, sizeof(string), f_str, FI[PI[playerid][pMember]][fBank]);
		ShowPlayerDialog(playerid, D_LMENU_BANK, DSL, ""P"Управление банком фракции", string, "Далее", "Назад");
	}
	case 3:   //Респавн незанятых авто
	{
		for(new i = GetVehiclePoolSize() + 1; --i != 0;)
		{
			if(!IsValidVehicle(i)) continue;
			if(VehicleInfo[i][vTeam] != PI[playerid][pMember]) continue;
			if(IsVehicleOccupied(i)) continue;
			SetVehicleToRespawn(i);
		}
		static const f_respawn_frac_car[] = "\
		[F] %s %s заспавнил незанятые машины";

		new str_respawn_frac_car[sizeof(f_respawn_frac_car) + (-2 + 25) + (-2 + 25)];
		format(str_respawn_frac_car, sizeof(str_respawn_frac_car), f_respawn_frac_car, GetRankName(PI[playerid][pMember], PI[playerid][pRank]), player_name[playerid], playerid);
		SendFamilyMessage(PI[playerid][pMember], COLOR_LIGHTRED, str_respawn_frac_car);
	}
	case 4:   //Анти Team-Kill
	{
		if(FI[GetTeamID(playerid)][fAntiTK])
		{
			FI[GetTeamID(playerid)][fAntiTK] = 0;
			SendOk(playerid, "Функция Анти Team Kill успешно отключена");
		}
		else
		{
			FI[GetTeamID(playerid)][fAntiTK] = 1;
			SendOk(playerid, "Функция Анти Team Kill успешно включена");
		}
		UpdateFraction(GetTeamID(playerid), "AntiTk", FI[GetTeamID(playerid)][fAntiTK]);
	}

	case 5: // Может участвовать в капте\t"
	{
		STRING_GLOBAL[0] = EOS;
		for(new i = 1; i <= FI[GetTeamID(playerid)][fMaxRang]; i++)
		{
			new frac_rank_check = -1;
			frac_rank_check = FI[PI[playerid][pMember]][fRangCapt];
			if(frac_rank_check == -1) return true;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i. %s%s\n", STRING_GLOBAL, i, (i == frac_rank_check) ? (""P"") : (""W""), GetRankName(PI[playerid][pMember], i));
		}
		PlayerLeaderFix[playerid] = listitem;
		ShowPlayerDialog(playerid, D_LMENU_RANK, DSL, ""P"Выберите ранг", STRING_GLOBAL, "Выбрать", "Закрыть");
	}
	case 6:   //Дипломатия
	{
		/*if(!IsAGang(playerid) && !IsAMafia(playerid)) return 1;
		dialog_diplom(playerid, true);*/
	}
	case 7: ShowPlayerDialog(playerid, D_GANG_POINT, DSL, ""P"Выберите ранг", ""P"1."W" Управление автомобилями\n"P"2."W" Боеприпасы\n"P"3."W" Аптечки\n"P"4."W" Наркотики", "Принять", "Отмена");
	case 8: {
		STRING_GLOBAL[0] = EOS;
		new count;
		for(new i = 1; i < MAX_FRACTIONS_SUBDIVISION; i ++)
		{
			if(PI[playerid][pMember] == Subdivision[i][sub_frac])
			{
				if(count > 20) break;
				SubdivisionDialog[playerid][count] = i;
				count++;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"P"%i."W"%s\n", STRING_GLOBAL, count, Subdivision[i][sub_name]);
			}
		}
		if(count < 20)
		{
			SubdivisionDialog[playerid][count] = 1000;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"P"Добавить подразделение", STRING_GLOBAL);
		}
		ShowPlayerDialog(playerid, D_SUB_LIST, DST, ""P"Список подразделений", STRING_GLOBAL, "Выбрать", "Отмена");
	}
	}
	return 1;
}

stock GetVipReasonMaximalValue(playerid, type)
{
	new ReasonValue;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		switch(type)
		{
		/*case TYPE_VIP_VALUE_MASK: ReasonValue = VipData[TYPE_VIP[playerid]][VipMask];
		case TYPE_VIP_VALUE_MATS: ReasonValue = VipData[TYPE_VIP[playerid]][VipMats];
		case TYPE_VIP_VALUE_FUEL: ReasonValue = VipData[TYPE_VIP[playerid]][VipFuel];
		case TYPE_VIP_VALUE_REMP: ReasonValue = VipData[TYPE_VIP[playerid]][VipRemp];
		case TYPE_VIP_VALUE_JIMMY: ReasonValue = VipData[TYPE_VIP[playerid]][VipJimmy];
		case TYPE_VIP_VALUE_DRUGS: ReasonValue = VipData[TYPE_VIP[playerid]][VipDrugs];
		case TYPE_VIP_VALUE_HEALME: ReasonValue = VipData[TYPE_VIP[playerid]][VipHealme];*/
		case TYPE_VIP_VALUE_MASK: ReasonValue = 5;
		case TYPE_VIP_VALUE_FUEL: ReasonValue = 1;
		case TYPE_VIP_VALUE_REMP: ReasonValue = 5;
		case TYPE_VIP_VALUE_JIMMY: ReasonValue = 5;
		case TYPE_VIP_VALUE_HEALME: ReasonValue = 5;
		case TYPE_VIP_VALUE_DRUGS: ReasonValue = 150;
		case TYPE_VIP_VALUE_MATS: ReasonValue = 500;
		}
	}
	if(TYPE_VIP[playerid] == VIP_STATE_NONE)
	{
		switch(type)
		{
		case TYPE_VIP_VALUE_MASK: ReasonValue = 5;
		case TYPE_VIP_VALUE_FUEL: ReasonValue = 1;
		case TYPE_VIP_VALUE_REMP: ReasonValue = 5;
		case TYPE_VIP_VALUE_JIMMY: ReasonValue = 5;
		case TYPE_VIP_VALUE_HEALME: ReasonValue = 5;
		case TYPE_VIP_VALUE_DRUGS: ReasonValue = 150;
		case TYPE_VIP_VALUE_MATS: ReasonValue = 500;
		}
	}
	return ReasonValue;
}

stock GetReasonMoneyPercentVip(playerid, type, old_money)
{
	new ReasonMoney = old_money, vip_percent;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		switch(type)
		{
		case TYPE_VIP_HEAL: vip_percent = VipData[TYPE_VIP[playerid]][VipHeal];
		case TYPE_VIP_AUTO: vip_percent = VipData[TYPE_VIP[playerid]][VipAuto];
		case TYPE_VIP_SKIN: vip_percent = VipData[TYPE_VIP[playerid]][VipSkin];
		case TYPE_VIP_HOUSE: vip_percent = VipData[TYPE_VIP[playerid]][VipHouse];
		case TYPE_VIP_WEAPON: vip_percent = VipData[TYPE_VIP[playerid]][VipWeapon];
		case TYPE_VIP_FIXCAR: vip_percent = VipData[TYPE_VIP[playerid]][VipFixCar];
		case TYPE_VIP_TUNNING: vip_percent = VipData[TYPE_VIP[playerid]][VipTunning];
		case TYPE_VIP_BUSINESS: vip_percent = VipData[TYPE_VIP[playerid]][VipBusiness];
		case TYPE_VIP_PERFOMANCE: vip_percent = VipData[TYPE_VIP[playerid]][VipPerfomance];
		case TYPE_VIP_UPDATE_HOUSE: vip_percent = VipData[TYPE_VIP[playerid]][VipUpdateHouse];
		}
	}
	ReasonMoney = (old_money - (old_money * vip_percent / 100));
	return ReasonMoney;
}

