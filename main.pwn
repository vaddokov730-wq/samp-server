stock UpdateEconomyData(const field[], data)
{
	new query[156];
	format(query, sizeof(query), "UPDATE `economy` SET `%s` = '%d' LIMIT 1", field, data);
	mysql_tquery(connects, query, "", "");
	return mysql_errno();
}

stock UpdateDonateData(const field[], data)
{
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `donate` SET `%s` = '%d' LIMIT 1", field, data);
	mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	return mysql_errno();
}

stock UpdateBonusesData(const field[], data)
{
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `bonus` SET `%s` = '%d' LIMIT 1", field, data);
	mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	return mysql_errno();
}
