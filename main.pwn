CMD:fhelp(playerid, params[])
{
	if(!IsAArm(playerid)) return true;
	if(PI[playerid][pRank] < 3) return ErrorMessage(playerid, "Ваш ранг недостаточен");
	new string[128];
	if(IsFailPosSF(playerid) == 1 && PI[playerid][pMember] == fARMYSF)
	{
		if(army_chs[0] == false)
		{
			format(string, sizeof(string), "Внимание! %s %s[%d] объявил(а) о Чрезвычайной Ситуации в Армии СФ!", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid);
			SendDepMessage(COLOR_ALLDEPT, string);
			SendDepMessage(COLOR_ALLDEPT, "Просим поддержки всех силовых структур!");
			GangZoneFlashForAll(SFa, COLOR_RED);

			for(new i = 0; i != 6; i ++)
			{
				UpdateDynamic3DTextLabelText(army_text[i], -1, ""NO"Объявлена Чрезвычайная Ситуация"W"\nДля отключения, введите: "P"/fhelp");
			}
			army_chs[0] = true;
		}
		else
		{
			if(IsPlayerInRangeOfPoint(playerid, 7.0, -1334.3103, 373.8245, 7.1937) == 0) return ErrorMessage(playerid, "Отменить черезвычайую ситуацию можно только на главном пульте управления");
			format(string, sizeof(string), "Внимание! %s %s[%d] объявил(а) об устранении Чрезвычайной Ситуации в Армии СФ", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid);
			SendDepMessage(COLOR_ALLDEPT, string);
			GangZoneStopFlashForAll(SFa);

			for(new i = 0; i != 6; i ++)
			{
				UpdateDynamic3DTextLabelText(army_text[i], -1, "Для объявления чрезвычайной ситуации, введите:\n"P"/fhelp");
			}
			army_chs[0] = false;
		}
	}
	else if(IsFailPosLV(playerid) == 1 && PI[playerid][pMember] == fARMYLV)
	{
		if(army_chs[1] == false)
		{
			format(string, sizeof(string), "Внимание! %s %s[%d] объявил(а) о Чрезвычайной Ситуации в Армии ЛС!", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid);
			SendDepMessage(COLOR_ALLDEPT, string);
			SendDepMessage(COLOR_ALLDEPT, "Просим поддержки всех силовых структур!");
			GangZoneFlashForAll(Army, COLOR_RED);

			for(new i = 6; i != 14; i ++)
			{
				UpdateDynamic3DTextLabelText(army_text[i], -1, ""NO"Объявлена Чрезвычайная Ситуация"W"\nДля отключения, введите: "P"/fhelp");
			}
			army_chs[1] = true;
		}
		else
		{
			//if(IsPlayerInRangeOfPoint(playerid, 7.0, 182.2824, 1809.9597, 17.6406) == 0) return ErrorMessage(playerid, "Отменить черезвычайую ситуацию можно только на главном пульте управления");
			format(string, sizeof(string), "Внимание! %s %s[%d] объявил(а) об устранении Чрезвычайной Ситуации в Армии ЛС", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid);
			SendDepMessage(COLOR_ALLDEPT, string);
			GangZoneStopFlashForAll(Army);

			for(new i = 6; i != 14; i ++)
			{
				UpdateDynamic3DTextLabelText(army_text[i], -1, "Для объявления чрезвычайной ситуации, введите:\n"P"/fhelp");
			}
			army_chs[1] = false;
		}
	}
	return true;
}

CMD:carpass(playerid, params[])
{
	if(!GetPlayerVehicles(playerid)) return ErrorMessage(playerid, "У вас нет личного транспорта");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/carpass [id]");
	if(playerid != params[0] && CheckDistancePlayerToPlayer(5.0, playerid, params[0]) == 0) return ErrorMessage(playerid, "Вы слишком далеко от данного игрока");
	//if(params[1] < 1 || params[1] > 2) return ErrorMessage(playerid, "Достумое значение в поле слот не может быть менее 1 и более 2");


	new id = GetNearestPlayerVehicle(playerid);
	if(id == -1)
		return ErrorMessage(playerid, "Вы далеко от своего Т/С");
	new vehicleid = PlayerVehicleInfo[id][carVehicle];

	//new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
			"W"Владелец: \t"P"%s\n\
			"W"Автомобиль: \t"P"%s\n\
			"W"Техническое состояние: "P"%.1f / 100.0%%\n ",
			player_name[playerid],
			gTransport[GetVehicleModel(vehicleid) - 400][trName],
			VehicleInfo[vehicleid][vStatus],

			VehicleInfo[vehicleid][vPEngine][0] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPEngine][1] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPEngine][2] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPEngine][3] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPEngine][4] ? ("Установлено") : ("Отсутствует"),

			VehicleInfo[vehicleid][vPBrake][0] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPBrake][1] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPBrake][2] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPBrake][3] ? ("Установлено") : ("Отсутствует"),
			VehicleInfo[vehicleid][vPBrake][4] ? ("Установлено") : ("Отсутствует")
		);
		ShowPlayerDialog(params[0], DIALOG_NONE, DIALOG_STYLE_MSGBOX, "Технический паспорт транспорта", STRING_GLOBAL, "Скрыть", ""), STRING_GLOBAL[0] = EOS;
/*\n

			"ORANGE"Улучшения двигателя:\n
			"W"Нагнетатель воздуха: \t\t\t\t"P"%s\n
			"W"Кованные поршни двигателя: \t\t\t"P"%s\n
			"W"Дроссельная заслонка увеличенного диаметра: \t"P"%s\n
			"W"Воздушный фильтр нулевого сопротивления: \t"P"%s\n
			"W"Спортивный распредвал: \t\t\t\t"P"%s\n\n

			"ORANGE"Улучшения тормозной системы:\n
			"W"Тормозной шланг: \t\t\t\t\t"P"%s\n
			"W"Спортивные тормозные диски: \t\t\t"P"%s\n
			"W"Модифицированные тормозные колодки: \t\t"P"%s\n
			"W"Тормозной цилинтр: \t\t\t\t\t"P"%s\n
			"W"Вакуумный усилитель: \t\t\t\t"P"%s*/
		new string[128];
		format(string, sizeof(string), "достал(а) тех.паспорт и показал(а) его %s", player_RP_name[params[0]]);
		MeAction(playerid, string);
	}
	return 0x1;
}
CMD:carm(playerid, params[])
{
	if(!GetFractionCommand(playerid, 40)) return true;
	new veh = GetPlayerVehicleID(playerid);
	switch(GetVehicleModel(veh))
	{
	case 433: if(VehicleInfo[veh][vTeam] == fARMYLV) ShowPlayerDialog(playerid, D_ARMY_CARM, DSL, ""P"Развозка боеприпасов", ""P"1."W" Разгрузить на склад Полиции ЛС\n"P"2."W" Разгрузить на склад Полиции СФ\n"P"3."W" Разгрузить на склад Полиции ЛВ\n"P"4."W" Разгрузить на склад ФБР\n"P"5."W" Состояние складов", "Выбрать", "Отмена");
	case 548: if(VehicleInfo[veh][vTeam] == fARMYLV) ShowPlayerDialog(playerid, D_ARMY_CARM_SF, DSL, ""P"Развозка боеприпасов", ""P"1."W" Загрузка боеприпасов\n"P"2."W" Разгрузка боеприпасов", "Выбрать", "Отмена");
	}
	return true;
}
CMD:load(playerid, params[])
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsAArm(playerid) && !IsAGang(playerid) && !IsAMafia(playerid) && (!IsAGang(playerid) || GetPlayerSkin(playerid) != 191) && (!IsAGang(playerid) || GetPlayerSkin(playerid) != 287)) return 1;
		//if(IsAArm(playerid)) if(PI[playerid][pRank] < 3) return ErrorMessage(playerid, "Доступно с 3 ранга");
		if(!GetFractionCommand(playerid, 38)) return true;
		switch(GetVehicleModel(vehicleid))
		{
		case 433, 482, 573: {
			if(VG[vehicleid][vgLoading] || VG[vehicleid][vgUnloading]) return ErrorMessage(playerid, "Авто уже стоит на загрузке / разгрузке");
			if((IsAGang(playerid) && GetPlayerSkin(playerid) == 191 && GetVehicleModel(vehicleid) == 433) || (IsAGang(playerid) && GetPlayerSkin(playerid) == 287 && GetVehicleModel(vehicleid) == 433))
			{
				switch(VehicleInfo[vehicleid][vTeam])
				{
				case fARMYLV: SetPlayerCheckpoint(playerid, 255.0845, 1831.5399, 18.1076, 5.0), SetPVarInt(playerid, "MatsArmyCar", 10);
				case fARMYSF: SetPlayerCheckpoint(playerid, -1325.2426, 407.5635, 7.0743, 5.0), SetPVarInt(playerid, "MatsArmyCar", 11);
				}
				return 1;
			}
			VG[vehicleid][vgID] = vehicleid;
			VG[vehicleid][vgLoading] = true;

			RemovePlayerFromVehicleAC(playerid);
			new Float:x, Float:y, Float:z, Float: a;
			GetVehiclePos(vehicleid, x, y, z);
			GetVehicleZAngle(vehicleid, a);
			x = x - (-6.0 * floatsin(a, degrees));
			y = y - 6.0 * floatcos(a, degrees);

			VG[vehicleid][vgPickup] = CreateDynamicPickup(2358, 1, x, y, z - 0.5);
			SetDynamicPickupType(VG[vehicleid][vgPickup], PICKUP_TYPE_VG_LOAD, vehicleid);

			new string[64];
			switch(GetVehicleModel(vehicleid))
			{
			case 433: format(string, sizeof(string), "Ящиков: "O"%i/70", VG[vehicleid][vgAmount][0]);
			case 482: format(string, sizeof(string), "Ящиков: "O"%i/50", VG[vehicleid][vgAmount][0]);
			case 573: format(string, sizeof(string), "Ящиков: "O"%i/200", VG[vehicleid][vgAmount][0]);
			}
			VG[vehicleid][vgText] = CreateDynamic3DTextLabel(string, COLOR_WHITE, x, y, z + 0.5, 20.0);
		}
		default: return ErrorMessage(playerid, "Вы должны быть за рулем т.с. для перевозки оружия");
		}
	}
	return 1;
}
CMD:unload(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Необходимо находиться за рулем автомобиля");
	if(!IsAArm(playerid) && !IsAGang(playerid) && !IsAMafia(playerid) && (!IsAGang(playerid) || GetPlayerSkin(playerid) != 191) && (!IsAGang(playerid) || GetPlayerSkin(playerid) != 287)) return 1;
	if(!GetFractionCommand(playerid, 39)) return true;
	new vehicleid = GetPlayerVehicleID(playerid);
	switch(GetVehicleModel(vehicleid))
	{
	case 433, 482: {
		if(VG[vehicleid][vgLoading] || VG[vehicleid][vgUnloading]) return ErrorMessage(playerid, "Авто уже стоит на загрузке / разгрузке");
		VG[vehicleid][vgID] = vehicleid;
		VG[vehicleid][vgUnloading] = true;
		RemovePlayerFromVehicleAC(playerid);
		new Float:x, Float:y, Float:z, Float: a;
		GetVehiclePos(vehicleid, x, y, z);
		GetVehicleZAngle(vehicleid, a);
		x = x - (-6.0 * floatsin(a, degrees));
		y = y - 6.0 * floatcos(a, degrees);
		VG[vehicleid][vgPickup] = CreateDynamicPickup(2358, 1, x, y, z - 0.5);
		SetDynamicPickupType(VG[vehicleid][vgPickup], PICKUP_TYPE_VG_LOAD, vehicleid);

		new string[64];
		switch(GetVehicleModel(vehicleid))
		{
		case 433: format(string, sizeof(string), "Ящиков: "O"%i/70", VG[vehicleid][vgAmount][0]);
		case 482: format(string, sizeof(string), "Ящиков: "O"%i/50", VG[vehicleid][vgAmount][0]);
		}
		VG[vehicleid][vgText] = CreateDynamic3DTextLabel(string, COLOR_WHITE, x, y, z + 0.5, 20.0);
	}
	case 573: {
		if(!VG[vehicleid][vgAmount][0]) return ErrorMessage(playerid, "В Т/С недостаточно боеприпасов для разгрузки");
		if(!IsPlayerInRangeOfPoint(playerid, 50, 2650.70430, -2021.7925, 14.1766) && GetTeamID(playerid) == fBALLAS) return ErrorMessage(playerid, "Вы далеко от The Ballas");
		if(!IsPlayerInRangeOfPoint(playerid, 50, 2770.68800, -1628.7234, 12.1775) && GetTeamID(playerid) == fVAGOS) return ErrorMessage(playerid, "Вы далеко от The Vagos");
		if(!IsPlayerInRangeOfPoint(playerid, 50, 2492.53980, -1673.5878, 13.3359) && GetTeamID(playerid) == fGROVE) return ErrorMessage(playerid, "Вы далеко от The Grove");
		if(!IsPlayerInRangeOfPoint(playerid, 50, 1689.20280, -2112.7527, 13.4776) && GetTeamID(playerid) == fAZTEC) return ErrorMessage(playerid, "Вы далеко от The Aztec");
		if(!IsPlayerInRangeOfPoint(playerid, 50, 2185.76900, -1815.2278, 13.5469) && GetTeamID(playerid) == fRIFA) return ErrorMessage(playerid, "Вы далеко от The Rifa");
		if(!IsPlayerInRangeOfPoint(playerid, 100, -1327.430, 406.402400, 7.07430) && GetTeamID(playerid) == fARMYSF) return ErrorMessage(playerid, "Вы далеко от склада Армии СФ");
		if(!IsPlayerInRangeOfPoint(playerid, 100, 273.97640, 1831.20970, 17.6709) && GetTeamID(playerid) == fARMYLV) return ErrorMessage(playerid, "Вы далеко от склада Армии ЛВ");
		if(!IsPlayerInRangeOfPoint(playerid, 100, 1450.5173, 751.188300, 11.0234) && GetTeamID(playerid) == fLCN) return ErrorMessage(playerid, "Вы далеко от Итальянской Мафии");
		if(!IsPlayerInRangeOfPoint(playerid, 100, 2610.6470, 1824.09640, 10.8203) && GetTeamID(playerid) == fYAKUZA) return ErrorMessage(playerid, "Вы далеко от Японской Мафии");
		if(!IsPlayerInRangeOfPoint(playerid, 100, 966.80950, 1732.47030, 8.64840) && GetTeamID(playerid) == fRM) return ErrorMessage(playerid, "Вы далеко от Русской Мафии");

		if(!IsAArm(playerid))
		{
			FI[GetTeamID(playerid)][fMats] += (VG[vehicleid][vgAmount][0] * 5000);
			if(FI[GetTeamID(playerid)][fMats] > 300000) FI[GetTeamID(playerid)][fMats] = 300000;

			VG[vehicleid][vgAmount][0] = 0;
		}
		else
		{
			new mats = floatround(FI[GetTeamID(playerid)][fMats] / 500);
			new mats_2 = mats + (VG[vehicleid][vgAmount][0] * 5000 / 500);
			if(mats_2 > 2000)
			{
				new mats_3 = 2000 - mats_2;
				VG[vehicleid][vgAmount][0] = mats_3;
			}
			else
			{
				FI[GetTeamID(playerid)][fMats] += VG[vehicleid][vgAmount][0] * 5000;
				VG[vehicleid][vgAmount][0] = 0;
			}
			if(FI[GetTeamID(playerid)][fMats] > 1000000) FI[GetTeamID(playerid)][fMats] = 1000000;
			else if(FI[GetTeamID(playerid)][fMats] < 0) FI[GetTeamID(playerid)][fMats] = 1000000;
		}
		UpdateFraction(GetTeamID(playerid), "Mats", FI[GetTeamID(playerid)][fMats]);

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""G"Боеприпасы успешно рагружены. Боеприпасов на складе: "W"%d", FI[GetTeamID(playerid)][fMats]);
		SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
	}
	default: return ErrorMessage(playerid, "Вы должны быть за рулем т.с. для перевозки оружия");
	}
	return 1;
}
stock ProxDetector(Float: radi, playerid, const string[], color, type = 0) {
	new Float:X, Float:Y, Float: Z;
	GetPlayerPos(playerid, X, Y, Z);
	foreach(new i: Player) {
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		switch(type) {
			case 1:	if(!PI[i][pPlayerSettings][PLAYER_SETTING_OOC_CHAT]) continue;
		}
		if(IsPlayerInRangeOfPoint(i, radi, X, Y, Z) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid)) SendClientMessageEx(i, color, string);
	}
	return true;
}
