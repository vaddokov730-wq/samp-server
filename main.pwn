				PI[playerid][pCasinoDice], casinoDataInfo[casinoDiceCourse]
			);
			return ShowPlayerDialog(playerid, DIALOG_CASINO_BUY_DICE, DIALOG_STYLE_INPUT, "{d8284c}Покупка костей", STRING_GLOBAL, "Принять", "Назад"), STRING_GLOBAL[0] = EOS;
		}

