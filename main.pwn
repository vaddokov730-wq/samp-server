		new
			slot_id = InventoryTempInfo[playerid][tActionSelectedSlotID],
			item_id = PI[playerid][pItemsID][slot_id], slotid, boneid;

		switch(InventoryItemInfo[item_id][itemType]) {
			case ITEM_TYPE_HEADPHONES: boneid = 1;
			case ITEM_TYPE_BACKPACK: boneid = 1;
			case ITEM_TYPE_WATCHES: boneid = 6;
			default: boneid = 2;
		}
		switch(slot_id) {
			case INVENTORY_SLOT_ID_HEAD: slotid = ATTACH_SLOT_HEAD;
			case INVENTORY_SLOT_ID_GLASSES: slotid = ATTACH_SLOT_GLASSES;
			case INVENTORY_SLOT_ID_BANDANA: slotid = ATTACH_SLOT_BANDANA;
			case INVENTORY_SLOT_ID_WATCHES: slotid = ATTACH_SLOT_WATCHES;
			case INVENTORY_SLOT_ID_BACKPACK: slotid = ATTACH_SLOT_BACKPACK;
		}
		if(!IsValidAccessory(playerid, InventoryItemInfo[item_id][itemModelID]))
			return true;
		switch(listitem + 1) {
			case 1: {
				inventory_Hide(playerid);

				EditAttachedObject(playerid, slotid);
				InventoryTempInfo[playerid][tEditAccessorySlot] = (slotid + 1);

