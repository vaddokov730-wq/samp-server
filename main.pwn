		PI[playerid][pOrgAccess][6]
	);
	strcat(STRING_GLOBAL, str, sizeof(STRING_GLOBAL));

	mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s WHERE `pID`='%d'", STRING_GLOBAL, PI[playerid][pID]);
	mysql_tquery(connects, STRING_GLOBAL, "", "");

	SaveSpawnData(playerid);

	#if defined _inventory_included
		SavePlayerInventory(playerid);
	#endif
	DeletePVar(playerid, "player_save");
	return true;
}

CB:reg_friend(playerid)
{
	new rows;
	cache_get_row_count(rows);
	new Name[25];
	if(!rows) return 1;
	cache_get_value_name(0, "pDrug", Name, 25);
	new id = GetPlayerID(Name);
	if(IsPlayerConnected(id) && TI[id][tLogin])
	{
		GiveMoney(id, REFERAL_MONEY_AMOUNT, "за друга");
		SendClientMessage(id, CGOLD, "Вы получили $"#REFERAL_MONEY_AMOUNT" за приглашенного друга, достигшего 4 уровня");
	}
	else
	{
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `"TABLE_ACCOUNTS"` SET pCash = pCash + "#REFERAL_MONEY_AMOUNT" WHERE Name = '%s'", Name);
		mysql_tquery(connects, MYSQL_GLOBAL);
	}
	PI[playerid][pDrugInv] = 1;
	UpdatePlayerData(playerid, "drunginv", 1);

	return 1;
}
CB:player_register(playerid)
{
	SetPlayerDrunkLevel(playerid, 0);
	SendClientMessage(playerid, COLOR_BLUE, "Поздравляем Вас с успешной регистрацией!");
	StopAudioStreamForPlayer(playerid);

	PlayerRegister(playerid);
	return 1;
}

stock CheckTuning(playerid, model){
	new player_vehicleid = GetPlayerVehicleCarID(playerid);

	if(
		PlayerVehicleInfo[player_vehicleid][carVehcom][0] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][1] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][2] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][3] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][4] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][5] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][6] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][7] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][8] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][9] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][10] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][11] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][12] == model ||
		PlayerVehicleInfo[player_vehicleid][carVehcom][13] == model
	) return true;

	return false;
}

