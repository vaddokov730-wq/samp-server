		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `vote` SET `vote_count` = '%i' WHERE `vote_name` = '%s'", vote_count[listitem], vote_name[listitem]);
		mysql_pquery(connects, MYSQL_GLOBAL, "", "");
		new string[144];
