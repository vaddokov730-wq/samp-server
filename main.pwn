stock OnPlayerCheckFailedAnim(playerid)
{
	if(GetPVarInt(playerid, "anti_sbiv_time") > unix && PI[playerid][pJailTime] <= 0)
	{
		new str_time = 30;

		if(GetTeamID(playerid) > 0)
		{
			static const f_bot_penalty[] = "\
			"NameServer" Bot посадил в ДеМорган %s на %d минут. Причина: сбив анимации [%s]";

			new str_bot_penalty[sizeof(f_bot_penalty) + (-2 + MAX_PLAYER_NAME + 1) + (-2 + 8) + (-2 + 36)];
			format(str_bot_penalty, sizeof(str_bot_penalty), f_bot_penalty, player_name[playerid], str_time, FI[GetTeamID(playerid)][fName]);
			SendAdminActionMessage(COLOR_LIGHTRED, str_bot_penalty);
		}
		if(GetTeamID(playerid) == 0)
		{
			static const f_bot_penalty[] = "\
			"NameServer" Bot посадил в ДеМорган %s на %d минут. Причина: сбив анимации";

			new str_bot_penalty[sizeof(f_bot_penalty) + (-2 + MAX_PLAYER_NAME + 1) + (-2 + 8)];
			format(str_bot_penalty, sizeof(str_bot_penalty), f_bot_penalty, player_name[playerid], str_time);
			SendAdminActionMessage(COLOR_LIGHTRED, str_bot_penalty);
		}

		if(player_to_game[playerid] == 1) players_in_game--;
		if(player_to_golod[playerid] == 1)
		{
			players_in_golod--;
			golod_deatch(playerid, players_in_golod);
		}
		ResetPlayerWeapons(playerid);

		// inventory_ResetWeapons(playerid, RESET_WEAPON_TYPE_FULL);
		PI[playerid][pJail] = 5;
		PI[playerid][pJailTime] = 1800;

		UpdatePlayerData(playerid, "pJailTime", PI[playerid][pJailTime]);
		UpdatePlayerData(playerid, "pJail", 5);
		PlayerSpawn(playerid);

		GameTextForPlayer(playerid, "~w~YOU IN ~R~JAIL", 5000, 4);
		SendOk(playerid, ""NameServer" Bot посадил вас в ДеМорган на 30 минут. Причина: сбив анимации");
		SendOk(playerid, "Время до выхода на свободу: "W"/time");
		WriteLog(LOG_JAIL, -1, ""NameServer" Bot", player_name[playerid], "Сбив Анимации");
	}
	return 0x1;
}

stock UpdateReportsFraction(playerid, status)
{
	mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "SELECT id,count_1 FROM `fractionreports` WHERE `user` = '%d' AND `fraction` = '%d' AND `data` = DATE(now())", PI[playerid][pID], PI[playerid][pMember]);
	mysql_tquery(connects, MYSQL_GLOBAL, "SelectFractionReports", "dd", playerid, status);

	return true;
}

CB:SelectFractionReports(playerid, status)
{
	new id;
	if(cache_num_rows())
	{
		cache_get_value_int(0, "id", id);
		cache_get_value_int(0, "count_1", RepFractionLoad[playerid][0]);
		if(status)
		{
			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `fractionreports` SET `count_1` = `count_1` + '%d' WHERE `id` = '%d';", RepFraction[playerid][0], id);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			RepFractionLoad[playerid][0] += RepFraction[playerid][0];
			RepFraction[playerid][0] = 0;
		}

	}
	else
	{
		if(status)
		{
			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "INSERT INTO `fractionreports` (`user`, `data`, `fraction`, `count_1`, `count_2`) VALUES ('%d', NOW(), '%d', '%d', '0');", PI[playerid][pID], PI[playerid][pMember], RepFraction[playerid][0]);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
		}
		RepFraction[playerid][0] = 0;
		RepFractionLoad[playerid][0] = 0;
	}
	return true;
}

stock GetFractionCommand(playerid, command)
{
	if(PI[playerid][pMember] == 0) return 0x0;
	//  if(!GetFractionCommand(playerid, 1)) return true; // проверка для команд ВСЕГО КМД 73
	if(!start_work[playerid]) return ErrorMessage(playerid, "Вам необходимо начать рабочий день");
	if(RightCommand[PI[playerid][pMember]][command] == 30)
	{
		ErrorMessage(playerid, "Данная команда вам не доступна!");
		return false;
	}
	if(RightCommand[PI[playerid][pMember]][command] == 0)
	{
		ErrorMessage(playerid, "Данная команда временно недоступна, лидер не установил на нее права!");
		return false;
	}
	if(PI[playerid][pRank] >= RightCommand[PI[playerid][pMember]][command]) return true;
	else
	{
		static const f_frac_cmd[] = "\
		Данная функция доступна с %i ранга";

		new str_frac_cmd[sizeof(f_frac_cmd) + (-2 + 4)];
		format(str_frac_cmd, sizeof(str_frac_cmd), f_frac_cmd, RightCommand[PI[playerid][pMember]][command]);
		ErrorMessage(playerid, str_frac_cmd);
	}
	return 0x0;
}

CB:AddSubdivision(playerid)
{
	Subdivision[SubdivisionDialog[playerid][0]][sub_tag_settings] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_leader] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_substituent] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_substituent_2] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_id] = cache_insert_id();

	static const f_create_sub[] = "\
	Подразделение '%s' успешно создано";

	new str_create_sub[sizeof(f_create_sub)];
	format(str_create_sub, sizeof(str_create_sub), f_create_sub, Subdivision[SubdivisionDialog[playerid][0]][sub_name]);
	SendOk(playerid, str_create_sub);
	SubdivisionDialog[playerid][0] = EOS;
	return true;
}

stock CancelSubdivision(playerid)
{

	Subdivision[SubdivisionDialog[playerid][0]][sub_id] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_status] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_frac] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_name][0] = EOS;
	Subdivision[SubdivisionDialog[playerid][0]][sub_short_name][0] = EOS;
	Subdivision[SubdivisionDialog[playerid][0]][sub_tag][0] = EOS;
	Subdivision[SubdivisionDialog[playerid][0]][sub_tag_settings] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_leader] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_substituent] = 0;
	Subdivision[SubdivisionDialog[playerid][0]][sub_substituent_2] = 0;
	SubdivisionDialog[playerid][0] = EOS;
	return true;
}
