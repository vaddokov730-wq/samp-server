stock ShowAirportInformation(playerid, id, dialogid)
{
	new day, arend;
	day = (gAirs[id][airDay] - gettime()) / 86400;
	for(new i = 1; i <= gPlaneCount; i ++)
	{
		if(gAirplanes[i][aAirport] != id + 1) continue;
