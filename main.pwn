stock CreatePickups()
{
	for(new i; i != 21; i++)
	{
		objgolod[i] = -1;
		pickups_game_golod_2[i] = -1;
	}

	//CreateDynamicPickup(3632, 23, 415.0787, 1405.1608, 8.5656, 0, 0); //[нефть] пикап бочки
	//CreateDynamicPickup(3632, 23, 401.2273, 1456.7953, 8.1906, 0, 0); //[нефть] пикап бочки

	for(new id = 0, objectid; id < sizeof (MovingDoorsInfo); id++) {
		CreateDynamic3DTextLabel(""G"Взаимодействие: "P"\"ALT\"", -1,
			MovingDoorsInfo[id][doorClosedPos][0], MovingDoorsInfo[id][doorClosedPos][1],
			MovingDoorsInfo[id][doorClosedPos][2] + 0.8, 8.0,
			.worldid = MovingDoorsInfo[id][doorWorld], .interiorid = MovingDoorsInfo[id][doorInterior]
		);
		objectid = CreateDynamicObject(MovingDoorsInfo[id][doorModel],
			MovingDoorsInfo[id][doorClosedPos][0], MovingDoorsInfo[id][doorClosedPos][1],
			MovingDoorsInfo[id][doorClosedPos][2], MovingDoorsInfo[id][doorClosedPos][3],
			MovingDoorsInfo[id][doorClosedPos][4], MovingDoorsInfo[id][doorClosedPos][5],
			MovingDoorsInfo[id][doorWorld], MovingDoorsInfo[id][doorInterior], -1, 80.0, 80.0
		);
		MovingDoorsInfo[id][doorObjectID] = objectid;

		switch(MovingDoorsInfo[id][doorModel]) {
			case 19870: {
				SetDynamicObjectMaterial(objectid, 0, -1, "none", "none", 0xFFFFFFFF);
				SetDynamicObjectMaterial(objectid, 1, 4830, "airport2", "sanpedock5", 0x00000000);
				SetDynamicObjectMaterial(objectid, 2, 19297, "matlights", "invisible", 0x00000000);
			}
			case 19911: { }
			default: {
				SetDynamicObjectMaterial(objectid, MovingDoorsInfo[id][doorIndex],
					MovingDoorsInfo[id][doorModelID], MovingDoorsInfo[id][doorTXD],
					MovingDoorsInfo[id][doorTexture], MovingDoorsInfo[id][doorColor]
				);
			}
		}

		MovingDoorsInfo[id][doorIsOpened] = false;
	}
	for(new i = 0; i < sizeof(gTeleportsToD); i++)
	{
		new string[72];
		strcat(string, gTeleportsToD[i][tpName]), strcat(string, "\n\n"G"Вcтаньте на пикап, чтобы войти/выйти");
		CreateDynamic3DTextLabel(string, PP, gTeleportsToD[i][tpEnterPos_X], gTeleportsToD[i][tpEnterPos_Y], gTeleportsToD[i][tpEnterPos_Z], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, gTeleportsToD[i][tpEnterWorld], gTeleportsToD[i][tpEnterInt]);
