		case 11: return ShowPlayerDialog(playerid, D_SPAWN, DSL, ""P"Выбор спавна", ""P"1."W" Вокзал\n"P"2."W" Дом/Отель\n"P"3."W" Организация", "Выбрать", "Отмена");
		case 12: {
