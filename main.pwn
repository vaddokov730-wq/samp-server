				TI[playerid][tTempChangeCarBuyerID] = INVALID_PLAYER_ID;
				ErrorMessage(targetid, "У Вас максимальное количество ТС. (Вы можете его продать игроку, либо утилизировать)");
				ErrorMessage(playerid, "У игрока максимальное количество ТС.");
				return false;
