CMD:setsalary(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0)
		return true;
	new fraction, fracpay_min, fracpay_max;
	if(sscanf(params, "iii", fraction, fracpay_min, fracpay_max) || !(0 <= fraction < sizeof (FracSalary)) || !(200 <= fracpay_min <= 7000) || !(400 <= fracpay_max <= 7000)) {
		SendClientMessage(playerid, -1, "0 - PD | 1 - FBI | 2 - MAYOR | 3 - ARMY | 4 - MEDICS | 5 - NEWS");
		SendClientMessage(playerid, -1, "8 - WHITEHOUSE | 9 - LICENSERS");
		return SendEsp(playerid, "/setsalary [fraction 0-9] [min $] [max $]");
	}

	new total_rank = sizeof (FracSalary[]);
	/*for(new rankid = 1; rankid <= sizeof (FracSalary; rankid++) {
		if(rankid == (1 + MAX_RANK)) break;
		if(!strcmp(FracSalary[fraction][rankid], "None", true)) break;

		total_rank++;
	}*/
	new step_pay = fracpay_max / total_rank, name[32];

	switch(fraction) {
		case 0: format(name, sizeof (name), "PD");
		case 1: format(name, sizeof (name), "FBI");
		case 2: format(name, sizeof (name), "MAYOR");
		case 3: format(name, sizeof (name), "ARMY");
		case 4: format(name, sizeof (name), "MEDICS");
		case 5: format(name, sizeof (name), "NEWS");
		case 8: format(name, sizeof (name), "WHITEHOUSE");
		case 9: format(name, sizeof (name), "LICENSERS");
		default: return true;
	}
	for(new rankid = 0, pay_count; rankid < total_rank; rankid++) {
		if(rankid == 0)
			pay_count = fracpay_min;
		else pay_count += step_pay;

		FracSalary[fraction][rankid] = pay_count;
		if(FracSalary[fraction][rankid] < 0)
			FracSalary[fraction][rankid] = 0;
		format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "\
			"P"[%s] "G"Ранг №%i - "GREEN"$%i\n",
			name, rankid + 1, pay_count
		);
		SendClientMessage(playerid, -1, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
	}
	save_salary(fraction);

	return true;
}
CMD:clist(playerid) {
	TI[playerid][tClistDisabled] = !TI[playerid][tClistDisabled];
	if(TI[playerid][tClistDisabled]) {
		SetPlayerColor(playerid, TEAM_HIT_COLOR);
		SendOk(playerid, "Вы выключили клист.");
	} else {
		if(start_work[playerid]) {
			SetPlayerColor(playerid, gFractionSpawn[PI[playerid][pMember]][fracColor]);
		}
		SendOk(playerid, "Вы включили клист.");
	}
	return true;
}
