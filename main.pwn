				switch(gHouses[houseid][houseClass]) {
					case 0: id = 0;
					case 1: id = 2;
					case 2: id = 4;
					case 3: id = 6;
				}
				if(slotid) id++;

				VehicleInfo[PlayerVehicleInfo[player_vehicle_id][carVehicle]][vParkingFine] = 0;
				PlayerVehicleInfo[player_vehicle_id][carParked] = 1;

				PlayerVehicleInfo[player_vehicle_id][carPos][0] = cargarage[id][0];
				PlayerVehicleInfo[player_vehicle_id][carPos][1] = cargarage[id][1];
				PlayerVehicleInfo[player_vehicle_id][carPos][2] = cargarage[id][2];
				PlayerVehicleInfo[player_vehicle_id][carPos][3] = cargarage[id][3];

				PlayerVehicleInfo[player_vehicle_id][carInterior] = interiorid;
				PlayerVehicleInfo[player_vehicle_id][carWorld] = houseid + 1;

				SetVehicleToRespawn(PlayerVehicleInfo[player_vehicle_id][carVehicle]);

				SavePlayerVehicle(player_vehicle_id);
				SendOk(playerid, "Выбранный транспорт успешно доставлен в гараж за "GREEN"$"#FIX_CAR_GARAGE_PRICE""G".");
			}
		}
		UpdateVehicleDamageStatus(PlayerVehicleInfo[player_vehicle_id][carVehicle], vpanels, vdoors, vlights, vtires);
		SetVehicleHealth(PlayerVehicleInfo[player_vehicle_id][carVehicle], vehicleHealth);

		DeletePVar(playerid, "player_vehicle_id");
		return true;
	}
