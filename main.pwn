			   Subdivision[SubdivisionDialog[playerid][listitem]][sub_tag],
			   header,
			   Subdivision[SubdivisionDialog[playerid][listitem]][sub_leader]);
		SelectFractionChange[playerid][0] = SubdivisionDialog[playerid][listitem];
		ShowPlayerDialog(playerid, D_SUB_LIST_1, DSTH, ""P"Список подразделений", STRING_GLOBAL, "Выбрать", "Отмена");
	}
	case D_SUB_LIST_1: {
		if(!response) return true;
		switch(listitem)
		{
		case 0: {
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите название подразделения от 1 до 15 символов:\n"P"Текущие название: %s", Subdivision[SelectFractionChange[playerid][0]][sub_name]);
			ShowPlayerDialog(playerid, D_SUB_EDIT_NAME, DSI, ""P"Изменить название", STRING_GLOBAL, "Изменить", "Закрыть");
		}
		case 1: {
			STRING_GLOBAL[0] = EOS;
			for(new i = 0; i < sizeof(color_fraction); i++)
			{
				if(i == (sizeof(color_fraction) - 1))
				{
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x}%i.Цвет", STRING_GLOBAL, color_fraction[i][fracColor] >>> 8, i + 1);
					break;
				}
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x}%i.Цвет\n", STRING_GLOBAL, color_fraction[i][fracColor] >>> 8, i + 1);
			}
			ShowPlayerDialog(playerid, D_SUB_EDIT_COLOR, DST, ""P"Выберите цвет", STRING_GLOBAL, "Сменить", "Закрыть");
		}
		case 2: {
			ShowPlayerDialog(playerid, D_SUB_EDIT_TAG, DSI, ""P"Введите тэг", ""W"Введите название тэга, который используется в чате фракции\n"W"От 1 до 5 символов", "Далее", "Закрыть");
		}
		case 3: {
			if(Subdivision[SelectFractionChange[playerid][0]][sub_tag_settings] == 1)
			{
				SendOk(playerid, "Вы отключили отображение тэга в чате фракции");
				Subdivision[SelectFractionChange[playerid][0]][sub_tag_settings] = 0;
			}
			else
			{
				SendOk(playerid, "Вы включили отображение тэга в чате фракции");
				Subdivision[SelectFractionChange[playerid][0]][sub_tag_settings] = 1;
			}
			MYSQL_GLOBAL[0] = EOS;
			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `subdivision` SET `tag_settings` = '%d' WHERE `id` = '%d';", Subdivision[SelectFractionChange[playerid][0]][sub_tag_settings], Subdivision[SelectFractionChange[playerid][0]][sub_id]);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			STRING_GLOBAL[0] = EOS;
			new header[10];
			if(Subdivision[SelectFractionChange[playerid][0]][sub_tag_settings] == 1) format(header, sizeof(header), "Выключить");
			else format(header, sizeof(header), "Включить");

			format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
					""P"Название\t"P"Статус\n\
					"P"1."W" Изменить название\t"P"%s\n\
					"P"2."W" Изменить цвет\t{%06x}%s\n\
					"P"3."W" Изменить тэг\t"P"%s\n\
					"P"4."W" %s тэг в чате\n\
					"P"5."W" Изменить командира\n\
					"P"6."W" Изменить заместителя №1\n\
					"P"7."W" Изменить заместителя №2\n\
					"P"8."W" Назначить начальным",
					Subdivision[SelectFractionChange[playerid][0]][sub_name],
					color_fraction[Subdivision[SubdivisionDialog[playerid][listitem]][sub_color]][fracColor] >>> 8,
					Subdivision[SelectFractionChange[playerid][0]][sub_name],
					Subdivision[SelectFractionChange[playerid][0]][sub_tag],
					header,
					Subdivision[SelectFractionChange[playerid][0]][sub_leader]
			);
			ShowPlayerDialog(playerid, D_SUB_LIST_1, DSTH, ""P"Список подразделений", STRING_GLOBAL, "Выбрать", "Отмена");
		}
		case 4: {
			SelectFractionChange[playerid][1] = 1;
			ShowPlayerDialog(playerid, D_SUB_PUT, DSI, ""P"Введите ID", ""W"Введите ID игрока, которого хотите назначить руководителем подразделения\nЧтобы снять игрока с должности введите 1001", "Назначить", "Закрыть");
		}
		case 5: {
			SelectFractionChange[playerid][1] = 2;
			ShowPlayerDialog(playerid, D_SUB_PUT, DSI, ""P"Введите ID", ""W"Введите ID игрока, которого хотите назначить заместителем(1) подразделения\nЧтобы снять игрока с должности введите 1001", "Назначить", "Закрыть");
		}
		case 6: {
			SelectFractionChange[playerid][1] = 3;
			ShowPlayerDialog(playerid, D_SUB_PUT, DSI, ""P"Введите ID", ""W"Введите ID игрока, которого хотите назначить заместителем(2) подразделения\nЧтобы снять игрока с должности введите 1001", "Назначить", "Закрыть");
		}
		case 7: {
			if(FI[PI[playerid][pMember]][fDefSub] == Subdivision[SelectFractionChange[playerid][0]][sub_id])  return ErrorMessage(playerid, "Данное подразделение уже является начальным");
			SendOk(playerid, "Вы изменили начальное подразделения при вступлению в вашу фракцию");
			FI[PI[playerid][pMember]][fDefSub] = Subdivision[SelectFractionChange[playerid][0]][sub_id];
			MYSQL_GLOBAL[0] = EOS;
			mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `fractions` SET `DefaultSubdivision` = '%d' WHERE `ID` = '%d';", FI[PI[playerid][pMember]][fDefSub], PI[playerid][pMember]);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
		}
		}
	}
	case D_SUB_PUT: {
		if(!response) return 1;
		if(!strlen(inputtext)) return ErrorMessage(playerid, "Вы не ввели ID игрока!");
		new id = strval(inputtext);
		MYSQL_GLOBAL[0] = EOS;
		if(id < 0 || id > 1001) return ErrorMessage(playerid, "Введите ID игрока от 0 до 1000");
		if(id == 1001)
		{

			Subdivision[SelectFractionChange[playerid][0]][sub_leader] = 0;
			foreach(new i: Player)
			{
				if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
				if(
					Subdivision[SelectFractionChange[playerid][0]][sub_leader] == PI[i][pID]
					|| Subdivision[SelectFractionChange[playerid][0]][sub_substituent] == PI[i][pID]
					|| Subdivision[SelectFractionChange[playerid][0]][sub_substituent_2] == PI[i][pID]) SubdivisionPlayer[i][1] = 0;

			}
			CHAT_GLOBAL[0] = EOS;
			switch(SelectFractionChange[playerid][1])
			{
			case 1: {
				format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), "[R] %s %s[%d] cнял руководителем подразделения '"P"%s{31cf63}' ", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid, Subdivision[SelectFractionChange[playerid][0]][sub_name]);
				SendFamilyMessage(PI[playerid][pMember], 0x31cf63FF, CHAT_GLOBAL);
				mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `subdivision` SET `leader` = '0' WHERE `id` = '%d';", Subdivision[SelectFractionChange[playerid][0]][sub_id]);
				mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			}
			case 2: {
				format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), "[R] %s %s[%d] cнял заместителя(1) подразделения '"P"%s{31cf63}' ", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid, Subdivision[SelectFractionChange[playerid][0]][sub_name]);
				SendFamilyMessage(PI[playerid][pMember], 0x31cf63FF, CHAT_GLOBAL);
				mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `subdivision` SET `substituent` = '0' WHERE `id` = '%d';", Subdivision[SelectFractionChange[playerid][0]][sub_id]);
				mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			}
			case 3: {
				format(CHAT_GLOBAL, sizeof(CHAT_GLOBAL), "[R] %s %s[%d] cнял заместителя(2) подразделения '"P"%s{31cf63}' ", GetRankName(GetTeamID(playerid), PI[playerid][pRank]), player_name[playerid], playerid, Subdivision[SelectFractionChange[playerid][0]][sub_name]);
				SendFamilyMessage(PI[playerid][pMember], 0x31cf63FF, CHAT_GLOBAL);
				mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `subdivision` SET `substituent2` = '0' WHERE `id` = '%d';", Subdivision[SelectFractionChange[playerid][0]][sub_id]);
				mysql_tquery(connects, MYSQL_GLOBAL, "", "");
			}
			}
			return true;
		}
		if(!IsPlayerConnected(id) || id == INVALID_PLAYER_ID) return ErrorMessage(playerid, not_id);
		if(PI[playerid][pMember] != PI[id][pMember]) return ErrorMessage(playerid, "Игрок не состоит в вашей организации");
		if(SubdivisionPlayer[id][1] != 0) return ErrorMessage(playerid, "Игрок уже назначен на какое-то подразделение");
		if(!start_work[id]) return ErrorMessage(playerid, "Игрок не начал рабочий день");
		switch(SelectFractionChange[playerid][1])
		{
		case 1: {
			CHAT_GLOBAL[0] = EOS;
