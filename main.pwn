CMD:atdoggletestdamage1a(playerid) {
	if(AnticheatToggle[0]) {
		AnticheatToggle[0] = 0;
		SendClientMessage(playerid, -1, "Античит на дамаггер руками выключен -.");
	}
	else {
		AnticheatToggle[0] = 1;
		SendClientMessage(playerid, -1, "Античит на дамаггер руками включен +.");
	}
	return true;
}
CMD:atogggletestdamage2a(playerid) {
	if(AnticheatToggle[1]) {
		AnticheatToggle[1] = 0;
		SendClientMessage(playerid, -1, "Античит на дамаггер оружием выключен -.");
