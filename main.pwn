			case 2: SetSpawnInfo(playerid, 255, INVENTORY_NUDE_SKIN_FEMALE, spawn_ls[rand][0], spawn_ls[rand][1], spawn_ls[rand][2], spawn_ls[rand][3], -1, -1, -1, -1, -1, -1);
			default:  SetSpawnInfo(playerid, 255, INVENTORY_NUDE_SKIN_MALE, spawn_ls[rand][0], spawn_ls[rand][1], spawn_ls[rand][2], spawn_ls[rand][3], -1, -1, -1, -1, -1, -1);
		}
		if(!response || PI[playerid][pSpawnTime] < gettime()) {
			TI[playerid][tLastSpawn] = 0;
		} else {
			TI[playerid][tLastSpawn] = 1;
		}
