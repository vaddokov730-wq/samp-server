				mysql_tquery(connects, query);
			}
			format(query, sizeof(query), "UPDATE `airports` SET `ownerid` = '0', `owner` = '', `bank` = '0' WHERE `id` = '%d'", i + 1);
			mysql_tquery(connects, query, "", "");
			gAirs[i][airOwnerID] = 0;
			SetString(gAirs[i][airOwner], "");
			UpdateAirportsText(i);
		}
	}
	for(new i = 1; i <= gPlaneCount; i ++)
	{
		if(!GetString(gAirplanes[i][aOwner], "State") && gAirplanes[i][aTime] <= unix)
		{
			SetString(gAirplanes[i][aOwner], "State");
			gAirplanes[i][aTime] = 0;
			UpdateDynamic3DTextLabelText(gAirplanes[i][aText], -1, "Не арендован");
			SavePlane(i);
			SetVehicleParamsEx(gAirplanes[i][aCar], engine, lights, alarm, 0, bonnet, boot, objective);
		}
	}
	for(new i = 1; i < 16; i ++)
	{
		if(ATMData[i][atm_Bank] && ATMData[i][atm_BankTime] <= unix)
		{
			ATMData[i][atm_Bank] = 0;
			ATMData[i][atm_BankTime] = 0;
			UpdateAtmData(i, "ATM_BANK", ATMData[i][atm_Bank]);
			UpdateAtmData(i, "ATM_BANKTIME", ATMData[i][atm_BankTime]);
		}
	}
	for(new i; i < MAX_BILLBORDS; i++)
	{
		if(BildInfo[i][bOwned] && BildInfo[i][bDay] <= unix)
		{
			BildInfo[i][bFontSize] = 0;
			BildInfo[i][bBackColor] = 0;
			BildInfo[i][bFontFace] = 0;
			BildInfo[i][bOwned] = 0;
			BildInfo[i][bDay] = 0;
			format(BildInfo[i][bOwner], 1, "-");
			UpdateBuildText(i);

			MYSQL_GLOBAL[0] = EOS;
			mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `billboards` SET `bDay` = 0, `bOwned` = 0, `bOwner` = '-', `bText` = '-', `bFontSize` = 25, `bAligment` = 1, `bBackColor` = 1, `bFontFace` = 0 WHERE `id` = %i", i);
			mysql_tquery(connects, MYSQL_GLOBAL, "", "");
		}
	}

	for(new i = 0; i < 50; i++)
	{
		if(FracVehicle[i][fvehModelNew] == 0) continue;
		if(FracVehicle[i][fvehModelNew] && FracVehicle[i][fvehTime] < unix)
		{
			FracVehicle[i][fvehTime] = 0;
			FracVehicle[i][fvehModelNew] = 0;
			save_fracveh(i);
		}
	}
	foreach(new i: Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		PI[i][pPlayTime][0]++;
		if(TI[i][tMaskTime] > 0)
		{
			TI[i][tMaskTime]--;
			if(TI[i][tMaskTime] == 0)
			{
				if(PI[i][pMember] && start_work[i]) SetPlayerColor(i, gFractionSpawn[PI[i][pMember]][fracColor]);
				else SetPlayerColor(i, 0xFFFFFF00);
				if(TI[i][tMasked]) SetPlayerColor(i, gFractionSpawn[TI[i][tMasked]][fracColor]);
				SendOk(i, "По истечению 10 минут, маска была снята");
				RemovePlayerAttachedObject(i, ATTACH_SLOT_BANDANA);
				inventory_UpdateAccesory(i, ATTACH_SLOT_BANDANA);
			}
		}
		if(PI[i][pSatiety] >= 1)
		{
			if(PI[i][pDSatiety]) continue;
			SetPVarFloat(i, "timer_satiety", GetPVarFloat(i, "timer_satiety") + 1);
			if(GetPVarFloat(i, "timer_satiety") >= 2)
			{
				GiveFullness(i, -1);
				DeletePVar(i, "timer_satiety");
			}
		}
		if(PI[i][pSatiety] == 15 && !PI[i][pDisease][1] && TI[i][tLogin] && PI[i][pLevel] > 2)
		{
			if(PI[i][pDDisease]) continue;
			SendOk(i, "Вы очень голодны. Чтобы не заболеть, советуем посетить закусочную");
			SendOk(i, "Следите за своим состоянием голода на прогресс баре");
		}
		if(PI[i][pSatiety] < 5 && !PI[i][pDisease][1] && TI[i][tLogin] && PI[i][pLevel] > 2)
		{
			if(PI[i][pDDisease]) continue;
			new rand = random(5);
			if(rand != 2) continue;
			SendOk(i, "Вы заболели от недостатка питания (анорексия)");
			SendOk(i, "Советуем Вам обратиться к медикам в любой из пунктов больницы!");
			//SendOk(i, "(( Внимание! Состояние Вашей жизни (HP) будет падать значительно быстрее ))");
			PI[i][pDisease][1] = 1;
			UpdatePlayerData(i, "pDisease_1", 1);
		}
		if(TI[i][tArendKey] != -1)
		{
			new rc = TI[i][tArendKey];
			if(ArendInfo[rc][aPlayerID] != i)
			{
				TI[i][tArendKey] = -1;
				continue;
			}
			if(!IsPlayerInVehicle(i, ArendInfo[rc][aID]))
			{
				new Float:x, Float:y, Float: z;
				GetVehiclePos(ArendInfo[rc][aID], x, y, z);
				if(!IsPlayerInRangeOfPoint(i, 2000.0, x, y, z) && GetPlayerVirtualWorld(i) == 0 && GetPlayerInterior(i) == 0)
				{
					SendClientMessage(i, COLOR_REDD, "Вы отошли слишком далеко от арендованного Вами транспорта");
					ArendInfo[rc][aPlayerID] = INVALID_PLAYER_ID;
					SetVehicleToRespawn(ArendInfo[rc][aID]);
					TI[i][tArendKey] = -1;
					continue;
				}
			}
		}
	}
}
CB:OnUpdateCheatPlayers()
{
	for(new i = MAX_DICE_TABLES - 1; i != -1; i --)
	{
		if(CasinoUpdateScore[i] == 1)
		{
			if(++CasinoUpdateScoreTime[i] == 2)
			{
				score_update(i);
				CasinoUpdateScore[i] = 0;
				CasinoUpdateScoreTime[i] = 0;
			}
		}
	}
	return 1;
}
#define FUEL_TIMER_UPDATE	(20)
static
	FUEL_TIMER = 0,
	SAD_TIMER = 2;

stock second_timer() {
	gettime(tmphour, tmpminute, tmpsecond);

	if(second_timerlog > 0) {
		format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Потерялся конец second_timerlog. Этап: %d", second_timerlog), CHAT_GLOBAL[0] = EOS;
	}
	if(++FUEL_TIMER >= FUEL_TIMER_UPDATE) {
		FUEL_TIMER = 0;
		FuelTimer();
	}
	OnUpdateCheatPlayers();

	#if defined _factoryjob_included
		factory_Timer();
	#endif
	#if defined _cargo_ship_inc
		OnCargoShipTimer();
	#endif
	#if defined _poker_included
		poker_Timer();
	#endif
	#if defined _blackjack_included
		blackjack_Timer();
	#endif
	#if defined _casino_included
		casino_Timer();
	#endif
	#if defined _farmjob_included
		farm_Timer(); // every 5 seconds | plants
	#endif
	#if defined _organizations_included
		org_Timer(); // every 5 seconds | plants
	#endif
	#if defined _inventory_included
		OnDroppedItemsTimer(); // every 2 hours
	#endif

	second_timerlog = 1;

	capture_kd[fBALLAS] = capture_kd[fVAGOS] = capture_kd[fGROVE] = capture_kd[fAZTEC] = capture_kd[fRIFA] = unix;

	if(BizWarTime[0] > 0)
	{
		BizWarTime[0]--;
		if(BizWarTime[0] == 600)
		{
			SendFamilyMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, "До начала встречи осталось 10 минут");
			SendFamilyMessage(MZInfo[bNapad], COLOR_LIGHTRED, "До начала встречи осталось 10 минут");
		}
		if(BizWarTime[0] == 300)
		{
			SendFamilyMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, "До начала встречи осталось 5 минут");
			SendFamilyMessage(MZInfo[bNapad], COLOR_LIGHTRED, "До начала встречи осталось 5 минут");
		}
		if(BizWarTime[0] == 180)
		{
			SendFamilyMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, "Приготовьтесь! До начала встречи осталось 3 минуты");
			SendFamilyMessage(MZInfo[bNapad], COLOR_LIGHTRED, "Приготовьтесь! До начала встречи осталось 3 минуты");
		}
		if(BizWarTime[0] == 60)
		{
			SendFamilyMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, "Внимание! До начала встречи осталась 1 минута");
			SendFamilyMessage(MZInfo[bNapad], COLOR_LIGHTRED, "Внимание! До начала встречи осталась 1 минута");
		}
		if(BizWarTime[0] == 0) MafiaTimeCapture(MZInfo[bFrakVlad], MZInfo[bNapad]);
	}
	if(BizWarTime[1]) BizWarTimer();

	if(++SAD_TIMER >= 5) {
		for(new i = 0; i < 119; i ++)
		{
			if(SI[i][sad_temp] != 4)
				continue;
			if(SI[i][sad_temp] == 4 && SI[i][sad_time] <= unix)
			{
				sad_delete(i);
			}
		}
		for(new id = 0; id < MAX_OBJECT_MOVED; id++)
		{
			if(ServerMovedEx[id] == 1)
			{
				if(ServerMovedFix[id] < gettime())
				{
					CheckObjectBarrier(id);
					ServerMovedEx[id] = 0;
				}
			}
		}
		SAD_TIMER = 0;
	}
	/*#if defined _player_vehicles_included
	if((++OnDestroyCarsTimer_Timer) >= VEHICLE_ON_DESTROY_TIMER) {
		OnDestroyCarsTimer();
		OnDestroyCarsTimer_Timer = 0;
	}
	#endif*/

	STRING_GLOBAL[0] = EOS;

	second_timerlog = 2;

	#if defined _bank_robbery_included
		RB_Timer();
	#endif
	#if defined _metro_stop_included
		ms_Timer(); // every 3 seconds
	#endif

	second_timerlog = 9;
	for(new i; i < MAX_ACTORSS; i++) {
		if(actortime[i] > 0) {
			actortime[i]--;
			if(actortime[i] == 0) {
				ApplyActorAnimation(i, "BD_FIRE", "BD_Fire1", 4.1, 0, 0, 0, 0, 1);
				if(i == 6 || i == 7 || i == 8 || i == 9 || i == 10 || i == 11 || i == 12)
					ApplyActorAnimation(i, "DEALER", "Dealer_idle", 4.1, 0, 0, 0, 1, 1);
				Update3DTextLabelText(tActor[i], COLOR_GREY, "");
			}
		}
	}
	if(tmphour == 05 && tmpminute == 03 && tmpsecond == 00) {
		SendClientMessageToAll(COLOR_YELLOW, "Через две минуты произойдет автоматическая перезагрузка сервера");
		SendClientMessageToAll(COLOR_YELLOW, "Просьба закончить все свои работы. Спасибо за понимание");
	}
	#if defined _events_inc
	else if(tmphour == 23 && tmpminute == 59 && (tmpsecond == 00 || tmpsecond == 01)) {
		mysql_tquery(connects, "SELECT `accountid`, `online_sec`, `afk_sec`, `user_name` FROM `online_player` WHERE date >= CURDATE() ORDER BY `online_sec` DESC LIMIT 3", "OnMemoryLoadEventTime", "dd", -1, 0);
		//mysql_tquery(connects, "SELECT `account`, `sum` FROM `unitpay_payments` WHERE date >= CURDATE() AND `status` == '1' ORDER BY `sum` DESC LIMIT 1", "OnMemoryLoadEventDonate", "dd", -1, 0);
	}
	else if(tmphour == 04 && tmpminute == 55 && (tmpsecond == 00 || tmpsecond == 01)) {
		for(new CountEvent = 1; CountEvent != MAX_EVENT_COUNT; CountEvent ++)
		{
			switch(CountEvent)
			{
			case 1: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventCapt` FROM `accounts` WHERE `pMember` >= 18 AND `pMember` <= 22 ORDER BY `EventCapt` DESC LIMIT 3", "OnMemoryLoadEventCapt", "dd", -1, 0);
			case 2: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventBizWar` FROM `accounts` WHERE `pMember` >= 15 AND `pMember` <= 17 ORDER BY `EventBizWar` DESC LIMIT 3", "OnMemoryLoadEventBizWar", "dd", -1, 0);
			case 3: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventTrucker` FROM `accounts` ORDER BY `EventTrucker` DESC LIMIT 25", "OnMemoryLoadEventTrucker", "dd", -1, 0);
			case 4: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventApple` FROM `accounts` ORDER BY `EventApple` DESC LIMIT 25", "OnMemoryLoadEventApple", "dd", -1, 0);
			case 5: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventGun` FROM `accounts` ORDER BY `EventGun` DESC LIMIT 25", "OnMemoryLoadEventGun", "dd", -1, 0);
			case 6: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventLes` FROM `accounts` ORDER BY `EventLes` DESC LIMIT 25", "OnMemoryLoadEventLes", "dd", -1, 0);
			case 7: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventNeft` FROM `accounts` ORDER BY `EventNeft` DESC LIMIT 25", "OnMemoryLoadEventNeft", "dd", -1, 0);
			case 8: mysql_tquery(connects, "SELECT `pID`, `Name`, `EventFish` FROM `accounts` ORDER BY `EventFish` DESC LIMIT 25", "OnMemoryLoadEventFish", "dd", -1, 0);
			}
		}
	}
	else if(tmphour == 05 && tmpminute == 03 && (tmpsecond == 00 || tmpsecond == 01))
	{
		SendClientMessageToAll(COLOR_YELLOW, "Через две минуты произойдет автоматическая перезагрузка сервера");
		SendClientMessageToAll(COLOR_YELLOW, "Просьба закончить все свои работы. Спасибо за понимание");

		mysql_tquery(connects, "UPDATE `accounts` SET `EventTrucker` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventApple` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventGun` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventLes` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventNeft` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventFish` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventCapt` = '0'", "", "");
		mysql_tquery(connects, "UPDATE `accounts` SET `EventBizWar` = '0'", "", "");
	}
	#endif
	else if(tmphour == 05 && tmpminute == 04 && tmpsecond == 50) {
		SendClientMessageToAll(COLOR_REDD, ""FullServName" | Restart...");
		save_other();
		foreach(new player_vehicle_id: playerVehicles) {
			if(PlayerVehicleInfo[player_vehicle_id][carModel] == 0)
				continue;
			SavePlayerVehicle(player_vehicle_id);
		}
		foreach(new i: Player) {
			if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i))
				continue;
			SaveAccount(i);
			/*save_car(i, 0);  \\
			save_car(i, 1);*/
			Kick(i);
		}
		SendRconCommand("gmx");
		printf("Auto Restart - Reloading...");
		return 1;
	}
	second_timerlog = 0;
	return true;
}




public OnGameModeExit()
{
	SaveServer();

    #if defined _sampvoice_included
	if(gstream != SV_NULL) {
		SvDeleteStream(gstream);
		gstream = SV_NULL;
	}
	#endif
	#if defined _poker_included
		Iter_Clear(pokerTables);
	#endif
	#if defined _blackjack_included
		Iter_Clear(blackjackTables);
	#endif
	#if defined _angars_included
		angar_OnGameModeExit();
	#endif
	#if defined _organizations_included
		Iter_Clear(orgPlants);
	#endif
	#if defined _farmjob_included
		Iter_Clear(farmPlants);
	#endif
	#if defined _inventory_included
		Iter_Clear(DroppedItems);
	#endif
	#if defined _player_vehicles_included
	foreach (new i: playerVehicles)
		A_DestroyVehicle(PlayerVehicleInfo[i][carVehicle]);
	Iter_Clear(playerVehicles);
	#endif
	mysql_close(connects);
	#if defined _timerfix_included
		KillAllTimers();
	#endif

	if(GlobalSecondTimer != -1) {
		KillTimer(GlobalSecondTimer);
		printf("[KillTimer 18] GlobalSecondTimer = '%d' killed",
			GlobalSecondTimer
		);
	}
	GlobalSecondTimer = -1;
/*	Profiler_Dump();
	Profiler_Stop();*/

	print("Gamemode ended.");
	return true;
