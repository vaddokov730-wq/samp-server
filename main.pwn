		}
		case 8: {
			InventoryTempInfo[playerid][tClothesSlotBlocked] = 0;
			inventory_UpdateClothes(playerid);

			TI[playerid][tGym] = false;
			SendOk(playerid, "Вы закончили тренировку");

			if(UsePlayerSportBox[playerid] != 0)
			{
				for(new i = 0; i != 10; i ++)
				{
					if(SportData[Give][i] == playerid || SportData[Take][i] != playerid)
					{

						if(SportData[Give][i] != 0xFFFF) GiveMoney(SportData[Give][i], SportData[Bank][i] / 2, "Возрат ставки за поединок");
						SportData[Give][i] = 0xFFFF;
					}
					if(SportData[Give][i] != playerid || SportData[Take][i] == playerid)
					{
						if(SportData[Take][i] != 0xFFFF)  GiveMoney(SportData[Take][i], SportData[Bank][i] / 2, "Возрат ставки за поединок");
						SportData[Take][i] = 0xFFFF;
					}
				}
				UsePlayerSportBox[playerid] = 0;
			}
			return 0x1;
		}
		}
	}
