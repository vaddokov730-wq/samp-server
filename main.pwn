CB:OnServerRestarting()
{
	SendClientMessageToAll(COLOR_REDD, ""FullServName" | Restart...");

	foreach(new player_vehicle_id: playerVehicles) {
		if(PlayerVehicleInfo[player_vehicle_id][carModel] == 0)
			continue;
		SavePlayerVehicle(player_vehicle_id);
	}
	foreach(new i: Player)
	{
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		SaveAccount(i);//, save_car(i, 0), save_car(i, 1);
		SetPlayerInterior(i, 0);
		SetPlayerVirtualWorld(i, 0);
		InterpolateCameraPos(i, 1178.088012, 1204.779541, 105.671997, 2501.051269, 1285.838867, 118.900398, 5000);
		InterpolateCameraLookAt(i, 1175.603149, 1201.194458, 103.228073, 2496.586669, 1285.855346, 116.649597, 5000);
		Kick(i);
	}
	SendRconCommand("gmx");
	printf("Auto Restart - Reloading...");
	return true;
}
CB:promo_check(playerid, code[])
{
	new rows;
	cache_get_row_count(rows);
	if(!rows) return ErrorMessage(playerid, "Указанный промокод не найден");
	new code_money, code_skils, code_lics, used_count;
	cache_get_value_index_int(0, 1, code_money);
	cache_get_value_index_int(0, 2, code_skils);
	cache_get_value_index_int(0, 3, code_lics);
	cache_get_value_index_int(0, 5, used_count);
	SetPVarInt(playerid, "code_money_", code_money);
	SetPVarInt(playerid, "code_skills_", code_skils);
	SetPVarInt(playerid, "code_lics_", code_lics);
	SetPVarInt(playerid, "used_count_", used_count);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM "T_PROMOCODE_USED" WHERE idacca = %d", PI[playerid][pID]);
	mysql_tquery(connects, STRING_GLOBAL, "promo_check2", "ds", playerid, code);
	return 1;
}
CB:promo_check2(playerid, code[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		ErrorMessage(playerid, "Вы уже использовали промокод");
		DeletePVar(playerid, "code_money_");
		DeletePVar(playerid, "code_skills_");
		DeletePVar(playerid, "code_lics_");
		DeletePVar(playerid, "used_count_");
		return 1;
	}

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO "T_PROMOCODE_USED" (idacca,code) VALUE (%d,'%s')", PI[playerid][pID], code);
	mysql_tquery(connects, STRING_GLOBAL, "", "");

	new code_money, used_count, code_skills, code_lics;
	code_money = GetPVarInt(playerid, "code_money_");
	code_skills = GetPVarInt(playerid, "code_skills_");
	code_lics = GetPVarInt(playerid, "code_lics_");
	used_count = GetPVarInt(playerid, "used_count_");

	new string[128];
	format(string, sizeof(string), "Промокод "P"%s"W" активирован", code);
	SendClientMessage(playerid, COLOR_WHITE, string);
	if(PI[playerid][pLevel] < 4)
	{
		PI[playerid][pMPromo] = code_money;
		UpdatePlayerData(playerid, "pMPromo", code_money);

		if(code_skills != 6)
		{
			new str2[6][13] = {"SD-Pistol", "Deagle", "ShotGun", "MP5", "AK-47", "M4"};
			new stri[128];
			format(stri, sizeof(stri), "Вам было добавлено 100% навыка владения оружием - "W"%s", str2[code_skills]);
			SendOk(playerid, stri);
			PI[playerid][pGunSkill][code_skills] = 100;
			SaveAccount(playerid);
		}
		if(code_lics != 4)
		{
			new str3[4][20] = {"Вод.права", "Полёты", "Вод.транспорт", "Оружие"};
			new stri[128];
			format(stri, sizeof(stri), "Вам была выдана лицензия - "W"%s", str3[code_lics]);
			SendOk(playerid, stri);
			lic[playerid][code_lics] = 1;
			UpdateLicenses(playerid);
		}
		new str[128];
		format(str, sizeof(str), ""ORANGE"$%d"G" будет выдано при достижении 4 игрового уровня", code_money);
		SendOk(playerid, str);
	}
	else
	{
		if(code_skills != 6)
		{
			new str2[6][13] = {"SD-Pistol", "Deagle", "ShotGun", "MP5", "AK-47", "M4"};
			new stri[128];
			format(stri, sizeof(stri), "Вам было добавлено 100% навыка владения оружием - "W"%s", str2[code_skills]);
			SendOk(playerid, stri);
			if(PI[playerid][pGunSkill][code_skills] + 100 < 100) PI[playerid][pGunSkill][code_skills] += 100;
			SaveAccount(playerid);
		}
		if(code_lics != 4)
		{
			new str3[4][20] = {"Вод.права", "Полёты", "Вод.транспорт", "Оружие"};
			new stri[128];
			format(stri, sizeof(stri), "Вам была выдана лицензия - "W"%s", str3[code_lics]);
			SendOk(playerid, stri);
			lic[playerid][code_lics] = 1;
			UpdateLicenses(playerid);
		}
		GiveMoney(playerid, code_money, "промокод");
	}
	used_count ++;

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE "T_PROMOCODE" SET used_count = %d WHERE code = '%s'", used_count, code);
	mysql_tquery(connects, STRING_GLOBAL, "", "");

	DeletePVar(playerid, "code_money_");
	DeletePVar(playerid, "code_skills_");
	DeletePVar(playerid, "code_lics_");
	DeletePVar(playerid, "used_count_");
	return 1;
}

CB:promo_create(playerid, code[])
{
	new rows;
	cache_get_row_count(rows);
	if(rows >= 500) return ErrorMessage(playerid, "Достигнут лимит промокодов (150 шт.)");
	new load_code[32], free_slot = -1;
	for(new i; i < rows; i++)
	{
		cache_get_value_index(i, 0, load_code, 32);
		if(!strcmp(load_code, code, false))
		{
			free_slot = i;
			break;
		}
	}
	if(free_slot != -1)
	{
		ErrorMessage(playerid, "Указанный промокод уже есть в списке");
		DeletePVar(playerid, "promoname");
		DeletePVar(playerid, "promoskills");
		DeletePVar(playerid, "promolic");
		DeletePVar(playerid, "promomoney");
		return 0;
	}
	new promodays = GetPVarInt(playerid, "promoskills");
	new promoplayers = GetPVarInt(playerid, "promolic");
	new promomoney = GetPVarInt(playerid, "promomoney");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO "T_PROMOCODE" (code,money,skills,lics,data) VALUES ('%s',%d,%d,%d,%d)", code, promomoney, promodays, promoplayers, gettime() + promodays);
	mysql_tquery(connects, STRING_GLOBAL, "", "");

	new str2[7][13] = {"SD-Pistol", "Deagle", "ShotGun", "MP5", "AK-47", "M4", "Не выдавать"};
	new str3[5][20] = {"Вод.права", "Полёты", "Вод.транспорт", "Оружие", "Не выдавать"};

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
	"W"Промокод "P"%s"W" успешно создан!\n\
	Количество денег "GREEN"$%i"W"\n\
	Навыки владения оружием: "ORANGE"%s"W"\n\
	Лицензия: "ORANGE"%s",
		   code, promomoney, str2[promodays], str3[promoplayers]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, "Промокод создан", STRING_GLOBAL, "Закрыть", "");
	DeletePVar(playerid, "promoname");
	DeletePVar(playerid, "promolic");
	DeletePVar(playerid, "promoskills");
	DeletePVar(playerid, "promomoney");
	return 1;
}

CB:promo_show(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(!rows)
	{
		ErrorMessage(playerid, "Промокоды не найдены");
		return ShowPlayerDialog(playerid, D_PROMO, DSL, ""P"Промокоды", ""P"1."W" Список промокодов\n"P"2."W" Создать промокод\n"P"3."W" Удалить промокод", "Выбрать", "Назад");
	}
	new code[32], code_money, code_days, used_count;

	STRING_GLOBAL[0] = EOS;
	STRING_GLOBAL = ""W"Название\t\t"W"Сумма\t\t"W"Использован\n";
	for(new i; i < rows; i++)
	{
		cache_get_value_index(i, 0, code, 32);
		cache_get_value_index_int(i, 1, code_money);
		cache_get_value_index_int(i, 2, code_days);
		cache_get_value_index_int(i, 5, used_count);
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s\t\t%d$\t\t%d раз\n", STRING_GLOBAL, code, code_money, used_count);
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DST, "Список промокодов", STRING_GLOBAL, "Закрыть", "");
	return 1;
}

CB:promo_dell(playerid, code[])
{
	new rows;
	cache_get_row_count(rows);
	if(!rows) return ErrorMessage(playerid, "Указанный промокод не найден");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Промокод "ORANGE"%s""W"" успешно удалён", code);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", STRING_GLOBAL, "Закрыть", "");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM "T_PROMOCODE" WHERE code = '%s'", code);
	mysql_tquery(connects, STRING_GLOBAL, "", "");
	return 1;
}
stock SendAdvertMessage(color, const text[]) {
	foreach (new i: Player) {
		if(AntiCheatIsKickedWithDecync(i))
			continue;
		if(!PI[i][pPlayerSettings][PLAYER_SETTING_NEWS_CNN])
			continue;
		SendClientMessage(i, color, text);
	}
}
stock AdvertTimer()
{
	new string[144];
	if(gAdvertTime > 0) gAdvertTime--;
	for(new d; d < MAX_ADVERT_COUNT; d++)
	{
		if(gAdvert[d][adTime] > 0) gAdvert[d][adTime]--;
		if(gAdvert[d][adCheked] && gAdvert[d][adTime] == 0)
		{
			if(IsPlayerConnected(gAdvert[d][adID]) && strlen(gAdvert[d][adText]))
			{
				if(gAdvert[d][adVIP])
				{
					format(string, sizeof(string), "VIP | СМИ %s | %s. Объявление от: %s[%d] (тел. %d)", gAdvert[d][adNews], gAdvert[d][adText], gAdvert[d][adSender], gAdvert[d][adID], gAdvert[d][adPhone]);
					SendAdvertMessage(0x0a9508FF, string);
				}
				else
				{
					format(string, sizeof(string), "СМИ %s | %s. Объявление от: %s[%d] (тел. %d)", gAdvert[d][adNews], gAdvert[d][adText], gAdvert[d][adSender], gAdvert[d][adID], gAdvert[d][adPhone]);
					SendAdvertMessage(0x0a9508FF, string);
				}

				format(string, sizeof(string), "\t\t\t\tОбъявление допустил(а) в эфир: %s", gAdvert[d][adCheker]);
				SendAdvertMessage(0x116b1300, string);

				strdel(gAdvert[d][adSender], 0, 24);
				gAdvert[d][adPhone] = 0;
				strdel(gAdvert[d][adText], 0, 100);
				strdel(gAdvert[d][adCheker], 0, 24);
				gAdvert[d][adID] = -1;
				gAdvert[d][adBusy] = false;
				gAdvert[d][adCheked] = false;
				gAdvert[d][adCheking] = false;
				gAdvert[d][adTime] = 0;
				gAdvert[d][adVIP] = false;
			}
			else
			{
				strdel(gAdvert[d][adSender], 0, 24);
				gAdvert[d][adPhone] = 0;
				strdel(gAdvert[d][adText], 0, 100);
				strdel(gAdvert[d][adCheker], 0, 24);
				gAdvert[d][adBusy] = false;
				gAdvert[d][adID] = -1;
				gAdvert[d][adCheked] = false;
				gAdvert[d][adCheking] = false;
				gAdvert[d][adTime] = 0;
				gAdvert[d][adVIP] = false;
			}
		}
	}
	if(gAdvertCount > 0) gAdvertCount--;
	return 1;
}

alias:jetpack("jp");
CMD:jetpack(playerid)
{
	if(PI[playerid][pAdmin] < 1) return 1;

	if(IsPlayerInAnyVehicle(playerid))
		return ErrorMessage(playerid, "Вы находитесь в транспорте.");

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
	return 1;
}

CMD:saonline(playerid)
{
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	ShowPlayerDialog(playerid, D_ADMIN_TIME, DSI, ""P"Статистика администратора", "\n\n"W"Для просмотра статистики администратора\nукажите его ник:\n\n", "Ввод", "Отмена");
	return 1;
}

alias:alogin("povishka");
CMD:alogin(playerid, params[])
{
	if(dostup[playerid] == 1) return 0x1;
	if(GetPVarInt(playerid, "check_alogin") > gettime()) return true;
	//if(PI[playerid][pGoogleSec] == 0) return ErrorMessage(playerid, "Подключите Google Authenticator!");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `"TABLE_ADMIN"` WHERE `Name` = '%s'", player_name[playerid]);
	mysql_tquery(connects, STRING_GLOBAL, "alogin1", "i", playerid);
	SetPVarInt(playerid, "check_alogin", gettime() + 5);
	return 1;
}
CMD:djlogin(playerid, params[])
{
	if(GetPVarInt(playerid, "check_alogin") > gettime() || DJlvl[playerid]) return true;

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `lvl`,`nick` FROM `rjlist` WHERE `pid` = '%d'", PI[playerid][pID]);
	mysql_tquery(connects, STRING_GLOBAL, "rjenter", "i", playerid);
	SetPVarInt(playerid, "check_alogin", gettime() + 5);
	return 1;
}

CMD:ahelp(playerid)
{
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	ShowPlayerDialog(playerid, D_ADMC, DSL, ""P"Админ помощь", ""P"1."W" Уровень [1]\n"P"2."W" Уровень [2]\n"P"3."W" Уровень [3]\n"P"4."W" Уровень [4]\n"P"5."W" Уровень [5]\n"P"6."W" Уровень [6]", "Выбрать", "Отмена");
	return 1;
}

CMD:ambulance(playerid) {
	if(PI[playerid][pStageDeath] != 1)
		return ErrorMessage(playerid, "Вы должны находиться в легкой стадии ранений!");
	if(GetPVarInt(playerid, "call_wound") && gettime() - GetPVarInt(playerid, "call_wound") < 300)
		return ErrorMessage(playerid, "Вы уже вызывали врачей!");
	static const f_amb_call[] = "\
		{d26ea6}Диспетчер: {eba2cb}Поступил вызов от %s с лёгкими ранениями. Район: %s {CCCCCC}(( /accept %d ))";

	new str_amb_call[sizeof(f_amb_call) + (-2 + MAX_PLAYERS + 1) + (-2 + 25) + (-2 + 30) + (-2 + 5)];
	format(str_amb_call, sizeof(str_amb_call), f_amb_call, player_name[playerid], GetPlayerZone(playerid), playerid);
	foreach(new i : Player) {
		if(GetPVarInt(i, "call_patient_id") == playerid + 1)  {
			DeletePVar(i, "call_patient_id");
		}
		if(IsAMedic(i) && start_work[i]) {
			if(GetPVarInt(i, "disabling_calls")) continue;
			SendClientMessage(i, -1, str_amb_call);
		}
	}
	SendOk(playerid, "Диспетчер: Ваш вызов принят, ожидайте...");
	SetPVarInt(playerid, "call_wound", gettime() + 300);

	return true;
}

CMD:ambcalls(playerid)
{
	if(IsAMedic(playerid))
	{
		if(!GetPVarInt(playerid, "disabling_calls"))
		{
			SetPVarInt(playerid, "disabling_calls", 1);
			SendOk(playerid, "Вы успешно отключили приём вызовов от диспетчера о ранениях");
		}
		else
		{
			DeletePVar(playerid, "disabling_calls");
			SendOk(playerid, "Вы успешно включили приём вызовов от диспетчера о ранениях");
		}
	}
	else ErrorMessage(playerid, "Вы не можете использовать данную команду");
	return true;
}

CMD:accept(playerid, params[])
{
	if(IsAMedic(playerid) && start_work[playerid])
	{
		new
			patient_id;

		if(sscanf(params, "d", patient_id))
			return SendEsp(playerid, "/accept [id]");

		if(!IsPlayerConnected(patient_id) || patient_id == playerid)
			return ErrorMessage(playerid, "Вы указали неверный ID игрока");

		if(!GetPVarInt(patient_id, "call_wound"))
			return ErrorMessage(playerid, "Диспетчер: От данного жителя штата не поступал вызов о получении ранения");

		new bool:busy_call = false;
		foreach(new i : Player)
		{
			if(IsAMedic(i) && (GetPVarInt(i, "call_patient_id") == patient_id + 1))
			{
				busy_call = true;
				break;
			}
		}
		if(busy_call)
			return ErrorMessage(playerid, "Диспетчер: К пострадавшему уже выехала бригада медиков");

		new
			Float:patient_pos_x,
			Float:patient_pos_y,
			Float:patient_pos_z;

		GetPlayerPos(patient_id, patient_pos_x, patient_pos_y, patient_pos_z);
		new Float:distance_call = GetPlayerDistanceFromPoint(playerid, patient_pos_x, patient_pos_y, patient_pos_z);

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "\
			{d26ea6}Диспетчер: {eba2cb}Сотрудник мед. службы %s принял Ваш вызов. Расстояние: %s м.", 
			player_name[playerid], ConvertTime(floatround(distance_call))
		);
		SendClientMessage(patient_id, -1, COMMAND_GLOBAL);

		distance_call = 60.0;


		EnableGPSForPlayer(playerid, patient_pos_x, patient_pos_y, patient_pos_z);
		SendOk(patient_id, "Для быстрого нахождения Вас медиком, оставайтесь на данном месте");

		if(timer_amb_call[playerid] != -1 && IsValidTimer(timer_amb_call[playerid])) {
			KillTimer(timer_amb_call[playerid]);
			printf("[KillTimer 28] timer_amb_call[playerid] = '%d' killed",
				timer_amb_call[playerid]
			);
			timer_amb_call[playerid] = -1;
		}
		timer_amb_ticks[playerid] = floatround(distance_call);
		timer_amb_call[playerid] = SetTimerEx("amb_call", 1000, true, "i", playerid);

		SetPVarInt(playerid, "call_patient_id", patient_id + 1);

		create_amb_ptd(playerid);

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "ЊOCЏPAѓA‹Ћ…†: ~y~%s", player_name[patient_id]);
		PlayerTextDrawSetString(playerid, amb_ptd[playerid][10], COMMAND_GLOBAL);

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "ѓ…CЏAH‰…•: ~y~%.1f ~w~м", GetPlayerDistanceFromPoint(playerid, patient_pos_x, patient_pos_y, patient_pos_z));
		PlayerTextDrawSetString(playerid, amb_ptd[playerid][11], COMMAND_GLOBAL);

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "‹PEM•: ~g~~h~%s", ConvertTime(floatround(distance_call)));
		PlayerTextDrawSetString(playerid, amb_ptd[playerid][12], COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;

		for(new i; i < 13; i++) PlayerTextDrawShow(playerid, amb_ptd[playerid][i]);
	}
	else ErrorMessage(playerid, "Вы не можете использовать данную команду");
	return true;
}

CB:amb_call(playerid)
{
	timer_amb_ticks[playerid]--;
	new time_amb = timer_amb_ticks[playerid];

	if(time_amb > 0)
	{
		new
			patient_id = GetPVarInt(playerid, "call_patient_id") - 1,
			Float:patient_pos_x,
			Float:patient_pos_y,
			Float:patient_pos_z;

		GetPlayerPos(patient_id, patient_pos_x, patient_pos_y, patient_pos_z);

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "ѓ…CЏAH‰…•: ~y~%.1f ~w~м",
			GetPlayerDistanceFromPoint(playerid, patient_pos_x, patient_pos_y, patient_pos_z)
		);
		PlayerTextDrawSetString(playerid, amb_ptd[playerid][11], COMMAND_GLOBAL);

		format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "‹PEM•: ~g~~h~%s",
			ConvertTime(time_amb)
		);
		PlayerTextDrawSetString(playerid, amb_ptd[playerid][12], COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
	} else {
		if(timer_amb_call[playerid] != -1 && IsValidTimer(timer_amb_call[playerid])) {
			KillTimer(timer_amb_call[playerid]);
			printf("[KillTimer 29] timer_amb_call[playerid] = '%d' killed",
				timer_amb_call[playerid]
			);
			timer_amb_call[playerid] = -1;
		}
		destroy_amb_ptd(playerid);

		DeletePVar(playerid, "call_patient_id");
	}
	return true;
}


stock ConvertTime(number)
{
    new string[16];
    new hours = floatround(number/3600);
    new mins = floatround((number/60) - (hours * 60));
    new secs = floatround(number - ((hours * 3600) + (mins * 60)));
    if(hours > 0) format(string, sizeof(string), "%d:%02d:%02d", hours, mins, secs);
    else format(string, sizeof(string), "%d:%02d", mins, secs);
    return string;
}

stock GetPlayerZone(playerid)
{
    new Float:POS[3],zone[32],bool:getzone;
    GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
    for(new i = 0; i < sizeof(gZoneInfo); i++)
    {
        if(POS[0] >= gZoneInfo[i][SAZONE_AREA][0]
        && POS[0] <= gZoneInfo[i][SAZONE_AREA][3]
        && POS[1] >= gZoneInfo[i][SAZONE_AREA][1]
        && POS[1] <= gZoneInfo[i][SAZONE_AREA][4])
        {
            format(zone, sizeof(zone), gZoneInfo[i][SAZONE_NAME]);
            getzone = true;
            break;
        }
    }
    if(!getzone) zone = "Неизвестно";
    return zone;
}

