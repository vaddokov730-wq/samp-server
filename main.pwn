stock WriteLog(type, playerid, const Names[], const NamePlayer[], const reason[])
{
	//string_replace(reason, "'", ' ') ;
	new query[400];
	if(playerid == -1)
		mysql_format(connects, query, sizeof(query), "INSERT INTO `adminlog` (`type`,`Name`,`NamePlayer`,`reason`,`date`,`time`,`AdminIP`) VALUES ('%d','%e','%e','%e',NOW(),NOW(),'1')", type, Names, NamePlayer, reason);
	else
	{
		new ip[17];
		GetPlayerIp(playerid, ip, 16);
		mysql_format(connects, query, sizeof(query), "INSERT INTO `adminlog` (`type`,`Name`,`NamePlayer`,`reason`,`date`,`time`,`AdminIP`) VALUES ('%d','%e','%e','%e',NOW(),NOW(),'%e')", type, Names, NamePlayer, reason, ip);
	}
	mysql_tquery(connects, query, "", "");
	return true;
}
stock WriteLogIP(command, playerid, player_id)
{
	/*1 - /get
	2 - /Getip
	3 - Agetip
	4 - Offstats
	5 - Astats*/
	new query[400], ip[17];
	GetPlayerIp(playerid, ip, 16);
	mysql_format(connects, query, sizeof(query), "INSERT INTO `adminlogip` (`command`,`nickAdmin`,`nickPlayer`,`ip`,`date`,`time`) VALUES ('%d','%d','%d','%e',NOW(),NOW())", command, PI[playerid][pID], player_id, ip);
	mysql_tquery(connects, query, "", "");
	return true;
}
stock WriteLogDonate(playerid, product, value, spend, dbefore)
{
	/*
	 1 - конверт доната в рубли
	2 - смена ника
	3 - снять предупреждение
	4 - законка
	5 - лицензия
	6 - скилы
	7 - антиголод
	8 - Иммунитет
	_______________________________
	У VIP значение value это количество дней
	[1] - 7 дней
	[2] - 15 дней
	[3] - 30 дней
	[4] - 60 дней
	_______________________________
	9 - V.I.P. Беззаконник
	10 - V.I.P Начальный
	11 - V.I.P Бронзовый
	12 - V.I.P Серебряный
	13 - V.I.P Золотой
	14 - V.I.P Платиновый
	15 - V.I.P. Экстра (value тут равно только 1)
	16 - Покупка транспорта (в value записывается ид машины)
	17 - Поинты (в value это количество купленных поинтов)
	18 - Мобильный банк
	19 - Уникальный скин (в value это ид скина)
	20 - Звезды
	21 - БХ
	22 - Бокс
	23 - Убрать весь тюнинг с Т/С
	24 - Симка (в value пишется номер телефона)
	25 - Выход из ЧС (в value пишется название фракции)
	26 - Выход из ЧС всех фракции
	27 - Наркозависимость
	28 - Новая трудовая книжка
	*/
	new query[400], ip[17];
	GetPlayerIp(playerid, ip, 16);
	mysql_format(connects, query, sizeof(query), "\
		INSERT INTO `donate_log` (`name`,`d_before`,`spend`,`product`,`value`,`ip`,`date`,`time`) VALUES \
		('%d','%d','%d','%d','%d','%s',NOW(),NOW())",
		PI[playerid][pID], dbefore, spend, product, value, ip
	);
	mysql_tquery(connects, query, "", "");
	return true;
}
stock FracLog(type, const Names[], const NamePlayer[], const reason[])
{
	//string_replace(reason, "'", ' ') ;
	new query[400];
	mysql_format(connects, query, sizeof(query), "INSERT INTO `fraclog` (`type`,`Name`,`NameP`,`reason`,`date`) VALUES ('%d','%e','%e','%e',CURRENT_TIMESTAMP)", type, Names, NamePlayer, reason);
	mysql_tquery(connects, query, "", "");
	return true;
}
CB:ShowWarns(playerid, listitem)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		new indexid = 1, AdminName[MAX_PLAYER_NAME], TargetNAMEe[MAX_PLAYER_NAME], reason[128], dates[31], times[31];

		STRING_GLOBAL[0] = EOS;
		STRING_GLOBAL = ""W"Результаты по запросу:\n\n";
		for(new id = 0; id < rows; id++)
		{
			cache_get_value_name(id, "reason", reason, 128);
			cache_get_value_name(id, "Name", AdminName, MAX_PLAYER_NAME);
			cache_get_value_name(id, "NamePlayer", TargetNAMEe, MAX_PLAYER_NAME);
			cache_get_value_name(id, "date", dates, 30);
			cache_get_value_name(id, "time", times, 30);

			if(listitem == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s выдал бан чата %s. Причина: %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe, reason);
			if(listitem == 1) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s кикнул %s. Причина: %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe, reason);
			if(listitem == 2) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s выдал варн %s. Причина: %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe, reason);
			if(listitem == 3) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s забанил %s. Причина: %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe, reason);
			if(listitem == 4) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s посадил %s. Причина: %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe, reason);
			if(listitem == 5) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s сменил ник %s. Новый ник: %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe, reason);
			if(listitem == 6) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s разбанил %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe);
			if(listitem == 7) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s заблокировал IP %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe);
			if(listitem == 8) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s разблокировал IP %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe);
			if(listitem == 9) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s тихо кикнул %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe);
			if(listitem == 10) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d. [%s %s] %s тихо забанил %s\n", STRING_GLOBAL, indexid, dates, times, AdminName, TargetNAMEe);
			indexid++;
		}
		if(indexid == 1) return ErrorMessage(playerid, "По запросу ничего не найдено");
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Запрос", STRING_GLOBAL, "Закрыть", "");
	}
	else if(rows == 0) ErrorMessage(playerid, "По запросу ничего не найдено");
	return 1;
}
public OnPlayerClickMap(playerid, Float: fX, Float: fY, Float: fZ) {
	if(PI[playerid][pAdmin] > 0) {
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new tmpcar = GetPlayerVehicleID(playerid);
			SetVehiclePos(tmpcar, fX, fY, fZ + 2);
		}
		else SetPlayerPosAC(playerid, fX, fY, fZ + 3.0, 0, 0);

		SetPlayerPosFindZ(playerid, fX, fY, 999.0);
		FreezePlayerForTime(playerid, 2);
		return 1;
	}
	if(GetPVarInt(playerid, "selectpoint") > 0 && GetPVarInt(playerid, "selectpoint") < 3) {
		SetPVarInt(playerid, "selectpoint", 2);
		SetPVarFloat(playerid, "selectpointX", fX);
		SetPVarFloat(playerid, "selectpointY", fY);
		SetPlayerMapIcon(playerid, iconTaxi, fX, fY, fZ, 0, COLOR_YELLOW, 1);
		SendOk(playerid, "Вы установили "W"место назначения. "G"Чтобы подтвердить, нажмите "W"~k~~CONVERSATION_YES~");
	}
	return 1;
}
stock GetString(const param1[], const param2[], bool:ignoreRegistry = false)
{
	return !strcmp(param1, param2, ignoreRegistry);
}
stock CheckBanned(playerid, listitem)
{
	if(listitem == 20) FirstBL[playerid] += 20;
	else FirstBL[playerid] -= 20;
	if(FirstBL[playerid] < 0)
	{
		FirstBL[playerid] = 0;
		return ErrorMessage(playerid, "Больше нет забаненных");
	}
	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `Name` FROM `ban` ORDER BY `ID` DESC LIMIT %i , 20", FirstBL[playerid]);
	mysql_tquery(connects, STRING_GLOBAL, "MysqlCheckBanned", "d", playerid);
	return 1;
}
CB:MysqlCheckBanned(playerid)
{
	new rows;
	cache_get_row_count(rows);
	new names[25];
	STRING_GLOBAL[0] = EOS;
	if(rows == 0) return ErrorMessage(playerid, "Больше нет забаненных");
	for(new i; i < rows; i ++)
	{
		cache_get_value_name(i, "Name", names, MAX_PLAYER_NAME);
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s\n", STRING_GLOBAL, names);
	}
	if(rows == 20) strcat(STRING_GLOBAL, ""ORANGE"Далее >>>\n");
	if(FirstBL[playerid]) strcat(STRING_GLOBAL, ""ORANGE"<<< Назад");
	if(!ShowPlayerDialog(playerid, D_BAN_LIST, DSL, ""P"Забаненые", STRING_GLOBAL, "Выбрать", "Назад")) ErrorMessage(playerid, "Недоступно в данный момент.");
	return 1;
}
stock IsBLNameMember(const name[], member)
{

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `Name`,`pMember` FROM `accounts` WHERE `Name` = '%s' AND `pMember` = '%d' LIMIT 1", name, member);
	new Cache: result = mysql_query(connects, STRING_GLOBAL);
	new rows = cache_num_rows();
	if(cache_is_valid(result)) cache_delete(result);
	return rows;
}
stock IsBLName(const name[], member)
{

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `f_bl_accused`,`f_bl_id` FROM `fraction_bl` WHERE `f_bl_accused` = '%s' AND `f_bl_id` = '%d' LIMIT 1", name, member);
	new Cache: result = mysql_query(connects, STRING_GLOBAL);
	new rows = cache_num_rows();
	if(cache_is_valid(result)) cache_delete(result);
	return rows;
}
stock IsBannedNameReg(const name[])
{
	new strings[70 + MAX_PLAYER_NAME];
	mysql_format(connects, strings, sizeof(strings), "SELECT `Name` FROM `accounts` WHERE `Name` = '%e' LIMIT 1", name);
	new Cache: result = mysql_query(connects, strings);
	new rows = cache_num_rows();
	if(cache_is_valid(result)) cache_delete(result);
	return rows;
}
stock IsBannedName(const name[])
{
	new strings[65 + MAX_PLAYER_NAME];
	mysql_format(connects, strings, sizeof(strings), "SELECT `Name` FROM `ban` WHERE `Name` = '%e' LIMIT 1", name);
	new Cache: result = mysql_query(connects, strings);
	new rows = cache_num_rows();
	if(cache_is_valid(result)) cache_delete(result);
	return rows;
}
stock UnBanName(const name[])
{
	new strings[50 + MAX_PLAYER_NAME];
	if(IsBannedName(name))
	{
		mysql_format(connects, strings, sizeof(strings), "DELETE FROM `ban` WHERE `Name` = '%e'", name);
		mysql_tquery(connects, strings, "", "");
	}
	return true;
}
stock BanName(const name[], const namez[], days, const reason[])
{
	if(!IsBannedName(name))
	{
		new query[256];
		new bandate = gettime() + days;
		mysql_format(connects, query, sizeof(query), "INSERT INTO `ban` (`Name`, `Admin`, `Seconds`, `Reason`) VALUE ('%e', '%e', '%d', '%e')", name, namez, bandate, reason);
		mysql_tquery(connects, query, "", "");
	}
	return true;
}
stock CheckSim(const pass[])
{
	for(new i; i < strlen(pass); i ++)
	{
		if( (pass[i] >= 'a' && pass[i] <= 'f') ||
				(pass[i] >= 'A' && pass[i] <= 'F')) continue;
		else return false;
	}
	return true;
}
stock CheckPassword(const pass[])
{
	for(new i; i < strlen(pass); i ++)
	{
		if( (pass[i] >= 'a' && pass[i] <= 'z') ||
				(pass[i] >= 'A' && pass[i] <= 'Z') ||
				(pass[i] >= '?' && pass[i] <= '?') ||
				(pass[i] >= '?' && pass[i] <= '?') ||
				(pass[i] >= '0' && pass[i] <= '9')  ) continue;
		else return false;
	}
	return true;
}
stock CheckSkin(skin)
{
	new fix_skin[176] =
	{
		252, 99, 281, 280, 284, 282, 285, 303, 288, 283, 306, 203,
		309, 286, 163, 164, 165, 166, 141, 255, 57, 71, 187, 147, 150,
		287, 179, 311, 61, 255, 191, 276, 275, 274, 70, 219, 308, 188,
		170, 217, 261, 211, 59, 185, 240, 148, 124, 223, 127, 113, 214,
		117, 118, 123, 186, 120, 169, 121, 112, 111, 126, 125, 272, 216, 103,
		102, 104, 195, 108, 109, 110, 56, 105, 106, 107, 269, 271, 270,
		65, 48, 114, 116, 115, 41, 175, 174, 173, 273, 226, 255, 57,
		163, 228, 305, 304, 17, 76, 95, 50, 15, 35, 25, 36, 96, 155, 143,
		44, 24, 37, 2, 3, 6, 7, 14, 47, 67, 142, 23, 72, 22, 68, 220, 18, 45,
		97, 21, 60, 182, 262, 250, 183, 184, 30, 19, 20, 4, 5, 259, 17,
		180, 208, 185, 289, 28, 29, 119, 290, 291, 292, 293, 82, 83, 84, 101,
		241, 242, 295, 297, 296, 249, 299, 294, 55, 90, 13, 192, 193, 224, 12, 190, 40, 298, 93, 233,
		264 // клоун
	};
	for(new i = 0; i != 176; i++)
	{
		if(fix_skin[i] == skin) return 0x1;
	}
	return 0x0;
}
stock is_text_invalid(const text[])
{
	if(strfind(text, "'", true ) != -1) return 1;
	if(strfind(text, "=", true ) != -1) return 1;
	if(strfind(text, "%", true ) != -1) return 1;
	if(strfind(text, "&", true ) != -1) return 1;
	if(strfind(text, "*", true ) != -1) return 1;
	if(strfind(text, "( ", true ) != -1) return 1;
	if(strfind(text, ")", true ) != -1) return 1;
	if(strfind(text, ",", true ) != -1) return 1;
	if(strfind(text, "`", true ) != -1) return 1;
	if(strfind(text, ";", true ) != -1) return 1;
	if(strfind(text, "|", true ) != -1) return 1;
	return 0 ;
}

stock CheckHouses(playerid, listitem)
{
	STRING_GLOBAL[0] = EOS;
	if(listitem == 30)
	{
		drieltorka[playerid] = PlayerRealtorFix[playerid][29];
		if(drieltorka[playerid] < 0)
		{
			drieltorka[playerid] = 0;
			return ErrorMessage(playerid, "Больше домов не найдено");
		}
		new houseidd = 0, classname[20];
		for(new i = drieltorka[playerid]; i < gHouseCount; i ++)
		{
			if(gHouses[i][houseOwnerID] != 0) continue;
			switch(gHouses[i][houseClass])
			{
			case 0: classname = "Эконом";
			case 1: classname = "Cредний";
			case 2: classname = "Элитный";
			case 3: classname = "Особняк";
			case 10: classname = "Семейный";
			default: classname = "Неизвестно";
			}
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sДом "ORANGE"№%d "W"[%s]"W"\n", STRING_GLOBAL, i + 1, classname);
			PlayerRealtorFix[playerid][houseidd] = i;
			houseidd++;

			if(!houseidd) return ErrorMessage(playerid, "Свободных домов нет");
			if(houseidd == 30)
			{
				strcat(STRING_GLOBAL, ""ORANGE"Далее >>>\n");
				break;
			}
		}
	}
	else
	{
		drieltorka[playerid] = PlayerRealtorFix[playerid][0];
		if(drieltorka[playerid] < 0)
		{
			drieltorka[playerid] = 0;
			return ErrorMessage(playerid, "Больше домов не найдено");
		}
		new houseidd = 0, classname[20];
		for(new i = drieltorka[playerid]; i != -1; i --)
		{
			if(gHouses[i][houseOwnerID] != 0) continue;
			switch(gHouses[i][houseClass])
			{
			case 0: classname = "Эконом";
			case 1: classname = "Cредний";
			case 2: classname = "Элитный";
			case 3: classname = "Особняк";
			case 10: classname = "Семейный";
			default: classname = "Неизвестно";
			}
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sДом "ORANGE"№%d "W"[%s]"W"\n", STRING_GLOBAL, i + 1, classname);
			PlayerRealtorFix[playerid][houseidd] = i;
			houseidd++;

			if(!houseidd) return ErrorMessage(playerid, "Свободных домов нет");
			if(houseidd == 30)
			{
				strcat(STRING_GLOBAL, ""ORANGE"Далее >>>\n");
				break;
			}
		}
	}
	if(drieltorka[playerid]) strcat(STRING_GLOBAL, ""ORANGE"<<< Назад\n");
	if(!ShowPlayerDialog(playerid, D_RIELTOR_HOUSE, DSL, ""P"Выберите дом", STRING_GLOBAL, "Выбрать", "Назад")) ErrorMessage(playerid, "Недоступно в данный момент");
	return 1;
}
stock CheckBusiness(playerid, listitem)
{
	STRING_GLOBAL[0] = EOS;
	if(listitem == 20)
	{
		drieltorka[playerid] = PlayerRealtorFix[playerid][19];
		new bizzid = 0;
		for(new i = drieltorka[playerid]; i < gBusinessCount; i ++)
		{
			if(gBusiness[i][bizzOwnerID] != 0) continue;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sБизнес "ORANGE"№%d "W"[%s] [%s]\n", STRING_GLOBAL, i + 1, gBusiness[i][bizzName], gBusinessTypeName[gBusiness[i][bizzType] - 1]);
			PlayerRealtorFix[playerid][bizzid] = i;
			bizzid++;
			if(!bizzid) return ErrorMessage(playerid, "Свободных бизнесов нет");
			if(bizzid == 20)
			{
				strcat(STRING_GLOBAL, ""ORANGE"Далее >>>\n");
				break;
			}
		}
	}
	else
	{
		drieltorka[playerid] = PlayerRealtorFix[playerid][0];
		new bizzid = 0;
		for(new i = drieltorka[playerid]; i != -1; i --)
		{
			if(gBusiness[i][bizzOwnerID] != 0) continue;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sБизнес "ORANGE"№%d "W"[%s] [%s]\n", STRING_GLOBAL, i + 1, gBusiness[i][bizzName], gBusinessTypeName[gBusiness[i][bizzType] - 1]);
			PlayerRealtorFix[playerid][bizzid] = i;
			bizzid++;
			if(!bizzid) return ErrorMessage(playerid, "Свободных бизнесов нет");
			if(bizzid == 20)
			{
				strcat(STRING_GLOBAL, ""ORANGE"Далее >>>\n");
				break;
			}
		}
	}
	if(drieltorka[playerid] < 0)
	{
		drieltorka[playerid] = 0;
		return ErrorMessage(playerid, "Больше бизнесов не найдено");
	}
	if(drieltorka[playerid]) strcat(STRING_GLOBAL, ""ORANGE"<<< Назад\n");
	if(!ShowPlayerDialog(playerid, D_RIELTOR_BIZZ, DSL, ""P"Выберите бизнес", STRING_GLOBAL, "Выбрать", "Назад")) ErrorMessage(playerid, "Недоступно в данный момент");
	return 1;
}
CB:CopsWanted(playerid, player_id)
{
	if(!IsPlayerConnected(player_id))
	{
		patrul_id[playerid] = -1;
		if(time_wanted[playerid] != -1) {
			KillTimer(time_wanted[playerid]);
			printf("[KillTimer 24] time_wanted[playerid] = '%d' killed",
				time_wanted[playerid]
			);
			time_wanted[playerid] = -1;
		}
		DisablePlayerCheckpoint(playerid);
		SendOk(playerid, "Преследование завершено! Игрок покинул сервер");
		PlayerPatrulFix[playerid] = 0;
		return true;
	}
	if(GetPlayerInterior(player_id))
	{
		patrul_id[playerid] = -1;
		if(time_wanted[playerid] != -1) {
			KillTimer(time_wanted[playerid]);
			printf("[KillTimer 25] time_wanted[playerid] = '%d' killed",
				time_wanted[playerid]
			);
			time_wanted[playerid] = -1;
		}
		DisablePlayerCheckpoint(playerid);
		SendOk(playerid, "Преследование завершено! Человек скрылся! [Вход в интерьер]");
		return true;
	}
	new Float: Position[3];
	GetPlayerPos(player_id, Position[0], Position[1], Position[2]);
	SetPlayerCheckpoint(playerid, Position[0], Position[1], Position[2], 3);
	TimerCallFix[1] ++;
	return false;
}
stock ErrorMessage(playerid, const text[])
{
	format(STRING_GLOBAL, 256, ""NO"*"G" %s", text);
	SendClientMessage(playerid, COLOR_GREY, STRING_GLOBAL);
	return STRING_GLOBAL[0] = EOS;
}
stock SendEsp(playerid, const text[])
{
	format(STRING_GLOBAL, 256, "Используйте: %s", text);
	SendClientMessage(playerid, COLOR_GREY, STRING_GLOBAL);
	return STRING_GLOBAL[0] = EOS;
}
stock SendOk(playerid, const text[])
{
	format(STRING_GLOBAL, 256, ""GREEN"*"G" %s", text);
	SendClientMessage(playerid, COLOR_GREY, STRING_GLOBAL);
	return STRING_GLOBAL[0] = EOS;
}
stock SendUse(playerid, const text[])
{
	format(STRING_GLOBAL, 256, ""GREEN"*"G" %s", text);
	SendClientMessage(playerid, COLOR_GREY, STRING_GLOBAL);
	return STRING_GLOBAL[0] = EOS;
}
stock GetCheckID(const name[])
{
	new ID = INVALID_PLAYER_ID;
	sscanf(name, "u", ID);
	if(IsPlayerConnected(ID)) return ID;
	return INVALID_PLAYER_ID;
}
