				"P"1. "W"Что это за место?\n\
				"P"2. "W"Информация о болезнях\n\
				"P"3. "W"Сотрудники на смене\n\
				"P"4. "W"Получение медицинской карты\n\
				"P"5. "W"Купить аптечки",
				"Выбрать", "Отмена"
			);
			return true;
		}
		new amount = strval(inputtext), price = amount * 150;
		if(!(1 <= amount <= 10)) {
			ShowPlayerDialog(playerid, D_HOSPITAL_MENU_MEDKIT, DIALOG_STYLE_INPUT, ""P"Покупка аптечек", "\
				"W"Введите количество аптечек, которое хотите купить (максимум 10 шт.):\n \n\
				"W"Стоимость одной аптечки: "GREEN"$150",
				"Купить", "Назад"
			);
			return true;
		}
		if(ItemCounts(playerid, 3) + amount > 10)
			return ErrorMessage(playerid, "У вас уже есть 10 шт.");
		if(GetPlayerMoneyEx(playerid) < price)
			return ErrorMessage(playerid, "У Вас недостаточно средств.");
		if(!GivePlayerItem(playerid, 3, amount))
			return true;
		GiveMoney(playerid, -price, "покупка аптечки");
		format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы успешно купили %i аптечек за $%i.",
			amount, price
		);
		SendOk(playerid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
		SendOk(playerid, "Чтобы использовать аптечку, введите: "P"/healto [ID игрока]");
		// BUY MEDKIT

		return true;
	}
