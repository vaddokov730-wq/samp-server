				}
				if(dice < dice1)
				{
					GiveChips(playerid, money, "выиграл в dice");
					GiveChips(id, -money, "проиграл в dice");
					format(string, sizeof(string), "Поздравляем, Вы выиграли! Выигрыш составляет: {d8284c}%d", money);
