	case D_MAKELEADER_CLEAR: {
		if(!response) return 1;
		new ID = GetCheckID(FI[PlayerFracFix[playerid]][fLeader]);
		if(ID != INVALID_PLAYER_ID)
		{
			add_jobinfo(ID, "Снят с поста лидера");
			PI[ID][pLeader] = 0;
			PI[ID][pMember] = 0;
			PI[ID][pRank] = 0;
			start_work[ID] = 0;
			inventory_ClearFractionClothes(ID);
			inventory_ClearFractionWeapons(ID);
			static const f_str[] = ""W"%s "G"забрал у Вас полномочия лидера организации";
			new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME)];

			format(string, sizeof(string), f_str, player_name[playerid]);
			SendOk(ID, string);

			format(string, sizeof(string), "[A] %s[%d] снял %s[%d] с поста лидера %s", player_name[playerid], playerid, player_name[ID], ID, FI[PlayerFracFix[playerid]][fName]);
			AdmMSG(0xAFAFAFAA, string, 1);

			if(PI[playerid][pHouse] > 0) PI[ID][pSpawn] = 1;
			else PI[ID][pSpawn] = 0;
			inventory_UpdateClothes(ID);
			SaveAccount(ID);
			PlayerSpawn(ID);
		}
		else
		{
			new string[128];
			format(string, sizeof(string), "[A] %s[%d] снял %s с поста лидера %s", player_name[playerid], playerid, FI[PlayerFracFix[playerid]][fLeader], FI[PlayerFracFix[playerid]][fName]);
			AdmMSG(0xAFAFAFAA, string, 1);
			off_add_jobinfo(FI[PlayerFracFix[playerid]][fName], "Недееспособен");
			SendOk(playerid, "Лидер организации успешно снят в оффлайн");

			STRING_GLOBAL[0] = EOS;
			mysql_format(connects, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `"TABLE_ACCOUNTS"` SET pLeader = '0',pMember = '0',pRank = '0',pModel = '0' WHERE Name = '%s'", FI[PlayerFracFix[playerid]][fLeader]);
			mysql_tquery(connects, STRING_GLOBAL, "", ""), MYSQL_GLOBAL[0] = EOS;
		}
		format(FI[PlayerFracFix[playerid]][fLeader], 5, "None");
		SaveFraction(PlayerFracFix[playerid]);
	}
