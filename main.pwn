		format(string, sizeof(string), "Вы добавили кандитата: "W"%s", inputtext);
		SendOk(playerid, string);

		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "INSERT INTO `vote`(`vote_name`, `vote_count`) VALUES ('%s','%i')", vote_name[slot], vote_count[slot]);
		mysql_pquery(connects, MYSQL_GLOBAL, "", "");
		DeletePVar(playerid, "vote_slot");
		return 1;
	}
