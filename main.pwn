	case D_PARKING_FINE: {
		if(!response)
			return true;
		new player_vehicle_id = playerVehicleListitemID[playerid][listitem];
		new vehicleid = PlayerVehicleInfo[player_vehicle_id][carVehicle];

		if(GetPlayerMoneyEx(playerid) < 1000)
			return ErrorMessage(playerid, "У вас недостаточно средств");
		GiveMoney(playerid, -1000, "оплата штрафстоянки");
		VehicleInfo[vehicleid][vParkingFine] = 0;
		SavePlayerVehicle(player_vehicle_id);
		SendOk(playerid, "Вы успешно оплатили штраф, перепаркуйте свой транспорт в другом месте. (/park)");

		return true;
	}
	case D_THEFT:   //угон
	{
		if(!response) return true;
		theftveh[playerid][0] = INVALID_VEHICLE_ID;
		theftveh[playerid][2] = 0;
		if(PI[playerid][ptheftSkill] < 25)
		{
			if(!ItemContains(playerid, 5)) return ErrorMessage(playerid, "У Вас нет отмычки");
		}
		FindNearestHouseCar(playerid);
	}
	case D_THEFT_LIST:   //угон
	{
		if(!response) return true;
		switch(listitem)
		{
		case 0: {
			if(thefttime[playerid] > 0) return ErrorMessage(playerid, "Вы уже начали задание, для отмены введите команду /theftcancel");
			ShowPlayerDialog(playerid, D_THEFT, DSM, ""P"Угон транспорта", ""W"Здарова, я Jackson Young, наш общий знакомый сказал,\nчто ты не против заработать на нелегальной работенке.\nСуть моего задания в том, что я передаю на GPS координаты тачки, которая мне нужна.\nПеред тем, как берешься за работу, нужно купить в магазине отмычки.\nНичего сложного нет, крадешь тачку и получаешь - легкие деньги.\nБудешь браться за дело?", "Да", "Нет");
		}
		case 1: {
			if(thefttime[playerid] == 0) return ErrorMessage(playerid, "Нужно сначала взять задание!");
			new car;
			theftveh[playerid][1] = 120;
			PlayerTextDrawShow(playerid, theft_PTD[playerid][1]);
			switch(PI[playerid][ptheftSkill])
			{
			case 1: car = 462;
			case 2: car = 481;
			case 3..25: car = 461;
			}

			switch(random(5))
			{
			case 0: theftveh[playerid][0] = A_CreateVehicle(car, 2516.0000, -1456.4834, 23.5250, 181.6838, random(50), random(50), -1, VEHICLE_TYPE_ADMIN);
			case 1: theftveh[playerid][0] = A_CreateVehicle(car, 2514.4329, -1456.4664, 23.5371, 179.9724, random(50), random(50), -1, VEHICLE_TYPE_ADMIN);
			case 2: theftveh[playerid][0] = A_CreateVehicle(car, 2512.7175, -1456.5023, 23.5253, 180.0509, random(50), random(50), -1, VEHICLE_TYPE_ADMIN);
			case 3: theftveh[playerid][0] = A_CreateVehicle(car, 2511.2451, -1456.7246, 23.5299, 182.7245, random(50), random(50), -1, VEHICLE_TYPE_ADMIN);
			case 4: theftveh[playerid][0] = A_CreateVehicle(car, 2509.6570, -1456.8005, 23.5466, 181.3288, random(50), random(50), -1, VEHICLE_TYPE_ADMIN);
			}
			if(car == 461) VehicleInfo[theftveh[playerid][0]][vFuel] = 50.0;

		}
		}
	}
	#if defined _roulette_included
	case D_ROULETTE_2: {
		if(!response)
			return false;
		STRING_GLOBAL[0] = EOS;

		mysql_format(connects, STRING_GLOBAL, 128, "SELECT * FROM "TABLE_ROULETTE" WHERE `player_name` = '%s' AND `id`=%d LIMIT 1",
			GetName(playerid), RouletteInfo[playerid][roulettePrizeID][listitem]);
		mysql_tquery(connects, STRING_GLOBAL, "roulette_TakePrize","d", playerid), STRING_GLOBAL[0] = EOS;
		return true;
	}
	case D_ROULETTE_3: {
		if(!response)
			return false;
		ShowPlayerDialog(playerid, D_ROULETTE_4, DIALOG_STYLE_LIST, ""P"Доступные действия",
			!""P"1. "W"Использовать приз\n\
			"P"2. "W"Продать приз "G"[50%]", //
			!"Выбрать", "Отмена"
		);
		return true;
	}
	case D_ROULETTE_4: {
		if(!response)
			return false;
		switch(listitem + 1) {
			case 1: {
				roulette_UsePrize(playerid,
					RouletteInfo[playerid][rouletteTempID], RouletteInfo[playerid][rouletteTempArrayID],
					RouletteInfo[playerid][rouletteTempModelID], RouletteInfo[playerid][rouletteTempTypeID]
				);
			}
			case 2: {
				ErrorMessage(playerid, "Продажа призов закрыта");
			}
		}
		return true;
	}
	#endif
	#if defined _factoryjob_included
	case D_FACTORYJOB_CELL: {
		if(!response)
			return true;
		new cell_id = FactoryJob_PI[playerid][factoryCellID];
		switch(listitem + 1) {
			case 1: {
				if(FactoryCellInfo[cell_id][cellStatus] != FACTORY_CELL_STATUS_NONE)
					return ErrorMessage(playerid, "Процесс запуска отсека горячей обработки уже запущен!");
				if(FactoryCellInfo[cell_id + 2][cellStatus] != FACTORY_CELL_STATUS_NONE)
					return ErrorMessage(playerid, "Процесс запуска отсека горячей обработки еще не завершился!");
				if(FactoryCellInfo[cell_id][cellAmount] < 10)
					return ErrorMessage(playerid, "В отсеке фильтрации недостаточно молока!");
				FactoryCellInfo[cell_id][cellAmount] = 0;
				FactoryCellInfo[cell_id][cellProcess] = 0;
				FactoryCellInfo[cell_id][cellStatus] = FACTORY_CELL_STATUS_PROCCESING;

				MeAction(playerid, "запустил отсек фильтрации");
			}
			case 2: {
				if(FactoryCellInfo[cell_id + 2][cellStatus] != FACTORY_CELL_STATUS_NONE)
					return ErrorMessage(playerid, "Процесс запуска отсека горячей обработки уже запущен!");
				if(FactoryCellInfo[cell_id + 4][cellStatus] != FACTORY_CELL_STATUS_NONE)
					return ErrorMessage(playerid, "Процесс запуска отсека холодной обработки еще не завершился!");

				new next_cell_id = cell_id + 2;

				switch(next_cell_id) {
					case 2: {
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][0] = CreateDynamicObject(18693,
							1370.582519, 1580.803833, 2997.840087, 0.000000, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [1] fire effect
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][1] = CreateDynamicObject(18735,
							1370.716918, 1582.439941, 2999.985595, 89.899986, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [1]HOT_EFFECT
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][2] = CreateDynamicObject(18741,
							1370.749755, 1580.800292, 2999.160156, 0.000000, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [1]HOT_EFFECT_2
					}
					case 3: {
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][0] = CreateDynamicObject(18693,
							1370.582519, 1592.305908, 2997.840087, 0.000000, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [2] fire effect
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][1] = CreateDynamicObject(18735,
							1370.716918, 1593.860839, 2999.985595, 89.899986, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [2]HOT_EFFECT
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][2] = CreateDynamicObject(18741,
							1370.749755, 1592.240722, 2999.160156, 0.000000, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [2]HOT_EFFECT_2
					}
				}
				FactoryCellInfo[next_cell_id][cellStatus] = FACTORY_CELL_STATUS_LOADING;
				FactoryCellInfo[next_cell_id][cellProcess] = 0;
				factory_UpdateCellText(next_cell_id);
				Streamer_Update(playerid);
				MeAction(playerid, "запустил отсек горячей обработки");
			}
			case 3: {
				if(FactoryCellInfo[cell_id + 4][cellStatus] != FACTORY_CELL_STATUS_NONE)
					return ErrorMessage(playerid, "Процесс запуска отсека холодной обработки уже запущен!");
				if(FactoryCellInfo[cell_id + 4][cellStatus] < 10)
					return ErrorMessage(playerid, "Процесс запуска отсека холодной обработки уже запущен!");

				new next_cell_id = cell_id + 4;

				switch(next_cell_id) {
					case 4: {
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][0] = CreateDynamicObject(18735,
							1370.716918, 1582.439941 + 3.5, 2999.985595 - 0.3, 89.899986, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [1]FREEZE_EFFECT
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][1] = CreateDynamicObject(18741,
							1370.749755, 1584.320312, 2999.160156, 0.000000, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [1]FREEZE_EFFECT_2
					}
					case 5: {
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][0] = CreateDynamicObject(18735,
							1370.716918, 1593.860839 - 3.82, 2999.985595 - 0.3, 89.899986, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [2]FREEZE_EFFECT
						FactoryCellInfo[next_cell_id][cellEffectsObjectID][1] = CreateDynamicObject(18741,
							1370.749755, 1588.840209, 2999.160156, 0.000000, 0.000000, 0.000000, 5, 4, -1, 60.00, 60.00
						); // [1]FREEZE_EFFECT_2
					}
				}
				FactoryCellInfo[next_cell_id][cellStatus] = FACTORY_CELL_STATUS_LOADING;
				FactoryCellInfo[next_cell_id][cellProcess] = 0;
				factory_UpdateCellText(next_cell_id);
				Streamer_Update(playerid);

				MeAction(playerid, "запустил отсек холодной обработки");
			}
			case 4: {
				new next_cell_id = cell_id + 4;

				if(FactoryCellInfo[cell_id + 4][cellStatus] != FACTORY_CELL_STATUS_FREEZED)
					return ErrorMessage(playerid, "Молоко еще не прошло через отсек холодной обработки!");
				FactoryCellInfo[next_cell_id][cellStatus] = FACTORY_CELL_STATUS_PROCCESING;
				FactoryCellInfo[next_cell_id][cellProcess] = 0;

				factory_UpdateCellText(next_cell_id);
				Streamer_Update(playerid);

				MeAction(playerid, "запустил процесс переливания");
			}
		}
		return true;
	}
	case D_FACTORYJOB_JOIN: {
		if(!response)
			return true;
		switch(listitem + 2) {
			case 1: {
				ErrorMessage(playerid, "В данное время работы нет!");
				/*ShowPlayerDialog(playerid, D_FACTORYJOB_1, DIALOG_STYLE_MSGBOX, ""P"Работник цеха",
					!""W"Вы действительно хотите устроиться на "P"работник цеха"W"?",
					!"Да", "Назад"
				);*/
			}
			case 2: {
				ShowPlayerDialog(playerid, D_FACTORYJOB_2, DIALOG_STYLE_MSGBOX, ""P"Работа экспедитора",
					!""W"Вы действительно хотите устроиться на "P"работу экспедитора"W"?",
					!"Да", "Назад"
				);
			}
		}
		return true;
	}
	case D_FACTORYJOB_1: {
		if(!response) {
			ShowPlayerDialog(playerid, D_FACTORYJOB_JOIN, DIALOG_STYLE_LIST, ""P"Устройство на работу",
				!""P"1. "W"Экспедитор",
				!"Выбрать", "Отмена"
			);
			return true;
		}
		if(start_work[playerid])
			return ErrorMessage(playerid, "Необходимо закончить текущую работу / рабочий день в организации");
		if(GetPVarInt(playerid, "factoryJob"))
			return false;
		FarmJob_PI[playerid][farmJobCollected] = 0;

		SetPVarInt(playerid, "factoryJob", 1);
		ShowJobInfoTD(playerid, INFOBAR_ID_FACTORY_JOB_1);

		switch(PI[playerid][pSex]) {
			case 1: A_SetPlayerSkin(playerid, 1);
			case 2: A_SetPlayerSkin(playerid, 201);
		}
		InventoryTempInfo[playerid][tClothesSlotBlocked] = 1;
		SendOk(playerid, "Рабочий день начат. Отправляйтесь на склад и начинайте работу.");
		start_work[playerid] = 1;

		return true;
	}
	case D_FACTORYJOB_2: {
		if(!response) {
			ShowPlayerDialog(playerid, D_FACTORYJOB_JOIN, DIALOG_STYLE_LIST, ""P"Устройство на работу",
				!""P"1. "W"Экспедитор",
				!"Выбрать", "Отмена"
			);
			return true;
		}
		if(start_work[playerid])
			return ErrorMessage(playerid, "Необходимо закончить текущую работу / рабочий день в организации");
		if(GetPVarInt(playerid, "factoryJob"))
			return false;
		FactoryJob_PI[playerid][factoryJobCollected] = 0;
		FactoryJob_PI[playerid][factoryTruckProcess] = 0;

		SetPVarInt(playerid, "factoryJob", 2);
		ShowJobInfoTD(playerid, INFOBAR_ID_FACTORY_JOB_2);

		switch(PI[playerid][pSex]) {
			case 1: A_SetPlayerSkin(playerid, 72);
			case 2: A_SetPlayerSkin(playerid, 53);
		}
		InventoryTempInfo[playerid][tClothesSlotBlocked] = 1;

		SendOk(playerid, "Рабочий день начат. Арендуйте свободную фуру.");
		start_work[playerid] = 1;

		return true;
	}
	case D_FACTORYJOB_QUIT: {
		if(!response)
			return true;
		/*if(GetPVarInt(playerid, "factoryJob") == 1 && FarmJob_PI[playerid][farmPlantsCollected])
			return ErrorMessage(playerid, "Сначала сдайте собранные вами ростки на склад.");*/

		farm_DestroyRentVehicle(playerid);
		farm_DestroyAllPlants(playerid);

		if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_1))
			RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_1);
		if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_2))
			RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_2);
		if(GetPVarInt(playerid, "factoryMilkTaken")) {
			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			DeletePVar(playerid, "factoryMilkTaken");
		}
		new payday_factory, job_amount = FactoryJob_PI[playerid][factoryJobCollected];
		switch(GetPVarInt(playerid, "factoryJob")) {
			case 1: payday_factory = PAYDAY_FACTORY_JOB_1;
			case 2: payday_factory = PAYDAY_FACTORY_JOB_2;
		}
		if(job_amount * payday_factory) {
			static const f_factory_quit[] = "\
				Рабочий день окончен. Вы заработали $%i.";

			new str_factory_quit[sizeof(f_factory_quit) + (-2 + 12)];
			format(str_factory_quit, sizeof(str_factory_quit),
				f_factory_quit,
				job_amount * payday_factory
			);
			SendOk(playerid, str_factory_quit);
		}
		else SendOk(playerid, "Рабочий день окончен.");

		GiveMoney(playerid, job_amount * payday_factory, "работа на заводе");

		SetPlayerColor(playerid, TEAM_HIT_COLOR);
		start_work[playerid] = 0;

		InventoryTempInfo[playerid][tClothesSlotBlocked] = 0;
		inventory_UpdateClothes(playerid);

		DeletePVar(playerid, "factoryJob");
		HideJobInfoTD(playerid);

		new rent_vehicleid = TI[playerid][tArendaCar];
		if(rent_vehicleid != -1 && IsValidVehicle(rent_vehicleid) && VehicleInfo[rent_vehicleid][vJob] == FACTORY_VEHICLE_JOB_ID) {
			new factory_vehicleid = -1;
			for(new i = 0; i < MAX_FACTORY_VEHICLES; i++) {
				if(FactoryVehicleInfo[i][factoryVehicleID] == rent_vehicleid) {
					factory_vehicleid = i;
					break;
				}
			}
			if(factory_vehicleid != -1) factory_ResetRentVehicle(factory_vehicleid, playerid);
		}
		return true;
	}
	case D_FACTORYJOB_RENT: {
		if(!response)
			return RemovePlayerFromVehicleAC(playerid);
		if(PI[playerid][pCash] < FACTORY_VEHICLE_RENT_COST) {
			ErrorMessage(playerid, "У Вас недостаточно средств для аренды рабочего транспорта. ($"#FACTORY_VEHICLE_RENT_COST")");
			return RemovePlayerFromVehicleAC(playerid);
		}
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
			return true;
		new factory_vehicleid = GetPVarInt(playerid, "factoryTempVehicleID");
		if(FactoryVehicleInfo[factory_vehicleid][factoryVehicleOwnerID] != INVALID_PLAYER_ID){
			ErrorMessage(playerid, "Данный транспорт уже кто-то арендует.");
			return RemovePlayerFromVehicleAC(playerid);
		}
		GiveMoney(playerid, -FACTORY_VEHICLE_RENT_COST, "аренда завод (3)");
		TI[playerid][tArendaCar] = GetPlayerVehicleID(playerid);
		VehicleInfo[TI[playerid][tArendaCar]][vPlayer] = playerid;
		FactoryVehicleInfo[factory_vehicleid][factoryVehicleOwnerID] = playerid;
		// FactoryVehicleInfo[factory_vehicleid][factoryVehicleMilkAmount] = 0;
		//farm_UpdateVehicleText(factory_vehicleid);

		SendOk(playerid, "Загрузите ваш рабочий транспорт молоком и отвезите на завод.");
	}
	#endif

	case D_POLICE_ATTACH_LIST: {
		if(!response)
			return true;
		if(listitem == sizeof (PoliceAttachObjectInfo)) {
			if(ClearPoliceAttach(playerid)) {
				inventory_UpdateAccesory(playerid);
				SendOk(playerid, "Вы сняли всё полицейское снаряжение.");
			}
			else ErrorMessage(playerid, "На вас ничего не надето из снаряжения.");
			ShowPoliceAttachMenu(playerid);


		} else {
			new attach_type = PoliceAttachObjectInfo[listitem][attachType];
			if(TI[playerid][tPoliceAttachID][attach_type] == listitem) {
				playerListitemID[playerid][0] = listitem;
				ShowPoliceAttachMenu(playerid, 2);
			} else {
				new
					attachid = listitem, type = PoliceAttachObjectInfo[attachid][attachType],
					id = 9 * type, inventory_slotid = PoliceAttachObjectInfo[attachid][attachInventorySlot];

				if(inventory_slotid && PI[playerid][pItemsID][inventory_slotid])
					return ErrorMessage(playerid, "Сначала снимите аксессуар, который мешает! (головной убор)");
				TI[playerid][tPoliceAttachID][type] = attachid;

				TI[playerid][tPoliceAttachPos][0 + id] = PoliceAttachObjectInfo[attachid][attachPosition][0];
				TI[playerid][tPoliceAttachPos][1 + id] = PoliceAttachObjectInfo[attachid][attachPosition][1];
				TI[playerid][tPoliceAttachPos][2 + id] = PoliceAttachObjectInfo[attachid][attachPosition][2];
				TI[playerid][tPoliceAttachPos][3 + id] = PoliceAttachObjectInfo[attachid][attachPosition][3];
				TI[playerid][tPoliceAttachPos][4 + id] = PoliceAttachObjectInfo[attachid][attachPosition][4];
				TI[playerid][tPoliceAttachPos][5 + id] = PoliceAttachObjectInfo[attachid][attachPosition][5];
				TI[playerid][tPoliceAttachPos][6 + id] = PoliceAttachObjectInfo[attachid][attachPosition][6];
				TI[playerid][tPoliceAttachPos][7 + id] = PoliceAttachObjectInfo[attachid][attachPosition][7];
				TI[playerid][tPoliceAttachPos][8 + id] = PoliceAttachObjectInfo[attachid][attachPosition][8];

				ApplyPoliceAttach(playerid, attachid);
				SendOk(playerid, "Вы надели полицейское снаряжение.");

				ShowPoliceAttachMenu(playerid);
			}
		}
