	case D_SUB_CREATE: {
		new id;
		if(!response)
		{
			SendOk(playerid, "Вы отменили создание подразделения");
			CancelSubdivision(playerid);
			return true;
		}
		if(strlen(inputtext) < 1 || strlen(inputtext) > 15)
		{
			ErrorMessage(playerid, "Введите название от 1 символов до 15");
			return ShowPlayerDialog(playerid, D_SUB_CREATE, DSI, ""P"Создание подразделения", ""W"Введите название подразделения от 1 до 15 символов:", "Далее", "Закрыть");
		}
		for(new i = 1; i < MAX_FRACTIONS_SUBDIVISION; i ++)
		{
			if(Subdivision[i][sub_status] == 0)
			{
				id = i;
				break;
			}
		}
		Subdivision[id][sub_status] = 1;
		SubdivisionDialog[playerid][0] = id;
		strmid(Subdivision[id][sub_name], inputtext, 0, strlen(inputtext), 15);
		Subdivision[id][sub_frac] = PI[playerid][pMember];
		STRING_GLOBAL[0] = EOS;
		for(new i = 0; i < sizeof(color_fraction); i++)
		{
			if(i == (sizeof(color_fraction) - 1))
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x}%i.Цвет", STRING_GLOBAL, color_fraction[i][fracColor] >>> 8, i + 1);
				break;
			}
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x}%i.Цвет\n", STRING_GLOBAL, color_fraction[i][fracColor] >>> 8, i + 1);
		}
		ShowPlayerDialog(playerid, D_SUB_CREATE_2, DST, ""P"Выберите цвет", STRING_GLOBAL, "Далее", "Закрыть");
	}
