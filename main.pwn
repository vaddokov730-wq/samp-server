					TI[playerid][tInterior] = GetPlayerInterior(goid);
					SetPlayerFacingAngle(playerid, agle);
					SetPlayerPosAC(playerid, xX, xY, xZ);
					SetPlayerInterior(playerid, TI[playerid][tInterior]);
					SetPlayerVirtualWorld(playerid, TI[playerid][tVirtualWorld]);
				}
				if(!IsPlayerInRangeOfPoint(playerid, 20, xX, xY, xZ))
				{
					SetPlayerFacingAngle(playerid, agle);
					SetPlayerPosAC(playerid, xX, xY, xZ);
				}

				if(GetPlayerState(goid) == 1)
				{
					new ANIMATION;
					if(GotoInfo[goid][gtTPX] != 0.0 || GotoInfo[goid][gtTPY] != 0.0)
					{
						SetPlayerFaceToPoint(playerid, GotoInfo[goid][gtTPX], GotoInfo[goid][gtTPY]);
						ANIMATION = GoPlayerAnimation(playerid, GotoInfo[goid][gtTPX], GotoInfo[goid][gtTPY], GotoInfo[goid][gtTPZ]);
					}
					else
					{
						TurnPlayerFaceToPlayer(playerid, goid);
						ANIMATION = GoPlayerAnimation(playerid, xX, xY, xZ);
					}
					if(ANIMATION != 1)
					{
						if(IsPlayerInRangeOfPoint(playerid, 0.05, GotoInfo[playerid][gtX], GotoInfo[playerid][gtY], GotoInfo[playerid][gtZ]))
						{
							GotoInfo[playerid][gtStayed] ++;
							if(GotoInfo[playerid][gtStayed] >= 10)
							{
								new Float: xA;
								GetPlayerPos(playerid, xX, xY, xZ);
								GetPlayerFacingAngle(playerid, xA);
								ShiftCords(0, xX, xY, xZ, xA, 1.5);
								SetPlayerPosAC(playerid, xX, xY, xZ, TI[playerid][tVirtualWorld], TI[playerid][tInterior]);
								GotoInfo[playerid][gtStayed] = 0;
							}
						}
						else GotoInfo[playerid][gtStayed] = 0;
						GetPlayerPos(playerid, GotoInfo[playerid][gtX], GotoInfo[playerid][gtY], GotoInfo[playerid][gtZ]);
					}
				}
			}
			else
			{
				GotoInfo[playerid][gtGoID] = INVALID_PLAYER_ID;
				GotoInfo[playerid][gtX] = 0.0;
				GotoInfo[playerid][gtY] = 0.0;
				GotoInfo[playerid][gtZ] = 0.0;
			}
		}
		if(SERIU[playerid][sID] != INVALID_PLAYER_ID)
		{
			recon_update(playerid, SERIU[playerid][sID]);
		}
		// second_timerlog = 4;
		AdvertTimer();
		if(PlayerTrailer[playerid] != INVALID_VEHICLE_ID && !GetPVarInt(playerid, "attach_trailer"))
		{
			if(PlayerTrailerTime[playerid]) PlayerTrailerTime[playerid]--;
			else if(PlayerTrailerTime[playerid] < 1)
			{
				A_DestroyVehicle(PlayerTrailer[playerid]);
				PlayerTrailer[playerid] = INVALID_VEHICLE_ID;

				if(gPlayerProdText[playerid] != Text3D: -1)
				{
					DestroyDynamic3DTextLabel(gPlayerProdText[playerid]);
					gPlayerProdText[playerid] = Text3D:  -1;
				}
				if(gPlayerProdCP[playerid] != -1) DestroyDynamicCP(gPlayerProdCP[playerid]);
				DeletePVar(playerid, "count_prod2");
				DeletePVar(playerid, "count_prod");
				DeletePVar(playerid, "attach_trailer");
			}
		}
		if(IsPlayerInAnyVehicle(playerid))
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
				new veh = GetPlayerVehicleID(playerid);
				if(veh == LastVeh[playerid])
				{
					new tr = GetVehicleTrailer(veh);
					if(tr != 0)
					{
						if(VehTrailer[playerid] != INVALID_VEHICLE_ID)
						{
							if(VehTrailer[playerid] != tr)
							{
								OnPlayerDeattachTrailer(playerid, veh, VehTrailer[playerid]);
								VehTrailer[playerid] = tr;
								OnPlayerAttachTrailer(playerid, veh, tr);
							}
						}
						else
						{
							VehTrailer[playerid] = tr;
							OnPlayerAttachTrailer(playerid, veh, tr);
						}
					}
					else
					{
						if(VehTrailer[playerid] != INVALID_VEHICLE_ID)
						{
							OnPlayerDeattachTrailer(playerid, veh, VehTrailer[playerid]);
							VehTrailer[playerid] = INVALID_VEHICLE_ID;
						}
					}
				}
				else
				{
					LastVeh[playerid] = veh;
					new tr = GetVehicleTrailer(veh);
					if(tr != 0) VehTrailer[playerid] = tr;
					else VehTrailer[playerid] = INVALID_VEHICLE_ID;
				}
			}
		}
		if(TI[playerid][tTrucker][3] != 0 && TK_Trailer[playerid] != INVALID_VEHICLE_ID)
		{
			TI[playerid][tTrucker][3]--;
			format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "%d", TI[playerid][tTrucker][3]);
			GameTextForPlayer(playerid, COMMAND_GLOBAL, 1000, 6), COMMAND_GLOBAL[0] = EOS;
			if(TI[playerid][tTrucker][3] == 0)
			{
				TI[playerid][tTrucker][3] = 0;
				TI[playerid][tTrucker][2] = 0;
				TI[playerid][tTrucker][1] = 0;
				TI[playerid][tTrucker][0] = 0;
				A_DestroyVehicle(TK_Trailer[playerid]);
				TK_Trailer[playerid] = INVALID_VEHICLE_ID;
				SendOk(playerid, "Груз удален");
			}
		}
		if(Factory_TrailerTime[playerid] != 0 && Factory_Trailer[playerid] != INVALID_VEHICLE_ID)
		{
			Factory_TrailerTime[playerid]--;
			format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "%d", Factory_TrailerTime[playerid]);
			GameTextForPlayer(playerid, COMMAND_GLOBAL, 1000, 6), COMMAND_GLOBAL[0] = EOS;
			if(Factory_TrailerTime[playerid] == 0)
			{
				Factory_TrailerTime[playerid] = 0;
				A_DestroyVehicle(Factory_Trailer[playerid]);
				Factory_Trailer[playerid] = INVALID_VEHICLE_ID;
				SendOk(playerid, "Груз удален");
			}
		}
		gOnlinePlayer[playerid][0]++;
		NoRoof(playerid);
		// second_timerlog = 5;
		if(TI[playerid][tAntiDM] > 0)
		{
			if(GetPlayerAnimationIndex(playerid) != 471) ApplyAnimation(playerid, "FAT", "IDLE_tired", 4.0, 1, 0, 0, 0, 0, 1);
			TI[playerid][tAntiDM]--;
			if(TI[playerid][tAntiDM] == 0) ClearAnims(playerid);
		}

		// second_timerlog = 6;
		TI[playerid][tAFK] ++;
		if(TI[playerid][tAFK] >= 3)
		{
			format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), ""W"На паузе: "NO"%s", Convert(TI[playerid][tAFK]));
			SetPlayerChatBubble(playerid, COMMAND_GLOBAL, 0x7FB151AA, 10.0, 1600), COMMAND_GLOBAL[0] = EOS;
			gOnlinePlayerAFK[playerid][0]++;
		}

		if(oldpickup[playerid] != -1)
		{
			new Float: z;
			GetPlayerPos(playerid, z, z, z);
			if(timepickup[playerid] > 0) timepickup[playerid]--;
			if(!IsPlayerInRangeOfPoint(playerid, 5.0, PickupX[playerid], PickupY[playerid], z) && timepickup[playerid] == 0) oldpickup[playerid] = -1;
		}
		if(oldpickupStatic[playerid] != -1)
		{
			new Float: z;
			GetPlayerPos(playerid, z, z, z);
			if(timepickupStatic[playerid] > 0) timepickupStatic[playerid]--;
			if(!IsPlayerInRangeOfPoint(playerid, 4.0, PickupXStatic[playerid], PickupYStatic[playerid], z) && timepickupStatic[playerid] == 0) oldpickupStatic[playerid] = -1;
		}

		if(PI[playerid][pMute] > 0 && TI[playerid][tAFK] <= 3)
		{
			PI[playerid][pMute] -= 1;
			if(PI[playerid][pMute] <= 0)
			{
				SendOk(playerid, "Срок действия бана чата закончился");
				UpdatePlayerData(playerid, "mute", 0);
			}
		}
		if(PI[playerid][pMuteOOC] > 0 && TI[playerid][tAFK] <= 3)
		{
			PI[playerid][pMuteOOC] -= 1;
			if(PI[playerid][pMuteOOC] <= 0)
			{
				SendOk(playerid, "Срок действия бана чата закончился");
				UpdatePlayerData(playerid, "mute_ooc", 0);
			}
		}
		if(PI[playerid][pFMute] > 0 && TI[playerid][tAFK] <= 3)
		{
			PI[playerid][pFMute] --;
			if(!PI[playerid][pFMute])
			{
				UpdatePlayerData(playerid, "pFMute", 0);
				SendOk(playerid, "Срок действия заглушки в организации закончился");
			}
		}
		if(UsingDrugs[playerid] > 0)
		{
			UsingDrugs[playerid]--;
			if(UsingDrugs[playerid] == 0)
			{
				gettime(hour, minute);
				SetPlayerTime(playerid, ConvertHoursToGame(hour, minute), ConvertMinutesToGame(minute, second));
				SetPlayerWeather(playerid, 2);
				SetPlayerDrunkLevel(playerid, 0);
			}
		}
		if(thefttime[playerid] > 0)   //угон
		{
			thefttime[playerid]--;
			new tdstring[10];
			format(tdstring, sizeof(tdstring), "%02d:%02d", thefttime[playerid] / 60, thefttime[playerid] % 60);
			PlayerTextDrawSetString(playerid, theft_PTD[playerid][0], tdstring);
			if(thefttime[playerid] == 0)
			{
				SendOk(playerid, "Вы отменили задание, ваш навык угона понижен.");
				DestroyDynamicArea(theftarea[playerid][0]);
				DisablePlayerCheckpoint(playerid);
				DestroyDynamicCP(theftCheck[playerid][0]);
				A_DestroyVehicle(theftIDveh[playerid][0]);
				theftIDveh[playerid][0] = INVALID_VEHICLE_ID;
				if(theftveh[playerid][0] != INVALID_VEHICLE_ID)
				{
					A_DestroyVehicle(theftveh[playerid][0]);
					theftveh[playerid][0] = INVALID_VEHICLE_ID;
				}
				theftplayer[playerid][0] = 1010;
				theftplayer[playerid][1] = 0;
				theftCheck[playerid][1] = 0;
				PlayerTextDrawHide(playerid, theft_PTD[playerid][0]);
				thefttime[playerid] = 0;
				if(PI[playerid][ptheftExp] == 0)
				{
					if(PI[playerid][ptheftSkill] != 0) PI[playerid][ptheftSkill]--, UpdatePlayerData(playerid, "theftSkill", PI[playerid][ptheftSkill]);
					PI[playerid][ptheftExp] = TheftSkillMax[PI[playerid][ptheftSkill]] - 1, UpdatePlayerData(playerid, "theftExp", PI[playerid][ptheftExp]);
				}
				else
				{
					if(PI[playerid][ptheftExp] != 0) PI[playerid][ptheftExp]--, UpdatePlayerData(playerid, "theftExp", PI[playerid][ptheftExp]);
				}
			}
		}
		if(theftveh[playerid][1] > 0)   //угон
		{
			theftveh[playerid][1]--;
			new tdstring[10];
			format(tdstring, sizeof(tdstring), "%02d:%02d", theftveh[playerid][1] / 60, theftveh[playerid][1] % 60);
			PlayerTextDrawSetString(playerid, theft_PTD[playerid][1], tdstring);
			if(theftveh[playerid][1] == 0)
			{
				SendOk(playerid, "Ваш временный транспорт уничтожен.");
				if(theftveh[playerid][0] != INVALID_VEHICLE_ID)
				{
					A_DestroyVehicle(theftveh[playerid][0]);
					theftveh[playerid][0] = INVALID_VEHICLE_ID;
				}
				PlayerTextDrawHide(playerid, theft_PTD[playerid][1]);
			}
		}
		if(PI[playerid][pAskmute] > 0 && TI[playerid][tAFK] <= 3)
		{
			PI[playerid][pAskmute]--;
			if(PI[playerid][pAskmute] == 0)
			{
				UpdatePlayerData(playerid, "pAskMute", 0);
			}
		}
		if(PI[playerid][pJailTime] > 0)
		{
			PI[playerid][pJailTime] -= 1;
			if(PI[playerid][pJailTime] <= 0)
			{
				SetPlayerPosAC(playerid, camExit[PI[playerid][pJail] - 1][0], camExit[PI[playerid][pJail] - 1][1], camExit[PI[playerid][pJail] - 1][2], 0, 0);
				SetPlayerFacingAngle(playerid, camExit[PI[playerid][pJail] - 1][3]);
				SendClientMessage(playerid, CGOLD, "Вы заплатили свой долг обществу, теперь Вы свободны");
				PI[playerid][pJailTime] = 0;
				PI[playerid][pJail] = 0;
				UpdatePlayerData(playerid, "pJailTime", 0);
				UpdatePlayerData(playerid, "pJail", 0);
				SetCameraBehindPlayer(playerid);
				GameTextForPlayer(playerid, "~g~Freedom", 5000, 1);
			}
		}
		// second_timerlog = 8;
		if(PI[playerid][pCash] >= 1000000)
		{
			if(!TI[playerid][tShowKeys])
			{
				SetPlayerAttachedObject(playerid, ATTACH_SLOT_OTHER, 1210, 5, 0.299999, 0.099999, 0.000000, 0.000000, -83.000000, 0.000000, 1.000000, 1.000000, 1.000000);
				TI[playerid][tShowKeys] = true;
			}
			if(TI[playerid][tShowKeys])
			{
				if(GetPlayerWeapon(playerid) > 0 || GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || !PI[playerid][pSettings][7] || TI[playerid][tJobSad][0] || GetPVarInt(playerid, "fish_place") || TI[playerid][tJobGun][0] || TI[playerid][tJobOil][0] || TI[playerid][tClothesWork][0])
				{
					if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_OTHER))
						RemovePlayerAttachedObject(playerid, ATTACH_SLOT_OTHER);
				}
				else
				{
					if(!IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_OTHER))
						SetPlayerAttachedObject(playerid, ATTACH_SLOT_OTHER, 1210, 5, 0.299999, 0.099999, 0.000000, 0.000000, -83.000000, 0.000000, 1.000000, 1.000000, 1.000000);
				}
			}
		}
		else if(PI[playerid][pCash] < 1000000)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_SLOT_JOB_1))
			{
				if(TI[playerid][tShowKeys])
				{
					RemovePlayerAttachedObject(playerid, ATTACH_SLOT_JOB_1);
					TI[playerid][tShowKeys] = false;
				}
			}
		}
		if(TI[playerid][tSpcarTime])
		{
			TI[playerid][tSpcarTime]--;
			format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "~r~~h~%i", TI[playerid][tSpcarTime]);
			GameTextForPlayer(playerid, COMMAND_GLOBAL, 1000, 6), COMMAND_GLOBAL[0] = EOS;
			if(TI[playerid][tSpcarTime] == 1)
			{
				switch(PI[playerid][pJob])
				{
				case 1: if(GetPVarInt(playerid, "bus_id")) SetVehicleToRespawn(GetPVarInt(playerid, "bus_id"));
				case 2: if(GetPVarInt(playerid, "mehjob")) SetVehicleToRespawn(GetPVarInt(playerid, "mehjob"));
				case 3: if(GetPVarInt(playerid, "prod_vehicle_id")) SetVehicleToRespawn(GetPVarInt(playerid, "prod_vehicle_id"));
				case 4: if(GetPVarInt(playerid, "eatjob")) SetVehicleToRespawn(GetPVarInt(playerid, "eatjob"));

				}
				if(GetPVarInt(playerid, "track_id")) EndTrack(playerid);
				TI[playerid][tSpcarTime] = 0;
			}
		}
		if(TI[playerid][tAlcotraz][0])
		{
			TI[playerid][tAlcotraz][0]--;
			format(COMMAND_GLOBAL, sizeof(COMMAND_GLOBAL), "~r~~h~%p", TI[playerid][tAlcotraz][0]);
			GameTextForPlayer(playerid, COMMAND_GLOBAL, 1000, 6), COMMAND_GLOBAL[0] = EOS;
			if(TI[playerid][tAlcotraz][0] == 1)
			{
				SendClientMessage(playerid, COLOR_REDD, "Побег не удался. Время заключение увеличено на 20 минут");
				PI[playerid][pJailTime] += 1200;
				if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) SetVehicleToRespawn(GetPlayerVehicleID(playerid));
				DisablePlayerRaceCheckpoint(playerid);
				TI[playerid][tAlcotraz][2] = 0;
				TI[playerid][tAlcotraz][1] = 0;
				PlayerSpawn(playerid);
			}
		}

		if(TI[playerid][tDMArea][0] || TI[playerid][tGunArea][0]) UpdateInfoTD(playerid);
		if(TI[playerid][tDuel] != -1)
		{
			if(TI[playerid][tAFK] >= 20)
			{
				if(DI[TI[playerid][tDuel]][duel_start] == true)
				{
					end_duel(playerid, 1);
				}
			}
		}
		if(PI[playerid][pCash] != GetPlayerMoney(playerid)) ResetPlayerMoney(playerid), GivePlayerMoney(playerid, PI[playerid][pCash]);
	}
	// PlayerSecondTimer[playerid] = SetPreciseTimer("OnPlayerSecondUpdate", 1000, false, "d", playerid);
}

stock Float:fmax(Float: v1, Float: v2)
{
	return v1 > v2 ? v1 : v2;
}
stock Float:fmin(Float: v1, Float: v2)
{
	return v1 < v2 ? v1 : v2;
}
stock Float:jfloatsub(Float: value1, Float: value2)
{
	new Float: num1 = fmax(value1, value2);
	new Float: num2 = fmin(value1, value2);
	new Float: diff = (num1 - num2);
	if(diff > 300.0) diff = ( 360.0 - num1 ) + num2;
	return diff;
}
stock Float:PointToPoint3D(Float: x1, Float: y1, Float: z1, Float: x2, Float: y2, Float: z2) return floatsqroot(floatadd(floatadd(floatpower(x2 - x1, 2), floatpower(y2 - y1, 2)), floatpower(z2 - z1, 2)));

CB:OnPlayerSpeedometerUpdate(playerid, vehicleid, modelid) {
	new
		Float:Xx, Float:Yy, Float: Zz, Float: Health,
		Float:speedcar = _GetVehicleSpeed(vehicleid);

	GetVehicleHealth(vehicleid, Health);
	GetVehicleVelocity(vehicleid, Xx, Yy, Zz);

	if(TI[playerid][tAFK] <= 3) {
		new Float:X, Float:Y, Float:Z, Float:A, Float:X2, Float:Y2, Float: Z2;
		X2 = VehicleInfo[vehicleid][veX];
		Y2 = VehicleInfo[vehicleid][veY];
		Z2 = VehicleInfo[vehicleid][veZ];

		if(VehicleInfo[vehicleid][vEngineBoost] || VehicleInfo[vehicleid][vBrakeBoost]) {
			// new Float: speedcar = floatsqroot(floatpower(floatabs(Xx), 2.0) + floatpower(floatabs(Yy), 2.0) + floatpower(floatabs(Zz), 2.0)) * 100.3;

			if(VehicleInfo[vehicleid][vPerfStatus])
			{
				new key_pressed, ud, lr;
				GetPlayerKeys(playerid, key_pressed, ud, lr);
				if(VehicleInfo[vehicleid][vEngineBoost] > 0)
				{
					if(key_pressed == KEY_SPRINT && speedcar > 5 && modelid != 0 && speedcar < MaxSpeedCar[modelid - 400] && engine == 1 && modelid != 521 && modelid != 522)
					{
						SetVehicleSpeed(vehicleid, speedcar + VehicleInfo[vehicleid][vEngineBoost]);
						VehicleInfo[vehicleid][vzAngle] = Zz;
					}
				}
				if(VehicleInfo[vehicleid][vBrakeBoost] > 0)
				{
					if(key_pressed == KEY_JUMP && speedcar > 30 && (Zz - VehicleInfo[vehicleid][vzAngle] < 0.3 && Zz - VehicleInfo[vehicleid][vzAngle] > - 0.3) && modelid != 521 && modelid != 522)
					{
						SetVehicleSpeed(vehicleid, speedcar - VehicleInfo[vehicleid][vBrakeBoost] * 2);
						VehicleInfo[vehicleid][vzAngle] = Zz;
					}
				}
				VehicleInfo[vehicleid][vzAngle] = Zz;
			}
		}
		new model = modelid - 400;
		GetVehiclePos(vehicleid, X, Y, Z);
		new Float:veloc = PointToPoint3D(X2, Y2, Z2, X, Y, Z) / 1000;


		if(VehicleInfo[vehicleid][vEngine] == 1) {
			VehicleInfo[vehicleid][vDrived] += veloc;

			if(model >= 0 && modelid >= 400 && !IsABike(modelid) && !IsAVelik(modelid)) {
				VehicleInfo[vehicleid][vFuel] -= (veloc / 100) * gTransport[model][trConsumption];
				if(VehicleInfo[vehicleid][vFuel] <= 0.0) {
					VehicleInfo[vehicleid][vFuel] = 0.0;
					SetVehicleEngineStatus(vehicleid, playerid, 0);
					lights_status(vehicleid, 0, playerid);
				}
			}
			GetVehicleZAngle(vehicleid, A);
			if(Signal[vehicleid]) {
				new Float: LAngle = jfloatsub(A, SignalAngle[vehicleid]);
				if(SignalTick[vehicleid][1] >= 0) {
					SignalTick[vehicleid][1] --;
					if(!SignalTick[vehicleid][1]) {
						Signal[vehicleid] = 0;
						if(LightsObject[vehicleid][0] != -1) {
							DestroyDynamicObject(LightsObject[vehicleid][0]);
							LightsObject[vehicleid][0] = -1;
						}
						if(LightsObject[vehicleid][1] != -1) {
							DestroyDynamicObject(LightsObject[vehicleid][1]);
							LightsObject[vehicleid][1] = -1;
						}
					}
				}
				else if(LAngle >= 50.0) SignalTick[vehicleid][1] = 20;
				SignalTick[vehicleid][0] ++;
				if(SignalTick[vehicleid][0] > 17) SignalTick[vehicleid][0] = 0;
			}
		}
		if(Health < PLAYER_VEHICLE_MIN_HEATH) {
			SetVehicleHealth(vehicleid, PLAYER_VEHICLE_MIN_HEATH);
			SetVehicleEngineStatus(vehicleid, playerid, 0);
			lights_status(vehicleid, 0, playerid);
		}
		VehicleInfo[vehicleid][veX] = X;
		VehicleInfo[vehicleid][veY] = Y;
		VehicleInfo[vehicleid][veZ] = Z;

		if(TI[playerid][tTaxiGoing]) {
			new passid = TI[playerid][tTaxiPass], tarif;

			switch(modelid) {
				case 426, 438: tarif = FuncBizz[PI[playerid][bizz_work]][funcbTarif][0];
				case 540, 550: tarif = FuncBizz[PI[playerid][bizz_work]][funcbTarif][1];
				case 560, 580: tarif = FuncBizz[PI[playerid][bizz_work]][funcbTarif][3];
				default: tarif = FuncBizz[PI[playerid][bizz_work]][funcbTarif][0];
			}
			new sum1 = floatround((VehicleInfo[vehicleid][vDrived] - TI[playerid][tTaxiStart]) * tarif);
			new percent = floatround(sum1 / 100 * FuncBizz[PI[playerid][bizz_work]][funcbPercent]);
			new sum2 = sum1 - percent;
			if(GetPlayerState(passid) == PLAYER_STATE_PASSENGER && GetPlayerVehicleID(passid) == vehicleid) {
				static const f_str[] = "~w~TARIF: ~g~$%d/km~n~~w~Count: ~y~$%d";
				new mes[sizeof(f_str) + 1 + (-2 + 5) + (-2 + 6)];
				format(mes, sizeof(mes), f_str, tarif, sum1);
				GameTextForPlayer(playerid, mes, 1000, 1);
				GameTextForPlayer(passid, mes, 1000, 1);
				if(GetPlayerMoneyEx(passid) - 20 <= sum1) {
					if(GetPlayerMoneyEx(passid) - sum1 >= 0 && sum1 > 0) {
						bizz_pay(PI[playerid][bizz_work] - 1, percent);
						PI[playerid][bizz_cash] += percent;
						UpdatePlayerData(playerid, "bizz_cash", PI[playerid][bizz_cash]);
						GiveMoney(passid, -sum1, "taxipay");
						GiveMoney(playerid, sum2, "taxipay");
					}
					ErrorMessage(passid, "Недостаточно денег для проезда на такси");
					SendOk(playerid, "Пассажир оплачивающий такси вышел, счётчик отключен");
					TI[playerid][tTaxiGoing] = false;
					TI[playerid][tTaxiPass] = INVALID_PLAYER_ID;
					RemovePlayerFromVehicleAC(passid);
					passid = INVALID_PLAYER_ID;
				}
			} else {
				if(sum1 > 0) {
					bizz_pay(PI[playerid][bizz_work] - 1, percent);
					PI[playerid][bizz_cash] += percent;
					UpdatePlayerData(playerid, "bizz_cash", PI[playerid][bizz_cash]);
					GiveMoney(passid, -sum1, "taxipay");
					GiveMoney(playerid, sum2, "taxipay");
				}
				SendOk(playerid, "Пассажир оплачивающий такси вышел, счётчик отключен");
				RemovePlayerMapIcon(playerid, iconTaxi);
				RemovePlayerMapIcon(passid, iconTaxi);
				TI[playerid][tTaxiGoing] = false;
				TI[playerid][tTaxiPass] = INVALID_PLAYER_ID;
				TI[playerid][tTaxiStart] = 0.0;
				passid = INVALID_PLAYER_ID;
			}
		}
	}
	if(VehicleInfo[vehicleid][vType] == VEHICLE_TYPE_PLAYER && (0 <= VehicleInfo[vehicleid][vStatus] <= 80)) {
		new vehicleLimitSpeed = floatround(MaxSpeedCar[GetVehicleModel(vehicleid) - 400] * (VehicleInfo[vehicleid][vStatus] + 10) / 100);

		if(vehicleLimitSpeed < 10)
			vehicleLimitSpeed = 10;
		if(TI[playerid][tSLimit] >= vehicleLimitSpeed)
			TI[playerid][tSLimit] = 0;
		if(speedcar > vehicleLimitSpeed + 10) {
			new Float:dif = vehicleLimitSpeed / speedcar;
			SetVehicleVelocity(vehicleid, Xx * dif, Yy * dif, Zz * dif);
			speedcar = vehicleLimitSpeed;
		}
		/*if(VehicleInfo[vehicleid][vStatus] == 0) {
			VehicleInfo[vehicleid][vStatus] = 100;
			VehicleInfo[vehicleid][vFuel] = 50;
		}*/
	}
	if(TI[playerid][tSLimit]) {
		if(speedcar > TI[playerid][tSLimit]) {
			new Float: dif = TI[playerid][tSLimit] / speedcar;
			SetVehicleVelocity(vehicleid, Xx * dif, Yy * dif, Zz * dif);
			speedcar = TI[playerid][tSLimit];
		}
	}
	new stext[12 + 2];
	if(0 < speedcar <= 200) {
		new check_color, Float:bar_speed;

		bar_speed = 525.999 + (0.436005 * speedcar);
		PlayerTextDrawTextSize(playerid, speed_ptd[playerid][21], bar_speed, 9.457777);

		check_color = (speedcar > 20) ? floatround(speedcar / 20) : 0;
		if(check_color > (sizeof (speed_color) - 1)) check_color = sizeof (speed_color) - 1;
		PlayerTextDrawBoxColor(playerid, speed_ptd[playerid][21], speed_color[check_color]);
		PlayerTextDrawShow(playerid, speed_ptd[playerid][21]);
	}
	format(stext, sizeof(stext), "%02d", floatround(speedcar));
	PlayerTextDrawSetString(playerid, speed_ptd[playerid][18], stext);

	if(VehicleInfo[vehicleid][vFuel] <= 10)
		format(stext, sizeof(stext), "~r~%.0f ~w~L", VehicleInfo[vehicleid][vFuel] + 0.5);
	else format(stext, sizeof(stext), "~y~%.0f ~w~L", VehicleInfo[vehicleid][vFuel] + 0.5);
	PlayerTextDrawSetString(playerid, speed_ptd[playerid][14], stext);

	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

	format(stext, sizeof(stext), "%06d ~y~KM", floatround(VehicleInfo[vehicleid][vDrived]));
	PlayerTextDrawSetString(playerid, speed_ptd[playerid][12], stext);

	if(Health > 400) {
		format(stext, sizeof(stext), "~g~%d ~w~HP", floatround(Health));
	} else {
		format(stext, sizeof(stext), "~r~%d ~w~HP", floatround(Health));
	}
	PlayerTextDrawSetString(playerid, speed_ptd[playerid][10], stext);
	// pl_update_speed[playerid] = SetTimerEx("OnPlayerSpeedometerUpdate", 500, false, "ii", playerid, carid);
}
