	new price[5];
	for(new i; i < 5; i ++)
	{
		if(VehicleInfo[vehicleid][vPBrake][i]) format(str, sizeof(str), ""W"%s "P"[+ %.1f %s]\t"GREEN"Установлено\n", brake_name[i], brake_name_boost[i], "%");
		else
		{
			price[i] = brake_name_price[i];
			if(TYPE_VIP[playerid] != VIP_STATE_NONE)
			{
				price[i] = GetReasonMoneyPercentVip(playerid, TYPE_VIP_PERFOMANCE, brake_name_price[i]);
			}
			format(str, sizeof(str), ""G"%s "P"[+ %.1f %s]\t"ORANGE"$%d\n", brake_name[i], brake_name_boost[i], "%", price[i]);
		}
		strcat(string, str);
	}
	ShowPlayerDialog(playerid, D_PERF_BRAKE, DIALOG_STYLE_TABLIST, ""P"Тормозная система", string, "Купить", "Назад");
}
stock GetVehicleRotation(vehicleid, &Float: rx, &Float: ry, &Float: rz)
{
	new Float:qw, Float:qx, Float:qy, Float: qz;
	GetVehicleRotationQuat(vehicleid, qw, qx, qy, qz);
	rx = asin(2 * qy * qz - 2 * qx * qw ) ;
	ry = -atan2(qx * qz + qy * qw, 0.5 - qx * qx - qy * qy);
	rz = -atan2(qx * qy + qz * qw, 0.5 - qx * qx - qz * qz);
}
stock RemovePlayerFromVehicleAC(playerid)
{
	RemovePlayerFromVehicle(playerid);
	//SetTimerEx("remove_kick", 1200, 0, "d",playerid);
	return true;
}

#include "../logic/accessory.inc"

CB:SetVehiclePosAC(vehicleid, Float:x, Float:y, Float:z, Float:angle, world, interior) {
	SetVehiclePos(vehicleid, x, y, z);
	SetVehicleZAngle(vehicleid, angle);
	SetVehicleVirtualWorld(vehicleid, world);
	LinkVehicleToInterior(vehicleid, interior);
}
stock SetPlayerPosAC(playerid, Float: x, Float: y, Float: z, world = -1, interior = -1, setUP = false)  {
	printf("SetPlayerPosAC(playerid %d, %.1f, %.1f, %.1f) %d | %d ", playerid, x, y, z, world, interior);
	if(playerid != INVALID_PLAYER_ID) {
		gettime(tmphour, tmpminute, tmpsecond);
		if(!setUP) {
			if(world != -1 && TI[playerid][tVirtualWorld] != world) {
				if(PI[playerid][pDescriptionTextID] != INVALID_DYNAMIC_3D_TEXT_ID)
					Streamer_SetIntData(STREAMER_TYPE_3D_TEXT_LABEL, PI[playerid][pDescriptionTextID], E_STREAMER_WORLD_ID, world);
				TI[playerid][tVirtualWorld] = world;
				SetPlayerVirtualWorld(playerid, world);
			}
			if(interior != -1) {
				TI[playerid][tInterior] = interior;
				SetPlayerInterior(playerid, interior);

				if(!interior)
					SetPlayerTime(playerid, ConvertHoursToGame(tmphour, tmpminute), ConvertMinutesToGame(tmpminute, tmpsecond));
				else SetPlayerTime(playerid, 11, 00);
			}
		} else {
			if(world != -1) {
				if(PI[playerid][pDescriptionTextID] != INVALID_DYNAMIC_3D_TEXT_ID)
					Streamer_SetIntData(STREAMER_TYPE_3D_TEXT_LABEL, PI[playerid][pDescriptionTextID], E_STREAMER_WORLD_ID, world);
				TI[playerid][tVirtualWorld] = world;
				SetPlayerVirtualWorld(playerid, world);
			}
			if(interior != -1) {
				TI[playerid][tInterior] = interior;
				SetPlayerInterior(playerid, interior);
			}

			if(!interior)
				SetPlayerTime(playerid, ConvertHoursToGame(tmphour, tmpminute), ConvertMinutesToGame(tmpminute, tmpsecond));
			else SetPlayerTime(playerid, 11, 00);
		}
		// if(!IsPlayerInAnyVehicle(playerid))
		SetPlayerPos(playerid, x, y, z);
	}
}
stock auto_news(slot, playerid)
{
	format(gAdvert[slot][adSender], 24, "%s", player_name[playerid]);
	gAdvert[slot][adID] = playerid;
	gAdvert[slot][adPhone] = PI[playerid][pPhone];
	gAdvert[slot][adBusy] = true;
	gAdvert[slot][adTime] = gAdvertTime;
	gAdvertTime += 30;

	SetString(gAdvert[slot][adCheker], ""NameServer" Bot");

	gAdvert[slot][adCheking] = false;
	gAdvert[slot][adCheked] = true;

	SendOk(playerid, "Объявление подано в редакцию. Ожидайте публикации");
}

stock Float:GetSpeed(Float: x = 0.0, Float: y = 0.0, Float: z = 0.0) {
	return floatsqroot((x * x) + (y * y) + (z * z)) * 100.0;
}
CB:StartDrawing(playerid)
{
	SendOk(playerid, "Вы начали рисовать граффити!");
	PlayerGrafityFix[playerid] = 1;
	graf_timer[playerid] = SetTimerEx("graffity", 5000, false, "i", playerid);
	return 1;
}
GraffitiDone(playerid)
{
	if(PlayerGrafityFix[playerid] == 0) return 1;
	new obj;
	switch(PI[playerid][pMember]) {
	case 00: obj = 18666;
	case 20: obj = 18659;
	case 21: obj = 18661;
	case 22: obj = 18663;
	case 18: obj = 18664;
	case 19: obj = 18665;//вагос
	}
	DestroyDynamicObject(GrafInfo[GetPVarInt(playerid, "Grafity")][gObject]);
	GrafInfo[GetPVarInt(playerid, "Grafity")][gObject] = CreateDynamicObject(obj, GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][0], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][1], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][2], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][3], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][4], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][5]);
	GrafInfo[GetPVarInt(playerid, "Grafity")][gFrak] = PI[playerid][pMember];

	if(PlayerGrafityFix[playerid] == 1) PlayerGrafityFix[playerid] = 0;
	GameTextForPlayer(playerid, "~g~GOOD", 1000, 5);
	Streamer_Update(playerid);

	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "UPDATE `graffity` SET `gGang` = '%d' WHERE `gID` = '%d'", PI[playerid][pMember], GetPVarInt(playerid, "Grafity"));
	mysql_tquery(connects, MYSQL_GLOBAL);
	if(PI[playerid][pMember]) add_gang_points(PI[playerid][pMember], 1);
	return 1;
}

GraffitiFailed(playerid)
{
	if(PlayerGrafityFix[playerid] == 1)
	{
		PlayerGrafityFix[playerid] = 0;
	}
	GameTextForPlayer(playerid, "~r~FAILED", 1000, 5);
	return 1;
}
CB:graffity(playerid)
{
	graf_timer[playerid] = -1;
	TimerCallFix[25] ++;
	GraffitiDone(playerid);
	return 1;
}
