stock AddCheater(playerid)
{
	/*new str[10];
	if(addchet[playerid] == 0) addchet[playerid] = 1;
	else addchet[playerid] = 2;
	for(new i; i < 10; i++)
	{
		if(ChetInfo[i][cheatid1] == playerid)return false;
	}
	ChetInfo[Cheat1][cheatid1] = playerid;
	format(str, sizeof(str), "%d", playerid);
	TextDrawSetString(CheatText[Cheat1], str);
	Cheat1 ++;
	if(Cheat1 > 9) Cheat1 = 0;*/


	if(addchet[playerid] == 0)
		addchet[playerid] = 1;
	else addchet[playerid] = 2;

	// for(new i; i < 10; i++) if(ChetInfo[i][cheatid1] == playerid)return false;
	for(new i = 1; i < 10; i++)  {

		ChetInfo[i][cheatid1] = ChetInfo[i - 1][cheatid1];
	}
	ChetInfo[0][cheatid1] = playerid;

	UpdateCheatPanel();

	return 1;
}
stock UpdateCheatPanel() {
	STRING_GLOBAL[0] = EOS;

	for(new i = 0, str[22]; i < 10; i++) {
		if(INVALID_PLAYER_ID == ChetInfo[i][cheatid1])
			format(str, sizeof(str), "~w~000__");
		else {
			switch(ChetInfo[i][cheatid1]) {
				case 0..9:  format(str, sizeof(str), "~w~00~r~~h~~h~~h~%i__", ChetInfo[i][cheatid1]);
				case 10..99: format(str, sizeof(str), "~w~0~r~~h~~h~~h~%i__", ChetInfo[i][cheatid1]);
				default: format(str, sizeof(str), "~r~~h~~h~~h~%i__", ChetInfo[i][cheatid1]);
			}
		}
		strcat(STRING_GLOBAL, str);
	}
	TextDrawSetString(CheatPanelTD[2], STRING_GLOBAL), STRING_GLOBAL[0] = EOS;
}
public OnPlayerSelectObject(playerid, type, objectid, modelid, Float: fX, Float: fY, Float: fZ)
{
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return true;
	if(gAdmin[playerid][9] == 0 || PI[playerid][pAdmin] < 4) return 0x1;
	return EditObject(playerid, objectid);
}

public OnPlayerEditDynamicObject( playerid, objectid, response, Float: x, Float: y, Float: z, Float: rx, Float: ry, Float: rz )
{
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return true;

	#if defined _mapeditor_included
		if(ME_OnPlayerEditDynamicObject(playerid, objectid, response, x, y, z, rx, ry, rz)) return true;
	#endif
	if(gAdmin[playerid][9] == 0 || PI[playerid][pAdmin] < 4) return 0x1;
	if(response == EDIT_RESPONSE_FINAL)
	{
		if(EdittingATM[playerid] != 0)
		{
			new atmID = EdittingATM[playerid];
			ATMData[atmID][ATM_Pos][0]   = x;
			ATMData[atmID][ATM_Pos][1]   = y;
			ATMData[atmID][ATM_Pos][2]   = z;
			ATMData[atmID][ATM_Pos][3]   = rx;
			ATMData[atmID][ATM_Pos][4]   = ry;
			ATMData[atmID][ATM_Pos][5]   = rz;

			SaveATM(atmID);
			new string[128];
			format(string, sizeof(string), "Вы изменили позицию ATM номер %d", atmID);
			SendOk(playerid, string);

			UpdateATMLabel(atmID);

			if(ATMData[atmID][atm_Object]) DestroyDynamicObject(ATMData[atmID][atm_Object]);

			ATMData[atmID][atm_Object] = CreateDynamicObject(2754, ATMData[atmID][ATM_Pos][0], ATMData[atmID][ATM_Pos][1], ATMData[atmID][ATM_Pos][2], 0.0, 0.0, ATMData[atmID][ATM_Pos][5], ATMData[atmID][atm_VW], ATMData[atmID][atm_INT]);
			EdittingATM[playerid] = 0;
			return 1;
		}
	}
	else if(response == EDIT_RESPONSE_UPDATE)
	{
		SetObjectPos(objectid, x, y, z);
		SetObjectRot(objectid, rx, ry, rz);
	}
	if(response == EDIT_RESPONSE_CANCEL)
	{
		new atmID = EdittingATM[playerid];
		if(EdittingATM[playerid] != 0)
		{
			SetTimerEx("SetObjectOldPos", 300, false, "dffffff", ATMData[atmID][atm_Object], ATMData[objectid][ATM_Pos][0], ATMData[objectid][ATM_Pos][1], ATMData[objectid][ATM_Pos][2], ATMData[objectid][ATM_Pos][3], ATMData[objectid][ATM_Pos][4], ATMData[objectid][ATM_Pos][5]);
			EdittingATM[playerid] = 0;
		}
	}
	else if(response) SetDynamicObjectPos(objectid, x, y, z), SetDynamicObjectRot(objectid, rx, ry, rz);
	return true;
}
CB:SetObjectOldPos(objectid, Float: oldX, Float: oldY, Float: oldZ, Float: oldRotX, Float: oldRotY, Float: oldRotZ)
{
	TimerCallFix[12] ++;
	SetDynamicObjectPos(objectid, oldX, oldY, oldZ);
	SetDynamicObjectRot(objectid, oldRotX, oldRotY, oldRotZ);
	return 1;
}
public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float: x, Float: y, Float: z) return EditDynamicObject(playerid, objectid);
public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float: new_x, Float: new_y, Float: new_z, Float: vel_x, Float: vel_y, Float: vel_z)
{
	if(VehicleInfo[vehicleid][vType] == VEHICLE_TYPE_PLAYER && VehicleInfo[vehicleid][vParkingFine]) {
		new player_vehicleid = VehicleInfo[vehicleid][vPlayerVehicleID];

		if(GetVehicleDistanceFromPoint(vehicleid, PlayerVehicleInfo[player_vehicleid][carPos][0], PlayerVehicleInfo[player_vehicleid][carPos][1], PlayerVehicleInfo[player_vehicleid][carPos][2]) > 2.0) {
			SetVehiclePos(vehicleid, PlayerVehicleInfo[player_vehicleid][carPos][0], PlayerVehicleInfo[player_vehicleid][carPos][1], PlayerVehicleInfo[player_vehicleid][carPos][2]);
			SetVehicleZAngle(vehicleid, PlayerVehicleInfo[player_vehicleid][carPos][3]);
		}
	}
	return 1;
}
public OnTrailerUpdate(playerid, vehicleid)
{
	if(!IsPlayerInAnyVehicle(playerid) || GetVehicleTrailer(GetPlayerVehicleID(playerid)) != vehicleid)
		return false;
	return 1;
}
stock IsAGreenZone(playerid)
{
	for(new i = 1; i <= TOTALZONE; i++) if(IsPlayerInRangeOfPoint(playerid, GREENZONE[i][grD], GREENZONE[i][grX], GREENZONE[i][grY], GREENZONE[i][grZ])) return true;
	return false;
}
stock ShowStats(playerid, targetid, idx)
{
	if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return true;
	new jtext[28];
	switch(PI[targetid][pJob])
	{
	case 1: jtext = "Водитель автобуса";
	case 2: jtext = "Механик";
	case 3: jtext = "Развозчик продуктов/топлива";
	case 4: jtext = "Развозчик еды";
	case 5: jtext = "Мойщик дорог";
	default: jtext = "Безработный";
	}

	STRING_GLOBAL[0] = EOS;
	new str[128];
	format(str, 128, ""P"Имя:\t\t\t\t\t"YELLOW"%s", player_name[targetid]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n\n"P"Уровень:\t\t\t\t"W"%i", PI[targetid][pLevel]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Очки опыта:\t\t\t\t"W"%i/%i", PI[targetid][pExp], (PI[targetid][pLevel]) * 6), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Предупреждений:\t\t\t"W"%i", PI[targetid][pWarns]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n\n"P"Пол:\t\t\t\t\t"W"%s", (PI[targetid][pSex] == 1) ? ("Мужчина") : ("Женщина")), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Супруг(а):\t\t\t\t"W"%s", PI[targetid][pMarried]), strcat(STRING_GLOBAL, str);
	if(PI[targetid][pPhone] == 0) strcat(STRING_GLOBAL, "\n\n"P"Номер телефона:\t\t\t"W"Отсутствует");
	else format(str, 128, "\n\n"P"Номер телефона:\t\t\t"W"%i", PI[targetid][pPhone]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Мобильный счёт:\t\t\t"W"%i", PI[targetid][pMobile]), strcat(STRING_GLOBAL, str);

	format(str, 128, "\n\n"P"Законопослушность:\t\t\t"W"%i", PI[targetid][pZakonp]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Преступлений:\t\t\t\t"W"%i", PI[targetid][pCrimes]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Арестов:\t\t\t\t"W"%i", PI[targetid][pArrested]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Уровень розыска:\t\t\t"W"%i", PI[targetid][pSearch]), strcat(STRING_GLOBAL, str);
	format(str, 128, "\n"P"Зависимость:\t\t\t\t"W"%i", PI[targetid][pAddiction]), strcat(STRING_GLOBAL, str);

	if(GetTeamID(targetid)) format(str, 128, "\n\n"P"Организация:\t\t\t\t"W"%s", FI[GetTeamID(targetid)][fName]), strcat(STRING_GLOBAL, str);
	else strcat(STRING_GLOBAL, "\n\n"P"Организация:\t\t\t\t"W"Отсутствует");

	if(idx)
	{
		if(PI[targetid][pRank] != 0) format(str, 128, "\n"P"Должность:\t\t\t\t"W"%s (%d)", GetRankName(GetTeamID(targetid), PI[targetid][pRank]), PI[targetid][pRank]), strcat(STRING_GLOBAL, str);
		else format(str, 128, "\n"P"Должность:\t\t\t\t"W"%s", GetRankName(GetTeamID(targetid), PI[targetid][pRank])), strcat(STRING_GLOBAL, str);
	}
	else format(str, 128, "\n"P"Должность:\t\t\t\t"W"%s", GetRankName(GetTeamID(targetid), PI[targetid][pRank])), strcat(STRING_GLOBAL, str);
	
	new organization_id = PI[targetid][pOrgMember];
	if(organization_id) {
		format(str, 128, "\n\n"P"Пользовательская организация:\t"W"%s", OrganizationInfo[organization_id][orgName]);
		strcat(STRING_GLOBAL, str);

		format(str, 128, "\n"P"Должность:\t\t\t\t"W"%s", OrganizationRank[organization_id][PI[targetid][pOrgRank] - 1]), strcat(STRING_GLOBAL, str);
	} else {
		strcat(STRING_GLOBAL, "\n\n"P"Пользовательская организация:\t\t\t\t"W"Отсутствует");
	}

	
	/*switch(PI[playerid][pMember])
	{
	case 1, 2, 3, 4, 6, 7: {
		format(str, 128, "\n"P"Подразделение:\t\t\t"W"%s", Subdivision[SubdivisionPlayer[playerid][0]][sub_name]), strcat(STRING_GLOBAL, str);
	}
	}*/
	if(PI[targetid][pHouse])
	{
		new classname[15];
		switch(gHouses[PI[targetid][pHouse] - 1][houseClass])
		{
		case 0: classname = "Эконом";
		case 1: classname = "Cредний";
		case 2: classname = "Элитный";
		case 3: classname = "Особняк";
		}
		format(str, 128, "\n\n"P"Дом:\t\t\t\t\t"W"№%d (%s)", gHouses[PI[targetid][pHouse] - 1][houseID], classname), strcat(STRING_GLOBAL, str);
	}
	else strcat(STRING_GLOBAL, "\n\n"P"Дом:\t\t\t\t\t"W"Отсутствует");
	if(PI[targetid][pBusiness]) format(str, 128, "\n"P"Бизнес:\t\t\t\t"W"%s (%s)", gBusiness[PI[targetid][pBusiness] - 1][bizzName], gBusinessTypeName[gBusiness[PI[targetid][pBusiness] - 1][bizzType] - 1]), strcat(STRING_GLOBAL, str);
	else strcat(STRING_GLOBAL, "\n"P"Бизнес:\t\t\t\t"W"Отсутствует");
	if(PI[targetid][pHotel]) format(str, 128, "\n"P"Отель:\t\t\t\t"W"%s", gHotels[PI[targetid][pHotel] - 1][hotelName]), strcat(STRING_GLOBAL, str);
	else strcat(STRING_GLOBAL, "\n"P"Отель:\t\t\t\t\t"W"Отсутствует");
	if(PI[targetid][pAirport]) format(str, 128, "\n"P"Аэропорт:\t\t\t\t"W"%s", gAirs[PI[targetid][pAirport] - 1][airName]), strcat(STRING_GLOBAL, str);
	else strcat(STRING_GLOBAL, "\n"P"Аэропорт:\t\t\t\t"W"Отсутствует");

	format(str, 128, "\n\n"P"Работа:\t\t\t\t\t"W"%s", jtext), strcat(STRING_GLOBAL, str);
	if(idx)
	{
		format(str, 128, "\n"P"Банк:\t\t\t\t\t"W"%i", PI[targetid][pBank]), strcat(STRING_GLOBAL, str);
		format(str, 128, "\n"P"На руках:\t\t\t\t"W"%i", PI[targetid][pCash]), strcat(STRING_GLOBAL, str);
		format(str, 128, "\n"P"Скин:\t\t\t\t\t"W"%i", PI[targetid][pSkin]), strcat(STRING_GLOBAL, str);
		format(str, 128, "\n"P"СкинФр:\t\t\t\t"W"%i", PI[targetid][pFracSkin]), strcat(STRING_GLOBAL, str);
		format(str, 128, "\n"P"Дата регистрации:\t\t\t"W"%s", PI[targetid][pDataReg]), strcat(STRING_GLOBAL, str);
		format(str, 128, "\n"P"Google Authenticator:\t\t\t"W"%s", (PI[targetid][pGoogleSec] == 1) ? ("Включен") : ("Отключен")), strcat(STRING_GLOBAL, str);
	}
	strcat(STRING_GLOBAL, "\n\n"ORANGE"Информацию о проекте Вы можете узнать по адресу:");
	strcat(STRING_GLOBAL, "\n\t\t\t"ORANGE""NameSite"");
	return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Статистика", STRING_GLOBAL, "Закрыть", "");
}

stock UpdateSkladFrakGang()
{
	ClearTotalGz();
	for(new i = 0; i < TOTALGZ; i++)
	{
		if(GZInfo[i][gFrakVlad] == fBALLAS) TotalGZ[0]++;
		if(GZInfo[i][gFrakVlad] == fVAGOS) TotalGZ[1]++;
		if(GZInfo[i][gFrakVlad] == fGROVE) TotalGZ[2]++;
		if(GZInfo[i][gFrakVlad] == fAZTEC) TotalGZ[4]++;
		if(GZInfo[i][gFrakVlad] == fRIFA) TotalGZ[3]++;
	}
	new string[250];
	format(string, sizeof(string), "Склад банды {8813E7}Ballas"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d", TotalGZ[0], FI[fBALLAS][fMats], FI[fBALLAS][fDrugs], FI[fBALLAS][fBank], TotalGZ[0] * 65);
	UpdateDynamic3DTextLabelText(gMenu[0], -1, string);
	format(string, sizeof(string), "Склад банды {DBD604}Vagos"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d", TotalGZ[1], FI[fVAGOS][fMats], FI[fVAGOS][fDrugs], FI[fVAGOS][fBank], TotalGZ[1] * 65);
