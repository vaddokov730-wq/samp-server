CMD:change_car(playerid, params[]) {
	new vehicle_amount = GetPlayerVehicles(playerid);
	if(!vehicle_amount)
		return ErrorMessage(playerid, "У Вас нет личных ТС.");

	new targetid;
	if(sscanf(params, "i", targetid) || !(0 <= targetid < MAX_PLAYERS) || targetid == playerid)
		return SendEsp(playerid, "/changecar [id игрока]");

	if(!IsPlayerStream(5.0, playerid, targetid))
		return ErrorMessage(playerid, "Игрок не рядом с Вами!");

	TradingInfo[playerid][tradePlayerID] = INVALID_PLAYER_ID;
	TradingInfo[playerid][tradePlayerVehicleID] = INVALID_VEHICLE_ID;
	TradingInfo[playerid][tradeTargetVehicleID] = INVALID_VEHICLE_ID;
	TradingInfo[playerid][tradeCost] = 0;

	ShowTradeCarMenu(playerid);
	return true;
}
CMD:gotobiz(playerid, params[]) {

	TI[playerid][tTPpick] = true;
	SetPlayerPosAC(playerid, gBusiness[id][bizzX], gBusiness[id][bizzY], gBusiness[id][bizzZ], 0, 0);
	SetPlayerFacingAngle(playerid, gBusiness[id][bizzR]);
	SetCameraBehindPlayer(playerid);

	format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы телепортировать к бизнесу - %s [Тип: %s] - текущая цена: $%i");
	SendClientMessage(playerid, -1, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
	return true;
}
