		{
			PlayerPageFix[playerid] = 0;
			PlayerRowsFix[playerid] = 0;
			return pc_cmd_bl(playerid);
		}
		if(listitem == 0)
		{
			new rows_list = PlayerPageFix[playerid] - 1;
			new query[128];
			if(rows_list == 0)
			{
				format(query, sizeof (query), "SELECT * FROM `fraction_bl` WHERE `f_bl_id` = '%d'", PI[playerid][pMember]);
				mysql_pquery(connects, query, "bl_callback", "i", playerid );
				ErrorMessage(playerid, "Вы на 1ой странице");
				return 1 ;
			}
			PlayerPageFix[playerid] = rows_list;
			format(query, sizeof(query), "SELECT * FROM `fraction_bl` WHERE `f_bl_id` = '%d'", PI[playerid][pMember]);
			mysql_pquery(connects, query, "bl_callback", "i", playerid);
		}
		else if(listitem == 1)
		{
			new rows_list = PlayerPageFix[playerid] - 1;
			new query[128];
			if((rows_list + 1 ) * 10 >= PlayerRowsFix[playerid])
			{
				ErrorMessage(playerid, "Вы на последней странице");
				format(query, sizeof (query), "SELECT * FROM `fraction_bl` WHERE `f_bl_id` = '%d'", PI[playerid][pMember]);
				mysql_pquery(connects, query, "bl_callback", "i", playerid);
				return 1 ;
			}
			PlayerPageFix[playerid] = rows_list + 2;
			format(query, sizeof (query), "SELECT * FROM `fraction_bl` WHERE `f_bl_id` = '%d'", PI[playerid][pMember]);
			mysql_pquery(connects, query, "bl_callback", "i", playerid);
		}
		else
		{
			MYSQL_GLOBAL[0] = EOS;
			format(MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT * FROM `fraction_bl` WHERE `f_bl_id` = '%d'", PI[playerid][pMember]);
			mysql_pquery(connects, MYSQL_GLOBAL, "bl_callback", "i", playerid);
		}
