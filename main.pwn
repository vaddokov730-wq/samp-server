		if(PI[playerid][pBusiness]) return  ErrorMessage(playerid, "У Вас уже есть бизнес");

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `business` SET `ownerid` = '%d', `owner` = '%s' WHERE `id` = '%d'", PI[playerid][pID], player_name[playerid], businessid + 1);
		mysql_tquery(connects, STRING_GLOBAL, "", "");

		gBusiness[businessid][bizzOwnerID] = PI[playerid][pID];
		SetString(gBusiness[businessid][bizzOwner], player_name[playerid]);
